{
  "name": "prompt-base",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "cf-typegen": "wrangler types",
    "db:gen-seed": "node --experimental-strip-types scripts/gen-seed.ts",
    "db:setup:local": "npm run db:gen-seed && wrangler d1 execute freepromptbase-com --local --file=db/schema.sql && wrangler d1 execute freepromptbase-com --local --file=db/seed.sql",
    "db:setup:remote": "npm run db:gen-seed && wrangler d1 execute freepromptbase-com --remote --file=db/schema.sql && wrangler d1 execute freepromptbase-com --remote --file=db/seed.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.5.4",
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tiptap/core": "^3.23.6",
    "@tiptap/extension-image": "^3.23.6",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/extension-table": "^3.23.6",
    "@tiptap/extension-table-cell": "^3.23.6",
    "@tiptap/extension-table-header": "^3.23.6",
    "@tiptap/extension-table-row": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "astro": "^6.3.7",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260526.1",
    "wrangler": "^4.94.0"
  }
}
