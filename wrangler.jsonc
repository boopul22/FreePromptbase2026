{
	// Cloudflare Worker for Free Prompt Base.
	// SSR via the @astrojs/cloudflare adapter (unified entrypoint) + static
	// assets, with a D1 database binding for prompt content.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "freepromptbase2026",
	// The auth token may have access to multiple CF accounts; pin the one that
	// owns this project's domain/D1/R2/email so wrangler never prompts to choose.
	"account_id": "ab54ca2d01df4886aa0c3f240ace806d",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-05-25",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// The SSR worker renders 404.astro for unmatched routes.
		"not_found_handling": "none"
	},
	"observability": { "enabled": true },
	"d1_databases": [
		{
			// Accessed in code as env.DB (see src/lib/prompts.ts + src/lib/db.ts).
			"binding": "DB",
			"database_name": "freepromptbase-com",
			"database_id": "90131e07-7de7-48e7-b8bc-6153b5b105e6"
		}
	],
	"r2_buckets": [
		{
			// Accessed in code as env.R2 (CMS media library uploads use the binding
			// directly — no S3 API token needed).
			"binding": "R2",
			"bucket_name": "freepromptbase-media-2026"
		}
	],
	// Cloudflare Email Sending binding — used by src/lib/subscribers.ts as
	// env.EMAIL.send() to deliver double opt-in + welcome emails. Requires the
	// sender domain (freepromptbase.com) to be onboarded to Email Sending:
	//   npx wrangler email sending enable freepromptbase.com
	// (or onboard it in the Cloudflare dashboard → Email → Email Sending), then
	// add the DNS records Cloudflare provides. To exercise real sends during local
	// `wrangler dev`, temporarily add `"remote": true` to this binding (it proxies
	// to the live service, so it needs a token with email perms — leave it off for
	// normal builds/deploys).
	"send_email": [
		{ "name": "EMAIL" }
	],
	"kv_namespaces": [
		{
			// Required by @astrojs/cloudflare which auto-enables Astro sessions.
			// We don't use Astro sessions ourselves (the CMS has its own D1-backed
			// sessions in src/lib/session.ts), but the adapter still expects this
			// binding. Pinning the existing namespace ID prevents the build from
			// trying to re-create it on every deploy.
			"binding": "SESSION",
			"id": "f32c5a6d533d46dea4de2fe8417d82d6"
		}
	],
	"vars": {
		// Same-origin CDN proxy — uploaded media URLs are built as
		// `${R2_PUBLIC_URL}/${r2_key}` and served via the /cdn/<key> route in
		// src/pages/cdn/[...key].ts. Keeps every image under the project's
		// own domain for SEO + branding. Safe to commit; not a secret.
		"R2_PUBLIC_URL": "https://freepromptbase.com/cdn",
		// Non-secret admin user id used to credit authenticated agent publishes.
		// The bearer credential itself is the AGENT_PUBLISH_TOKEN Worker secret.
		"AGENT_PUBLISH_USER_ID": "oRrwF0SWVY3NqH6iQ8LPf",

		// Newsletter (Cloudflare Email Service) — the custom branded sender address
		// and reply-to. EMAIL_FROM's domain must be onboarded to Email Sending.
		// SITE_URL builds the confirm/unsubscribe links inside emails. Not secrets.
		"EMAIL_FROM": "updates@freepromptbase.com",
		"EMAIL_FROM_NAME": "Free Prompt Base",
		"EMAIL_REPLY_TO": "hello@freepromptbase.com",
		"SITE_URL": "https://freepromptbase.com"
	}
}
