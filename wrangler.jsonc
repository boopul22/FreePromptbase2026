{
	// Cloudflare Worker for Free Prompt Base.
	// SSR via the @astrojs/cloudflare adapter (unified entrypoint) + static
	// assets, with a D1 database binding for prompt content.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "freepromptbase2026",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-05-25",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// The SSR worker renders 404.astro for unmatched routes.
		"not_found_handling": "none"
	},
	"observability": { "enabled": true },
	"d1_databases": [
		{
			// Accessed in code as env.DB (see src/lib/prompts.ts).
			"binding": "DB",
			"database_name": "freepromptbase",
			// Filled in after `wrangler d1 create freepromptbase`.
			"database_id": "PLACEHOLDER_DB_ID"
		}
	]
}
