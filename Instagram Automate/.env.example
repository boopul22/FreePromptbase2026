# Instagram API with Instagram Login (recommended)
IG_ACCESS_TOKEN=replace_me
IG_USER_ID=replace_me
IG_API_HOST=https://graph.instagram.com
IG_API_VERSION=v25.0

# Facebook Page API. The configured Facebook User token is exchanged for the
# Page-scoped token at runtime through /me/accounts.
FB_PAGE_ID=your-facebook-page-id
FB_PAGE_ACCESS_TOKEN=your-facebook-user-access-token
FB_API_HOST=https://graph.facebook.com
FB_API_VERSION=v26.0

# Optional local settings
# IG_AGENT_DB=/absolute/path/to/jobs.sqlite3
# IG_PROCESSING_TIMEOUT=300

# For the older Facebook Login flow, use:
# IG_API_HOST=https://graph.facebook.com
# IG_ACCESS_TOKEN=<page-access-token>
