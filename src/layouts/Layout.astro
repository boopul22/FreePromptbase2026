---
import '../styles/global.css';
import IconSprite from '../components/IconSprite.astro';

interface Props {
	title?: string;
	description?: string;
	/** Optional page-specific JSON-LD (e.g. CreativeWork on a prompt page). */
	schema?: Record<string, unknown>;
	/** Additional JSON-LD blocks (BreadcrumbList, ItemList, etc.) emitted alongside `schema`. */
	extraSchemas?: Record<string, unknown>[];
	/** Absolute or root-relative URL of the social-share image (1200×630 ideal). */
	ogImage?: string;
	/** `website` (default) or `article` for detail pages. */
	ogType?: 'website' | 'article';
	/** Set to true on admin/CMS pages to add a noindex meta + load Material Symbols. */
	noindex?: boolean;
	/** Optional robots meta override for crawlable pages that should not be indexed. */
	robots?: string;
	/** LCP image to preload (href fallback). Pair with the srcset/sizes below. */
	preloadImage?: string;
	preloadImageSrcset?: string;
	preloadImageSizes?: string;
}

const {
	title = 'Free Prompt Base – AI Prompt Library for ChatGPT & Gemini',
	description = 'A free library of ready-to-use AI prompts for ChatGPT, Midjourney, Claude and Gemini. No signup needed. Find one, copy it, create.',
	schema,
	extraSchemas = [],
	ogImage = '/og-default.png',
	ogType = 'website',
	noindex = false,
	robots,
	preloadImage,
	preloadImageSrcset,
	preloadImageSizes,
} = Astro.props;

// Offerwall control — must be defined on window BEFORE adsbygoogle.js loads.
// The messaging library calls controlledMessagingFunction once per page view;
// we suppress just the Offerwall (consent and other privacy messages still
// show) so nothing ever interrupts reading or copying a prompt, and fail open
// if the MessageTypeEnum API is ever missing. Kept as a frontmatter string +
// set:html because the Astro compiler mangles raw script bodies inside
// expressions.
const offerwallGateInit = `(function () {
	window.googlefc = window.googlefc || {};
	window.googlefc.callbackQueue = window.googlefc.callbackQueue || [];
	window.googlefc.controlledMessagingFunction = function (message) {
		var types = window.googlefc.MessageTypeEnum;
		if (types && types.OFFERWALL !== undefined) {
			message.proceed(false, [types.OFFERWALL]);
		} else {
			message.proceed(true);
		}
	};
})();`;

// Ad script loader — injects adsbygoogle.js after window load instead of as a
// blocking-bandwidth <script async> tag in the head. The ad stack was
// contending with the LCP image on slow mobile connections (Lighthouse LCP
// 6.2s). The API is queue-based (the adsbygoogle array), so AdSlot pushes made
// before the script arrives are processed on load. A fallback timer still
// loads it if a hanging resource delays the load event, so no pageview ever
// skips ads entirely.
const adScriptsInit = `(function () {
	var done = false;
	function load() {
		if (done) return;
		done = true;
		var s = document.createElement('script');
		s.async = true;
		s.crossOrigin = 'anonymous';
		s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7803867089582138';
		document.head.appendChild(s);
	}
	if (document.readyState === 'complete') {
		load();
	} else {
		window.addEventListener('load', load, { once: true });
		setTimeout(load, 6000);
	}
})();`;

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/$/, '');

// Google truncates meta descriptions around ~160 chars, so clamp anything longer
// to a clean word boundary (never mid-word) with an ellipsis. Acts as a safety
// net so hand-written descriptions can't overflow into a truncated SERP snippet.
const clampDescription = (d: string, max = 158): string => {
	if (!d || d.length <= max) return d;
	const cut = d.slice(0, max - 1);
	const lastSpace = cut.lastIndexOf(' ');
	return `${(lastSpace > 40 ? cut.slice(0, lastSpace) : cut).replace(/[\s,;:.\-–—]+$/, '')}…`;
};
const metaDescription = clampDescription(description);

// Normalize the path for canonical/OG: the `file` build format makes
// Astro.url.pathname end in ".html" (e.g. /cold-email-writer.html), but the
// served + sitemap URL is clean (/cold-email-writer). Strip index/.html and any
// trailing slash so canonical matches the real URL.
let cleanPath = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '');
if (cleanPath.length > 1) cleanPath = cleanPath.replace(/\/$/, '');
if (cleanPath === '') cleanPath = '/';
// Lowercase canonical so externally-shared mixed-case URLs collapse to one form.
cleanPath = cleanPath.toLowerCase();
const canonical = `${siteUrl}${cleanPath === '/' ? '/' : cleanPath}`;

// Resolve og:image to an absolute URL if a relative path was passed in.
const absoluteOgImage = ogImage
	? ogImage.startsWith('http')
		? ogImage
		: `${siteUrl}${ogImage.startsWith('/') ? ogImage : `/${ogImage}`}`
	: undefined;

// Infer og:image:type from extension; default jpeg for unknown.
const ogImageType = absoluteOgImage
	? /\.svg(\?|$)/i.test(absoluteOgImage)
		? 'image/svg+xml'
		: /\.png(\?|$)/i.test(absoluteOgImage)
			? 'image/png'
			: /\.webp(\?|$)/i.test(absoluteOgImage)
				? 'image/webp'
				: 'image/jpeg'
	: undefined;

// We only know dimensions for two image shapes: the default OG png and the
// generated /og/<slug>.svg endpoint (both 1200x630). For user-uploaded covers
// we don't know real dimensions, so we skip width/height rather than lie.
const ogImageKnownSize =
	!!ogImage && (ogImage === '/og-default.png' || /^\/og\/[^/]+\.svg$/.test(ogImage));
// Allow large, relevant editorial images to be used in Google Discover. Pages
// that explicitly opt out (admin/drafts) still keep their noindex directive.
const robotsContent = noindex ? 'noindex, nofollow' : robots ?? 'max-image-preview:large';

// Site-wide WebSite schema with a sitelinks search box action.
const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	'@id': `${siteUrl}/#website`,
	name: 'Free Prompt Base',
	url: siteUrl,
	description:
		'A free, curated library of ready-to-use AI prompts for ChatGPT, Midjourney, Claude and Gemini.',
	potentialAction: {
		'@type': 'SearchAction',
		target: {
			'@type': 'EntryPoint',
			urlTemplate: `${siteUrl}/?q={search_term_string}`,
		},
		'query-input': 'required name=search_term_string',
	},
};

// Site-wide Organization schema — needed by BlogPosting.publisher and Google
// brand-entity indexing.
const organizationSchema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: 'Free Prompt Base',
	url: siteUrl,
	logo: {
		'@type': 'ImageObject',
		url: `${siteUrl}/logo.svg`,
	},
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<!-- gtag.js deferred to first interaction; charset must stay first (<1024B). -->
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-X4PPQXDSMG');
			(function () {
				var loaded = false;
				var evts = ['scroll', 'pointerdown', 'keydown', 'touchstart'];
				function load() {
					if (loaded) return;
					loaded = true;
					evts.forEach(function (e) { window.removeEventListener(e, load); });
					var s = document.createElement('script');
					s.async = true;
					s.src = 'https://www.googletagmanager.com/gtag/js?id=G-X4PPQXDSMG';
					document.head.appendChild(s);
				}
				evts.forEach(function (e) { window.addEventListener(e, load, { once: true, passive: true }); });
			})();
		</script>

		{/* Google AdSense loader — site-wide on public pages; skipped on
		   noindex admin/CMS pages so ads never render in the dashboard. The
		   Offerwall-control script must come first (see offerwallGateInit);
		   the actual ad scripts are injected post-load (see adScriptsInit). */}
		{!noindex && <script is:inline set:html={offerwallGateInit} />}
		{!noindex && <script is:inline set:html={adScriptsInit} />}

		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#211D16" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={metaDescription} />
		<!-- Pinterest domain claim (HTML-tag method); same hash as the DNS TXT record. -->
		<meta name="p:domain_verify" content="c4fb2597439177318c1172122d3b49c9" />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" type="application/rss+xml" title="Free Prompt Base — Blog" href="/blog/rss.xml" />
		<link rel="alternate" type="application/rss+xml" title="Free Prompt Base — AI News" href="/news/rss.xml" />
		<link rel="alternate" type="application/rss+xml" title="Free Prompt Base — Prompts" href="/pinterest/rss.xml" />

		{/* Preconnect to Google's CDN only for signed-in users (avatars load from
		   there). Anonymous pages don't request it, so omitting avoids an
		   "unused preconnect" warning. */}
		{Astro.locals.user && (
			<link rel="preconnect" href="https://lh3.googleusercontent.com" crossorigin />
		)}

		<!-- Open Graph -->
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="Free Prompt Base" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:url" content={canonical} />
		{absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}
		{absoluteOgImage && ogImageType && <meta property="og:image:type" content={ogImageType} />}
		{absoluteOgImage && ogImageKnownSize && <meta property="og:image:width" content="1200" />}
		{absoluteOgImage && ogImageKnownSize && <meta property="og:image:height" content="630" />}

		<!-- Twitter -->
		<meta name="twitter:card" content={absoluteOgImage ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={metaDescription} />
		{absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}

		{
			preloadImage && (
				<link
					rel="preload"
					as="image"
					href={preloadImage}
					imagesrcset={preloadImageSrcset}
					imagesizes={preloadImageSizes}
					fetchpriority="high"
				/>
			)
		}
		<title>{title}</title>

		{robotsContent && <meta name="robots" content={robotsContent} />}
		{noindex && (
			<>
				{/* Admin icon font — loaded non-blocking so it never delays first paint.
				    media="print" + onload swap is the standard async-CSS trick. */}
				<link rel="preconnect" href="https://fonts.googleapis.com" />
				<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
				<link
					href="https://fonts.googleapis.com/icon?family=Material+Symbols+Outlined"
					rel="stylesheet"
					media="print"
					onload="this.media='all'"
				/>
				<noscript>
					<link
						href="https://fonts.googleapis.com/icon?family=Material+Symbols+Outlined"
						rel="stylesheet"
					/>
				</noscript>
			</>
		)}

		<!-- Structured data -->
		<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
		{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
		{extraSchemas.map((s) => (
			<script type="application/ld+json" set:html={JSON.stringify(s)} />
		))}
	</head>
	<body class="min-h-screen flex flex-col">
		<IconSprite />
		<slot />
	</body>
</html>
