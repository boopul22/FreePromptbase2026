---
import { categories } from '../data/categories';

const year = new Date().getFullYear();

// Pick a handful of top-level browse links for the BROWSE column.
const browseLinks = categories.slice(0, 5).map((c) => ({
	href: `/category/${c.slug}`,
	label: c.name,
}));

// Static blog/learn links — keep these stable. Descriptive anchors so the
// link text itself carries the topic (good for internal-link relevance).
const learnLinks = [
	{ href: '/blog', label: 'Prompt engineering blog' },
	{ href: '/blog/how-to-write-midjourney-prompts', label: 'Midjourney prompt guide' },
	{ href: '/blog/prompt-patterns-that-work', label: 'Prompt patterns that work' },
	{ href: '/blog/chatgpt-prompt-frameworks', label: 'ChatGPT prompt frameworks' },
];

// Site nav — surface the high-value UGC + utility pages once each, with
// keyword-bearing anchor text (legal links live in the bottom strip instead).
const siteLinks = [
	{ href: '/categories', label: 'All categories' },
	{ href: '/tags', label: 'Browse by keyword' },
	{ href: '/submit', label: 'Submit a prompt' },
	{ href: '/saved', label: 'Saved prompts' },
	{ href: '/about', label: 'About' },
];
---

<footer class="mt-20 bg-link text-gray-300" data-purpose="site-footer">
	<!-- Thin gold accent line -->
	<div class="h-px bg-lime"></div>

	<div class="max-w-7xl mx-auto px-6 sm:px-8 py-12 sm:py-14">
		<!-- Top grid -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">
			<!-- Brand + newsletter + socials -->
			<div class="lg:col-span-1">
				<a href="/" class="inline-flex items-center gap-2.5 mb-4">
					<img src="/logo.svg" alt="" aria-hidden="true" class="w-6 h-6" width="24" height="24" />
					<span class="text-sm font-bold tracking-wide text-white uppercase">Free Prompt Base</span>
				</a>
				<p class="text-sm text-gray-400 leading-relaxed max-w-sm">
					Free, curated AI prompts for ChatGPT, Claude, Midjourney, and more.
					Copy, paste, and create — no signup required.
				</p>

				<!-- Brand attribution (no outbound links) -->
				<p class="mt-6 text-sm font-medium text-gray-300">bipul.online</p>
			</div>

			<!-- BROWSE -->
			<nav aria-label="Browse">
				<h2 class="text-[11px] font-semibold uppercase tracking-widest text-white mb-4">Browse</h2>
				<ul class="space-y-3">
					{browseLinks.map((l) => (
						<li>
							<a href={l.href} class="group flex items-center justify-between text-sm text-gray-300 hover:text-primary transition-colors">
								<span class="uppercase tracking-wide text-[12px] font-semibold">{l.label}</span>
								<span class="w-5 h-5 flex items-center justify-center border border-gray-700 text-gray-500 group-hover:text-primary group-hover:border-primary transition-colors text-xs leading-none">+</span>
							</a>
						</li>
					))}
				</ul>
			</nav>

			<!-- LEARN -->
			<nav aria-label="Learn">
				<h2 class="text-[11px] font-semibold uppercase tracking-widest text-white mb-4">Learn</h2>
				<ul class="space-y-3">
					{learnLinks.map((l) => (
						<li>
							<a href={l.href} class="group flex items-center justify-between text-sm text-gray-300 hover:text-primary transition-colors">
								<span class="uppercase tracking-wide text-[12px] font-semibold">{l.label}</span>
								<span class="w-5 h-5 flex items-center justify-center border border-gray-700 text-gray-500 group-hover:text-primary group-hover:border-primary transition-colors text-xs leading-none">+</span>
							</a>
						</li>
					))}
				</ul>
			</nav>

			<!-- SITE -->
			<nav aria-label="Site">
				<h2 class="text-[11px] font-semibold uppercase tracking-widest text-white mb-4">Site</h2>
				<ul class="space-y-3">
					{siteLinks.map((l) => (
						<li>
							<a href={l.href} class="group flex items-center justify-between text-sm text-gray-300 hover:text-primary transition-colors">
								<span class="uppercase tracking-wide text-[12px] font-semibold">{l.label}</span>
								<span class="w-5 h-5 flex items-center justify-center border border-gray-700 text-gray-500 group-hover:text-primary group-hover:border-primary transition-colors text-xs leading-none">+</span>
							</a>
						</li>
					))}
				</ul>
			</nav>
		</div>

		<!-- Divider -->
		<div class="h-px bg-white/10 my-10"></div>

		<!-- Bottom: copyright + legal/utility strip (links not duplicated above) -->
		<div class="pt-6 border-t border-white/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-gray-400">
			<p>© {year} Free Prompt Base. Designed by Bipul.</p>
			<nav aria-label="Legal" class="flex flex-wrap gap-x-6 gap-y-2">
				<a href="/privacy" class="hover:text-primary transition-colors">Privacy</a>
				<a href="/terms" class="hover:text-primary transition-colors">Terms</a>
				<a href="/sitemap.xml" class="hover:text-primary transition-colors">Sitemap</a>
			</nav>
		</div>
	</div>
</footer>

