---
import { categories } from '../data/categories';

const year = new Date().getFullYear();

// Pick a handful of top-level browse links for the BROWSE column.
const browseLinks = categories.slice(0, 5).map((c) => ({
	href: `/category/${c.slug}`,
	label: c.name,
}));

// Static blog/learn links — keep these stable.
const learnLinks = [
	{ href: '/blog', label: 'Blog' },
	{ href: '/blog/how-to-write-midjourney-prompts', label: 'Midjourney guide' },
	{ href: '/blog/prompt-patterns-that-work', label: 'Prompt patterns' },
	{ href: '/blog/chatgpt-prompt-frameworks', label: 'ChatGPT frameworks' },
];

// Site nav (replaces the third nav column in the reference).
const siteLinks = [
	{ href: '/categories', label: 'All categories' },
	{ href: '/about', label: 'About' },
	{ href: '/privacy', label: 'Privacy' },
	{ href: '/terms', label: 'Terms' },
];

// Sister sites in the network — surface a few cross-promo links.
const sisterSites = [
	{ href: 'https://imagetourl.cloud', label: 'ImageToURL', emoji: '☁️' },
	{ href: 'https://bipul.online', label: 'bipul.online', emoji: '🌐' },
];
---

<footer class="mt-20 bg-link text-gray-300" data-purpose="site-footer">
	<!-- Thin gold accent line -->
	<div class="h-px bg-primary"></div>

	<div class="max-w-7xl mx-auto px-6 sm:px-8 py-12 sm:py-14">
		<!-- Top grid -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">
			<!-- Brand + newsletter + socials -->
			<div class="lg:col-span-1">
				<a href="/" class="inline-flex items-center gap-2.5 mb-4">
					<svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
						<path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
					</svg>
					<span class="text-sm font-bold tracking-wide text-white uppercase">Free Prompt Base</span>
				</a>
				<p class="text-sm text-gray-400 leading-relaxed max-w-sm">
					Curated AI prompts you can copy and use. Find one, copy it, create.
				</p>

				<!-- Newsletter form -->
				<form class="mt-6 space-y-2" data-newsletter aria-label="Subscribe to the newsletter">
					<p class="text-[11px] font-semibold uppercase tracking-widest text-gray-300">Stay updated</p>
					<div class="flex">
						<label for="newsletter-email" class="sr-only">Your email</label>
						<input
							id="newsletter-email"
							type="email"
							required
							placeholder="Your email..."
							class="flex-1 min-w-0 bg-white/5 border border-white/10 rounded-l-md px-3 py-2 text-sm text-white placeholder:text-gray-500 focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary"
						/>
						<button
							type="submit"
							class="shrink-0 px-4 py-2 bg-primary text-link rounded-r-md text-xs font-bold uppercase tracking-wider hover:opacity-90 transition-opacity"
						>
							Join
						</button>
					</div>
					<p class="text-[11px] text-gray-500 hidden" data-newsletter-msg></p>
				</form>

				<!-- Socials -->
				<div class="flex items-center gap-4 mt-6 text-gray-400">
					<a href="https://github.com/boopul22" target="_blank" rel="noopener" class="hover:text-primary transition-colors" aria-label="GitHub">
						<svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55v-1.93c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.47.11-3.05 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.9-.4.98.01 1.97.14 2.9.4 2.21-1.49 3.18-1.18 3.18-1.18.62 1.58.23 2.76.11 3.05.74.81 1.18 1.84 1.18 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.66.79.55A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z"/></svg>
					</a>
					<a href="https://instagram.com/boopul.official" target="_blank" rel="noopener" class="hover:text-primary transition-colors" aria-label="Instagram">
						<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
					</a>
					<a href="https://bipul.online" target="_blank" rel="noopener" class="text-sm font-medium text-gray-300 hover:text-primary transition-colors">
						bipul.online
					</a>
				</div>
			</div>

			<!-- BROWSE -->
			<nav aria-label="Browse">
				<p class="text-[11px] font-semibold uppercase tracking-widest text-white mb-4">Browse</p>
				<ul class="space-y-3">
					{browseLinks.map((l) => (
						<li>
							<a href={l.href} class="group flex items-center justify-between text-sm text-gray-300 hover:text-primary transition-colors">
								<span class="uppercase tracking-wide text-[12px] font-semibold">{l.label}</span>
								<span class="w-5 h-5 flex items-center justify-center border border-gray-700 text-gray-500 group-hover:text-primary group-hover:border-primary transition-colors text-xs leading-none">+</span>
							</a>
						</li>
					))}
				</ul>
			</nav>

			<!-- LEARN -->
			<nav aria-label="Learn">
				<p class="text-[11px] font-semibold uppercase tracking-widest text-white mb-4">Learn</p>
				<ul class="space-y-3">
					{learnLinks.map((l) => (
						<li>
							<a href={l.href} class="group flex items-center justify-between text-sm text-gray-300 hover:text-primary transition-colors">
								<span class="uppercase tracking-wide text-[12px] font-semibold">{l.label}</span>
								<span class="w-5 h-5 flex items-center justify-center border border-gray-700 text-gray-500 group-hover:text-primary group-hover:border-primary transition-colors text-xs leading-none">+</span>
							</a>
						</li>
					))}
				</ul>
			</nav>

			<!-- SITE -->
			<nav aria-label="Site">
				<p class="text-[11px] font-semibold uppercase tracking-widest text-white mb-4">Site</p>
				<ul class="space-y-3">
					{siteLinks.map((l) => (
						<li>
							<a href={l.href} class="group flex items-center justify-between text-sm text-gray-300 hover:text-primary transition-colors">
								<span class="uppercase tracking-wide text-[12px] font-semibold">{l.label}</span>
								<span class="w-5 h-5 flex items-center justify-center border border-gray-700 text-gray-500 group-hover:text-primary group-hover:border-primary transition-colors text-xs leading-none">+</span>
							</a>
						</li>
					))}
				</ul>
			</nav>
		</div>

		<!-- Divider -->
		<div class="h-px bg-white/10 my-10"></div>

		<!-- Bottom grid: resources inline + sister sites -->
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
			<div>
				<p class="text-[11px] font-semibold uppercase tracking-widest text-white mb-3">Resources</p>
				<div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-gray-400">
					<a href="/privacy" class="hover:text-primary transition-colors">Privacy</a>
					<a href="/terms" class="hover:text-primary transition-colors">Terms</a>
					<a href="/about" class="hover:text-primary transition-colors">About</a>
					<a href="/categories" class="hover:text-primary transition-colors">Categories</a>
					<a href="/blog" class="hover:text-primary transition-colors">Blog</a>
					<a href="/sitemap.xml" class="hover:text-primary transition-colors">Sitemap</a>
				</div>
			</div>

			<div>
				<p class="text-[11px] font-semibold uppercase tracking-widest text-white mb-3">Our network</p>
				<div class="flex flex-wrap gap-x-6 gap-y-3 items-center">
					{sisterSites.map((s) => (
						<a href={s.href} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-sm text-gray-300 hover:text-primary transition-colors">
							<span class="text-base" aria-hidden="true">{s.emoji}</span>
							<span class="font-medium">{s.label}</span>
						</a>
					))}
				</div>
			</div>
		</div>

		<!-- Copyright -->
		<div class="mt-10 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-gray-500">
			<p>© {year} Free Prompt Base. Designed by Bipul.</p>
			<p>Built with care · Hosted on Cloudflare</p>
		</div>
	</div>
</footer>

<script>
	// Newsletter form — captures email client-side and shows a friendly thanks.
	// Real persistence/integration can wire to /api/newsletter later.
	const forms = document.querySelectorAll<HTMLFormElement>('[data-newsletter]');
	forms.forEach((form) => {
		const msg = form.querySelector<HTMLParagraphElement>('[data-newsletter-msg]');
		const input = form.querySelector<HTMLInputElement>('input[type="email"]');
		form.addEventListener('submit', (e) => {
			e.preventDefault();
			if (!input?.value) return;
			if (msg) {
				msg.textContent = `Thanks! We'll keep ${input.value} in the loop.`;
				msg.classList.remove('hidden');
			}
			input.value = '';
		});
	});
</script>
