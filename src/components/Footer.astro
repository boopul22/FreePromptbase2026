---
import { categories } from '../data/categories';

const year = new Date().getFullYear();

// Pick a handful of top-level browse links for the BROWSE column.
const browseLinks = categories.slice(0, 5).map((c) => ({
	href: `/category/${c.slug}`,
	label: c.name,
}));

// Static blog/learn links — keep these stable.
const learnLinks = [
	{ href: '/blog', label: 'Blog' },
	{ href: '/blog/how-to-write-midjourney-prompts', label: 'Midjourney guide' },
	{ href: '/blog/prompt-patterns-that-work', label: 'Prompt patterns' },
	{ href: '/blog/chatgpt-prompt-frameworks', label: 'ChatGPT frameworks' },
];

// Site nav (replaces the third nav column in the reference).
const siteLinks = [
	{ href: '/categories', label: 'All categories' },
	{ href: '/about', label: 'About' },
	{ href: '/privacy', label: 'Privacy' },
	{ href: '/terms', label: 'Terms' },
];

// Sister sites in the network — surface a few cross-promo links.
const sisterSites = [
	{ href: 'https://imagetourl.cloud', label: 'ImageToURL', emoji: '☁️' },
	{ href: 'https://bipul.online', label: 'bipul.online', emoji: '🌐' },
];
---

<footer class="mt-20 bg-link text-gray-300" data-purpose="site-footer">
	<!-- Thin gold accent line -->
	<div class="h-px bg-primary"></div>

	<div class="max-w-7xl mx-auto px-6 sm:px-8 py-12 sm:py-14">
		<!-- Top grid -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">
			<!-- Brand + newsletter + socials -->
			<div class="lg:col-span-1">
				<a href="/" class="inline-flex items-center gap-2.5 mb-4">
					<img src="/logo.svg" alt="" aria-hidden="true" class="w-6 h-6" width="24" height="24" />
					<span class="text-sm font-bold tracking-wide text-white uppercase">Free Prompt Base</span>
				</a>
				<p class="text-sm text-gray-400 leading-relaxed max-w-sm">
					Curated AI prompts you can copy and use. Find one, copy it, create.
				</p>

				<!-- Brand attribution (no outbound links) -->
				<p class="mt-6 text-sm font-medium text-gray-300">bipul.online</p>
			</div>

			<!-- BROWSE -->
			<nav aria-label="Browse">
				<p class="text-[11px] font-semibold uppercase tracking-widest text-white mb-4">Browse</p>
				<ul class="space-y-3">
					{browseLinks.map((l) => (
						<li>
							<a href={l.href} class="group flex items-center justify-between text-sm text-gray-300 hover:text-primary transition-colors">
								<span class="uppercase tracking-wide text-[12px] font-semibold">{l.label}</span>
								<span class="w-5 h-5 flex items-center justify-center border border-gray-700 text-gray-500 group-hover:text-primary group-hover:border-primary transition-colors text-xs leading-none">+</span>
							</a>
						</li>
					))}
				</ul>
			</nav>

			<!-- LEARN -->
			<nav aria-label="Learn">
				<p class="text-[11px] font-semibold uppercase tracking-widest text-white mb-4">Learn</p>
				<ul class="space-y-3">
					{learnLinks.map((l) => (
						<li>
							<a href={l.href} class="group flex items-center justify-between text-sm text-gray-300 hover:text-primary transition-colors">
								<span class="uppercase tracking-wide text-[12px] font-semibold">{l.label}</span>
								<span class="w-5 h-5 flex items-center justify-center border border-gray-700 text-gray-500 group-hover:text-primary group-hover:border-primary transition-colors text-xs leading-none">+</span>
							</a>
						</li>
					))}
				</ul>
			</nav>

			<!-- SITE -->
			<nav aria-label="Site">
				<p class="text-[11px] font-semibold uppercase tracking-widest text-white mb-4">Site</p>
				<ul class="space-y-3">
					{siteLinks.map((l) => (
						<li>
							<a href={l.href} class="group flex items-center justify-between text-sm text-gray-300 hover:text-primary transition-colors">
								<span class="uppercase tracking-wide text-[12px] font-semibold">{l.label}</span>
								<span class="w-5 h-5 flex items-center justify-center border border-gray-700 text-gray-500 group-hover:text-primary group-hover:border-primary transition-colors text-xs leading-none">+</span>
							</a>
						</li>
					))}
				</ul>
			</nav>
		</div>

		<!-- Divider -->
		<div class="h-px bg-white/10 my-10"></div>

		<!-- Bottom grid: resources inline + sister sites -->
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
			<div>
				<p class="text-[11px] font-semibold uppercase tracking-widest text-white mb-3">Resources</p>
				<div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-gray-400">
					<a href="/privacy" class="hover:text-primary transition-colors">Privacy</a>
					<a href="/terms" class="hover:text-primary transition-colors">Terms</a>
					<a href="/about" class="hover:text-primary transition-colors">About</a>
					<a href="/categories" class="hover:text-primary transition-colors">Categories</a>
					<a href="/blog" class="hover:text-primary transition-colors">Blog</a>
					<a href="/sitemap.xml" class="hover:text-primary transition-colors">Sitemap</a>
				</div>
			</div>

			<div>
				<p class="text-[11px] font-semibold uppercase tracking-widest text-white mb-3">Our network</p>
				<div class="flex flex-wrap gap-x-6 gap-y-3 items-center">
					{sisterSites.map((s) => (
						<a href={s.href} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-sm text-gray-300 hover:text-primary transition-colors">
							<span class="text-base" aria-hidden="true">{s.emoji}</span>
							<span class="font-medium">{s.label}</span>
						</a>
					))}
				</div>
			</div>
		</div>

		<!-- Copyright -->
		<div class="mt-10 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-gray-500">
			<p>© {year} Free Prompt Base. Designed by Bipul.</p>
			<p>Built with care · Hosted on Cloudflare</p>
		</div>
	</div>
</footer>

