---
import { categories } from '../data/categories';
import { posts } from '../data/posts';
import { tags } from '../data/tags';

const year = new Date().getFullYear();

// BROWSE — core discovery routes plus real category pages.
const browseLinks = [
	{ href: '/', label: 'All prompts' },
	{ href: '/categories', label: 'Categories' },
	...categories.map((c) => ({ href: `/category/${c.slug}`, label: c.name })),
	{ href: '/tags', label: 'Keyword index' },
];

// TRENDING — curated keyword landing pages. Each lives at the root /<slug>
// (see src/pages/[slug].astro). We pick a high-value subset by slug and pull
// the label straight from tags.ts, so anything renamed/removed self-corrects
// and we never emit a dead link.
const trendingSlugs = [
	'nano-banana-prompt',
	'nano-banana',
	'trending-gemini-prompt',
	'chatgpt-caricature-prompt',
	'banana-prompt',
	'nano-banana-ai',
	'holi-prompt',
];
const tagBySlug = new Map(tags.map((t) => [t.slug, t]));
const linksFromTags = (slugs: string[]) =>
	slugs
	.map((slug) => tagBySlug.get(slug))
	.filter((t): t is (typeof tags)[number] => Boolean(t))
	.map((t) => ({ href: `/${t.slug}`, label: t.name }));

const trendingLinks = linksFromTags(trendingSlugs);

const geminiSlugs = [
	'gemini-ai-prompt',
	'gemini-ai-prompt-copy-paste',
	'prompt-gemini',
	'prompt-for-gemini-ai',
	'google-gemini-ai-photo',
	'google-gemini-trending-photo-prompt',
];
const geminiLinks = linksFromTags(geminiSlugs);

const photoSlugs = [
	'gemini-ai-photo-prompt',
	'gemini-ai-photo-prompt-copy-paste',
	'gemini-photo-prompt',
	'gemini-photo-editing-prompt',
	'gemini-couple-photo-prompt',
	'google-gemini-ai-photo-prompt',
	'prompt-for-gemini-ai-girl',
	'couple-prompt',
];
const photoLinks = linksFromTags(photoSlugs);

const creatorSlugs = [
	'ai-prompt-ghaus-editz',
	'ai-prompt-razz-suman',
	'prompt-wala',
	'prompt-by-vikas-editing',
	'anup-sagar-prompt',
	'mk-edit',
	'banana-prompts',
];
const creatorLinks = linksFromTags(creatorSlugs);

// LEARN — blog index plus seed posts that map to /blog/<slug>.
const learnLinks = [
	{ href: '/blog', label: 'Blog' },
	...posts.map((p) => ({ href: `/blog/${p.slug}`, label: p.title })),
];

// SITE — high-value UGC + account utility pages (legal links live in the bottom strip).
const siteLinks = [
	{ href: '/submit', label: 'Submit a prompt' },
	{ href: '/saved', label: 'Saved prompts' },
	{ href: '/liked', label: 'Liked prompts' },
	{ href: '/account', label: 'Account settings' },
	{ href: '/about', label: 'About' },
	{ href: '/contact', label: 'Contact' },
	{ href: '/privacy', label: 'Privacy' },
	{ href: '/terms', label: 'Terms' },
	{ href: '/ai-policy', label: 'AI Policy' },
	{ href: '/sitemap.xml', label: 'Sitemap' },
];

// Each group renders as a real accordion at every viewport size. The aria
// string must start with the visible label (axe: label-content-name-mismatch).
const navGroups: { label: string; aria: string; items: { href: string; label: string }[] }[] = [
	{ label: 'Browse', aria: 'Browse', items: browseLinks },
	{ label: 'Trending', aria: 'Trending prompts', items: trendingLinks },
	{ label: 'Gemini', aria: 'Gemini prompt links', items: geminiLinks },
	{ label: 'Photos', aria: 'Photos — prompt links', items: photoLinks },
	{ label: 'Creators', aria: 'Creators — prompt links', items: creatorLinks },
	{ label: 'Learn', aria: 'Learn', items: learnLinks },
	{ label: 'Site', aria: 'Site', items: siteLinks },
];
---

<footer class="mt-20 bg-link text-gray-400 border-t-4 border-primary" data-purpose="site-footer">
	<div class="max-w-6xl mx-auto px-6 sm:px-8 pt-12 pb-8" style="padding-bottom: max(2rem, env(safe-area-inset-bottom));">
		<!-- Top grid: brand block on the left, nav groups in their own grid on the
		     right so they wrap evenly and the tall brand column never pushes a row
		     of groups to the bottom. -->
		<div class="grid grid-cols-1 lg:grid-cols-[1.25fr_minmax(0,3fr)] gap-x-8 gap-y-10">

			<!-- Brand + Newsletter + Socials -->
			<div>
				<a href="/" class="inline-flex items-center gap-2.5 mb-3">
					<img src="/logo.svg" alt="" aria-hidden="true" class="w-6 h-6" width="24" height="24" />
					<span class="text-sm font-bold tracking-wide text-white uppercase">Free Prompt Base</span>
				</a>
				<p class="text-sm text-gray-400 leading-relaxed max-w-xs mb-6">
					Free, curated AI prompts for ChatGPT, Claude, Midjourney, and more.
					Copy, paste, and create — no signup required.
				</p>

				<span class="block text-[11px] font-semibold uppercase tracking-widest text-white mb-3">Stay updated</span>
				<form class="footer-news flex flex-col sm:flex-row gap-2 max-w-sm mb-3" novalidate>
					<input
						type="email"
						name="email"
						required
						placeholder="you@email.com"
						aria-label="Email address"
						class="flex-1 min-w-0 bg-white/5 border border-white/15 rounded-lg text-white placeholder:text-gray-500 px-3 py-2 text-sm focus:border-primary focus:outline-none transition-colors"
					/>
					<button type="submit" class="footer-join shrink-0 bg-primary text-link border border-link/90 rounded-lg px-4 py-2 text-xs font-bold uppercase tracking-wide transition-transform">
						Join
					</button>
				</form>
				<p class="footer-news-msg text-xs text-gray-400 mb-6" role="status" aria-live="polite" hidden></p>

				<div class="flex items-center gap-4">
					<a href="https://github.com/boopul22" target="_blank" rel="noopener" aria-label="GitHub" class="text-gray-400 hover:text-primary transition-colors">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.579.688.481C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
					</a>
					<a href="https://bipul.online/" target="_blank" rel="noopener" aria-label="bipul.online — personal website" class="text-xs text-gray-400 hover:text-primary transition-colors">bipul.online</a>
				</div>
			</div>

			<!-- Nav groups: collapsed accordions, in their own evenly-wrapping grid -->
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-x-8 gap-y-3 self-start">
				{navGroups.map((g) => (
					<details class="footer-dd">
						<summary aria-label={g.aria}>
							<span>{g.label}</span>
							<span class="dd-sq" aria-hidden="true"></span>
						</summary>
						<div class="dd-body">
							{g.items.map((i) => (
								<a href={i.href} class="text-sm text-gray-400 hover:text-primary transition-colors">{i.label}</a>
							))}
						</div>
					</details>
				))}
			</div>
		</div>

		<!-- Divider -->
		<div class="h-px bg-white/10 my-10"></div>

		<!-- Bottom: copyright + legal/utility strip -->
		<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-gray-400">
			<p>© {year} Free Prompt Base. Designed by Bipul Kumar.</p>
			<nav aria-label="Legal" class="flex flex-wrap gap-x-6 gap-y-2">
				<a href="/contact" class="hover:text-primary transition-colors">Contact</a>
				<a href="/privacy" class="hover:text-primary transition-colors">Privacy</a>
				<a href="/terms" class="hover:text-primary transition-colors">Terms</a>
				<a href="/ai-policy" class="hover:text-primary transition-colors">AI Policy</a>
				<a href="/sitemap.xml" class="hover:text-primary transition-colors">Sitemap</a>
			</nav>
		</div>
	</div>
</footer>

<style>
	/* --- Newsletter button: brand neobrutalist press --- */
	.footer-join:hover { transform: translate(-1px, -1px); box-shadow: 2px 2px 0 0 rgba(0, 0, 0, 0.35); }
	.footer-join:active { transform: translate(0, 0); box-shadow: none; }
	.footer-join:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }

	/* --- Nav group: real accordion on mobile and desktop --- */
	.footer-dd {
		/* Hug content so a collapsed group is just its title + rule — keeps every
		   group the same compact height in the grid instead of stretching to the
		   tall brand column. */
		align-self: start;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}
	.footer-dd > summary {
		list-style: none;
		cursor: pointer;
		user-select: none;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.875rem 0;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #fff;
		transition: color 160ms linear;
	}
	.footer-dd > summary:hover { color: var(--color-primary); }
	.footer-dd > summary:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 4px;
	}
	.footer-dd > summary::-webkit-details-marker { display: none; }
	.footer-dd > summary::marker { content: ''; }

	/* Toggle chip — flips to the brand yellow w/ dark ink when open */
	.dd-sq {
		flex-shrink: 0;
		width: 18px;
		height: 18px;
		border: 1px solid rgba(255, 255, 255, 0.25);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: #9b948a;
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 14px;
		line-height: 1;
		font-weight: 700;
		transition: color 160ms linear, background-color 160ms linear, border-color 160ms linear;
	}
	.dd-sq::before { content: '+'; display: block; transform: translateY(-1px); }
	.footer-dd[open] .dd-sq {
		background: var(--color-primary);
		border-color: var(--color-primary);
		color: var(--color-link);
	}
	.footer-dd[open] .dd-sq::before { content: '–'; transform: translateY(-2px); }

	/* Body rail — yellow accent on open */
	.dd-body {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 0.25rem 0 0.875rem 0.75rem;
		margin-left: 0.125rem;
		border-left: 2px solid var(--color-primary);
	}
	.footer-dd:not([open]) > .dd-body {
		display: none;
	}
</style>

<script>
	// Newsletter capture → /api/subscribe (Cloudflare Email Service, double opt-in).
	// The API stores a pending subscriber and emails a confirmation link; the user
	// isn't on the list until they click it.
	document.querySelectorAll<HTMLFormElement>('.footer-news').forEach((form) => {
		const msg = form.parentElement?.querySelector<HTMLElement>('.footer-news-msg');
		const input = form.querySelector<HTMLInputElement>('input[name="email"]');
		const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');

		const show = (text: string, ok: boolean) => {
			if (!msg) return;
			msg.textContent = text;
			msg.style.color = ok ? '#D7F99A' : '#fca5a5';
			msg.hidden = false;
		};

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const email = input?.value.trim() ?? '';
			if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
				show('Please enter a valid email.', false);
				input?.focus();
				return;
			}
			if (btn) { btn.disabled = true; btn.textContent = '...'; }
			try {
				const res = await fetch('/api/subscribe', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
					body: JSON.stringify({ email }),
				});
				const data = await res.json().catch(() => ({}));
				if (!res.ok) throw new Error(data?.error || 'Request failed');
				show(data?.message || 'Almost there — check your inbox to confirm.', true);
				form.reset();
			} catch (err) {
				show(err instanceof Error ? err.message : 'Something went wrong. Please try again.', false);
			} finally {
				if (btn) { btn.disabled = false; btn.textContent = 'Join'; }
			}
		});
	});
</script>
