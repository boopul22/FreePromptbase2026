---
import { categories } from '../data/categories';

const year = new Date().getFullYear();

// Pick a handful of top-level browse links for the BROWSE column.
const browseLinks = categories.slice(0, 5).map((c) => ({
	href: `/category/${c.slug}`,
	label: c.name,
}));

// Static blog/learn links — keep these stable. Descriptive anchors so the
// link text itself carries the topic (good for internal-link relevance).
const learnLinks = [
	{ href: '/blog', label: 'Prompt engineering blog' },
	{ href: '/blog/how-to-write-midjourney-prompts', label: 'Midjourney prompt guide' },
	{ href: '/blog/prompt-patterns-that-work', label: 'Prompt patterns that work' },
	{ href: '/blog/chatgpt-prompt-frameworks', label: 'ChatGPT prompt frameworks' },
];

// Site nav — surface the high-value UGC + utility pages once each, with
// keyword-bearing anchor text (legal links live in the bottom strip instead).
const siteLinks = [
	{ href: '/categories', label: 'All categories' },
	{ href: '/tags', label: 'Browse by keyword' },
	{ href: '/submit', label: 'Submit a prompt' },
	{ href: '/saved', label: 'Saved prompts' },
	{ href: '/about', label: 'About' },
];

// Each nav group renders as an accordion on mobile and an open column on
// desktop (see the <style> block). Same data, one render path.
const navGroups: { label: string; aria: string; items: { href: string; label: string }[] }[] = [
	{ label: 'Browse', aria: 'Browse', items: browseLinks },
	{ label: 'Learn', aria: 'Learn', items: learnLinks },
	{ label: 'Site', aria: 'Site', items: siteLinks },
];
---

<footer class="mt-20 bg-link text-gray-400 border-t-4 border-primary" data-purpose="site-footer">
	<div class="max-w-6xl mx-auto px-6 sm:px-8 pt-12 pb-8" style="padding-bottom: max(2rem, env(safe-area-inset-bottom));">
		<!-- Top grid: brand + newsletter + socials, then three nav groups -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-x-10 gap-y-10">

			<!-- Brand + Newsletter + Socials -->
			<div class="sm:col-span-2 lg:col-span-4">
				<a href="/" class="inline-flex items-center gap-2.5 mb-3">
					<img src="/logo.svg" alt="" aria-hidden="true" class="w-6 h-6" width="24" height="24" />
					<span class="text-sm font-bold tracking-wide text-white uppercase">Free Prompt Base</span>
				</a>
				<p class="text-sm text-gray-400 leading-relaxed max-w-xs mb-6">
					Free, curated AI prompts for ChatGPT, Claude, Midjourney, and more.
					Copy, paste, and create — no signup required.
				</p>

				<span class="block text-[11px] font-semibold uppercase tracking-widest text-white mb-3">Stay updated</span>
				<form class="footer-news flex flex-col sm:flex-row gap-2 max-w-sm mb-3" novalidate>
					<input
						type="email"
						name="email"
						required
						placeholder="you@email.com"
						aria-label="Email address"
						class="flex-1 min-w-0 bg-white/5 border border-white/15 rounded-lg text-white placeholder:text-gray-500 px-3 py-2 text-sm focus:border-primary focus:outline-none transition-colors"
					/>
					<button type="submit" class="footer-join shrink-0 bg-primary text-link border border-link/90 rounded-lg px-4 py-2 text-xs font-bold uppercase tracking-wide transition-transform">
						Join
					</button>
				</form>
				<p class="footer-news-msg text-xs text-gray-400 mb-6" role="status" aria-live="polite" hidden></p>

				<div class="flex items-center gap-4">
					<a href="https://github.com/boopul22" target="_blank" rel="noopener" aria-label="GitHub" class="text-gray-400 hover:text-primary transition-colors">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.579.688.481C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
					</a>
					<a href="https://www.instagram.com/bipul.skill" target="_blank" rel="noopener" aria-label="Instagram" class="text-gray-400 hover:text-primary transition-colors">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
					</a>
					<a href="https://bipul.online/" target="_blank" rel="noopener" aria-label="bipul.online — personal website" class="text-xs text-gray-400 hover:text-primary transition-colors">bipul.online</a>
				</div>
			</div>

			<!-- Nav groups: accordion on mobile, open column on desktop -->
			{navGroups.map((g) => (
				<details class="footer-dd lg:col-span-2" open>
					<summary aria-label={g.aria}>
						<span>{g.label}</span>
						<span class="dd-sq" aria-hidden="true"></span>
					</summary>
					<div class="dd-body">
						{g.items.map((i) => (
							<a href={i.href} class="text-sm text-gray-400 hover:text-primary transition-colors">{i.label}</a>
						))}
					</div>
				</details>
			))}
		</div>

		<!-- Divider -->
		<div class="h-px bg-white/10 my-10"></div>

		<!-- Bottom: copyright + legal/utility strip (links not duplicated above) -->
		<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-gray-400">
			<p>© {year} Free Prompt Base. Designed by Bipul.</p>
			<nav aria-label="Legal" class="flex flex-wrap gap-x-6 gap-y-2">
				<a href="/privacy" class="hover:text-primary transition-colors">Privacy</a>
				<a href="/terms" class="hover:text-primary transition-colors">Terms</a>
				<a href="/sitemap.xml" class="hover:text-primary transition-colors">Sitemap</a>
			</nav>
		</div>
	</div>
</footer>

<style>
	/* --- Newsletter button: brand neobrutalist press --- */
	.footer-join:hover { transform: translate(-1px, -1px); box-shadow: 2px 2px 0 0 rgba(0, 0, 0, 0.35); }
	.footer-join:active { transform: translate(0, 0); box-shadow: none; }
	.footer-join:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }

	/* --- Nav group: accordion on mobile, static column on desktop --- */
	.footer-dd {
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}
	.footer-dd > summary {
		list-style: none;
		cursor: pointer;
		user-select: none;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.875rem 0;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #fff;
	}
	.footer-dd > summary::-webkit-details-marker { display: none; }
	.footer-dd > summary::marker { content: ''; }

	/* Toggle chip — flips to the brand yellow w/ dark ink when open */
	.dd-sq {
		flex-shrink: 0;
		width: 18px;
		height: 18px;
		border: 1px solid rgba(255, 255, 255, 0.25);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: #9b948a;
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 14px;
		line-height: 1;
		font-weight: 700;
		transition: color 160ms linear, background-color 160ms linear, border-color 160ms linear;
	}
	.dd-sq::before { content: '+'; display: block; transform: translateY(-1px); }
	.footer-dd[open] .dd-sq {
		background: var(--color-primary);
		border-color: var(--color-primary);
		color: var(--color-link);
	}
	.footer-dd[open] .dd-sq::before { content: '–'; transform: translateY(-2px); }

	/* Body rail — yellow accent on open */
	.dd-body {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 0.25rem 0 0.875rem 0.75rem;
		margin-left: 0.125rem;
		border-left: 2px solid var(--color-primary);
	}

	/* Desktop: drop the accordion chrome, show every column open + flat */
	@media (min-width: 1024px) {
		.footer-dd { border-bottom: none; }
		.footer-dd > summary {
			cursor: default;
			pointer-events: none;
			padding: 0 0 1rem;
			letter-spacing: 0.15em;
		}
		.footer-dd > summary .dd-sq { display: none; }
		.footer-dd > .dd-body {
			display: flex !important;
			padding: 0;
			margin-left: 0;
			border-left: none;
		}
	}
</style>

<script>
	// Newsletter capture via FormSubmit.co AJAX — no backend required.
	document.querySelectorAll<HTMLFormElement>('.footer-news').forEach((form) => {
		const msg = form.parentElement?.querySelector<HTMLElement>('.footer-news-msg');
		const input = form.querySelector<HTMLInputElement>('input[name="email"]');
		const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');

		const show = (text: string, ok: boolean) => {
			if (!msg) return;
			msg.textContent = text;
			msg.style.color = ok ? '#D7F99A' : '#fca5a5';
			msg.hidden = false;
		};

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const email = input?.value.trim() ?? '';
			if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
				show('Please enter a valid email.', false);
				input?.focus();
				return;
			}
			if (btn) { btn.disabled = true; btn.textContent = '...'; }
			try {
				const res = await fetch('https://formsubmit.co/ajax/bipul281b@gmail.com', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
					body: JSON.stringify({
						email,
						_subject: 'New Free Prompt Base subscriber',
					}),
				});
				if (!res.ok) throw new Error('Request failed');
				show('Thanks — you’re on the list.', true);
				form.reset();
			} catch {
				show('Something went wrong. Please try again.', false);
			} finally {
				if (btn) { btn.disabled = false; btn.textContent = 'Join'; }
			}
		});
	});
</script>
