---
// Sort tabs for the prompt grid. The homepage SSRs three grids (one per tab)
// and the tab click toggles which grid is visible — no client-side reorder.
// Active styling is driven entirely by the [data-active] attribute (see the
// .sort-tab rules in global.css), so the click handler only flips that flag.
const tabs = [
	{ id: 'trending', label: 'Trending' },
	{ id: 'popular', label: 'Popular' },
	{ id: 'recent', label: 'Recent' },
] as const;
---

<nav class="sort-tabs flex items-center gap-1 mb-8" data-purpose="content-tabs">
	{
		tabs.map((tab, i) => (
			<button
				type="button"
				data-sort={tab.id}
				data-active={i === 0 ? 'true' : 'false'}
				class="sort-tab"
			>
				{tab.label}
			</button>
		))
	}
</nav>
