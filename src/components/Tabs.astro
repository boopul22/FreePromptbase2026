---
// Sort tabs for the prompt grid. The homepage SSRs three grids (one per tab)
// and the tab click toggles which grid is visible — no client-side reorder.
// Active styling is driven entirely by the [data-active] attribute (see the
// .sort-tab rules in global.css), so the click handler only flips that flag.
const tabs = [
	{ id: 'trending', label: 'Trending' },
	{ id: 'recent', label: 'Recent' },
	{ id: 'all', label: 'All' },
] as const;

// Tab the homepage opens on. Keep this in sync with which PromptGrid is
// rendered un-hidden in index.astro.
const DEFAULT_TAB = 'all';
const activeIndex = Math.max(0, tabs.findIndex((t) => t.id === DEFAULT_TAB));
---

<nav class="sort-tabs mb-8" data-purpose="content-tabs" role="tablist" aria-label="Sort prompts">
	<!-- Sliding active pill. Width is locked to a third of the track, so switching
	     tabs only animates translateX (a transform, never a layout property). The
	     initial position points at the default tab. -->
	<span class="sort-indicator" data-tab-indicator style={`transform: translateX(${activeIndex * 100}%)`} aria-hidden="true"></span>
	{
		tabs.map((tab, i) => (
			<button
				type="button"
				data-sort={tab.id}
				data-active={i === activeIndex ? 'true' : 'false'}
				role="tab"
				aria-selected={i === activeIndex ? 'true' : 'false'}
				class="sort-tab"
			>
				{tab.label}
			</button>
		))
	}
</nav>
