---
import { collection } from '../data/site';

interface Props {
	promptCount: number;
	categoryCount: number;
}

const { promptCount, categoryCount } = Astro.props;
---

<section class="mb-12" data-purpose="collection-hero">
	<div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-4">
		<div class="flex items-center gap-4 flex-wrap">
			<h1 class="text-4xl font-bold tracking-tight text-text-primary">
				{collection.title}
			</h1>
			<div class="flex gap-2">
				<button
					data-follow-btn
					data-following="false"
					class="bg-primary text-link px-6 py-1.5 rounded-lg text-sm font-bold hover:opacity-90 transition-opacity"
				>
					Follow
				</button>
				<a
					href="/categories"
					class="bg-white text-text-primary border border-gray-200 px-6 py-1.5 rounded-lg text-sm font-semibold hover:bg-gray-50 transition-colors"
				>
					Browse
				</a>
			</div>
		</div>
	</div>

	<p class="text-gray-600 text-lg mb-4">{collection.description}</p>

	<div class="flex items-center gap-3 text-sm text-gray-500 flex-wrap">
		<span>
			{promptCount} prompts across {categoryCount} categories. Curated by
		</span>
		<div class="flex items-center gap-2 text-text-primary font-medium">
			<img
				alt={collection.curator.name}
				class="w-6 h-6 rounded-full object-cover"
				src={collection.curator.avatar}
				width="24"
				height="24"
				loading="lazy"
			/>
			<span>{collection.curator.name}</span>
		</div>
	</div>
</section>
