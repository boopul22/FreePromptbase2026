---
import { collection } from '../data/site';
import type { TopContributor } from '../lib/users';

interface Props {
	promptCount: number;
	categoryCount: number;
	topContributor?: TopContributor | null;
}

const { promptCount, categoryCount, topContributor } = Astro.props;
const tcInitial = topContributor?.name?.slice(0, 1).toUpperCase() ?? '';
---

<section class="mb-5" data-purpose="collection-hero">
	<!-- Title + description are kept in the DOM (the H1 anchors the homepage
	     for SEO) but visually hidden per request — nothing textual shows. -->
	<h1 class="sr-only">{collection.title}</h1>
	<p class="sr-only">{collection.description}</p>

	<!-- Actions on the left, contributor + stats on the right, closed by a rule. -->
	<div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 pb-4 border-b border-black/10">
		<!-- Actions -->
		<div class="flex items-center gap-2">
			<a href="/blog" class="btn-primary text-sm">
				<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
				</svg>
				Blog
			</a>

			<a href="/tags" class="btn-secondary text-sm">
				<svg class="w-4 h-4 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" />
					<rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" />
				</svg>
				Browse
			</a>
		</div>

		<!-- Right cluster: flashy top-contributor badge + collection stats. -->
		<div class="flex flex-wrap items-center gap-x-3 gap-y-2.5">
			{topContributor && (
				<a
					href={`/author/${topContributor.username}`}
					class="top-contributor group relative inline-flex items-center gap-2.5 rounded-full border border-primary bg-white py-1 pl-1 pr-3.5 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-text-primary"
					title={`Top contributor: ${topContributor.name}`}
				>
					<!-- Avatar + crown badge -->
					<span class="relative shrink-0">
						{topContributor.avatarUrl ? (
							<img
								src={topContributor.avatarUrl}
								alt=""
								width="32"
								height="32"
								loading="lazy"
								referrerpolicy="no-referrer"
								class="w-8 h-8 rounded-full object-cover ring-2 ring-soft"
							/>
						) : (
							<span class="w-8 h-8 rounded-full bg-soft text-link flex items-center justify-center text-xs font-bold ring-2 ring-soft">{tcInitial}</span>
						)}
						<span class="absolute -top-1.5 -right-1.5 w-4 h-4 rounded-full bg-primary text-link flex items-center justify-center shadow-sm ring-1 ring-white">
							<svg class="w-2.5 h-2.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M3 7l4.5 4L12 4l4.5 7L21 7l-1.6 11H4.6L3 7z" />
							</svg>
						</span>
					</span>

					<span class="flex flex-col leading-tight min-w-0">
						<span class="text-[10px] font-semibold uppercase tracking-wide text-secondary">Top contributor</span>
						<span class="text-sm font-bold text-text-primary truncate max-w-[9rem]">{topContributor.name}</span>
					</span>

					<!-- Periodic shine sweep (overlay only; transform-based, reduced-motion safe). -->
					<span class="tc-shine pointer-events-none absolute inset-0 rounded-full overflow-hidden" aria-hidden="true"></span>
				</a>
			)}

			<dl class="flex items-center gap-2 text-sm">
				<div class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 bg-gray-50 px-3 py-1.5">
					<svg class="w-4 h-4 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" />
					</svg>
					<dt class="sr-only">Prompts</dt>
					<dd class="text-gray-500"><span class="font-bold text-text-primary tabular-nums">{promptCount}</span> prompts</dd>
				</div>
				<div class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 bg-gray-50 px-3 py-1.5">
					<svg class="w-4 h-4 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
					</svg>
					<dt class="sr-only">Categories</dt>
					<dd class="text-gray-500"><span class="font-bold text-text-primary tabular-nums">{categoryCount}</span> categories</dd>
				</div>
			</dl>
		</div>
	</div>
</section>

<style>
	/* Flashy-but-tasteful: a slow diagonal light sweep across the badge every few
	   seconds, plus a brighter sweep on hover. Pure transform/opacity, and fully
	   stilled for visitors who prefer reduced motion. */
	.tc-shine::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 40%;
		height: 100%;
		transform: translateX(-180%) skewX(-20deg);
		background: linear-gradient(
			90deg,
			transparent,
			color-mix(in oklch, var(--color-primary) 60%, white) 50%,
			transparent
		);
		opacity: 0.55;
		animation: tc-sweep 5.5s ease-out infinite;
	}
	.top-contributor:hover .tc-shine::before {
		animation-duration: 1.1s;
		opacity: 0.8;
	}
	@keyframes tc-sweep {
		0% { transform: translateX(-180%) skewX(-20deg); }
		/* sweep across in the first ~1s, then hold off-screen so it reads as an
		   occasional glint rather than a constant strobe */
		18% { transform: translateX(320%) skewX(-20deg); }
		100% { transform: translateX(320%) skewX(-20deg); }
	}
	@media (prefers-reduced-motion: reduce) {
		.tc-shine::before { animation: none; opacity: 0; }
	}
</style>
