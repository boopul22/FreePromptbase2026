---
import { collection } from '../data/site';

interface Props {
	promptCount: number;
	categoryCount: number;
}

const { promptCount, categoryCount } = Astro.props;
---

<section class="mb-12" data-purpose="collection-hero">
	<!-- Title + description are kept in the DOM (the H1 anchors the homepage
	     for SEO) but visually hidden per request — nothing textual shows. -->
	<h1 class="sr-only">{collection.title}</h1>
	<p class="sr-only">{collection.description}</p>

	<div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-4">
		<div class="flex items-center gap-4 flex-wrap">
			<div class="flex gap-2">
				<button
					data-follow-btn
					data-following="false"
					class="bg-primary text-link px-6 py-1.5 rounded-lg text-sm font-bold hover:opacity-90 transition-opacity"
				>
					Follow
				</button>
				<a
					href="/categories"
					class="bg-white text-text-primary border border-gray-200 px-6 py-1.5 rounded-lg text-sm font-semibold hover:bg-gray-50 transition-colors"
				>
					Browse
				</a>
			</div>
		</div>
	</div>

	<div class="flex items-center gap-3 text-sm text-gray-600 flex-wrap">
		<span>{promptCount} prompts across {categoryCount} categories.</span>
	</div>
</section>
