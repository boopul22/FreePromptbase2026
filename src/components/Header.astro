---
import { currentUser } from '../data/site';

// Resolve the auth-aware user from middleware. Falls back to the mock when no
// one is signed in, so the UI stays familiar for guests.
const sessionUser = Astro.locals.user;
const isAdmin = sessionUser?.role === 'admin';
---

<header
	class="sticky top-0 z-50 bg-white border-b border-gray-200 px-4 py-3"
	data-purpose="main-navigation"
>
	<div class="max-w-7xl mx-auto flex items-center justify-between gap-2 sm:gap-4">
		<!-- Left: logo + desktop nav -->
		<div class="flex items-center gap-2 md:gap-8">
			<a href="/" class="flex items-center gap-2 shrink-0" aria-label="Free Prompt Base — home" data-purpose="logo">
				<svg
					class="w-8 h-8 text-primary shrink-0"
					fill="none"
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path
						d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"
						stroke="currentColor"
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"></path>
				</svg>
			</a>
			<nav class="hidden md:flex items-center gap-6 font-medium text-sm text-gray-600">
				<a class="text-text-primary" href="/">Feed</a>
				<a class="hover:text-primary transition-colors" href="/categories">Discover</a>
				<a class="hover:text-primary transition-colors" href="/blog">Blog</a>
				<a class="hover:text-primary transition-colors" href="/about">Community</a>
			</nav>
		</div>

		<!-- Center: Search Bar -->
		<form class="flex-grow max-w-xl" action="/" method="get" data-search-form role="search">
			<div class="relative">
				<label for="site-search" class="sr-only">Search prompts</label>
				<input
					id="site-search"
					name="q"
					data-search-input
					class="w-full bg-gray-100 border-none rounded-lg py-2 px-5 text-sm focus:outline-none focus:ring-2 focus:ring-primary"
					placeholder="Search..."
					type="text"
					autocomplete="off"
				/>
			</div>
		</form>

		<!-- Right: User Controls -->
		<div class="flex items-center gap-2 sm:gap-4">
			<button class="hidden sm:inline-flex text-gray-500 hover:text-primary transition-colors" aria-label="Messages">
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path
						d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"></path>
				</svg>
			</button>
			<button class="hidden sm:inline-flex text-gray-500 hover:text-primary transition-colors" aria-label="Notifications">
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path
						d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"></path>
				</svg>
			</button>
			{
				isAdmin && (
					<a
						href="/admin/cms"
						class="hidden md:inline-flex px-4 py-2 bg-link text-white hover:opacity-90 rounded-lg text-sm font-semibold transition-opacity"
					>
						Admin
					</a>
				)
			}

			{
				sessionUser ? (
					<div class="hidden md:flex items-center gap-3 ml-2">
						{sessionUser.avatarUrl && (
							<img
								alt={sessionUser.name}
								class="w-8 h-8 rounded-full object-cover"
								src={sessionUser.avatarUrl}
								width="32"
								height="32"
								loading="lazy"
							/>
						)}
						<a
							href="/api/auth/logout"
							class="text-xs font-semibold text-gray-500 hover:text-text-primary"
						>
							Sign out
						</a>
					</div>
				) : (
					<a
						href="/api/auth/login"
						class="hidden md:inline-flex shrink-0 whitespace-nowrap px-4 py-2 bg-primary text-link hover:opacity-90 rounded-lg text-sm font-semibold transition-opacity"
					>
						Sign in
					</a>
				)
			}

			<!-- Mobile hamburger (replaces the Sign-in / avatar block on small screens) -->
			<button
				type="button"
				aria-label="Open menu"
				data-site-menu-open
				class="md:hidden w-10 h-10 flex items-center justify-center rounded-md hover:bg-gray-100 text-text-primary shrink-0 -mr-2"
			>
				<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<line x1="3" y1="6" x2="21" y2="6"/>
					<line x1="3" y1="12" x2="21" y2="12"/>
					<line x1="3" y1="18" x2="21" y2="18"/>
				</svg>
			</button>

			<!-- Guest decoration: keep the mock streak/energy so the public chrome still pops -->
			{
				!sessionUser && (
					<div class="hidden lg:flex items-center gap-3 text-xs font-semibold text-gray-500 ml-2">
						<span class="flex items-center gap-1">
							<span class="text-text-primary">{currentUser.streak}</span> 🔥
						</span>
						<span class="flex items-center gap-1">
							<span class="text-text-primary">{currentUser.energy}</span> ⚡
						</span>
					</div>
				)
			}
		</div>
	</div>
</header>

<!-- ============================================================
     Mobile nav drawer (md:hidden) — opened by the hamburger above.
     ============================================================ -->
<dialog
	id="mobile-nav-drawer"
	class="site-drawer md:hidden p-0 m-0 max-w-none max-h-none w-full h-full bg-transparent"
	aria-label="Site navigation"
>
	<!-- Drawer panel (right-aligned via margin-left auto). Native ::backdrop
	     handles the dim overlay; clicks on it bubble up to the dialog where
	     the script catches and closes. -->
	<div class="drawer-panel ml-auto w-72 max-w-[85vw] h-full bg-white flex flex-col shadow-2xl">
		<!-- Brand band + close button -->
		<div class="flex items-center justify-between px-4 py-3 border-b border-gray-200">
			<a href="/" class="flex items-center gap-2">
				<svg class="w-6 h-6 text-primary shrink-0" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
					<path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
				</svg>
				<span class="text-sm font-semibold text-text-primary">Free Prompt Base</span>
			</a>
			<button
				type="button"
				aria-label="Close menu"
				data-drawer-close
				class="w-10 h-10 flex items-center justify-center rounded-md hover:bg-gray-100 text-text-primary"
			>
					<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
				</button>
			</div>

			<!-- Nav links -->
			<nav class="flex-1 overflow-y-auto px-3 py-3 flex flex-col gap-0.5">
				<a href="/" class="flex items-center gap-3 px-3 py-2.5 rounded-md text-sm font-medium text-text-primary hover:bg-gray-100 transition-colors">
					<svg class="w-5 h-5 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
					Feed
				</a>
				<a href="/categories" class="flex items-center gap-3 px-3 py-2.5 rounded-md text-sm font-medium text-text-primary hover:bg-gray-100 transition-colors">
					<svg class="w-5 h-5 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
					Discover
				</a>
				<a href="/blog" class="flex items-center gap-3 px-3 py-2.5 rounded-md text-sm font-medium text-text-primary hover:bg-gray-100 transition-colors">
					<svg class="w-5 h-5 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h12a4 4 0 0 1 4 4v12H8a4 4 0 0 1-4-4V4z"/><path d="M8 9h8M8 13h8M8 17h5"/></svg>
					Blog
				</a>
				<a href="/about" class="flex items-center gap-3 px-3 py-2.5 rounded-md text-sm font-medium text-text-primary hover:bg-gray-100 transition-colors">
					<svg class="w-5 h-5 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
					Community
				</a>
			</nav>

			<!-- Auth section -->
			<div class="border-t border-gray-200 px-3 py-3 space-y-2">
				{
					sessionUser ? (
						<>
							<div class="flex items-center gap-2 px-2">
								{sessionUser.avatarUrl && (
									<img
										src={sessionUser.avatarUrl}
										alt={sessionUser.name}
										class="w-8 h-8 rounded-full object-cover shrink-0"
										width="32"
										height="32"
										loading="lazy"
									/>
								)}
								<div class="min-w-0 flex-1">
									<p class="text-xs font-semibold text-text-primary truncate">{sessionUser.name}</p>
									<p class="text-[11px] text-gray-500 truncate">{sessionUser.email}</p>
								</div>
							</div>
							{isAdmin && (
								<a href="/admin/cms" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm font-semibold text-link bg-primary hover:opacity-90 transition-opacity">
									<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2z"/></svg>
									Admin dashboard
								</a>
							)}
							<a href="/api/auth/logout" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm text-gray-600 hover:text-text-primary hover:bg-gray-100 transition-colors">
								<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
								Sign out
							</a>
						</>
					) : (
						<a href="/api/auth/login" class="flex items-center justify-center gap-2 px-3 py-2.5 rounded-md text-sm font-semibold text-link bg-primary hover:opacity-90 transition-opacity">
							Sign in with Google
						</a>
					)
				}
			</div>
		</div>
</dialog>

<style is:global>
	/* Drawer shell — full-bleed dialog, transparent itself; the panel inside
	   carries the visible chrome. */
	dialog.site-drawer,
	dialog.admin-drawer {
		position: fixed;
		inset: 0;
		max-width: none;
		max-height: none;
		width: 100%;
		height: 100%;
		border: 0;
		background: transparent;
		outline: none;
		overflow: hidden;
	}

	/* Backdrop fade. ::backdrop is in the top layer, opacity transitions safely. */
	dialog.site-drawer::backdrop,
	dialog.admin-drawer::backdrop {
		background: rgba(24, 24, 48, 0.55);
		backdrop-filter: blur(3px);
		opacity: 0;
		transition: opacity 280ms ease;
	}
	dialog[data-state='open']::backdrop {
		opacity: 1;
	}
	dialog[data-state='closing']::backdrop {
		opacity: 0;
	}

	/* Panel slide — site drawer enters from the right, admin drawer from the left.
	   The `data-state="opening"` / no-attribute initial state holds the panel
	   offscreen so the transition to `open` has somewhere to start from. */
	dialog.site-drawer .drawer-panel {
		transform: translateX(100%);
		transition: transform 280ms cubic-bezier(0.32, 0.72, 0, 1);
		will-change: transform;
	}
	dialog.admin-drawer .drawer-panel {
		transform: translateX(-100%);
		transition: transform 280ms cubic-bezier(0.32, 0.72, 0, 1);
		will-change: transform;
	}
	dialog[data-state='open'] .drawer-panel {
		transform: translateX(0);
	}
	dialog.site-drawer[data-state='closing'] .drawer-panel {
		transform: translateX(100%);
	}
	dialog.admin-drawer[data-state='closing'] .drawer-panel {
		transform: translateX(-100%);
	}

	/* Scrolling inside the menu shouldn't bubble to the page. */
	.drawer-panel {
		overscroll-behavior: contain;
		-webkit-overflow-scrolling: touch;
	}

	@media (prefers-reduced-motion: reduce) {
		dialog.site-drawer .drawer-panel,
		dialog.admin-drawer .drawer-panel,
		dialog.site-drawer::backdrop,
		dialog.admin-drawer::backdrop {
			transition-duration: 1ms !important;
		}
	}
</style>

<script>
	// Shared drawer behavior — animated open/close + body scroll lock + focus
	// management. Used by both the public-site drawer (this file) and the admin
	// drawer (AdminSidebar.astro). Each binds with its own selectors.
	function bindDrawer(drawerId: string, openSelector: string) {
		const drawer = document.getElementById(drawerId) as HTMLDialogElement | null;
		if (!drawer) return;

		const DURATION = 280;
		let lastTrigger: HTMLElement | null = null;
		let closingTimer: ReturnType<typeof setTimeout> | null = null;

		function lockScroll() {
			const sbw = window.innerWidth - document.documentElement.clientWidth;
			if (sbw > 0) document.documentElement.style.paddingRight = `${sbw}px`;
			document.documentElement.classList.add('drawer-open');
		}
		function unlockScroll() {
			document.documentElement.classList.remove('drawer-open');
			document.documentElement.style.paddingRight = '';
		}

		function open(trigger: HTMLElement | null) {
			if (drawer!.dataset.state === 'open' || drawer!.dataset.state === 'opening') return;
			if (closingTimer) {
				clearTimeout(closingTimer);
				closingTimer = null;
			}
			lastTrigger = trigger;
			lockScroll();
			try {
				drawer!.showModal();
			} catch {
				drawer!.setAttribute('open', '');
			}
			drawer!.dataset.state = 'opening';
			// Two rAFs to make sure the initial "off-screen" state lays down
			// before we transition to the "open" state.
			requestAnimationFrame(() =>
				requestAnimationFrame(() => {
					if (drawer!.dataset.state !== 'opening') return;
					drawer!.dataset.state = 'open';
					(drawer!.querySelector('[data-drawer-close]') as HTMLButtonElement | null)?.focus();
				}),
			);
		}

		function close() {
			if (!drawer!.dataset.state || drawer!.dataset.state === 'closing') return;
			drawer!.dataset.state = 'closing';
			closingTimer = setTimeout(() => {
				drawer!.close();
				delete drawer!.dataset.state;
				unlockScroll();
				lastTrigger?.focus();
				closingTimer = null;
			}, DURATION);
		}

		document.querySelectorAll<HTMLElement>(openSelector).forEach((btn) => {
			btn.addEventListener('click', () => open(btn));
		});

		// Any close trigger inside the drawer (×, "Back", logout link etc).
		drawer.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;
			if (target.closest('[data-drawer-close]')) {
				e.preventDefault();
				close();
				return;
			}
			// Clicks on the dialog itself (its own background = the ::backdrop area)
			// close the drawer too. The panel intercepts its own clicks first.
			if (target === drawer) close();
		});

		// Auto-close when a link inside the panel is followed so the page
		// transition isn't covered by the backdrop.
		drawer.querySelectorAll('a[href]').forEach((a) => {
			a.addEventListener('click', () => close());
		});

		// Animate the Esc close (native `cancel` fires before `close`).
		drawer.addEventListener('cancel', (e) => {
			e.preventDefault();
			close();
		});
	}

	bindDrawer('mobile-nav-drawer', '[data-site-menu-open]');
</script>
