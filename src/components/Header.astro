---
import { getSiteStats } from '../lib/prompts';

// Auth-aware session — falls through to nothing for anonymous visitors.
const sessionUser = Astro.locals.user;
const isAdmin = sessionUser?.role === 'admin';

// Live aggregates shown in the right-rail decoration (replaces the old
// streak/energy mock). Falls back to zeros if D1 is unreachable.
let stats = { promptCount: 0, likeTotal: 0 };
try {
	stats = await getSiteStats();
} catch {}

function fmt(n: number): string {
	if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'K';
	return String(n);
}
---

<header
	class="sticky top-0 z-50 bg-white border-b border-gray-200 px-4 py-3"
	data-purpose="main-navigation"
>
	<div class="max-w-7xl mx-auto flex items-center justify-between gap-2 sm:gap-4">
		<!-- Left: logo + desktop nav -->
		<div class="flex items-center gap-2 md:gap-8">
			<a href="/" class="flex items-center gap-2 shrink-0" aria-label="Free Prompt Base — home" data-purpose="logo">
				<img
					src="/logo.svg"
					alt="Free Prompt Base"
					class="w-8 h-8 shrink-0"
					width="32"
					height="32"
				/>
			</a>
			<nav aria-label="Primary" class="hidden md:flex items-center gap-6 font-medium text-sm text-gray-600">
				<a class="text-text-primary" href="/">Prompts</a>
				<a class="hover:text-secondary transition-colors" href="/categories">Categories</a>
				<a class="hover:text-secondary transition-colors" href="/saved">Saved</a>
				<a class="hover:text-secondary transition-colors" href="/submit">Submit</a>
				<a class="hover:text-secondary transition-colors" href="/blog">Blog</a>
				<a class="hover:text-secondary transition-colors" href="/about">About</a>
			</nav>
		</div>

		<!-- Center: Search Bar -->
		<form class="flex-grow max-w-xl" action="/" method="get" data-search-form role="search">
			<div class="relative">
				<label for="site-search" class="sr-only">Search prompts</label>
				<input
					id="site-search"
					name="q"
					data-search-input
					class="w-full bg-gray-100 border-none rounded-lg py-2 px-5 text-sm focus:outline-none focus:ring-2 focus:ring-text-primary"
					placeholder="Search..."
					type="text"
					autocomplete="off"
				/>
			</div>
		</form>

		<!-- Right: User Controls -->
		<div class="flex items-center gap-2 sm:gap-4">
			{
				isAdmin && (
					<a
						href="/admin/cms"
						class="hidden md:inline-flex btn-dark"
					>
						Admin
					</a>
				)
			}

			{
				sessionUser ? (
					<div class="hidden md:block relative ml-2" data-profile-menu>
						<button
							type="button"
							data-profile-toggle
							aria-haspopup="true"
							aria-expanded="false"
							class="flex items-center gap-2 rounded-full hover:opacity-90 transition-opacity"
						>
							{sessionUser.avatarUrl ? (
								<img
									alt={sessionUser.name}
									class="w-8 h-8 rounded-full object-cover"
									src={sessionUser.avatarUrl}
									width="32"
									height="32"
									loading="lazy"
									referrerpolicy="no-referrer"
								/>
							) : (
								<div class="w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center text-xs font-semibold text-gray-500">
									{sessionUser.name.slice(0, 1).toUpperCase()}
								</div>
							)}
						</button>
						<div
							data-profile-dropdown
							class="hidden absolute right-0 mt-2 w-56 bg-white border border-gray-200 rounded-md shadow-lg py-1 z-50"
						>
							<div class="px-3 py-2 border-b border-gray-100">
								<p class="text-sm font-semibold text-text-primary truncate">{sessionUser.name}</p>
								<p class="text-xs text-gray-500 truncate">{sessionUser.email}</p>
							</div>
							{sessionUser.username && (
								<a href={`/author/${sessionUser.username}`} class="block px-3 py-2 text-sm text-text-primary hover:bg-gray-100">
									Your profile
								</a>
							)}
							<a href="/submit" class="block px-3 py-2 text-sm text-text-primary hover:bg-gray-100">Submit a prompt</a>
							<a href="/saved" class="block px-3 py-2 text-sm text-text-primary hover:bg-gray-100">Saved prompts</a>
							<a href="/account" class="block px-3 py-2 text-sm text-text-primary hover:bg-gray-100">Account settings</a>
							{isAdmin && (
								<a href="/admin/cms" class="block px-3 py-2 text-sm text-text-primary hover:bg-gray-100">Admin dashboard</a>
							)}
							<div class="border-t border-gray-100 mt-1">
								<a href="/api/auth/logout" class="block px-3 py-2 text-sm text-gray-600 hover:bg-gray-100">Sign out</a>
							</div>
						</div>
					</div>
				) : (
					<a
						href="/api/auth/login"
						class="hidden md:inline-flex shrink-0 whitespace-nowrap btn-primary text-sm"
					>
						Sign in
					</a>
				)
			}

			<!-- Mobile hamburger (replaces the Sign-in / avatar block on small screens) -->
			<button
				type="button"
				aria-label="Open menu"
				data-site-menu-open
				class="md:hidden w-10 h-10 flex items-center justify-center rounded-md hover:bg-gray-100 text-text-primary shrink-0 -mr-2"
			>
				<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<line x1="3" y1="6" x2="21" y2="6"/>
					<line x1="3" y1="12" x2="21" y2="12"/>
					<line x1="3" y1="18" x2="21" y2="18"/>
				</svg>
			</button>

			<!-- Real site aggregates — total approved prompts + total likes. -->
			<div class="hidden lg:flex items-center gap-3 text-xs font-semibold text-gray-500 ml-2" aria-label="Site stats">
				<span class="flex items-center gap-1">
					<span class="text-text-primary tabular-nums">{stats.promptCount}</span>
					<span>prompts</span>
				</span>
				<span class="flex items-center gap-1">
					<span class="text-text-primary tabular-nums">{fmt(stats.likeTotal)}</span>
					<span aria-hidden="true">❤️</span>
					<span class="sr-only">likes</span>
				</span>
			</div>
		</div>
	</div>
</header>

<!-- ============================================================
     Mobile nav drawer (md:hidden) — opened by the hamburger above.
     Animation + scroll-lock live in /styles/drawer.css and /scripts/drawer.ts.
     ============================================================ -->
<dialog
	id="mobile-nav-drawer"
	class="app-drawer from-right md:hidden"
	closedby="any"
	aria-labelledby="mobile-nav-title"
>
	<div class="flex flex-col h-full">
		<!-- Brand band + close button -->
		<div class="flex items-center justify-between px-4 py-3 border-b border-gray-200">
			<a href="/" class="flex items-center gap-2">
				<img src="/logo.svg" alt="" aria-hidden="true" class="w-6 h-6 shrink-0" width="24" height="24" />
				<span id="mobile-nav-title" class="text-sm font-semibold text-text-primary">Free Prompt Base</span>
			</a>
			<button
				type="button"
				aria-label="Close menu"
				data-drawer-close
				class="w-10 h-10 flex items-center justify-center rounded-md hover:bg-gray-100 text-text-primary"
			>
				<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
			</button>
		</div>

		<!-- Nav links -->
		<nav class="flex-1 overflow-y-auto px-3 py-3 flex flex-col gap-0.5">
			<a href="/" class="flex items-center gap-3 px-3 py-2.5 rounded-md text-sm font-medium text-text-primary hover:bg-gray-100 transition-colors">
				<svg class="w-5 h-5 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
				Prompts
			</a>
			<a href="/categories" class="flex items-center gap-3 px-3 py-2.5 rounded-md text-sm font-medium text-text-primary hover:bg-gray-100 transition-colors">
				<svg class="w-5 h-5 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
				Categories
			</a>
			<a href="/saved" class="flex items-center gap-3 px-3 py-2.5 rounded-md text-sm font-medium text-text-primary hover:bg-gray-100 transition-colors">
				<svg class="w-5 h-5 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
				Saved
			</a>
			<a href="/submit" class="flex items-center gap-3 px-3 py-2.5 rounded-md text-sm font-medium text-text-primary hover:bg-gray-100 transition-colors">
				<svg class="w-5 h-5 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
				Submit a prompt
			</a>
			<a href="/blog" class="flex items-center gap-3 px-3 py-2.5 rounded-md text-sm font-medium text-text-primary hover:bg-gray-100 transition-colors">
				<svg class="w-5 h-5 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h12a4 4 0 0 1 4 4v12H8a4 4 0 0 1-4-4V4z"/><path d="M8 9h8M8 13h8M8 17h5"/></svg>
				Blog
			</a>
			<a href="/about" class="flex items-center gap-3 px-3 py-2.5 rounded-md text-sm font-medium text-text-primary hover:bg-gray-100 transition-colors">
				<svg class="w-5 h-5 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
				About
			</a>
		</nav>

		<!-- Auth section -->
		<div class="border-t border-gray-200 px-3 py-3 space-y-2">
			{
				sessionUser ? (
					<>
						<div class="flex items-center gap-2 px-2">
							{sessionUser.avatarUrl && (
								<img
									src={sessionUser.avatarUrl}
									alt={sessionUser.name}
									class="w-8 h-8 rounded-full object-cover shrink-0"
									width="32"
									height="32"
									loading="lazy"
								/>
							)}
							<div class="min-w-0 flex-1">
								<p class="text-xs font-semibold text-text-primary truncate">{sessionUser.name}</p>
								<p class="text-[11px] text-gray-500 truncate">{sessionUser.email}</p>
							</div>
						</div>
						{sessionUser.username && (
							<a href={`/author/${sessionUser.username}`} class="flex items-center gap-3 px-3 py-2 rounded-md text-sm text-text-primary hover:bg-gray-100 transition-colors">
								<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
								Your profile
							</a>
						)}
						<a href="/account" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm text-text-primary hover:bg-gray-100 transition-colors">
							<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
							Account settings
						</a>
						{isAdmin && (
							<a href="/admin/cms" class="btn-primary flex items-center gap-3">
								<img src="/logo.svg" alt="" aria-hidden="true" class="w-4 h-4" width="16" height="16" />
								Admin dashboard
							</a>
						)}
						<a href="/api/auth/logout" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm text-gray-600 hover:text-text-primary hover:bg-gray-100 transition-colors">
							<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
							Sign out
						</a>
					</>
				) : (
					<a href="/api/auth/login" class="btn-primary w-full text-sm">
						Sign in with Google
					</a>
				)
			}
		</div>
	</div>
</dialog>

<script>
	import { bindDrawer } from '../scripts/drawer';
	bindDrawer('mobile-nav-drawer', '[data-site-menu-open]');

	// Profile dropdown (desktop). Toggle on click, close on outside-click / Escape.
	const menu = document.querySelector('[data-profile-menu]') as HTMLElement | null;
	if (menu) {
		const toggle = menu.querySelector('[data-profile-toggle]') as HTMLButtonElement;
		const dropdown = menu.querySelector('[data-profile-dropdown]') as HTMLElement;
		const setOpen = (open: boolean) => {
			dropdown.classList.toggle('hidden', !open);
			toggle.setAttribute('aria-expanded', String(open));
		};
		toggle.addEventListener('click', (e) => {
			e.stopPropagation();
			setOpen(dropdown.classList.contains('hidden'));
		});
		document.addEventListener('click', (e) => {
			if (!menu.contains(e.target as Node)) setOpen(false);
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') setOpen(false);
		});
	}
</script>
