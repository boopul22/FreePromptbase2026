---
import type { Prompt, Category } from '../lib/prompts';
import CategoryIcon from './CategoryIcon.astro';

interface Props {
	prompt: Prompt;
	/** Resolved category (for the badge emoji + gradient fallback). */
	category?: Category;
	/** Tailwind aspect class for the cover, e.g. "aspect-[3/4]" (masonry variety). */
	aspectClass?: string;
}

const { prompt, category, aspectClass = 'aspect-[4/3]' } = Astro.props;

const searchIndex = [prompt.title, prompt.description, ...prompt.tags]
	.join(' ')
	.toLowerCase();

// Per-actor state, seeded server-side so SSR matches reality (no flicker).
const liked = Astro.locals.likedSlugs?.has(prompt.slug) ?? false;
const saved = Astro.locals.savedSlugs?.has(prompt.slug) ?? false;
const likeCount = prompt.likeCount ?? 0;
const saveCount = prompt.saveCount ?? prompt.popularity ?? 0;

// Human-friendly count (1.2k instead of 1234) for the pill.
function fmt(n: number): string {
	if (n >= 1000) return (n / 1000).toFixed(n >= 10000 ? 0 : 1).replace(/\.0$/, '') + 'k';
	return String(n);
}
---

<article
	class="masonry-item group relative"
	data-prompt
	data-slug={prompt.slug}
	data-save-count={saveCount}
	data-popularity={saveCount}
	data-like-count={likeCount}
	data-date={prompt.date}
	data-search={searchIndex}
>
	<!-- Cover -->
	<div class={`relative overflow-hidden rounded-lg mb-3 ${aspectClass}`}>
		{
			prompt.featured && (
				<>
					<span class="absolute top-4 right-4 z-10 bg-primary text-link text-[10px] font-bold px-2 py-1 rounded">
						Prompt of the Day
					</span>
					<span class="absolute top-10 right-4 z-10 text-primary">
						<svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
							<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
						</svg>
					</span>
				</>
			)
		}

		{
			prompt.coverImage ? (
				<img
					src={prompt.coverImage}
					alt={prompt.title}
					class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
					loading="lazy"
					decoding="async"
				/>
			) : (
				<div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-primary/30 via-primary/10 to-link/15 text-text-primary group-hover:scale-105 transition-transform duration-500">
					{category ? (
						<CategoryIcon slug={category.slug} class="w-14 h-14" />
					) : (
						<svg class="w-14 h-14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
						</svg>
					)}
				</div>
			)
		}

		<!--
			Action cluster (sits above the stretched link).
			Layout: [share][bookmark][♥ count] — hearts always visible (social
			proof), bookmark + share fade in on hover so the image stays clean.
		-->
		<div class="absolute bottom-3 right-3 z-20 flex items-center gap-1.5">
			<button
				type="button"
				class="action-icon-btn opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition-opacity"
				data-share
				aria-label="Share prompt"
			>
				<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
					<line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
				</svg>
			</button>

			<button
				type="button"
				class={`action-icon-btn opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition-opacity ${saved ? 'is-saved' : ''}`}
				data-save
				data-saved={saved ? 'true' : 'false'}
				aria-label={saved ? 'Remove from saved' : 'Save prompt'}
				aria-pressed={saved ? 'true' : 'false'}
			>
				<svg
					class="save-icon w-4 h-4"
					viewBox="0 0 24 24"
					fill={saved ? 'currentColor' : 'none'}
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
				</svg>
			</button>

			<button
				type="button"
				class={`like-pill ${liked ? 'is-liked' : ''}`}
				data-like
				data-liked={liked ? 'true' : 'false'}
				aria-label={liked ? 'Unlike prompt' : 'Like prompt'}
				aria-pressed={liked ? 'true' : 'false'}
			>
				<svg
					class="like-icon w-4 h-4"
					viewBox="0 0 24 24"
					fill={liked ? 'currentColor' : 'none'}
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
				</svg>
				<span class="like-count tabular-nums" data-like-count-text data-raw={likeCount}>
					{likeCount > 0 ? fmt(likeCount) : ''}
				</span>
			</button>
		</div>
	</div>

	<!-- Caption -->
	<div class="space-y-1">
		<h3 class="font-bold text-sm text-text-primary group-hover:text-primary transition-colors">
			{prompt.title}
		</h3>
		{prompt.description && <p class="text-xs text-gray-500 line-clamp-2">{prompt.description}</p>}
	</div>

	<!-- Stretched link: makes the whole card open the prompt (except the actions) -->
	<a href={`/${prompt.slug}`} class="absolute inset-0 z-[1]" aria-label={prompt.title}></a>
</article>

<style is:global>
	/* Shared visual for the three action buttons on a prompt card. Lives in
	   :global so it applies across every PromptCard instance without scoping
	   collisions. */
	.action-icon-btn {
		width: 1.75rem;
		height: 1.75rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.92);
		backdrop-filter: blur(6px);
		color: var(--color-text-primary, #111827);
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
		transition: background-color 150ms ease, color 150ms ease, transform 150ms ease;
	}
	.action-icon-btn:hover {
		background: #fff;
		transform: translateY(-1px);
	}
	.action-icon-btn.is-saved {
		background: var(--color-primary, #f97316);
		color: var(--color-link, #fff);
		opacity: 1 !important;
	}

	/* Always-visible like pill — anchors the cluster's right edge. Pill grows
	   wider when a count is shown; the heart fill + color signal liked state. */
	.like-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		height: 1.75rem;
		padding: 0 0.55rem;
		border-radius: 9999px;
		font-size: 11px;
		font-weight: 700;
		line-height: 1;
		background: rgba(255, 255, 255, 0.92);
		backdrop-filter: blur(6px);
		color: var(--color-text-primary, #111827);
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
		transition: background-color 150ms ease, color 150ms ease, transform 150ms ease;
	}
	.like-pill:hover {
		background: #fff;
		transform: translateY(-1px);
	}
	.like-pill .like-count:empty {
		display: none;
	}
	.like-pill.is-liked {
		background: #fde2e2;
		color: #e11d48;
	}
	.like-pill.is-liked .like-icon {
		fill: currentColor;
	}
	/* Pop animation when the heart toggles on. */
	.like-pill.is-liked .like-icon {
		animation: like-pop 280ms cubic-bezier(0.22, 1.4, 0.36, 1);
	}
	@keyframes like-pop {
		0%   { transform: scale(1); }
		40%  { transform: scale(1.35); }
		100% { transform: scale(1); }
	}
</style>

<script>
	import { wireSave, wireShare, wireLike } from '../scripts/social';
	wireSave();
	wireShare();
	wireLike();
</script>
