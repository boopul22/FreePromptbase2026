---
import type { Prompt, Category } from '../lib/prompts';
import CategoryIcon from './CategoryIcon.astro';
import { cfSrcset } from '../lib/cfImage';

interface Props {
	prompt: Prompt;
	/** Resolved category (for the badge emoji + gradient fallback). */
	category?: Category;
	/** Above-the-fold cards (first row) eager-load + prioritise their cover so it
	    can be the LCP element instead of being deferred by lazy-loading. */
	priority?: boolean;
	/** Position in the parent grid; drives the rotating edge tint so adjacent
	    cards never share a border color. Falls back to a slug hash when the
	    card renders outside a grid. */
	index?: number;
	/** Whether this prompt is the current (view-driven) Prompt of the Day. */
	isPotd?: boolean;
}

const { prompt, category, priority = false, index, isPotd = false } = Astro.props;

const searchIndex = [prompt.title, prompt.description, ...prompt.tags]
	.join(' ')
	.toLowerCase();

// Per-actor state, seeded server-side so SSR matches reality (no flicker).
const liked = Astro.locals.likedSlugs?.has(prompt.slug) ?? false;
const saved = Astro.locals.savedSlugs?.has(prompt.slug) ?? false;
const likeCount = prompt.likeCount ?? 0;
const saveCount = prompt.saveCount ?? prompt.popularity ?? 0;

// Human-friendly count (1.2k instead of 1234) for the pill.
function fmt(n: number): string {
	if (n >= 1000) return (n / 1000).toFixed(n >= 10000 ? 0 : 1).replace(/\.0$/, '') + 'k';
	return String(n);
}

// Quiet tinted edge per card so white cards lift off the gray page instead of
// blending in. Grid position rotates through the palette (masonry columns fill
// in DOM order, so consecutive indices = vertical neighbors = always distinct);
// a slug hash covers cards rendered without an index.
const EDGE_TINTS = [
	'#d3ab62', // gold (brand-adjacent)
	'#d0a18a', // clay
	'#cf9da9', // rose
	'#a8bd97', // sage
	'#8fbeb3', // teal
	'#a3b0cf', // slate
];
const slugHash = [...prompt.slug].reduce((h, c) => (Math.imul(h, 31) + c.charCodeAt(0)) >>> 0, 7);
const edgeTint = EDGE_TINTS[(index ?? slugHash) % EDGE_TINTS.length];
---

<article
	class="masonry-item group relative bg-white overflow-hidden border"
	style={`--card-edge: ${edgeTint}`}
	data-prompt
	data-slug={prompt.slug}
	data-save-count={saveCount}
	data-popularity={saveCount}
	data-like-count={likeCount}
	data-date={prompt.date}
	data-search={searchIndex}
>
	<!-- Cover (natural aspect ratio — the image sets its own height) -->
	<div class="relative overflow-hidden">
		{
			isPotd && (
				<>
					<span class="absolute top-4 right-4 z-10 bg-primary text-link text-[10px] font-bold px-2 py-1 rounded">
						Prompt of the Day
					</span>
					<span class="absolute top-10 right-4 z-10 text-primary">
						<svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
							<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
						</svg>
					</span>
				</>
			)
		}

		{
			prompt.coverImage ? (
				<img
					src={prompt.coverImage}
					srcset={cfSrcset(prompt.coverImage, [300, 400, 520, 660], 68)}
					sizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 92vw"
					alt={prompt.title}
					width={prompt.coverW}
					height={prompt.coverH}
					class="block w-full h-auto group-hover:scale-105 transition-transform duration-500"
					loading={priority ? 'eager' : 'lazy'}
					fetchpriority={priority ? 'high' : undefined}
					decoding="async"
				/>
			) : (
				<div class="w-full aspect-[4/3] flex items-center justify-center bg-gradient-to-br from-primary/30 via-primary/10 to-link/15 text-text-primary group-hover:scale-105 transition-transform duration-500">
					{category ? (
						<CategoryIcon slug={category.slug} class="w-14 h-14" />
					) : (
						<svg class="w-14 h-14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
						</svg>
					)}
				</div>
			)
		}

	</div>

	<!-- Caption -->
	<div class="px-4 pt-3 pb-3 space-y-1">
		<h2 class="font-bold text-sm text-text-primary group-hover:text-primary transition-colors">
			{prompt.title}
		</h2>
		{prompt.description && <p class="text-xs text-gray-500 line-clamp-2">{prompt.description}</p>}
	</div>

	<!--
		Action row: [♥ count] ........ [bookmark][share]
		Lives below the caption behind a hairline divider so the actions are
		always visible (no hover-reveal, no blending into the cover) and sits
		above the stretched link (z-[2] > z-[1]).
	-->
	<div class="relative z-[2] flex items-center gap-1 border-t border-black/5 px-2.5 py-1">
		<button
			type="button"
			class={`card-action card-like ${liked ? 'is-liked' : ''}`}
			data-like
			data-liked={liked ? 'true' : 'false'}
			aria-label={`${liked ? 'Unlike prompt' : 'Like prompt'}${likeCount > 0 ? `, ${fmt(likeCount)} likes` : ''}`}
			aria-pressed={liked ? 'true' : 'false'}
		>
			<svg
				class="like-icon w-[18px] h-[18px]"
				viewBox="0 0 24 24"
				fill={liked ? 'currentColor' : 'none'}
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
			</svg>
			<span class="like-count tabular-nums" data-like-count-text data-raw={likeCount} aria-hidden="true">
				{likeCount > 0 ? fmt(likeCount) : ''}
			</span>
		</button>

		<button
			type="button"
			class={`card-action ml-auto ${saved ? 'is-saved' : ''}`}
			data-save
			data-saved={saved ? 'true' : 'false'}
			aria-label={saved ? 'Remove from saved' : 'Save prompt'}
			aria-pressed={saved ? 'true' : 'false'}
		>
			<svg
				class="save-icon w-[18px] h-[18px]"
				viewBox="0 0 24 24"
				fill={saved ? 'currentColor' : 'none'}
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
			</svg>
		</button>

		<button type="button" class="card-action" data-share aria-label="Share prompt">
			<svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
				<line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
			</svg>
		</button>
	</div>

	<!-- Stretched link: makes the whole card open the prompt (except the actions) -->
	<a href={`/${prompt.slug}`} class="absolute inset-0 z-[1]" aria-label={prompt.title}></a>
</article>

<style is:global>
	/* Per-card tinted edge (set via --card-edge inline). Deepens slightly on
	   hover so the lift reads as interactive, not decorative. */
	.masonry-item[data-prompt] {
		border-color: var(--card-edge, rgba(0, 0, 0, 0.1));
		transition: border-color 150ms ease;
	}
	.masonry-item[data-prompt]:hover {
		border-color: color-mix(in oklab, var(--card-edge, #999), var(--color-text-primary, #333) 25%);
	}

	/* Card action buttons — quiet gray icons in the action row under the
	   caption (and a count for the like). State carries the color: rose when
	   liked, ink when saved. Lives in :global so it applies to every
	   PromptCard without scope collisions. */
	.card-action {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.3rem;
		/* >=24x24 tap target for WCAG 2.5.8; icon stays 18px, padding grows the
		   tappable area. */
		min-width: 32px;
		min-height: 32px;
		padding: 0 6px;
		background: none;
		border: 0;
		color: #6b7280;
		font-size: 12px;
		font-weight: 700;
		line-height: 1;
		cursor: pointer;
		transition: color 150ms ease, background-color 150ms ease;
	}
	.card-action:hover {
		color: var(--color-text-primary, #333);
		background-color: rgba(0, 0, 0, 0.04);
	}
	.card-action.is-saved {
		color: var(--color-link, #181830);
	}
	.card-action .like-count:empty {
		display: none;
	}
	.card-like.is-liked {
		color: #e11d48;
	}
	.card-like.is-liked .like-icon {
		fill: currentColor;
		animation: like-pop 280ms cubic-bezier(0.22, 1.4, 0.36, 1);
	}
	@keyframes like-pop {
		0%   { transform: scale(1); }
		40%  { transform: scale(1.35); }
		100% { transform: scale(1); }
	}
</style>

<script>
	import { wireSave, wireShare, wireLike } from '../scripts/social';
	wireSave();
	wireShare();
	wireLike();
</script>
