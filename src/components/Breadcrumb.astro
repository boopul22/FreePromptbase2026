---
// The one global breadcrumb for the whole site. Pass an ordered list of crumbs
// from root to the current page; the last item (omit `href`) renders as the
// current-page label with aria-current.
//   variant="site"  — public pages: home icon, brand tokens (default)
//   variant="admin" — CMS chrome: compact uppercase, no home icon
export interface Crumb {
	label: string;
	href?: string;
}
interface Props {
	items: Crumb[];
	class?: string;
	variant?: 'site' | 'admin';
}
const { items, variant = 'site', class: cls } = Astro.props;
const isAdmin = variant === 'admin';
const margin = cls ?? (isAdmin ? '' : 'mb-6');
const navClass = isAdmin
	? 'flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-gray-500'
	: 'flex flex-wrap items-center gap-1.5 text-xs';
const linkClass = isAdmin
	? 'hover:text-text-primary transition-colors'
	: 'inline-flex items-center gap-1 font-medium text-[var(--ink-soft)] hover:text-text-primary transition-colors';
const currentClass = isAdmin
	? 'text-text-primary'
	: 'font-semibold text-text-primary truncate max-w-[55%]';
const sepClass = isAdmin
	? 'w-3.5 h-3.5 shrink-0 text-gray-400'
	: 'w-3.5 h-3.5 shrink-0 text-[var(--hairline)]';
---

<nav class:list={[navClass, margin]} aria-label="Breadcrumb">
	{
		items.map((item, i) => {
			const isLast = i === items.length - 1;
			const isLink = !!item.href && !isLast;
			return (
				<>
					{i > 0 && (
						<svg
							class={sepClass}
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<polyline points="9 18 15 12 9 6" />
						</svg>
					)}
					{isLink ? (
						<a href={item.href} class={linkClass}>
							{i === 0 && !isAdmin && (
								<svg
									class="w-3.5 h-3.5 shrink-0"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
									<polyline points="9 22 9 12 15 12 15 22" />
								</svg>
							)}
							<span>{item.label}</span>
						</a>
					) : (
						<span class={currentClass} aria-current="page">
							{item.label}
						</span>
					)}
				</>
			);
		})
	}
</nav>
