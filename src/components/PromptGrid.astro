---
import PromptCard from './PromptCard.astro';
import type { Prompt, Category } from '../lib/prompts';

interface Props {
	prompts: Prompt[];
	categories: Category[];
}

const { prompts, categories } = Astro.props;
const categoryBySlug = new Map(categories.map((c) => [c.slug, c]));

// Vary cover aspect ratios so the masonry columns stagger like the original.
const aspects = [
	'aspect-[3/4]',
	'aspect-[4/3]',
	'aspect-square',
	'aspect-[4/5]',
	'aspect-[5/4]',
	'aspect-[3/4]',
	'aspect-[16/10]',
];
---

<section class="masonry-grid" data-purpose="prompt-gallery" data-grid>
	{
		prompts.map((prompt, i) => (
			<PromptCard
				prompt={prompt}
				category={categoryBySlug.get(prompt.category)}
				aspectClass={aspects[i % aspects.length]}
			/>
		))
	}
</section>

<!-- Empty state shown by the search filter when nothing matches -->
<p data-empty class="hidden text-center text-gray-500 py-16">No prompts match your search.</p>
