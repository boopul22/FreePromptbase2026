---
import PromptCard from './PromptCard.astro';
import type { Prompt, Category } from '../lib/prompts';
import { getPromptOfTheDaySlug } from '../lib/prompts';

interface Props {
	prompts: Prompt[];
	categories: Category[];
	/** Tab id this grid belongs to (trending | popular | recent | etc). */
	tab?: string;
	/** Hidden by default? Used when multiple grids share the same screen. */
	hidden?: boolean;
	/** Optional empty-state message rendered when the prompts array is empty. */
	emptyMessage?: string;
}

const { prompts, categories, tab, hidden = false, emptyMessage } = Astro.props;
const categoryBySlug = new Map(categories.map((c) => [c.slug, c]));
// View-driven Prompt of the Day — memoized in the data layer, so multiple grids
// on one page resolve to the same winner without re-querying.
const potdSlug = await getPromptOfTheDaySlug();
---

<section
	class:list={['masonry-grid', hidden && 'hidden']}
	data-purpose="prompt-gallery"
	data-grid
	data-tab={tab}
>
	{
		prompts.map((prompt, i) => (
			<PromptCard
				prompt={prompt}
				category={categoryBySlug.get(prompt.category)}
				priority={!hidden && i === 0}
				index={i}
				isPotd={prompt.slug === potdSlug}
			/>
		))
	}
</section>

{
	prompts.length === 0 && emptyMessage && (
		<p
			class:list={['text-center text-gray-500 py-16', hidden && 'hidden']}
			data-empty-tab={tab}
		>
			{emptyMessage}
		</p>
	)
}

<!-- Empty state shown by the search filter when nothing matches in the active tab -->
<p data-empty class="hidden text-center text-gray-500 py-16">No prompts match your search.</p>
