---
interface Props {
	imageCount: number;
	textCount: number;
}

const { imageCount, textCount } = Astro.props;
const tabs = [
	{ id: 'images', label: 'Image prompts', count: imageCount },
	{ id: 'text', label: 'Text prompts', count: textCount },
] as const;
---

<nav class="prompt-type-tabs mb-4" role="tablist" aria-label="Prompt type">
	{
		tabs.map((tab, index) => (
			<button
				type="button"
				class="prompt-type-tab"
				data-prompt-type={tab.id}
				data-active={index === 0 ? 'true' : 'false'}
				role="tab"
				aria-selected={index === 0 ? 'true' : 'false'}
			>
				<span>{tab.label}</span>
				<span class="prompt-type-count" aria-label={`${tab.count} prompts`}>{tab.count.toLocaleString()}</span>
			</button>
		))
	}
</nav>
