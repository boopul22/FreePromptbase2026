---

<section class="mt-4" aria-label="Open this prompt in an AI tool" data-open-tools>
	<p class="text-[11px] font-semibold uppercase tracking-wide text-gray-500 mb-2.5">Open in</p>
	<div class="flex flex-wrap gap-2">
		{tools.map((t) => (
			<a
				href={t.href}
				target="_blank"
				rel="noopener"
				data-open-tool
				class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-text-primary hover:border-text-primary hover:bg-soft transition-colors"
			>
				<span class="tool-ico inline-flex h-[18px] w-[18px] shrink-0 items-center justify-center" set:html={t.svg} />
				{t.name}
			</a>
		))}
	</div>
	<p class="mt-2 text-[11px] text-gray-400">The prompt is copied to your clipboard — just paste it in.</p>
</section>

<style>
	/* Normalise every embedded brand SVG to the icon box, regardless of its
	   native viewBox/width. */
	[data-open-tools] .tool-ico svg {
		width: 100%;
		height: 100%;
		display: block;
	}
</style>

<script>
	// On any "Open in" click, copy the prompt to the clipboard so the user can
	// paste it into the tool that just opened. We read the already-rendered prompt
	// text from the copy box so there's a single source of truth. Navigation is
	// left to the anchor itself (target="_blank"); the clipboard write runs within
	// the same user gesture, so it succeeds before the new tab takes focus.
	document.querySelectorAll<HTMLElement>('[data-open-tools]').forEach((root) => {
		const source =
			root.closest('[data-prompt-detail]')?.querySelector<HTMLElement>('[data-copy-text]') ??
			document.querySelector<HTMLElement>('[data-copy-text]');
		const text = source?.textContent ?? '';
		if (!text) return;
		root.querySelectorAll<HTMLAnchorElement>('[data-open-tool]').forEach((a) => {
			a.addEventListener('click', () => {
				try {
					navigator.clipboard?.writeText(text);
				} catch {
					/* clipboard may be blocked — the tool still opens */
				}
			});
		});
	});
</script>
