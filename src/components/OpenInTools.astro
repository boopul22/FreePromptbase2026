// A compact row of "Open in <AI tool>" buttons shown directly under the prompt
// box. Clicking copies the prompt to the clipboard (so it can be pasted) and
// opens the tool in a new tab. ChatGPT additionally gets the prompt pre-filled
// via its ?q= query param when the prompt is short enough for a sane URL.
//
// Icons are the official brand marks (OpenAI, Google Gemini, Google Flow,
// Midjourney, Grok, Runway) embedded as authentic SVGs. Each keeps its own
// viewBox and brand colours; sizing is normalised via CSS below.
interface Props {
	/** The prompt text — used to pre-fill ChatGPT's query param. */
	text: string;
}
const { text } = Astro.props;

// ChatGPT reliably accepts a pre-filled prompt via ?q=. Guard the length so we
// never emit an absurdly long URL; long prompts fall back to clipboard paste.
const chatgptHref =
	text.length <= 3000 ? `https://chatgpt.com/?q=${encodeURIComponent(text)}` : 'https://chatgpt.com/';

