---
// Admin chrome for /admin/cms/*. Renders the same nav twice:
//   - md+ : a fixed left rail (sticky, h-screen).
//   - below md: a sticky top bar with a hamburger that opens a native
//     <dialog> drawer. Same nav items in both — `items[]` is the
//     single source of truth.
interface Props {
	activePage?: string;
}
const { activePage = '' } = Astro.props;

const user = Astro.locals.user;

const items = [
	{ href: '/admin/cms', label: 'Dashboard', icon: 'dashboard', match: 'dashboard' },
	{ href: '/admin/cms/prompts', label: 'Prompts', icon: 'bolt', match: 'prompts' },
	{ href: '/admin/cms/posts', label: 'Posts', icon: 'article', match: 'posts' },
	{ href: '/admin/cms/categories', label: 'Categories', icon: 'category', match: 'categories' },
	{ href: '/admin/cms/media', label: 'Media', icon: 'image', match: 'media' },
	{ href: '/admin/cms/pages', label: 'Pages', icon: 'description', match: 'pages' },
	{ href: '/admin/cms/users', label: 'Users', icon: 'group', match: 'users' },
];

const path = Astro.url.pathname;
const isActive = (it: { match: string }) =>
	it.match === 'dashboard'
		? path === '/admin/cms' || path === '/admin/cms/' || path.endsWith('/admin/cms.html')
		: path.includes('/admin/cms/' + it.match);

// Pick the current page title for the mobile top bar.
const current = items.find((it) => isActive(it));
const pageLabel = current?.label ?? 'CMS';
---

<!-- ============================================================
     Mobile: sticky top bar (only below md)
     ============================================================ -->
<header class="md:hidden sticky top-0 z-40 bg-white border-b border-gray-200 flex items-center gap-2 px-3 py-2">
	<button
		type="button"
		aria-label="Open menu"
		data-admin-menu-open
		class="w-10 h-10 flex items-center justify-center rounded-md hover:bg-gray-100 text-text-primary"
	>
		<span class="material-symbols-outlined text-2xl">menu</span>
	</button>
	<div class="min-w-0 flex-1">
		<p class="text-[10px] font-semibold uppercase tracking-wide text-gray-500 leading-tight">Free Prompt Base</p>
		<p class="text-sm font-semibold text-text-primary truncate leading-tight">{pageLabel}</p>
	</div>
	{
		user?.avatarUrl && (
			<img
				src={user.avatarUrl}
				alt={user.name}
				class="w-8 h-8 rounded-full object-cover shrink-0"
				width="32"
				height="32"
				loading="lazy"
			/>
		)
	}
</header>

<!-- ============================================================
     Mobile: native <dialog> drawer (animation + scroll-lock in
     /styles/drawer.css and /scripts/drawer.ts).
     ============================================================ -->
<dialog
	id="admin-drawer"
	class="app-drawer from-left md:hidden"
	closedby="any"
	aria-labelledby="admin-drawer-title"
>
	<div class="flex flex-col h-full">
		<div class="flex items-center justify-between px-4 py-3 border-b border-gray-200">
			<a href="/admin/cms" class="flex items-center gap-2">
				<img src="/logo.svg" alt="" aria-hidden="true" class="w-6 h-6 shrink-0" width="24" height="24" />
				<span id="admin-drawer-title" class="text-sm font-semibold text-text-primary">Free Prompt Base</span>
			</a>
			<button
				type="button"
				aria-label="Close menu"
				data-drawer-close
				class="w-10 h-10 flex items-center justify-center rounded-md hover:bg-gray-100 text-text-primary"
			>
				<span class="material-symbols-outlined text-xl">close</span>
			</button>
		</div>

		<nav class="flex-1 overflow-y-auto px-3 py-3 flex flex-col gap-0.5">
			{items.map((it) => (
				<a
					href={it.href}
					class:list={[
						'flex items-center gap-3 px-3 py-2.5 rounded-md text-sm font-medium transition-colors',
						isActive(it)
							? 'bg-primary text-link'
							: 'text-text-primary hover:bg-gray-100',
					]}
				>
					<span class="material-symbols-outlined text-lg">{it.icon}</span>
					{it.label}
				</a>
			))}
		</nav>

		<div class="border-t border-gray-200 px-3 py-3 space-y-2">
			{user && (
				<div class="flex items-center gap-2 px-2">
					{user.avatarUrl && (
						<img
							src={user.avatarUrl}
							alt={user.name}
							class="w-8 h-8 rounded-full object-cover shrink-0"
							width="32"
							height="32"
							loading="lazy"
						/>
					)}
					<div class="min-w-0 flex-1">
						<p class="text-xs font-semibold text-text-primary truncate">{user.name}</p>
						<p class="text-[11px] text-gray-500 truncate">{user.email}</p>
					</div>
				</div>
			)}
			<div class="flex flex-col gap-0.5">
				<a href="/" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm text-gray-600 hover:text-text-primary hover:bg-gray-100 transition-colors">
					<span class="material-symbols-outlined text-base">arrow_back</span>
					Back to site
				</a>
				<a href="/api/auth/logout" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm text-gray-600 hover:text-text-primary hover:bg-gray-100 transition-colors">
					<span class="material-symbols-outlined text-base">logout</span>
					Sign out
				</a>
			</div>
		</div>
	</div>
</dialog>

<!-- ============================================================
     Desktop: fixed left rail (md+)
     ============================================================ -->
<aside class="hidden md:flex flex-col w-52 shrink-0 bg-white border-r border-gray-200 h-screen sticky top-0">
	<!-- Brand band -->
	<a href="/admin/cms" class="flex items-center gap-2 px-4 py-4 border-b border-gray-200">
		<img src="/logo.svg" alt="" aria-hidden="true" class="w-6 h-6 shrink-0" width="24" height="24" />
		<span class="text-sm font-semibold text-text-primary leading-tight">Free Prompt Base</span>
	</a>

	<nav class="flex-1 px-3 py-3 gap-0.5 flex flex-col">
		{items.map((it) => (
			<a
				href={it.href}
				class:list={[
					'flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium transition-colors',
					isActive(it)
						? 'bg-primary text-link'
						: 'text-text-primary hover:bg-gray-100',
				]}
			>
				<span class="material-symbols-outlined text-lg">{it.icon}</span>
				{it.label}
			</a>
		))}
	</nav>

	<div class="border-t border-gray-200 px-3 py-3 space-y-2">
		{user && (
			<div class="flex items-center gap-2 px-2">
				{user.avatarUrl && (
					<img
						src={user.avatarUrl}
						alt={user.name}
						class="w-8 h-8 rounded-full object-cover shrink-0"
						width="32"
						height="32"
						loading="lazy"
					/>
				)}
				<div class="min-w-0 flex-1">
					<p class="text-xs font-semibold text-text-primary truncate">{user.name}</p>
					<p class="text-[11px] text-gray-500 truncate">{user.email}</p>
				</div>
			</div>
		)}
		<div class="flex flex-col gap-0.5">
			<a href="/" class="flex items-center gap-3 px-3 py-1.5 rounded-md text-xs text-gray-500 hover:text-text-primary hover:bg-gray-100 transition-colors">
				<span class="material-symbols-outlined text-base">arrow_back</span>
				Back to site
			</a>
			<a href="/api/auth/logout" class="flex items-center gap-3 px-3 py-1.5 rounded-md text-xs text-gray-500 hover:text-text-primary hover:bg-gray-100 transition-colors">
				<span class="material-symbols-outlined text-base">logout</span>
				Sign out
			</a>
		</div>
	</div>
</aside>

<script>
	import { bindDrawer } from '../scripts/drawer';
	bindDrawer('admin-drawer', '[data-admin-menu-open]');
</script>
