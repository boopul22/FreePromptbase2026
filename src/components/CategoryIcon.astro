---
// Inline Lucide-style SVG icons per category slug.
// Uses currentColor so it picks up the surrounding text color.
interface Props {
	slug: string;
	class?: string;
}
const { slug, class: className = 'w-4 h-4' } = Astro.props;

const paths: Record<string, string> = {
	'images': `<rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>`,
	'text': `<path d="M4 6h16M4 12h16M4 18h10"/>`,
};
const d = paths[slug] ?? `<circle cx="12" cy="12" r="9"/>`;
---
<svg
	class={className}
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	set:html={d}
/>
