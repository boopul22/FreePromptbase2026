---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from './Breadcrumb.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import CopyPromptButton from './CopyPromptButton.astro';
import OpenInTools from './OpenInTools.astro';
import AdSlot from './AdSlot.astro';
import PromptCard from './PromptCard.astro';
import CategoryIcon from './CategoryIcon.astro';
import { cfSrcset, cfImg } from '../lib/cfImage';
import type { Prompt } from '../lib/prompts';
import {
	getCategoryBySlug,
	getRelatedPrompts,
	getAllCategories,
	getAllTags,
	getPromptOfTheDaySlug,
	readTime,
} from '../lib/prompts';
import { getUserById } from '../lib/users';
import { breadcrumbSchema } from '../lib/seo';

// Full prompt-detail view. Rendered by the root [slug] route once a prompt has
// been resolved (the route decides prompt vs keyword-landing vs 404).
interface Props {
	prompt: Prompt;
}
const { prompt } = Astro.props;

// Fan out the remaining reads in parallel — they only depend on `prompt`, so the
// serial awaits here were the main server-response-time (TTFB) cost on detail pages.
const authorUserId = prompt.submittedBy || prompt.createdBy;
const [category, related, categories, potdSlug, authorProfile] = await Promise.all([
	getCategoryBySlug(prompt.category),
	getRelatedPrompts(prompt),
	getAllCategories(),
	getPromptOfTheDaySlug(),
	authorUserId ? getUserById(authorUserId) : Promise.resolve(null),
]);
const categoryBySlug = new Map(categories.map((c) => [c.slug, c]));

// Soft multi-colour pills (deterministic per seed so a tag/category keeps its
// colour across renders). Used by the breadcrumb, tags, and the related rail.
const PILL_COLORS = ['pill-gold', 'pill-clay', 'pill-rose', 'pill-sage', 'pill-teal', 'pill-slate'];
function pillColor(seed: string): string {
	let h = 0;
	for (const c of seed) h = (Math.imul(h, 31) + c.charCodeAt(0)) >>> 0;
	return PILL_COLORS[h % PILL_COLORS.length];
}
// Distinct categories across the related set — rendered as colourful chips that
// give the "More like this" header some life and double as category nav.
const relatedCategoryPills = [...new Set(related.map((r) => r.category))]
	.map((slug) => categoryBySlug.get(slug))
	.filter((c): c is NonNullable<typeof c> => Boolean(c))
	.slice(0, 6);

// Make each prompt tag a real link: to its curated keyword landing page at
// /<slug> when one exists, otherwise to the homepage search pre-filtered by the
// tag (which always returns matching prompts). Free-form prompt tags rarely
// match the 50 curated slugs, so the search fallback keeps every tag clickable.
const curatedTagSlugs = new Set(getAllTags().map((t) => t.slug));
const slugifyTag = (t: string) => t.toLowerCase().trim().replace(/\s+/g, '-');
const tagHref = (t: string) => {
	const s = slugifyTag(t);
	return curatedTagSlugs.has(s) ? `/${s}` : `/?q=${encodeURIComponent(t)}`;
};

const isSaved = Astro.locals.savedSlugs?.has(prompt.slug) ?? false;
const isLiked = Astro.locals.likedSlugs?.has(prompt.slug) ?? false;
const saveCount = prompt.saveCount ?? prompt.popularity ?? 0;
const likeCount = prompt.likeCount ?? 0;
const shareCount = prompt.shareCount ?? 0;

// D1 stores dates as 'YYYY-MM-DD' or UTC 'YYYY-MM-DD HH:MM:SS'. Parse both as UTC.
function parseDbDate(s: string): Date {
	if (/^\d{4}-\d{2}-\d{2}$/.test(s)) return new Date(s + 'T00:00:00Z');
	return new Date(s.endsWith('Z') ? s : s.replace(' ', 'T') + 'Z');
}
const publishedAt = parseDbDate(prompt.date);
// A scheduled prompt is created (and its updated_at stamped) BEFORE its publish
// date, and nothing rewrites updated_at when the schedule fires. So a stored
// updated_at can predate publication — which would render as "Updated <date it
// was made>" and emit a dateModified earlier than datePublished (invalid). Floor
// the effective updated date at the publish date so both stay accurate.
const rawUpdatedAt = parseDbDate(prompt.updatedAt ?? prompt.date);
const updatedAt = rawUpdatedAt < publishedAt ? publishedAt : rawUpdatedAt;
// The visible meta date is the last-updated date (freshness signal for readers
// and search engines); datePublished is still emitted in the structured data.
const dateLabel = updatedAt.toLocaleDateString('en-US', {
	month: 'short',
	day: 'numeric',
	year: 'numeric',
});
const mins = readTime(prompt);

// Use the gallery as og:image when present, otherwise the cover. When the
// prompt has no image at all, fall back to the dynamically-generated branded
// OG card so social shares don't default to /og-default.png.
const hasHeroImage = (prompt.images && prompt.images.length > 0) || !!prompt.coverImage;
const heroImage =
	(prompt.images && prompt.images.length > 0 ? prompt.images[0] : prompt.coverImage) ??
	`/og/${prompt.slug}.svg`;

// Prefer the real creator name (from createdBy join) over the static author
// string for E-E-A-T signal; fall back to the author string. (authorProfile is
// resolved in the parallel batch above.)
const authorName =
	authorProfile?.name ||
	(prompt as unknown as { createdByName?: string }).createdByName ||
	prompt.author;
const authorHref = authorProfile?.username ? `/author/${authorProfile.username}` : null;

// Engagement counters become InteractionCounter entries so Google can use
// them as an entity-popularity signal and AI engines can cite usage stats.
const interactionStatistic = [
	likeCount > 0 && {
		'@type': 'InteractionCounter',
		interactionType: 'https://schema.org/LikeAction',
		userInteractionCount: likeCount,
	},
	saveCount > 0 && {
		'@type': 'InteractionCounter',
		interactionType: 'https://schema.org/BookmarkAction',
		userInteractionCount: saveCount,
	},
	shareCount > 0 && {
		'@type': 'InteractionCounter',
		interactionType: 'https://schema.org/ShareAction',
		userInteractionCount: shareCount,
	},
].filter(Boolean);

const promptSchema: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: prompt.title,
	headline: prompt.title,
	description: prompt.description,
	datePublished: publishedAt.toISOString(),
	dateModified: updatedAt.toISOString(),
	author: {
		'@type': 'Person',
		name: authorName,
		...(authorHref ? { url: new URL(authorHref, Astro.site).href } : {}),
	},
	keywords: prompt.tags.join(', '),
	about: category?.name,
	url: new URL(`/${prompt.slug}`, Astro.site).href,
	inLanguage: 'en',
	isAccessibleForFree: true,
	text: prompt.promptText,
	...(prompt.images && prompt.images.length > 0
		? { image: prompt.images }
		: prompt.coverImage
			? { image: prompt.coverImage }
			: {}),
	...(interactionStatistic.length > 0 ? { interactionStatistic } : {}),
};

const breadcrumb = breadcrumbSchema([
	{ name: 'Home', path: '/' },
	...(category ? [{ name: category.name, path: `/category/${category.slug}` }] : []),
	{ name: prompt.title, path: `/${prompt.slug}` },
]);

// Visible H1 is derived from the slug; render it sentence-case (capitalise the
// first letter, keep the rest lowercase) rather than all-lowercase.
const slugWords = prompt.slug.replace(/-/g, ' ');
const heading = slugWords.charAt(0).toUpperCase() + slugWords.slice(1);
---

<Layout
	title={`${prompt.title} — Free Prompt Base`}
	description={prompt.description}
	schema={promptSchema}
	extraSchemas={[breadcrumb]}
	ogType="article"
	ogImage={heroImage}
	preloadImage={hasHeroImage ? heroImage : undefined}
	preloadImageSrcset={hasHeroImage ? cfSrcset(heroImage, [480, 768, 1080]) : undefined}
	preloadImageSizes="(min-width: 1024px) 700px, 92vw"
>
	<Header />
	<main class="flex-grow site-main py-8 sm:py-12">
		<!-- Breadcrumb — shares the page container's left edge with the H1 below,
		     so they align. Colour comes from the home glyph + the category pill. -->
		<Breadcrumb
			class="mb-5"
			items={[
				{ label: 'Home', href: '/' },
				...(category ? [{ label: category.name, href: `/category/${category.slug}` }] : []),
				{ label: prompt.title },
			]}
		/>

		<!-- Heading (full width, line-length capped for readability).
		     The slug is the visible H1; the real title is kept in the DOM but
		     visually hidden so SEO/schema and assistive tech still see it. The
		     description is intentionally not rendered on the frontend. -->
		<header class="mb-8 max-w-3xl">
			<h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-text-primary leading-[1.15]">
				{heading}
			</h1>
			<span class="sr-only">{prompt.title}</span>
		</header>

		<!-- Phone hint: plain, non-clickable text nudging readers to scroll down to
		     the copyable prompt (which sits below the cover image on small screens).
		     Deliberately NOT a jump link — we want readers to scroll past the page
		     content rather than skip straight to the prompt. Hidden on lg, where the
		     prompt already sits near the top of the right column. The chevron gently
		     bobs to draw the eye downward. -->
		<p class="lg:hidden -mt-4 mb-8 flex items-center gap-1.5 text-sm font-medium text-text-primary">
			Scroll down to copy the prompt
			<svg class="jump-chevron h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<polyline points="6 9 12 15 18 9" />
			</svg>
		</p>

		<!-- Two-column body: image left (sticky viewport), prompt content right.
		     Grid items default to align-items: stretch — the aside stretches to
		     the row's height (= taller column), giving the inner sticky wrapper
		     room to slide while the right column scrolls. -->
		<div class="grid grid-cols-1 lg:grid-cols-[1fr_1.1fr] gap-8 lg:gap-10">
			<!-- LEFT: image / gallery / placeholder. The <aside> stretches to fill
			     its grid cell (no align-self), and the inner wrapper is sticky.
			     This is the layout that actually pins the image while the right
			     column scrolls — applying sticky directly to a self-start grid
			     item does NOT work consistently across browsers. -->
			<aside>
				<div class="lg:sticky lg:top-24">
				{
					(prompt.images?.length ?? 0) > 1 ? (
						<div class="relative group lg:h-[calc(100dvh-7rem)] lg:min-h-[360px] lg:max-h-[760px] lg:overflow-hidden lg:rounded-base lg:bg-gray-50" data-carousel data-total={prompt.images!.length}>
							<div
								class="flex items-start gap-3 overflow-x-auto snap-x snap-proximity pb-3 scroll-smooth no-scrollbar lg:h-full lg:items-stretch lg:pb-0"
								data-carousel-track
							>
								{prompt.images!.map((src, i) => (
									<img
										src={cfImg(src, 1080)}
										srcset={cfSrcset(src, [480, 768, 1080])}
										sizes="(min-width: 1024px) 700px, 92vw"
										alt={`${prompt.title} — image ${i + 1}`}
										width={i === 0 ? prompt.coverW : undefined}
										height={i === 0 ? prompt.coverH : undefined}
										style={prompt.coverW && prompt.coverH ? `aspect-ratio:${prompt.coverW}/${prompt.coverH}` : undefined}
										class="snap-center shrink-0 w-full rounded-base object-contain lg:h-full lg:rounded-none"
										loading={i === 0 ? 'eager' : 'lazy'}
										fetchpriority={i === 0 ? 'high' : undefined}
										decoding="async"
									/>
								))}
							</div>

							<!-- Prev / next buttons (hidden at the ends via JS) -->
							<button
								type="button"
								data-carousel-prev
								aria-label="Previous image"
								class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/90 shadow-md flex items-center justify-center text-text-primary hover:bg-white transition-opacity opacity-80 group-hover:opacity-100 focus-visible:opacity-100 disabled:opacity-0 disabled:pointer-events-none"
							>
								<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<polyline points="15 18 9 12 15 6"/>
								</svg>
							</button>
							<button
								type="button"
								data-carousel-next
								aria-label="Next image"
								class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/90 shadow-md flex items-center justify-center text-text-primary hover:bg-white transition-opacity opacity-80 group-hover:opacity-100 focus-visible:opacity-100 disabled:opacity-0 disabled:pointer-events-none"
							>
								<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<polyline points="9 18 15 12 9 6"/>
								</svg>
							</button>

							<!-- Slide counter / dot indicator -->
							<div class="absolute bottom-5 left-1/2 -translate-x-1/2 flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-black/60 text-white text-[11px] font-semibold tabular-nums">
								<span data-carousel-index>1</span>
								<span class="opacity-60">/</span>
								<span>{prompt.images!.length}</span>
							</div>
						</div>
					) : prompt.coverImage ? (
						<img
							src={cfImg(prompt.coverImage, 1080)}
							srcset={cfSrcset(prompt.coverImage, [480, 768, 1080])}
							sizes="(min-width: 1024px) 700px, 92vw"
							alt={prompt.title}
							width={prompt.coverW}
							height={prompt.coverH}
							class="w-full rounded-base object-contain h-auto lg:h-[calc(100dvh-7rem)] lg:min-h-[360px] lg:max-h-[760px] lg:bg-gray-50"
							loading="eager"
							fetchpriority="high"
							decoding="async"
						/>
					) : (
						<div class="w-full aspect-[4/5] rounded-base bg-gray-50 border border-gray-200 flex flex-col items-center justify-center gap-3 text-gray-400 lg:h-[calc(100dvh-7rem)] lg:min-h-[360px] lg:max-h-[760px] lg:aspect-auto">
							{category ? (
								<CategoryIcon slug={category.slug} class="w-16 h-16" />
							) : (
								<svg class="w-16 h-16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
								</svg>
							)}
							<p class="text-xs font-medium uppercase tracking-wide text-gray-500">
								{category ? `${category.name} prompt` : 'Text prompt'}
							</p>
						</div>
					)
				}
				</div>
			</aside>

			<!-- RIGHT: meta, actions, prompt body, how-to-use, tags -->
			<div class="min-w-0" data-prompt-detail={prompt.slug}>

		<!-- Meta strip -->
		<div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-gray-600 mb-5">
			{
				category && (
					<a
						href={`/category/${category.slug}`}
						class="inline-flex items-center gap-1.5 text-text-primary hover:text-secondary font-semibold transition-colors"
					>
						<CategoryIcon slug={category.slug} class="w-3.5 h-3.5" />
						{category.name}
					</a>
				)
			}
			<span class="inline-flex items-center gap-1.5">
				<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
				Updated <time datetime={updatedAt.toISOString()}>{dateLabel}</time>
			</span>
			<span class="inline-flex items-center gap-1.5">
				<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
				{mins} min read
			</span>
			{/* Always rendered (even at 0) so recordView() can reveal + update it
			    from the server's authoritative count — the SSR number can be stale
			    when this page is served from the CDN cache. Hidden at 0 to match the
			    prior look until the first view lands. */}
			<span
				class="inline-flex items-center gap-1.5"
				data-view-count
				hidden={(prompt.viewCount ?? 0) === 0}
			>
				<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
				<span data-view-count-text>{(prompt.viewCount ?? 0).toLocaleString()} {(prompt.viewCount ?? 0) === 1 ? 'view' : 'views'}</span>
			</span>
			<span class="inline-flex items-center gap-1.5">
				<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
				by {authorHref ? (
					<a href={authorHref} class="text-text-primary font-medium hover:text-secondary transition-colors">{authorName}</a>
				) : (
					<span class="text-text-primary font-medium">{authorName}</span>
				)}
			</span>
		</div>

		<!-- Like + save + share row -->
		<div class="flex flex-wrap items-center gap-2 mb-6">
			<button
				type="button"
				data-like
				data-slug={prompt.slug}
				data-liked={isLiked ? 'true' : 'false'}
				aria-pressed={isLiked ? 'true' : 'false'}
				class:list={[
					'detail-like-btn inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold border transition-colors',
					isLiked
						? 'bg-rose-50 text-rose-600 border-rose-200'
						: 'bg-white text-text-primary border-gray-200 hover:border-rose-400 hover:text-rose-500',
				]}
			>
				<svg
					class="like-icon w-4 h-4"
					viewBox="0 0 24 24"
					fill={isLiked ? 'currentColor' : 'none'}
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
				</svg>
				<span data-like-label>{isLiked ? 'Liked' : 'Like'}</span>
				<span class="tabular-nums opacity-70 font-normal" data-like-count-text data-raw={likeCount}>
					{likeCount}
				</span>
			</button>

			<button
				type="button"
				data-save
				data-slug={prompt.slug}
				data-saved={isSaved ? 'true' : 'false'}
				aria-pressed={isSaved ? 'true' : 'false'}
				aria-label={isSaved ? 'Remove from saved' : 'Save prompt'}
				class:list={[
					'detail-save-btn inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold border transition-colors',
					isSaved
						? 'bg-primary text-link border-primary'
						: 'bg-white text-text-primary border-gray-200 hover:border-text-primary hover:text-secondary',
				]}
			>
				<svg
					class="save-icon w-4 h-4"
					viewBox="0 0 24 24"
					fill={isSaved ? 'currentColor' : 'none'}
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
				</svg>
				<span data-save-label>{isSaved ? 'Saved' : 'Save'}</span>
				<span class="tabular-nums opacity-70 font-normal" data-save-count>{saveCount}</span>
			</button>

			<button
				type="button"
				data-share
				data-slug={prompt.slug}
				data-title={prompt.title}
				class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold bg-white text-text-primary border border-gray-200 hover:border-text-primary hover:text-secondary transition-colors"
			>
				<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
					<line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
				</svg>
				<span>Share</span>
				{shareCount > 0 && <span class="tabular-nums opacity-70 font-normal">{shareCount}</span>}
			</button>
		</div>

		<!-- The prompt + copy (scroll target for the phone hint under the title).
		     No gate here — the AdSense Offerwall handles monetized gating at
		     page level, so copying stays one click. -->
		<div id="the-prompt" class="scroll-mt-24">
			<CopyPromptButton text={prompt.promptText} slug={prompt.slug} />
			<OpenInTools text={prompt.promptText} />
		</div>

		<!-- How to use (tip card) -->
		{
			prompt.howToUse && (
				<aside class="mt-8 flex gap-3 sm:gap-4 bg-amber-50/60 border border-amber-200/60 rounded-base p-4 sm:p-5">
					<svg class="w-5 h-5 text-amber-700 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.74V17a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-2.26A7 7 0 0 0 12 2z"/>
					</svg>
					<div class="min-w-0">
						<h2 class="text-sm font-semibold text-amber-900 mb-1">How to use it</h2>
						<p class="text-sm text-amber-900/80 leading-relaxed whitespace-pre-wrap">{prompt.howToUse}</p>
					</div>
				</aside>
			)
		}

		<!-- Tags -->
		{
			prompt.tags.length > 0 && (
				<section class="mt-10 pt-6 border-t border-gray-200">
					<h3 class="text-xs font-semibold uppercase tracking-wide text-gray-600 mb-3">Tags</h3>
					<div class="flex flex-wrap gap-1.5">
						{prompt.tags.map((tag) => (
							<a href={tagHref(tag)} class={`pill ${pillColor(tag)} hover:opacity-80 transition-opacity`}>#{tag}</a>
						))}
					</div>
				</section>
			)
		}

			</div><!-- /right column -->
		</div><!-- /two-column grid -->

		<AdSlot placement="prompt-above-related" />

		<script>
			import { wireSave, wireShare, wireLike, recordView } from '../scripts/social';
			wireSave();
			wireShare();
			wireLike();
			recordView();

			// Image carousel: prev/next buttons + live counter, driven by the
			// snap-scroll container's scrollLeft. Buttons disable at the ends.
			// Listens to scroll so counter updates from arrow clicks, drag, or
			// keyboard scrolling alike.
			document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
				if (root.dataset.wired === '1') return;
				root.dataset.wired = '1';
				const track = root.querySelector<HTMLElement>('[data-carousel-track]');
				const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
				const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
				const counter = root.querySelector<HTMLElement>('[data-carousel-index]');
				const total = Number(root.dataset.total ?? 0);
				if (!track || !prev || !next || !counter || total < 2) return;

				function slideWidth() {
					const first = track!.querySelector('img');
					return first ? first.getBoundingClientRect().width + 12 /* gap-3 */ : track!.clientWidth;
				}

				function update() {
					const idx = Math.round(track!.scrollLeft / slideWidth());
					const clamped = Math.min(Math.max(idx, 0), total - 1);
					counter!.textContent = String(clamped + 1);
					prev!.disabled = clamped === 0;
					next!.disabled = clamped === total - 1;
				}

				prev.addEventListener('click', () => {
					track!.scrollBy({ left: -slideWidth(), behavior: 'smooth' });
				});
				next.addEventListener('click', () => {
					track!.scrollBy({ left: slideWidth(), behavior: 'smooth' });
				});
				track.addEventListener('scroll', () => {
					// Debounce via rAF so we don't thrash on momentum scroll.
					if ((track as any)._raf) return;
					(track as any)._raf = requestAnimationFrame(() => {
						(track as any)._raf = null;
						update();
					});
				}, { passive: true });
				update();
			});
		</script>

		<style>
			.no-scrollbar { scrollbar-width: none; -ms-overflow-style: none; }
			.no-scrollbar::-webkit-scrollbar { display: none; }
		</style>

		<!-- Related -->
		{
			related.length > 0 && (
				<section class="mt-16 pt-10 border-t border-gray-200">
					<header class="mb-6">
						<p class="text-xs font-semibold uppercase tracking-wide text-gray-600">More like this</p>
						<h2 class="text-2xl font-bold text-text-primary mt-1">Related prompts</h2>
						{
							relatedCategoryPills.length > 0 && (
								<div class="mt-3 flex flex-wrap items-center gap-2">
									{relatedCategoryPills.map((c) => (
										<a href={`/category/${c.slug}`} class={`pill ${pillColor(c.slug)}`}>
											<CategoryIcon slug={c.slug} class="w-3 h-3" />
											{c.name}
										</a>
									))}
								</div>
							)
						}
					</header>
					<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
						{related.map((rel) => (
							<PromptCard prompt={rel} category={categoryBySlug.get(rel.category)} isPotd={rel.slug === potdSlug} />
						))}
					</div>
				</section>
			)
		}
	</main>
	<Footer />
</Layout>
