---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from './Breadcrumb.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import PromptGrid from './PromptGrid.astro';
import AdSlot from './AdSlot.astro';
import { splitAtNthH2 } from '../lib/ads';
import { getAllCategories, getAllTags, getPromptsByTag } from '../lib/prompts';
import type { Tag } from '../lib/prompts';
import { getTagArticle } from '../lib/tagArticles';
import { itemListSchema, breadcrumbSchema } from '../lib/seo';
import { cfSrcset, cfImg } from '../lib/cfImage';
import { pillColor } from '../lib/pills';
import { isTagIndexable, TAG_HUB_SLUG_SET, TAG_NOINDEX_SLUGS } from '../data/tag-seo';

// Keyword landing page, served at the ROOT URL /<main-keyword>. Compact answer
// ATF → prompt grid → editorial guide + FAQ. Used by the root [slug] route.
interface Props {
	tag: Tag;
}
const { tag } = Astro.props;

const [{ prompts, matched }, categories] = await Promise.all([
	getPromptsByTag(tag),
	getAllCategories(),
]);

const related = getAllTags()
	.filter((t) => t.slug !== tag.slug && isTagIndexable(t.slug) && TAG_HUB_SLUG_SET.has(t.slug))
	.slice(0, 14);

const name = tag.name;
const lower = name.toLowerCase();
const q = tag.query;
const blob = `${tag.query} ${tag.matchTerms.join(' ')}`.toLowerCase();
const isImage = /photo|image|foto|edit|caricature|portrait|retro|pic|art|banana|holi/.test(blob);

function plural(s: string): string {
	if (/prompts$/.test(s)) return s;
	if (/prompt$/.test(s)) return `${s}s`;
	if (/\bprompt\b/.test(s) || /s$/.test(s)) return s;
	return `${s} prompts`;
}
const lowerPl = plural(lower);

// Plain H1 = primary keyword (no templated marketing tails).
const heading = name;
const lead = isImage
	? `Free ${lowerPl} you can copy in one tap. Paste into Gemini or ChatGPT, add your own photo, and create something worth sharing.`
	: `Free, ready-to-use ${lowerPl}. Copy one, paste it into your favourite AI tool, and get to work.`;

const article = getTagArticle(tag.slug);
const bodyHtml =
	article?.bodyHtml ??
	`<p>Every ${lowerPl.replace(/\b\w/, (c) => c)} on this page is free to copy. Pick one above, paste it into Gemini, ChatGPT, or your image app, then swap in your own details.</p>`;
const faqs =
	article?.faqs ?? [
		{
			q: `Are these ${lowerPl} free?`,
			a: `Yes. Every prompt here is free and there is no signup. Copy any prompt and use it as often as you like.`,
		},
	];

function plainExcerpt(html: string, maxWords = 90): string {
	const text = html
		.replace(/<script[\s\S]*?<\/script>/gi, ' ')
		.replace(/<style[\s\S]*?<\/style>/gi, ' ')
		.replace(/<[^>]+>/g, ' ')
		.replace(/\s+/g, ' ')
		.trim();
	const words = text.split(' ').filter(Boolean);
	if (words.length <= maxWords) return text;
	return `${words.slice(0, maxWords).join(' ')}…`;
}
const atfAnswer = plainExcerpt(bodyHtml, 85);

const articleParts = splitAtNthH2(bodyHtml, 3);

const title = `${name} — Free Prompts to Copy & Paste | Free Prompt Base`;
const description = article?.metaDescription ?? tag.description;
const indexable = isTagIndexable(tag.slug);
const noindexTag = TAG_NOINDEX_SLUGS.has(tag.slug);

const list = itemListSchema(
	prompts.slice(0, 30).map((p) => ({ name: p.title, url: `/${p.slug}` })),
	`${name} prompts`,
);
const crumb = breadcrumbSchema([
	{ name: 'Home', path: '/' },
	{ name, path: `/${tag.slug}` },
]);
const collectionPage = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	'@id': `https://freepromptbase.com/${tag.slug}#webpage`,
	name: title,
	url: `https://freepromptbase.com/${tag.slug}`,
	description,
	isPartOf: { '@id': 'https://freepromptbase.com/#website' },
	about: { '@type': 'Thing', name },
	mainEntity: {
		'@type': 'ItemList',
		name: `${name} prompts`,
		numberOfItems: Math.min(prompts.length, 30),
		itemListElement: prompts.slice(0, 30).map((p, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			name: p.title,
			url: `https://freepromptbase.com/${p.slug}`,
		})),
	},
};
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};
const extraSchemas = indexable
	? [collectionPage, list, crumb, ...(TAG_HUB_SLUG_SET.has(tag.slug) ? [faqSchema] : [])]
	: [crumb];
const firstCover = prompts[0]?.coverImage;
---

<Layout
	title={title}
	description={description}
	extraSchemas={extraSchemas}
	robots={noindexTag ? 'noindex, follow' : undefined}
	preloadImage={firstCover ? cfImg(firstCover, 400, 68) : undefined}
	preloadImageSrcset={firstCover ? cfSrcset(firstCover, [300, 400, 520, 660], 68) : undefined}
	preloadImageSizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 92vw"
>
	<Header />
	<main class="flex-grow site-main py-10">
		<Breadcrumb
		class="mb-5"
		items={[
			{ label: 'Home', href: '/' },
			{ label: name },
		]}
	/>

		<header class="mb-6 max-w-3xl">
			<p class="text-xs font-semibold uppercase tracking-[0.18em] text-secondary mb-3">AI prompt library</p>
			<h1 class="text-3xl md:text-4xl font-bold tracking-tight text-text-primary leading-[1.15]">
				{heading}
			</h1>
			<p class="text-gray-600 text-lg mt-3">{lead}</p>
			<p class="text-sm text-gray-600 mt-2">
				{prompts.length} {prompts.length === 1 ? 'prompt' : 'prompts'} · free · no signup
			</p>
		</header>

		<!-- Compact answer + steps above the fold / before the long grid. -->
		<section class="mb-8 max-w-3xl rounded-base border border-gray-200 bg-soft/40 p-4 sm:p-5">
			<p class="text-base text-text-primary leading-relaxed">
				<strong>{atfAnswer}</strong>
			</p>
			<ol class="mt-4 space-y-1.5 text-sm text-gray-700 list-decimal list-inside">
				<li>Open a prompt card below and tap <strong>Copy</strong>.</li>
				<li>Paste into Gemini, ChatGPT, or your image app.</li>
				<li>{isImage ? 'Upload your photo and keep the face-preserve line.' : 'Swap in your details where the prompt asks.'}</li>
				<li>Generate, tweak one detail, and save what works.</li>
			</ol>
			<a href="#prompt-grid" class="btn-primary inline-flex mt-4 text-sm">
				Browse {prompts.length} free prompts
			</a>
		</section>

		<div id="prompt-grid">
		{
			prompts.length > 0 ? (
				<PromptGrid prompts={prompts} categories={categories} adPositions={[12]} />
			) : (
				<p class="text-center text-gray-500 py-16">No prompts here yet. Check back soon!</p>
			)
		}
		</div>

		{
			!matched && prompts.length > 0 && (
				<p class="text-sm text-gray-500 mt-6">
					Showing popular prompts you can adapt for “{q}”.
				</p>
			)
		}

		<section class="mt-16 pt-12 border-t border-gray-200 max-w-3xl">
			<p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.16em] text-secondary mb-3">
				<span class="h-1.5 w-1.5 rounded-full bg-secondary"></span>
				The guide
			</p>
			<h2 class="text-2xl md:text-3xl font-bold tracking-tight text-text-primary leading-tight mb-7">
				How to use {lowerPl}
			</h2>

			<div class="kw-article">
				{
					articleParts ? (
						<>
							<Fragment set:html={articleParts[0]} />
							<AdSlot placement="tag-article-mid" />
							<Fragment set:html={articleParts[1]} />
						</>
					) : (
						<Fragment set:html={bodyHtml} />
					)
				}
			</div>

			{
				indexable && (
					<div class="mt-16 pt-12 border-t border-gray-200">
						<p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.16em] text-secondary mb-3">
							<span class="h-1.5 w-1.5 rounded-full bg-secondary"></span>
							Questions
						</p>
						<h2 class="text-2xl font-bold tracking-tight text-text-primary mb-6">
							Frequently asked questions
						</h2>
						<div class="divide-y divide-gray-200 border-t border-gray-200">
							{faqs.map((f, i) => (
								<details class="group py-1" open={i === 0 && TAG_HUB_SLUG_SET.has(tag.slug)}>
									<summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-semibold text-text-primary hover:text-secondary transition-colors">
										<h3 class="m-0 text-base font-semibold">{f.q}</h3>
										<svg class="w-5 h-5 shrink-0 text-gray-400 transition-transform duration-200 group-open:rotate-180 group-open:text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
											<polyline points="6 9 12 15 18 9" />
										</svg>
									</summary>
									<p class="text-gray-700 leading-relaxed pb-4 -mt-1 max-w-[68ch]"><strong>{f.a}</strong></p>
								</details>
							))}
						</div>
					</div>
				)
			}
		</section>

		{indexable && <AdSlot placement="tag-after-faq" />}

		{
			related.length > 0 && (
				<section class="mt-16 pt-12 border-t border-gray-200">
					<h2 class="text-xl font-bold tracking-tight text-text-primary mb-4">Related searches</h2>
					<div class="flex flex-wrap gap-2">
						{related.map((t) => (
							<a href={`/${t.slug}`} class={`pill ${pillColor(t.slug)}`}>
								{t.name}
							</a>
						))}
					</div>
				</section>
			)
		}
	</main>
	<Footer />
</Layout>

<style is:global>
	/* Keyword article body. Uses the site's own sans typography (inherited system sans)
	   so it reads consistently with the prompt cards and the rest of the page —
	   no separate blog font or boxed background. */
	.kw-article {
		color: var(--color-text-primary);
		font-size: 1.0625rem;
		line-height: 1.75;
		max-width: 68ch; /* cap the reading measure (impeccable: 65-75ch) */
	}
	.kw-article > :first-child {
		margin-top: 0;
	}
	/* Lead paragraph — a touch larger to open the article with rhythm. */
	.kw-article > p:first-of-type {
		font-size: 1.15rem;
		line-height: 1.7;
		color: var(--color-text-primary);
	}
	/* In-prose links — readable dark text with a yellow underline accent. */
	.kw-article a {
		color: var(--color-text-primary);
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
		text-decoration-thickness: 2px;
		text-underline-offset: 2px;
		transition: text-decoration-color 150ms ease;
	}
	.kw-article a:hover {
		text-decoration-color: var(--color-text-primary);
	}
	.kw-article h2 {
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: -0.015em;
		line-height: 1.2;
		margin-top: 2.75rem;
		margin-bottom: 0.85rem;
		padding-bottom: 0.55rem;
		color: var(--color-text-primary, #1f2937);
		position: relative;
	}
	/* Short gold underline accent under every section heading. */
	.kw-article h2::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
		width: 2.25rem;
		height: 3px;
		border-radius: 2px;
		background: var(--color-secondary);
	}
	.kw-article h3 {
		font-size: 1.25rem;
		font-weight: 700;
		line-height: 1.3;
		margin-top: 2.1rem;
		margin-bottom: 0.45rem;
		color: var(--color-link, #181830);
	}
	.kw-article p {
		margin: 1.1rem 0;
	}
	.kw-article ul,
	.kw-article ol {
		margin: 1rem 0;
		padding-left: 1.4rem;
	}
	.kw-article ul {
		list-style: disc;
	}
	.kw-article ol {
		list-style: decimal;
	}
	.kw-article li {
		margin: 0.35rem 0;
	}
	.kw-article li::marker {
		color: var(--color-secondary);
	}
	.kw-article strong {
		font-weight: 700;
		color: #111827;
	}
	/* Pull-quote: warm tinted panel, no side stripe. A leading gold quote mark. */
	.kw-article blockquote {
		position: relative;
		margin: 2rem 0;
		padding: 1.1rem 1.25rem 1.1rem 2.6rem;
		background: var(--color-soft);
		border: 1px solid oklch(0.88 0.07 96);
		border-radius: var(--radius-base);
		color: var(--color-text-primary);
		font-style: italic;
	}
	.kw-article blockquote::before {
		content: '\201C';
		position: absolute;
		left: 0.7rem;
		top: 0.35rem;
		font-size: 2rem;
		line-height: 1;
		font-style: normal;
		color: var(--color-secondary);
	}
	.kw-article blockquote p {
		margin: 0;
	}
	/* Table: warm header wash, rounded outer frame, zebra rows. */
	.kw-article table {
		width: 100%;
		border-collapse: separate;
		border-spacing: 0;
		margin: 1.85rem 0;
		font-size: 0.95rem;
		line-height: 1.5;
		border: 1px solid var(--color-outline, #e7e1d4);
		border-radius: var(--radius-base);
		overflow: hidden;
	}
	.kw-article thead th {
		background: var(--color-soft);
		text-align: left;
		font-weight: 700;
		color: var(--color-text-primary);
	}
	.kw-article th,
	.kw-article td {
		padding: 0.65rem 0.85rem;
		vertical-align: top;
		border-bottom: 1px solid var(--hairline, #e7e1d4);
	}
	.kw-article th:not(:last-child),
	.kw-article td:not(:last-child) {
		border-right: 1px solid var(--hairline, #e7e1d4);
	}
	.kw-article tbody tr:last-child td {
		border-bottom: 0;
	}
	.kw-article tbody tr:nth-child(even) {
		background: var(--paper-sunken, #f7f3ea);
	}
</style>
