---
interface Props {
	/** The prompt text to display and copy. */
	text: string;
	/** Optional label override. */
	label?: string;
	/** Prompt slug — when set, successful copies are tracked via the copy API. */
	slug?: string;
	/**
	 * Rewarded-ad copy gate: the first Copy click on a page view releases the
	 * AdSense Offerwall (held back by Layout's controlledMessagingFunction) and
	 * copies once the visitor finishes the ad. Fails open — if the Offerwall
	 * doesn't appear (no inventory, ad blocker, script blocked), copy proceeds.
	 * Requires the page to be rendered with Layout's `copyGate` prop.
	 */
	adGate?: boolean;
}

const { text, label = 'The prompt', slug, adGate = false } = Astro.props;

// Stats shown in the header bar
const wordCount = text.trim().split(/\s+/).filter(Boolean).length;
const charCount = text.length;
---

<!-- The prompt is fully visible; monetization happens on the Copy click via
     the AdSense Offerwall (promptplum-style rewarded unlock, see adGate). -->
<section
	class="prompt-card rounded-base border border-gray-200 bg-white overflow-hidden"
	data-copy-root
	data-copy-slug={slug}
	data-ad-gate={adGate ? '' : undefined}
>
	<!-- Header bar -->
	<header class="flex items-center justify-between gap-3 px-4 sm:px-5 py-3 border-b border-gray-200 bg-soft">
		<div class="flex items-center gap-3 min-w-0">
			<h2 class="text-xs font-semibold uppercase tracking-wide text-text-primary m-0">{label}</h2>
			<span class="hidden sm:flex items-center gap-2 text-xs text-gray-500">
				<span>{wordCount} {wordCount === 1 ? 'word' : 'words'}</span>
				<span aria-hidden="true">·</span>
				<span>{charCount} chars</span>
			</span>
		</div>
		<button
			type="button"
			class="copy-btn btn-feedback btn-primary btn-sm inline-flex items-center gap-2"
			data-copy-btn
			aria-live="polite"
		>
			<svg class="copy-icon-copy w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
					d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
			</svg>
			<svg class="copy-icon-done hidden w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
				<polyline stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" points="20 6 9 17 4 12" />
			</svg>
			<svg class="copy-icon-spin hidden w-4 h-4 animate-spin" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
				<path stroke-linecap="round" d="M21 12a9 9 0 1 1-6.219-8.56" />
			</svg>
			<span class="copy-label">Copy</span>
		</button>
	</header>

	<!-- Prompt body — dark, monospace, scrollable -->
	<pre class="prompt-box px-4 sm:px-5 py-4 sm:py-5 m-0 overflow-x-auto rounded-none border-0" data-copy-text>{text}</pre>
</section>

<script>
	function initCopy(root: HTMLElement) {
		const btn = root.querySelector<HTMLButtonElement>('[data-copy-btn]');
		const source = root.querySelector<HTMLElement>('[data-copy-text]');
		const label = root.querySelector<HTMLElement>('.copy-label');
		const iconCopy = root.querySelector<SVGElement>('.copy-icon-copy');
		const iconDone = root.querySelector<SVGElement>('.copy-icon-done');
		const iconSpin = root.querySelector<SVGElement>('.copy-icon-spin');
		if (!btn || !source || !label) return;

		const text = source.textContent ?? '';
		const slug = root.dataset.copySlug;
		let resetTimer: ReturnType<typeof setTimeout> | undefined;

		// --- Rewarded-ad gate ------------------------------------------------
		// One unlock per page view: the first Copy click releases the Offerwall
		// that Layout's controlledMessagingFunction is holding, then waits for
		// the visitor to finish the ad. Every guard fails OPEN (copy proceeds)
		// so ad blockers, no-fill, or API changes can never lock the button.
		let unlocked = !root.hasAttribute('data-ad-gate');
		let unlocking = false;

		// The Offerwall (and any other privacy message) renders in an fc-* root
		// container. "Visible" = it has actual layout, not just DOM presence.
		function wallVisible(): boolean {
			const nodes = document.querySelectorAll<HTMLElement>(
				'.fc-message-root, .fc-consent-root, [class*="fc-monetization"], iframe[src*="fundingchoicesmessages.google.com"]',
			);
			for (const el of nodes) {
				const r = el.getBoundingClientRect();
				if (r.width > 4 && r.height > 4) return true;
			}
			return false;
		}

		function waitFor(cond: () => boolean, timeoutMs: number): Promise<boolean> {
			return new Promise((resolve) => {
				if (cond()) return resolve(true);
				const t0 = Date.now();
				const iv = setInterval(() => {
					if (cond()) {
						clearInterval(iv);
						resolve(true);
					} else if (Date.now() - t0 > timeoutMs) {
						clearInterval(iv);
						resolve(false);
					}
				}, 250);
			});
		}

		function setAdLoading(on: boolean) {
			btn!.disabled = on;
			label!.textContent = on ? 'Loading ad…' : 'Copy';
			iconCopy?.classList.toggle('hidden', on);
			iconSpin?.classList.toggle('hidden', !on);
		}

		async function unlock(): Promise<void> {
			if (unlocked || unlocking) return;
			unlocking = true;
			setAdLoading(true);
			try {
				const w = window as any;
				// The messaging library may not have called our hold function yet
				// on a very fast click — give it a moment before failing open.
				if (typeof w.__fpbReleaseOfferwall !== 'function') {
					await waitFor(() => typeof w.__fpbReleaseOfferwall === 'function', 1500);
				}
				const release = w.__fpbReleaseOfferwall;
				if (typeof release === 'function') {
					w.__fpbReleaseOfferwall = undefined;
					try {
						release();
					} catch {
						/* fail open */
					}
					// No inventory / blocked → the wall never appears; move on.
					const appeared = await waitFor(wallVisible, 4000);
					if (appeared) {
						// The Offerwall owns the screen until the ad is done.
						await waitFor(() => !wallVisible(), 600000);
					}
				}
			} finally {
				unlocked = true;
				unlocking = false;
				setAdLoading(false);
			}
		}
		// ---------------------------------------------------------------------

		// Fire-and-forget copy tracking; must never affect the copy UX.
		function trackCopy() {
			if (!slug) return;
			try {
				fetch(`/api/prompts/${encodeURIComponent(slug)}/copy`, {
					method: 'POST',
					keepalive: true,
				}).catch(() => {});
			} catch {
				// ignore
			}
		}

		function showCopied(ok: boolean) {
			label!.textContent = ok ? 'Copied!' : 'Press Ctrl/⌘+C';
			if (ok) {
				iconCopy?.classList.add('hidden');
				iconDone?.classList.remove('hidden');
			}
			clearTimeout(resetTimer);
			resetTimer = setTimeout(() => {
				label!.textContent = 'Copy';
				iconDone?.classList.add('hidden');
				iconCopy?.classList.remove('hidden');
			}, 2000);
		}

		async function copy() {
			if (!unlocked) {
				if (unlocking) return;
				await unlock();
			}
			try {
				if (navigator.clipboard?.writeText) {
					await navigator.clipboard.writeText(text);
				} else {
					const ta = document.createElement('textarea');
					ta.value = text;
					ta.style.position = 'fixed';
					ta.style.opacity = '0';
					document.body.appendChild(ta);
					ta.select();
					document.execCommand('copy');
					document.body.removeChild(ta);
				}
				showCopied(true);
				trackCopy();
			} catch {
				showCopied(false);
			}
		}

		btn.addEventListener('click', copy);
	}

	document
		.querySelectorAll<HTMLElement>('[data-copy-root]')
		.forEach((root) => initCopy(root));
</script>
