---
interface Props {
	/** The prompt text to display and copy. */
	text: string;
	/** Optional label override. */
	label?: string;
}

const { text, label = 'The prompt' } = Astro.props;

// Stats shown in the header bar
const wordCount = text.trim().split(/\s+/).filter(Boolean).length;
const charCount = text.length;
---

<section class="prompt-card rounded-base border border-gray-200 bg-white overflow-hidden" data-copy-root>
	<!-- Header bar -->
	<header class="flex items-center justify-between gap-3 px-4 sm:px-5 py-3 border-b border-gray-200 bg-gray-50">
		<div class="flex items-center gap-3 min-w-0">
			<span class="text-xs font-semibold uppercase tracking-wide text-text-primary">{label}</span>
			<span class="hidden sm:flex items-center gap-2 text-xs text-gray-500">
				<span>{wordCount} {wordCount === 1 ? 'word' : 'words'}</span>
				<span aria-hidden="true">·</span>
				<span>{charCount} chars</span>
			</span>
		</div>
		<button
			type="button"
			class="copy-btn inline-flex items-center gap-2 bg-primary text-link px-3.5 py-1.5 rounded-md text-xs font-semibold hover:opacity-90 active:opacity-80 transition-opacity"
			data-copy-btn
			aria-live="polite"
		>
			<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
					d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
			</svg>
			<span class="copy-label">Copy</span>
		</button>
	</header>

	<!-- Prompt body — dark, monospace, scrollable -->
	<pre class="prompt-box px-4 sm:px-5 py-4 sm:py-5 m-0 overflow-x-auto rounded-none border-0" data-copy-text>{text}</pre>
</section>

<script>
	function initCopy(root: HTMLElement) {
		const btn = root.querySelector<HTMLButtonElement>('[data-copy-btn]');
		const source = root.querySelector<HTMLElement>('[data-copy-text]');
		const label = root.querySelector<HTMLElement>('.copy-label');
		if (!btn || !source || !label) return;

		const text = source.textContent ?? '';
		let resetTimer: ReturnType<typeof setTimeout> | undefined;

		async function copy() {
			try {
				if (navigator.clipboard?.writeText) {
					await navigator.clipboard.writeText(text);
				} else {
					const ta = document.createElement('textarea');
					ta.value = text;
					ta.style.position = 'fixed';
					ta.style.opacity = '0';
					document.body.appendChild(ta);
					ta.select();
					document.execCommand('copy');
					document.body.removeChild(ta);
				}
				label!.textContent = 'Copied!';
			} catch {
				label!.textContent = 'Press Ctrl/⌘+C';
			}
			clearTimeout(resetTimer);
			resetTimer = setTimeout(() => {
				label!.textContent = 'Copy';
			}, 2000);
		}

		btn.addEventListener('click', copy);
	}

	document
		.querySelectorAll<HTMLElement>('[data-copy-root]')
		.forEach((root) => initCopy(root));
</script>
