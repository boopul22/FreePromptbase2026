---
interface Props {
	/** The prompt text to display and copy. */
	text: string;
}

const { text } = Astro.props;
---

<div class="relative" data-copy-root>
	<div class="flex items-center justify-between mb-2">
		<span class="text-sm font-bold text-text-primary">The Prompt</span>
		<button
			type="button"
			class="copy-btn inline-flex items-center gap-2 bg-primary text-link px-4 py-2 rounded-lg text-sm font-bold hover:opacity-90 transition-opacity"
			data-copy-btn
			aria-live="polite"
		>
			<svg class="copy-icon w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
				></path>
			</svg>
			<span class="copy-label">Copy Prompt</span>
		</button>
	</div>

	<!-- The copyable text. The value lives in a data attribute so copy works even
	     if the displayed text is ever truncated/styled. -->
	<pre class="prompt-box p-5 overflow-x-auto" data-copy-text>{text}</pre>
</div>

<script>
	function initCopy(root: HTMLElement) {
		const btn = root.querySelector<HTMLButtonElement>('[data-copy-btn]');
		const source = root.querySelector<HTMLElement>('[data-copy-text]');
		const label = root.querySelector<HTMLElement>('.copy-label');
		if (!btn || !source || !label) return;

		const text = source.textContent ?? '';
		let resetTimer: ReturnType<typeof setTimeout> | undefined;

		async function copy() {
			try {
				if (navigator.clipboard?.writeText) {
					await navigator.clipboard.writeText(text);
				} else {
					// Fallback for older / insecure contexts.
					const ta = document.createElement('textarea');
					ta.value = text;
					ta.style.position = 'fixed';
					ta.style.opacity = '0';
					document.body.appendChild(ta);
					ta.select();
					document.execCommand('copy');
					document.body.removeChild(ta);
				}
				label!.textContent = 'Copied!';
			} catch {
				label!.textContent = 'Press Ctrl/⌘+C';
			}
			clearTimeout(resetTimer);
			resetTimer = setTimeout(() => {
				label!.textContent = 'Copy Prompt';
			}, 2000);
		}

		btn.addEventListener('click', copy);
	}

	document
		.querySelectorAll<HTMLElement>('[data-copy-root]')
		.forEach((root) => initCopy(root));
</script>
