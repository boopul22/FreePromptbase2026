---
interface Props {
	/** The prompt text to display and copy. */
	text: string;
	/** Optional label override. */
	label?: string;
	/** Prompt slug — when set, successful copies are tracked via the copy API. */
	slug?: string;
	/**
	 * Copy gate: the prompt renders half-revealed behind a blur veil and a tap
	 * reveals it (remembered per prompt for the session). Purely an engagement
	 * step — monetized gating is the AdSense Offerwall's job (Privacy &
	 * messaging), never a custom watch-an-ad requirement.
	 */
	gated?: boolean;
}

const { text, label = 'The prompt', slug, gated = false } = Astro.props;

// Stats shown in the header bar
const wordCount = text.trim().split(/\s+/).filter(Boolean).length;
const charCount = text.length;

// Don't gate short prompts — there'd be nothing left to "half reveal" and the
// veil card would cover the whole box.
const shouldGate = gated && charCount > 280;

// Inline gate-arming script (see the <script is:inline> below). Kept as a
// frontmatter string + set:html because the Astro compiler mangles raw script
// bodies that sit inside a template expression.
const gateInit = `(() => {
	var el = document.currentScript.previousElementSibling;
	var on = true;
	try { on = !sessionStorage.getItem('fpb-unlock:' + (el.getAttribute('data-copy-slug') || '')); } catch (e) {}
	if (on) el.setAttribute('data-gate-on', '');
})();`;
---

<section data-copy-root data-copy-slug={slug}>
	<div class="prompt-card rounded-base border border-gray-200 bg-white overflow-hidden">
		<!-- Header bar -->
		<header class="flex items-center justify-between gap-3 px-4 sm:px-5 py-3 border-b border-gray-200 bg-soft">
			<div class="flex items-center gap-3 min-w-0">
				<h2 class="text-xs font-semibold uppercase tracking-wide text-text-primary m-0">{label}</h2>
				<span class="hidden sm:flex items-center gap-2 text-xs text-gray-500">
					<span>{wordCount} {wordCount === 1 ? 'word' : 'words'}</span>
					<span aria-hidden="true">·</span>
					<span>{charCount} chars</span>
				</span>
			</div>
			{
				shouldGate && (
					<button
						type="button"
						class="gate-lock-btn btn-feedback btn-primary btn-sm items-center gap-2"
						data-gate-open
					>
						<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
						</svg>
						<span>Reveal to copy</span>
					</button>
				)
			}
			<button
				type="button"
				class="copy-btn btn-feedback btn-primary btn-sm inline-flex items-center gap-2"
				data-copy-btn
				aria-live="polite"
			>
				<svg class="copy-icon-copy w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
						d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
				</svg>
				<svg class="copy-icon-done hidden w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<polyline stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" points="20 6 9 17 4 12" />
				</svg>
				<span class="copy-label">Copy</span>
			</button>
		</header>

		<!-- Prompt body — dark, monospace, scrollable. When the gate is on, the
		     wrapper clips the box to ~half height and the veil (gradient + blur +
		     CTA card) sits on top. The full text is always in the DOM. -->
		<div data-gate-clip>
			<pre class="prompt-box px-4 sm:px-5 py-4 sm:py-5 m-0 overflow-x-auto rounded-none border-0" data-copy-text>{text}</pre>
			{
				shouldGate && (
					<div class="gate-veil" data-nosnippet>
						<div class="gate-cta">
							<span class="gate-cta__badge" aria-hidden="true">
								<svg class="w-4.5 h-4.5" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
								</svg>
							</span>
							<p class="gate-cta__title">The full prompt is hidden</p>
							<p class="gate-cta__sub">Tap below to reveal the whole prompt and unlock the copy button.</p>
							<button type="button" class="btn-primary w-full justify-center" data-gate-open>
								Reveal full prompt
							</button>
							<span class="gate-cta__hint">Free · no sign-up needed</span>
						</div>
					</div>
				)
			}
		</div>
	</div>
</section>
<!-- Runs synchronously right after the section is parsed (before paint):
     arms the gate unless this prompt was already unlocked this session.
     No-JS visitors and crawlers therefore always get the full prompt. -->
{shouldGate && <script is:inline set:html={gateInit} />}

<script>
	function initCopy(root: HTMLElement) {
		const btn = root.querySelector<HTMLButtonElement>('[data-copy-btn]');
		const source = root.querySelector<HTMLElement>('[data-copy-text]');
		const label = root.querySelector<HTMLElement>('.copy-label');
		const iconCopy = root.querySelector<SVGElement>('.copy-icon-copy');
		const iconDone = root.querySelector<SVGElement>('.copy-icon-done');
		if (!btn || !source || !label) return;

		const text = source.textContent ?? '';
		const slug = root.dataset.copySlug;
		let resetTimer: ReturnType<typeof setTimeout> | undefined;

		// Fire-and-forget copy tracking; must never affect the copy UX.
		function trackCopy() {
			if (!slug) return;
			try {
				fetch(`/api/prompts/${encodeURIComponent(slug)}/copy`, {
					method: 'POST',
					keepalive: true,
				}).catch(() => {});
			} catch {
				// ignore
			}
		}

		function showCopied(ok: boolean) {
			label!.textContent = ok ? 'Copied!' : 'Press Ctrl/⌘+C';
			if (ok) {
				iconCopy?.classList.add('hidden');
				iconDone?.classList.remove('hidden');
			}
			clearTimeout(resetTimer);
			resetTimer = setTimeout(() => {
				label!.textContent = 'Copy';
				iconDone?.classList.add('hidden');
				iconCopy?.classList.remove('hidden');
			}, 2000);
		}

		async function copy() {
			try {
				if (navigator.clipboard?.writeText) {
					await navigator.clipboard.writeText(text);
				} else {
					const ta = document.createElement('textarea');
					ta.value = text;
					ta.style.position = 'fixed';
					ta.style.opacity = '0';
					document.body.appendChild(ta);
					ta.select();
					document.execCommand('copy');
					document.body.removeChild(ta);
				}
				showCopied(true);
				trackCopy();
			} catch {
				showCopied(false);
			}
		}

		btn.addEventListener('click', copy);
	}

	// Copy gate: a tap dissolves the veil and unclips the prompt. Deliberately
	// NOT tied to any ad — monetized gating is the AdSense Offerwall's job.
	function initGate(root: HTMLElement) {
		if (!root.hasAttribute('data-gate-on')) return;
		const clip = root.querySelector<HTMLElement>('[data-gate-clip]');
		const openBtns = root.querySelectorAll<HTMLButtonElement>('[data-gate-open]');
		let revealed = false;

		function reveal() {
			if (revealed) return;
			revealed = true;
			root.setAttribute('data-gate-unlocking', '');
			// Animate the clip open to its real height, then drop the gate state.
			if (clip) clip.style.maxHeight = `${clip.scrollHeight}px`;
			setTimeout(() => {
				root.removeAttribute('data-gate-on');
				root.removeAttribute('data-gate-unlocking');
				if (clip) clip.style.maxHeight = '';
			}, 650);
			try {
				sessionStorage.setItem(`fpb-unlock:${root.dataset.copySlug ?? ''}`, '1');
			} catch {
				// private mode — the reveal still applies for this page view
			}
		}

		openBtns.forEach((b) => b.addEventListener('click', reveal));
	}

	document.querySelectorAll<HTMLElement>('[data-copy-root]').forEach((root) => {
		initCopy(root);
		initGate(root);
	});
</script>
