---
interface Props {
	/** The prompt text to display and copy. */
	text: string;
	/** Optional label override. */
	label?: string;
	/** Prompt slug — when set, successful copies are tracked via the copy API. */
	slug?: string;
}

const { text, label = 'The prompt', slug } = Astro.props;

// Stats shown in the header bar
const wordCount = text.trim().split(/\s+/).filter(Boolean).length;
const charCount = text.length;
---

<section data-copy-root data-copy-slug={slug}>
	<div class="prompt-card rounded-base border border-gray-200 bg-white overflow-hidden">
		<!-- Header bar -->
		<header class="flex items-center justify-between gap-3 px-4 sm:px-5 py-3 border-b border-gray-200 bg-soft">
			<div class="flex items-center gap-3 min-w-0">
				<h2 class="text-xs font-semibold uppercase tracking-wide text-text-primary m-0">{label}</h2>
				<span class="hidden sm:flex items-center gap-2 text-xs text-gray-500">
					<span>{wordCount} {wordCount === 1 ? 'word' : 'words'}</span>
					<span aria-hidden="true">·</span>
					<span>{charCount} chars</span>
				</span>
			</div>
			<button
				type="button"
				class="copy-btn btn-feedback btn-primary btn-sm inline-flex items-center gap-2"
				data-copy-btn
				aria-live="polite"
			>
				<svg class="copy-icon-copy w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
						d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
				</svg>
				<svg class="copy-icon-done hidden w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<polyline stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" points="20 6 9 17 4 12" />
				</svg>
				<span class="copy-label">Copy</span>
			</button>
		</header>

		<!-- Prompt body — dark, monospace, scrollable. Always fully visible: the
		     prompt is never gated, so copy is one click. -->
		<pre class="prompt-box px-4 sm:px-5 py-4 sm:py-5 m-0 overflow-x-auto rounded-none border-0" data-copy-text>{text}</pre>
	</div>
</section>

<script>
	function initCopy(root: HTMLElement) {
		const btn = root.querySelector<HTMLButtonElement>('[data-copy-btn]');
		const source = root.querySelector<HTMLElement>('[data-copy-text]');
		const label = root.querySelector<HTMLElement>('.copy-label');
		const iconCopy = root.querySelector<SVGElement>('.copy-icon-copy');
		const iconDone = root.querySelector<SVGElement>('.copy-icon-done');
		if (!btn || !source || !label) return;

		const text = source.textContent ?? '';
		const slug = root.dataset.copySlug;
		let resetTimer: ReturnType<typeof setTimeout> | undefined;

		// Fire-and-forget copy tracking; must never affect the copy UX.
		function trackCopy() {
			if (!slug) return;
			try {
				fetch(`/api/prompts/${encodeURIComponent(slug)}/copy`, {
					method: 'POST',
					keepalive: true,
				}).catch(() => {});
			} catch {
				// ignore
			}
		}

		function showCopied(ok: boolean) {
			label!.textContent = ok ? 'Copied!' : 'Press Ctrl/⌘+C';
			if (ok) {
				iconCopy?.classList.add('hidden');
				iconDone?.classList.remove('hidden');
			}
			clearTimeout(resetTimer);
			resetTimer = setTimeout(() => {
				label!.textContent = 'Copy';
				iconDone?.classList.add('hidden');
				iconCopy?.classList.remove('hidden');
			}, 2000);
		}

		async function copy() {
			try {
				if (navigator.clipboard?.writeText) {
					await navigator.clipboard.writeText(text);
				} else {
					const ta = document.createElement('textarea');
					ta.value = text;
					ta.style.position = 'fixed';
					ta.style.opacity = '0';
					document.body.appendChild(ta);
					ta.select();
					document.execCommand('copy');
					document.body.removeChild(ta);
				}
				showCopied(true);
				trackCopy();
			} catch {
				showCopied(false);
			}
		}

		btn.addEventListener('click', () => {
			copy();
		});
	}

	document.querySelectorAll<HTMLElement>('[data-copy-root]').forEach((root) => initCopy(root));
</script>
