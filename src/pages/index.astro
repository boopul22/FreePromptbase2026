---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Tabs from '../components/Tabs.astro';
import PromptGrid from '../components/PromptGrid.astro';
import Footer from '../components/Footer.astro';
import {
	getAllPrompts,
	getAllCategories,
	getPopularPrompts,
	getTrendingPrompts,
} from '../lib/prompts';
import { itemListSchema } from '../lib/seo';

// Rendered on-demand (SSR) so new prompts added to D1 appear without a rebuild
// and so save/share counts stay fresh across requests.
export const prerender = false;

const [allPrompts, categories, popularPrompts, trendingFromEvents] = await Promise.all([
	getAllPrompts(),
	getAllCategories(),
	getPopularPrompts(),
	getTrendingPrompts(),
]);

// Recent = newest first (getAllPrompts already orders by date DESC).
const recentPrompts = allPrompts;

// Trending leads with the past-7-day winners, then pads from Popular so a
// quiet week doesn't leave the default tab looking thin. Dedup by slug.
const MIN_TRENDING = 12;
const trendingSlugs = new Set(trendingFromEvents.map((p) => p.slug));
const padding = popularPrompts.filter((p) => !trendingSlugs.has(p.slug));
const trendingPrompts =
	trendingFromEvents.length >= MIN_TRENDING
		? trendingFromEvents
		: [...trendingFromEvents, ...padding].slice(0, MIN_TRENDING);

// ItemList for the homepage collection (cap to 30 so the JSON-LD stays small).
const homeList = itemListSchema(
	trendingPrompts.slice(0, 30).map((p) => ({ name: p.title, url: `/${p.slug}` })),
	'Trending prompts',
);
---

<Layout extraSchemas={[homeList]}>
	<Header />
	<main class="max-w-7xl mx-auto px-4 py-12">
		<Hero promptCount={allPrompts.length} categoryCount={categories.length} />
		<Tabs />
		<PromptGrid
			prompts={trendingPrompts}
			categories={categories}
			tab="trending"
			emptyMessage="No trending prompts yet — heart a few to get this section moving."
		/>
		<PromptGrid
			prompts={popularPrompts}
			categories={categories}
			tab="popular"
			hidden
		/>
		<PromptGrid
			prompts={recentPrompts}
			categories={categories}
			tab="recent"
			hidden
		/>
	</main>
	<Footer />
</Layout>

<script>
	// Home interactivity: tab switching (show/hide pre-rendered grids), live
	// search across the active grid, and the collection follow button. Save and
	// share live inside PromptCard via /scripts/social.ts.
	const grids = Array.from(document.querySelectorAll<HTMLElement>('[data-grid][data-tab]'));
	const emptyTabMessages = Array.from(document.querySelectorAll<HTMLElement>('[data-empty-tab]'));
	const emptyState = document.querySelector<HTMLElement>('[data-empty]');
	const searchInput = document.querySelector<HTMLInputElement>('[data-search-input]');
	const searchForm = document.querySelector<HTMLFormElement>('[data-search-form]');
	const sortTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.sort-tab'));
	const followBtn = document.querySelector<HTMLButtonElement>('[data-follow-btn]');

	const ACTIVE_TAB = [
		'text-text-primary',
		"after:content-['']",
		'after:absolute',
		'after:-bottom-4',
		'after:left-0',
		'after:w-full',
		'after:h-1',
		'after:bg-primary',
	];
	const INACTIVE_TAB = ['text-gray-600', 'hover:text-primary'];

	function activeGrid(): HTMLElement | null {
		return grids.find((g) => !g.classList.contains('hidden')) ?? null;
	}

	function showTab(id: string) {
		grids.forEach((g) => g.classList.toggle('hidden', g.dataset.tab !== id));
		emptyTabMessages.forEach((p) => p.classList.toggle('hidden', p.dataset.emptyTab !== id));
		// Re-run any active search filter against the newly visible grid.
		if (searchInput?.value) runSearch(searchInput.value);
	}

	sortTabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			sortTabs.forEach((t) => {
				const isActive = t === tab;
				t.dataset.active = String(isActive);
				t.classList.remove(...ACTIVE_TAB, ...INACTIVE_TAB);
				t.classList.add(...(isActive ? ACTIVE_TAB : INACTIVE_TAB));
			});
			showTab(tab.dataset.sort ?? 'trending');
		});
	});

	function runSearch(query: string) {
		const q = query.trim().toLowerCase();
		const grid = activeGrid();
		if (!grid) return;
		const items = Array.from(grid.querySelectorAll<HTMLElement>('[data-prompt]'));
		let visible = 0;
		items.forEach((el) => {
			const match = !q || (el.dataset.search ?? '').includes(q);
			el.classList.toggle('hidden', !match);
			if (match) visible++;
		});
		emptyState?.classList.toggle('hidden', visible !== 0);
	}

	searchInput?.addEventListener('input', (e) =>
		runSearch((e.target as HTMLInputElement).value),
	);
	searchForm?.addEventListener('submit', (e) => {
		e.preventDefault();
		runSearch(searchInput?.value ?? '');
	});

	// Honor ?q= when arriving from a header search on another page.
	const initialQuery = new URLSearchParams(location.search).get('q');
	if (initialQuery && searchInput) {
		searchInput.value = initialQuery;
		runSearch(initialQuery);
	}

	followBtn?.addEventListener('click', () => {
		const following = followBtn.dataset.following === 'true';
		const next = !following;
		followBtn.dataset.following = String(next);
		followBtn.textContent = next ? 'Following' : 'Follow';
		followBtn.classList.toggle('bg-primary', !next);
		followBtn.classList.toggle('text-link', !next);
		followBtn.classList.toggle('bg-gray-200', next);
		followBtn.classList.toggle('text-text-primary', next);
	});
</script>
