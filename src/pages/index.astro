---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Tabs from '../components/Tabs.astro';
import PromptGrid from '../components/PromptGrid.astro';
import Footer from '../components/Footer.astro';
import {
	getRecentPrompts,
	getAllCategories,
	getPopularPrompts,
	getTrendingPrompts,
	getPromptOfTheDaySlug,
	getPromptsPage,
	getPromptBySlug,
	getSiteStats,
	type Prompt,
} from '../lib/prompts';
import { getTopContributor } from '../lib/users';
import { itemListSchema } from '../lib/seo';
import { cfSrcset, cfImg } from '../lib/cfImage';

// Rendered on-demand (SSR) so new prompts added to D1 appear without a rebuild
// and so save/share counts stay fresh across requests.
export const prerender = false;

// Only the first page of "All" is fetched up front (keyset-paginated, lazy-loaded
// on scroll); Recent and Trending are bounded sets. The whole catalog is never
// loaded into one response.
const [
	imageRecent,
	imageAllPage,
	categories,
	imagePopular,
	imageTrendingEvents,
	potdSlug,
	stats,
	topContributor,
] = await Promise.all([
	getRecentPrompts(24, 'images'),
	getPromptsPage(null, 24, 'images'),
	getAllCategories(),
	getPopularPrompts(60, 'images'),
	getTrendingPrompts(60, 'images'),
	getPromptOfTheDaySlug(),
	getSiteStats(),
	getTopContributor(),
]);

// Fetch the Prompt of the Day directly (one indexed lookup) so we can float it
// into Trending without loading the entire catalog just to find it.
const potdPrompt = potdSlug ? await getPromptBySlug(potdSlug) : undefined;

// Float the Prompt of the Day to the first card of Trending so it leads the
// page. Recent/All stay in strict newest order (no POTD float). The POTD still
// gets its badge wherever it naturally falls.
function withPotdFirst(list: Prompt[], category: string): Prompt[] {
	if (!potdSlug || potdPrompt?.category !== category) return list;
	const idx = list.findIndex((p) => p.slug === potdSlug);
	if (idx === 0) return list;
	if (idx > 0) return [list[idx], ...list.slice(0, idx), ...list.slice(idx + 1)];
	return potdPrompt ? [potdPrompt, ...list] : list;
}

// Trending leads with the past-7-day winners, then pads from Popular so a
// quiet week doesn't leave the default tab looking thin. Dedup by slug.
const MIN_TRENDING = 12;
function makeTrending(events: Prompt[], popular: Prompt[], category: string): Prompt[] {
	const trendingSlugs = new Set(events.map((p) => p.slug));
	const padding = popular.filter((p) => !trendingSlugs.has(p.slug));
	return withPotdFirst(
		events.length >= MIN_TRENDING ? events : [...events, ...padding].slice(0, MIN_TRENDING),
		category,
	);
}

const imageTrending = makeTrending(imageTrendingEvents, imagePopular, 'images');

// ItemList for the homepage collection (cap to 30 so the JSON-LD stays small).
const homeList = itemListSchema(
	imageTrending.slice(0, 30).map((p) => ({ name: p.title, url: `/${p.slug}` })),
	'Trending image prompts',
);

// Preload the first card's cover — must match the resized cdn-cgi URL the
	// <img> uses (not the raw /cdn original) or the browser downloads a wasted asset.
	const firstCover = imageAllPage.prompts[0]?.coverImage ?? imageTrending[0]?.coverImage;
	const hasQueryString = Astro.url.search !== '';
---

<Layout
	title="Free AI Prompts – Photo Editing Prompts for Gemini & ChatGPT"
	description="Free AI image prompts you can copy and paste for photo editing and image generation with Gemini, ChatGPT, Midjourney, and more. No signup."
	extraSchemas={[homeList]}
	robots={hasQueryString ? 'noindex, follow' : undefined}
	preloadImage={firstCover ? cfImg(firstCover, 400, 68) : undefined}
	preloadImageSrcset={firstCover ? cfSrcset(firstCover, [300, 400, 520, 660], 68) : undefined}
	preloadImageSizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 92vw"
>
	<Header />
	<main class="site-main py-12" id="prompt-gallery">
		<Hero promptCount={stats.promptCount} categoryCount={categories.length} topContributor={topContributor} />
		<Tabs />
		<PromptGrid
			prompts={imageTrending}
			categories={categories}
			tab="trending"
			hidden
			promptType="images"
			emptyMessage="No trending prompts yet — heart a few to get this section moving."
		/>
		<PromptGrid
			prompts={imageRecent}
			categories={categories}
			tab="recent"
			hidden
			promptType="images"
			emptyMessage="Nothing here yet. New prompts show up first."
		/>
		<PromptGrid
			prompts={imageAllPage.prompts}
			categories={categories}
			tab="all"
			promptType="images"
			nextCursor={imageAllPage.nextCursor}
			emptyMessage="No image prompts yet."
		/>
		<!-- Pagination for the All tab (shown/hidden with it). The button carries
		     the keyset cursor; clicking it fetches the next page from
		     /partials/prompts and appends the cards. -->
		<div data-load-more-wrap class="mt-10 flex justify-center">
			<button
				type="button"
				data-load-more
				data-tab="all"
				class="btn-secondary"
			>
				Load more prompts
			</button>
		</div>
		<p data-load-end class="hidden text-center text-gray-500 py-8">You've reached the end.</p>
	</main>
	<Footer />
</Layout>

<script>
	// Home interactivity: tab switching (show/hide pre-rendered grids), infinite
	// scroll for the All tab, live search across the active grid, and the
	// collection follow button. Like/save/share live inside PromptCard via
	// /scripts/social.ts; we re-call the (idempotent) wire functions after
	// appending lazy-loaded cards.
	import { wireSave, wireLike, wireShare } from '../scripts/social';

	const grids = Array.from(document.querySelectorAll<HTMLElement>('[data-grid][data-tab]'));
	const emptyTabMessages = Array.from(document.querySelectorAll<HTMLElement>('[data-empty-tab]'));
	const emptyState = document.querySelector<HTMLElement>('[data-empty]');
	const searchInput = document.querySelector<HTMLInputElement>('[data-search-input]');
	const searchForm = document.querySelector<HTMLFormElement>('[data-search-form]');
	const sortTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.sort-tab'));
	const tabIndicator = document.querySelector<HTMLElement>('[data-tab-indicator]');
	const loadMore = document.querySelector<HTMLButtonElement>('[data-load-more]');
	const loadMoreWrap = document.querySelector<HTMLElement>('[data-load-more-wrap]');
	const loadEnd = document.querySelector<HTMLElement>('[data-load-end]');
	const activeType = 'images';
	let activeSort = sortTabs.find((tab) => tab.dataset.active === 'true')?.dataset.sort ?? 'all';

	function activeGrid(): HTMLElement | null {
		return grids.find((g) => !g.classList.contains('hidden')) ?? null;
	}

	function activeAllGrid(): HTMLElement | null {
		return grids.find((g) => g.dataset.tab === 'all' && g.dataset.promptType === activeType) ?? null;
	}

	function showTab(id: string) {
		activeSort = id;
		grids.forEach((g) => g.classList.toggle('hidden', g.dataset.tab !== id || g.dataset.promptType !== activeType));
		emptyTabMessages.forEach((p) =>
			p.classList.toggle('hidden', p.dataset.emptyTab !== id || p.dataset.emptyPromptType !== activeType),
		);
		// All-tab-only pagination controls.
		const isAll = id === 'all';
		const cursor = activeAllGrid()?.dataset.nextCursor ?? '';
		const hasMore = !!cursor;
		if (loadMore) loadMore.dataset.cursor = cursor;
		loadMoreWrap?.classList.toggle('hidden', !isAll || !hasMore);
		loadEnd?.classList.toggle('hidden', !isAll || hasMore);
		// Re-run any active search filter against the newly visible grid.
		if (searchInput?.value) runSearch(searchInput.value);
	}

	function moveIndicator(index: number) {
		if (tabIndicator) tabIndicator.style.transform = `translateX(${index * 100}%)`;
	}

	sortTabs.forEach((tab, i) => {
		tab.addEventListener('click', () => {
			// Styling is attribute-driven (.sort-tab[data-active]); flip it + slide the pill.
			sortTabs.forEach((t) => {
				const on = t === tab;
				t.dataset.active = String(on);
				t.setAttribute('aria-selected', String(on));
			});
			moveIndicator(i);
			showTab(tab.dataset.sort ?? 'trending');
		});
	});

	// --- Load more: append the next keyset page of the All grid on click -------
	let loading = false;
	const loadMoreLabel = loadMore?.textContent ?? 'Load more prompts';

	async function loadNextAllPage() {
		const allGrid = activeAllGrid();
		const cursor = allGrid?.dataset.nextCursor;
		if (loading || !loadMore || !allGrid || !cursor) return;
		loading = true;
		loadMore.disabled = true;
		loadMore.textContent = 'Loading…';
		try {
			const res = await fetch(`/partials/prompts?category=${encodeURIComponent(activeType)}&cursor=${encodeURIComponent(cursor)}`);
			if (!res.ok) throw new Error(String(res.status));
			const next = res.headers.get('X-Next-Cursor') ?? '';
			allGrid.insertAdjacentHTML('beforeend', await res.text());
			// Wire the freshly injected cards (no-ops on already-wired ones).
			wireSave();
			wireLike();
			wireShare();
			allGrid.dataset.nextCursor = next;
			loadMore.dataset.cursor = next;
			if (!next) {
				loadMoreWrap?.classList.add('hidden');
				if (activeGrid()?.dataset.tab === 'all') loadEnd?.classList.remove('hidden');
			}
		} catch {
			// Leave the cursor intact so the next click retries.
		} finally {
			loading = false;
			loadMore.disabled = false;
			loadMore.textContent = loadMoreLabel;
		}
	}

	loadMore?.addEventListener('click', loadNextAllPage);

	// Initialise the controls for the default-open tab (hides the button when
	// the first page already covers everything).
	showTab(activeSort);

	function runSearch(query: string) {
		const q = query.trim().toLowerCase();
		const grid = activeGrid();
		if (!grid) return;
		const items = Array.from(grid.querySelectorAll<HTMLElement>('[data-prompt]'));
		let visible = 0;
		items.forEach((el) => {
			const match = !q || (el.dataset.search ?? '').includes(q);
			el.classList.toggle('hidden', !match);
			if (match) visible++;
		});
		emptyState?.classList.toggle('hidden', visible !== 0);
	}

	searchInput?.addEventListener('input', (e) =>
		runSearch((e.target as HTMLInputElement).value),
	);
	searchForm?.addEventListener('submit', (e) => {
		e.preventDefault();
		runSearch(searchInput?.value ?? '');
	});

	// Honor ?q= when arriving from a header search on another page.
	const initialQuery = new URLSearchParams(location.search).get('q');
	if (initialQuery && searchInput) {
		searchInput.value = initialQuery;
		runSearch(initialQuery);
	}

</script>
