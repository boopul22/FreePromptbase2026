---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getPostBySlug, getRelatedPosts, postReadTime } from '../../lib/posts';
import { breadcrumbSchema, publisherBlock } from '../../lib/seo';
import { cfSrcset } from '../../lib/cfImage';

// On-demand: look the post up in D1 at request time.
export const prerender = false;

const slug = Astro.params.slug!;
const post = await getPostBySlug(slug);
if (!post) {
	return Astro.rewrite('/404');
}

const related = await getRelatedPosts(post);
const mins = postReadTime(post);
const dateIso = post.publishedAt ?? post.createdAt;
const dateLabel = new Date(dateIso).toLocaleDateString('en-US', {
	month: 'short',
	day: 'numeric',
	year: 'numeric',
});
const authorName = post.authorName || 'Admin';

// --- Build TOC from h2/h3 in the body HTML, inject anchor ids inline ---
function slugify(s: string): string {
	return s
		.toLowerCase()
		.replace(/<[^>]+>/g, '')
		.replace(/[^a-z0-9\s-]/g, '')
		.replace(/\s+/g, '-')
		.replace(/-+/g, '-')
		.replace(/^-|-$/g, '');
}

interface TocEntry { level: 2 | 3; text: string; id: string; }

function buildToc(html: string): { html: string; toc: TocEntry[] } {
	const toc: TocEntry[] = [];
	const used = new Set<string>();
	const out = html.replace(
		/<(h[23])(\s[^>]*)?>([\s\S]*?)<\/\1>/gi,
		(match, tag, attrs = '', inner) => {
			const level = (tag.toLowerCase() === 'h2' ? 2 : 3) as 2 | 3;
			const text = String(inner).replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
			if (!text) return match;
			// Respect an existing id; otherwise generate a unique slug.
			const existingId = /\bid="([^"]+)"/i.exec(attrs ?? '');
			let id: string;
			if (existingId) {
				id = existingId[1];
			} else {
				id = slugify(text) || 'section';
				let n = 2;
				while (used.has(id)) id = `${slugify(text)}-${n++}`;
			}
			used.add(id);
			toc.push({ level, text, id });
			if (existingId) return match;
			return `<${tag}${attrs ?? ''} id="${id}">${inner}</${tag}>`;
		},
	);
	return { html: out, toc };
}

const rawBody = post.htmlContent || post.content.intro || '';
const { html: builtHtml, toc } = buildToc(rawBody);
// Lazy-load + async-decode every in-body image (they're below the fold) so the
// page doesn't eagerly fetch 20 MB of images on load. Only images without an
// explicit loading attr are touched.
const bodyHtml = builtHtml.replace(/<img(?![^>]*\bloading=)/gi, '<img loading="lazy" decoding="async"');

// Strip HTML to plain text for articleBody + wordCount. Truncate body so the
// JSON-LD payload stays small while still giving AI engines enough to cite.
const plainBody = bodyHtml.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const wordCount = plainBody ? plainBody.split(/\s+/).filter(Boolean).length : 0;
const articleBody = plainBody.length > 5000 ? `${plainBody.slice(0, 5000)}…` : plainBody;

const postUrl = new URL(`/blog/${post.slug}`, Astro.site).href;

const postSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.title,
	description: post.excerpt,
	datePublished: new Date(dateIso).toISOString(),
	dateModified: new Date(post.updatedAt ?? dateIso).toISOString(),
	author: { '@type': 'Person', name: authorName },
	publisher: publisherBlock(),
	url: postUrl,
	mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
	inLanguage: 'en',
	...(wordCount > 0 ? { wordCount, articleBody } : {}),
	...(post.coverImage ? { image: post.coverImage } : {}),
};

// FAQPage schema gets a separate JSON-LD block (Google's preferred shape).
const faqSchema =
	post.faqItems.length > 0
		? {
				'@context': 'https://schema.org',
				'@type': 'FAQPage',
				mainEntity: post.faqItems.map((it) => ({
					'@type': 'Question',
					name: it.question,
					acceptedAnswer: { '@type': 'Answer', text: it.answer },
				})),
			}
		: null;

const breadcrumb = breadcrumbSchema([
	{ name: 'Home', path: '/' },
	{ name: 'Blog', path: '/blog' },
	{ name: post.title, path: `/blog/${post.slug}` },
]);
---

<Layout
	title={`${post.title} — Free Prompt Base`}
	description={post.excerpt}
	schema={postSchema}
	extraSchemas={[breadcrumb, ...(faqSchema ? [faqSchema] : [])]}
	ogType="article"
	ogImage={post.coverImage ?? `/og/${post.slug}.svg`}
	preloadImage={post.coverImage ?? undefined}
	preloadImageSrcset={post.coverImage ? cfSrcset(post.coverImage, [400, 768, 1200, 1600]) : undefined}
	preloadImageSizes="(min-width: 1024px) 768px, 92vw"
>
	<Header />
	<main class="flex-grow max-w-6xl mx-auto px-4 w-full py-8 sm:py-12">
		<!-- Breadcrumb -->
		<nav class="text-xs text-gray-600 mb-6 flex flex-wrap items-center gap-1.5" aria-label="Breadcrumb">
			<a href="/" class="hover:text-primary transition-colors">Home</a>
			<span class="text-gray-300" aria-hidden="true">/</span>
			<a href="/blog" class="hover:text-primary transition-colors">Blog</a>
			<span class="text-gray-300" aria-hidden="true">/</span>
			<span class="text-text-primary truncate max-w-[60%]">{post.title}</span>
		</nav>

		<div class="lg:flex lg:gap-12 lg:items-start">
			<!-- Article column -->
			<article class="lg:flex-1 lg:max-w-3xl">
				<!-- Title + lead -->
				<header class="mb-6">
					{
						post.categoryName && (
							<p class="text-xs font-semibold uppercase tracking-wide text-primary mb-3">
								{post.categoryName}
							</p>
						)
					}
					<h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-text-primary leading-[1.15]">
						{post.title}
					</h1>
					<p class="text-gray-600 text-lg sm:text-xl leading-relaxed mt-4 max-w-2xl">
						{post.excerpt}
					</p>
				</header>

				<!-- Meta strip -->
				<div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-gray-500 pb-6 mb-8 border-b border-gray-200">
					<span class="inline-flex items-center gap-1.5">
						<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
						{dateLabel}
					</span>
					<span class="inline-flex items-center gap-1.5">
						<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
						{post.readTime || `${mins} min read`}
					</span>
					<span class="inline-flex items-center gap-1.5">
						<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
						by <span class="text-text-primary font-medium">{authorName}</span>
					</span>
				</div>

				<!-- Cover -->
				{
					post.coverImage && (
						<img
							src={post.coverImage}
							srcset={cfSrcset(post.coverImage, [400, 768, 1200, 1600])}
							sizes="(min-width: 1024px) 768px, 92vw"
							alt={post.title}
							width="1600"
							height="900"
							class="w-full aspect-[16/9] rounded-base mb-10 object-cover"
							loading="eager"
							fetchpriority="high"
							decoding="async"
						/>
					)
				}

				<!-- Mobile-only TOC (collapsed) -->
				{
					toc.length > 1 && (
						<details class="lg:hidden mb-8 border border-gray-200 rounded-md bg-white group">
							<summary class="px-4 py-3 cursor-pointer text-sm font-semibold text-text-primary flex items-center gap-2 list-none">
								<svg class="w-4 h-4 text-gray-500 transition-transform group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
								<span>On this page</span>
								<span class="ml-auto text-xs font-normal text-gray-500">{toc.length}</span>
							</summary>
							<nav class="border-t border-gray-200 px-4 py-3">
								<ol class="space-y-1.5 text-sm">
									{toc.map((h) => (
										<li class={h.level === 3 ? 'pl-4' : ''}>
											<a href={`#${h.id}`} class="text-gray-600 hover:text-primary transition-colors block py-0.5">
												{h.text}
											</a>
										</li>
									))}
								</ol>
							</nav>
						</details>
					)
				}

				<!-- Body -->
				<div class="prose-blog" set:html={bodyHtml} />

				<!-- FAQ (if present) -->
				{
					post.faqItems.length > 0 && (
						<section class="mt-12 pt-10 border-t border-gray-200">
							<p class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-2">FAQ</p>
							<h2 class="text-2xl font-bold text-text-primary mb-6">Frequently asked</h2>
							<div class="space-y-3">
								{post.faqItems.map((item) => (
									<details class="border border-gray-200 rounded-md bg-white group">
										<summary class="px-4 py-3 cursor-pointer text-sm font-semibold text-text-primary flex items-center gap-2 list-none">
											<svg class="w-4 h-4 text-gray-500 transition-transform group-open:rotate-90 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
											<span>{item.question}</span>
										</summary>
										<div class="px-4 pb-4 pt-0 text-gray-600 leading-relaxed whitespace-pre-wrap">
											{item.answer}
										</div>
									</details>
								))}
							</div>
						</section>
					)
				}

				<!-- Related -->
				{
					related.length > 0 && (
						<section class="mt-16 pt-10 border-t border-gray-200">
							<p class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-2">More to read</p>
							<h2 class="text-2xl font-bold text-text-primary mb-6">Keep reading</h2>
							<div class="grid gap-6 sm:grid-cols-2">
								{related.map((rel) => (
									<a
										href={`/blog/${rel.slug}`}
										class="block bg-white rounded-base border border-gray-200 p-5 hover:border-primary hover:shadow-sm transition-all"
									>
										<div class="text-xs text-gray-500 mb-2">
											{new Date(rel.publishedAt ?? rel.createdAt).toLocaleDateString('en-US', {
												month: 'short',
												day: 'numeric',
												year: 'numeric',
											})}
										</div>
										<h3 class="font-bold text-text-primary leading-snug">{rel.title}</h3>
										<p class="text-sm text-gray-600 mt-2">{rel.excerpt}</p>
									</a>
								))}
							</div>
						</section>
					)
				}
			</article>

			<!-- Sticky TOC (lg+) -->
			{
				toc.length > 1 && (
					<aside class="hidden lg:block lg:w-56 lg:shrink-0">
						<div class="sticky top-8">
							<p class="text-[11px] font-semibold uppercase tracking-wide text-gray-500 mb-3">
								On this page
							</p>
							<nav aria-label="Table of contents">
								<ol class="space-y-1.5 text-sm border-l border-gray-200 pl-4">
									{toc.map((h) => (
										<li class:list={[h.level === 3 && 'pl-3']}>
											<a
												href={`#${h.id}`}
												data-toc-link
												data-target={h.id}
												class="block py-0.5 text-gray-600 hover:text-primary transition-colors leading-snug"
											>
												{h.text}
											</a>
										</li>
									))}
								</ol>
							</nav>
						</div>
					</aside>
				)
			}
		</div>
	</main>
	<Footer />
</Layout>

<style is:global>
	.prose-blog {
		color: var(--color-text-primary, #1f2937);
		font-size: 1rem;
		line-height: 1.7;
	}
	@media (min-width: 640px) {
		.prose-blog {
			font-size: 1.0625rem;
			line-height: 1.75;
		}
	}
	.prose-blog > :first-child {
		margin-top: 0;
	}
	.prose-blog h2 {
		font-size: 1.4rem;
		font-weight: 700;
		margin-top: 2.5rem;
		margin-bottom: 0.75rem;
		letter-spacing: -0.015em;
		scroll-margin-top: 5rem;
		line-height: 1.25;
	}
	@media (min-width: 640px) {
		.prose-blog h2 {
			font-size: 1.625rem;
			margin-top: 3rem;
		}
	}
	.prose-blog h3 {
		font-size: 1.2rem;
		font-weight: 700;
		margin-top: 2rem;
		margin-bottom: 0.5rem;
		scroll-margin-top: 5rem;
		line-height: 1.3;
	}
	.prose-blog p {
		margin-top: 1rem;
		margin-bottom: 1rem;
		color: #374151;
	}
	.prose-blog ul,
	.prose-blog ol {
		margin: 1rem 0;
		padding-left: 1.5rem;
		color: #374151;
	}
	.prose-blog ul {
		list-style: disc;
	}
	.prose-blog ol {
		list-style: decimal;
	}
	.prose-blog li {
		margin: 0.25rem 0;
	}
	.prose-blog li::marker {
		color: #9ca3af;
	}
	.prose-blog a {
		color: var(--color-primary, #d97706);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.prose-blog strong {
		color: #111827;
		font-weight: 600;
	}
	.prose-blog em {
		font-style: italic;
		color: #4b5563;
	}
	.prose-blog code {
		background: #f3f4f6;
		border-radius: 4px;
		padding: 0.1rem 0.35rem;
		font-size: 0.92em;
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
	}
	.prose-blog pre {
		background: #0f172a;
		color: #f8fafc;
		padding: 1rem 1.25rem;
		border-radius: 8px;
		overflow-x: auto;
		margin: 1.5rem 0;
		font-size: 0.92rem;
		line-height: 1.6;
	}
	.prose-blog pre code {
		background: transparent;
		padding: 0;
		color: inherit;
	}
	.prose-blog blockquote {
		border-left: 3px solid var(--color-primary, #d97706);
		padding-left: 1rem;
		margin: 1.5rem 0;
		color: #4b5563;
		font-style: italic;
	}
	.prose-blog img {
		border-radius: 8px;
		margin: 1.5rem 0;
	}
	.prose-blog hr {
		border: 0;
		border-top: 1px solid #e5e7eb;
		margin: 2.5rem 0;
	}

	/* TOC active-link highlight */
	[data-toc-link].is-active {
		color: var(--color-primary, #d97706);
		font-weight: 600;
	}
</style>

<script>
	// Highlight the TOC item whose section is currently visible.
	const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
	if (links.length > 0) {
		const targets = links
			.map((l) => document.getElementById(l.dataset.target || ''))
			.filter((el): el is HTMLElement => !!el);

		const map = new Map<HTMLElement, HTMLAnchorElement>();
		links.forEach((l, i) => {
			const t = targets[i];
			if (t) map.set(t, l);
		});

		const setActive = (a: HTMLAnchorElement | null) => {
			links.forEach((l) => l.classList.remove('is-active'));
			if (a) a.classList.add('is-active');
		};

		const observer = new IntersectionObserver(
			(entries) => {
				const visible = entries
					.filter((e) => e.isIntersecting)
					.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
				if (visible) {
					const link = map.get(visible.target as HTMLElement);
					if (link) setActive(link);
				}
			},
			{ rootMargin: '-80px 0px -70% 0px', threshold: [0, 1] },
		);

		targets.forEach((t) => observer.observe(t));
		// Default to first link on load
		setActive(links[0] || null);
	}
</script>
