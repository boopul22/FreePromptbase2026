---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getPostBySlug, getRelatedPosts, postReadTime } from '../../lib/posts';
import { breadcrumbSchema, publisherBlock } from '../../lib/seo';
import { cfSrcset } from '../../lib/cfImage';

// On-demand: look the post up in D1 at request time.
export const prerender = false;

const slug = Astro.params.slug!;
const post = await getPostBySlug(slug);
if (!post) {
	return Astro.rewrite('/404');
}

const related = await getRelatedPosts(post);
const mins = postReadTime(post);
const dateIso = post.publishedAt ?? post.createdAt;
const dateLabel = new Date(dateIso).toLocaleDateString('en-US', {
	month: 'short',
	day: 'numeric',
	year: 'numeric',
});
const authorName = post.authorName || 'Admin';
const authorInitials = authorName
	.trim()
	.split(/\s+/)
	.map((w) => w[0])
	.slice(0, 2)
	.join('')
	.toUpperCase();

// --- Build TOC from h2/h3 in the body HTML, inject anchor ids inline ---
function slugify(s: string): string {
	return s
		.toLowerCase()
		.replace(/<[^>]+>/g, '')
		.replace(/[^a-z0-9\s-]/g, '')
		.replace(/\s+/g, '-')
		.replace(/-+/g, '-')
		.replace(/^-|-$/g, '');
}

interface TocEntry { level: 2 | 3; text: string; id: string; }

function buildToc(html: string): { html: string; toc: TocEntry[] } {
	const toc: TocEntry[] = [];
	const used = new Set<string>();
	const out = html.replace(
		/<(h[23])(\s[^>]*)?>([\s\S]*?)<\/\1>/gi,
		(match, tag, attrs = '', inner) => {
			const level = (tag.toLowerCase() === 'h2' ? 2 : 3) as 2 | 3;
			const text = String(inner).replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
			if (!text) return match;
			// Respect an existing id; otherwise generate a unique slug.
			const existingId = /\bid="([^"]+)"/i.exec(attrs ?? '');
			let id: string;
			if (existingId) {
				id = existingId[1];
			} else {
				id = slugify(text) || 'section';
				let n = 2;
				while (used.has(id)) id = `${slugify(text)}-${n++}`;
			}
			used.add(id);
			toc.push({ level, text, id });
			if (existingId) return match;
			return `<${tag}${attrs ?? ''} id="${id}">${inner}</${tag}>`;
		},
	);
	return { html: out, toc };
}

// --- Lift standalone quoted prompts into copyable cards -------------------
// Authors write example prompts inline as a whole paragraph, e.g.
//   <p><strong>Template:</strong> <em>"You are a [role]..."</em></p>
//   <p>Bad: <em>"a fisherman by the sea, beautiful, 8k"</em></p>
// We turn ONLY those (an optional short label + a single quoted <em> that fills
// the paragraph) into a copy block. Short inline quotes mid-sentence are left
// alone. The card mirrors CopyPromptButton's markup so the shared copy script
// (added below) drives it via the data-copy-* hooks.
function escapeHtml(s: string): string {
	return s
		.replace(/&/g, '&amp;')
		.replace(/</g, '&lt;')
		.replace(/>/g, '&gt;');
}
function decodeEntities(s: string): string {
	return s
		.replace(/&amp;/g, '&')
		.replace(/&lt;/g, '<')
		.replace(/&gt;/g, '>')
		.replace(/&quot;/g, '"')
		.replace(/&#39;|&apos;/g, "'");
}

const COPY_ICON =
	'<svg class="copy-icon-copy" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>';
const DONE_ICON =
	'<svg class="copy-icon-done hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><polyline stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" points="20 6 9 17 4 12"/></svg>';
const QUOTE_ICON =
	'<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.5 6C5.6 6 4 7.6 4 9.5S5.6 13 7.5 13c.2 0 .3 0 .5-.05V13a3 3 0 0 1-3 3 1 1 0 1 0 0 2 5 5 0 0 0 5-5V9.5C10 7.6 9.4 6 7.5 6Zm9 0C14.6 6 13 7.6 13 9.5s1.6 3.5 3.5 3.5c.2 0 .3 0 .5-.05V13a3 3 0 0 1-3 3 1 1 0 1 0 0 2 5 5 0 0 0 5-5V9.5C19 7.6 18.4 6 16.5 6Z"/></svg>';

function promptCard(label: string, text: string): string {
	const words = text.trim().split(/\s+/).filter(Boolean).length;
	return (
		`<div class="blog-prompt not-prose" data-copy-root>` +
		`<div class="blog-prompt__bar">` +
		`<div class="blog-prompt__meta">${QUOTE_ICON}` +
		`<span class="blog-prompt__label">${escapeHtml(label)}</span>` +
		`<span class="blog-prompt__count">${words} ${words === 1 ? 'word' : 'words'}</span>` +
		`</div>` +
		`<button type="button" class="blog-prompt__btn btn-feedback" data-copy-btn aria-live="polite">` +
		`${COPY_ICON}${DONE_ICON}<span class="copy-label">Copy</span></button>` +
		`</div>` +
		`<pre class="prompt-box" data-copy-text>${escapeHtml(text)}</pre>` +
		`</div>`
	);
}

function renderPromptBlocks(html: string): string {
	// Whole paragraph = [optional short label] + a single quoted <em>.
	const pattern =
		/^\s*(?:<strong>\s*([^<:]{1,24}?)\s*:?\s*<\/strong>\s*:?\s*|([A-Za-z][A-Za-z ]{0,20}?)\s*:\s*)?<em>\s*[“"]([\s\S]+?)[”"]\s*<\/em>\s*[.]?\s*$/;
	return html.replace(/<p>([\s\S]*?)<\/p>/gi, (match, inner) => {
		const m = pattern.exec(inner);
		if (!m) return match;
		const text = decodeEntities(m[3].replace(/<[^>]+>/g, '')).trim();
		// Skip throwaway fragments; real prompts are a few words at least.
		if (text.split(/\s+/).filter(Boolean).length < 4) return match;
		let label = (m[1] || m[2] || 'Prompt').trim();
		label = label.charAt(0).toUpperCase() + label.slice(1);
		return promptCard(label, text);
	});
}

const rawBody = post.htmlContent || post.content.intro || '';
const { html: builtHtml, toc } = buildToc(rawBody);
const withPrompts = renderPromptBlocks(builtHtml);
// Lazy-load + async-decode every in-body image (they're below the fold) so the
// page doesn't eagerly fetch 20 MB of images on load. Only images without an
// explicit loading attr are touched.
const bodyHtml = withPrompts.replace(/<img(?![^>]*\bloading=)/gi, '<img loading="lazy" decoding="async"');

// Strip HTML to plain text for articleBody + wordCount. Truncate body so the
// JSON-LD payload stays small while still giving AI engines enough to cite.
const plainBody = bodyHtml.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const wordCount = plainBody ? plainBody.split(/\s+/).filter(Boolean).length : 0;
const articleBody = plainBody.length > 5000 ? `${plainBody.slice(0, 5000)}…` : plainBody;

const postUrl = new URL(`/blog/${post.slug}`, Astro.site).href;

const postSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.title,
	description: post.excerpt,
	datePublished: new Date(dateIso).toISOString(),
	dateModified: new Date(post.updatedAt ?? dateIso).toISOString(),
	author: { '@type': 'Person', name: authorName },
	publisher: publisherBlock(),
	url: postUrl,
	mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
	inLanguage: 'en',
	...(wordCount > 0 ? { wordCount, articleBody } : {}),
	// `image` is required for Article/BlogPosting rich results. Always emit one —
	// fall back to the branded, generated OG card (absolute) when the post has no
	// cover, mirroring the ogImage fallback below.
	image: post.coverImage
		? new URL(post.coverImage, Astro.site).href
		: new URL(`/og/${post.slug}.svg`, Astro.site).href,
};

// FAQPage schema gets a separate JSON-LD block (Google's preferred shape).
const faqSchema =
	post.faqItems.length > 0
		? {
				'@context': 'https://schema.org',
				'@type': 'FAQPage',
				mainEntity: post.faqItems.map((it) => ({
					'@type': 'Question',
					name: it.question,
					acceptedAnswer: { '@type': 'Answer', text: it.answer },
				})),
			}
		: null;

const breadcrumb = breadcrumbSchema([
	{ name: 'Home', path: '/' },
	{ name: 'Blog', path: '/blog' },
	{ name: post.title, path: `/blog/${post.slug}` },
]);
---

<Layout
	title={`${post.title} — Free Prompt Base`}
	description={post.excerpt}
	schema={postSchema}
	extraSchemas={[breadcrumb, ...(faqSchema ? [faqSchema] : [])]}
	ogType="article"
	ogImage={post.coverImage ?? `/og/${post.slug}.svg`}
	preloadImage={post.coverImage ?? undefined}
	preloadImageSrcset={post.coverImage ? cfSrcset(post.coverImage, [400, 768, 1200, 1600]) : undefined}
	preloadImageSizes="(min-width: 1024px) 768px, 92vw"
>
	<Header />
	<div class="read-progress" id="read-progress" aria-hidden="true"></div>

	<main class="flex-grow site-main py-8 sm:py-12">
		<!-- Breadcrumb -->
		<nav class="text-xs text-[var(--ink-faint)] mb-8 flex flex-wrap items-center gap-1.5" aria-label="Breadcrumb">
			<a href="/" class="hover:text-secondary transition-colors">Home</a>
			<span class="text-[var(--hairline)]" aria-hidden="true">/</span>
			<a href="/blog" class="hover:text-secondary transition-colors">Field Notes</a>
			<span class="text-[var(--hairline)]" aria-hidden="true">/</span>
			<span class="text-text-primary truncate max-w-[55%]">{post.title}</span>
		</nav>

		<div class="lg:flex lg:gap-14 lg:items-start">
			<!-- Article column -->
			<article class="lg:flex-1 lg:max-w-3xl min-w-0">
				<!-- Title + dek -->
				<header class="mb-8">
					{
						post.categoryName && (
							<p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary mb-4">
								{post.categoryName}
							</p>
						)
					}
					<h1 class="text-3xl sm:text-4xl md:text-[2.875rem] font-bold tracking-tight text-text-primary leading-[1.1]">
						{post.title}
					</h1>
					<p class="text-[var(--ink-soft)] text-lg sm:text-xl leading-relaxed mt-5 max-w-[44rem]">
						{post.excerpt}
					</p>
				</header>

				<!-- Byline -->
				<div class="flex items-center gap-3 pb-7 mb-9 border-b border-[var(--hairline)]">
					{
						post.authorAvatar ? (
							<img
								src={post.authorAvatar}
								alt={authorName}
								class="w-11 h-11 rounded-full object-cover shrink-0 ring-1 ring-[var(--hairline)]"
								width="44"
								height="44"
								loading="lazy"
								decoding="async"
							/>
						) : (
							<div class="w-11 h-11 rounded-full shrink-0 bg-primary/15 text-primary flex items-center justify-center text-sm font-bold ring-1 ring-[var(--hairline)]" aria-hidden="true">
								{authorInitials}
							</div>
						)
					}
					<div class="min-w-0">
						<p class="text-sm font-semibold text-text-primary leading-tight">{authorName}</p>
						<div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs text-[var(--ink-faint)] mt-0.5">
							<span>{dateLabel}</span>
							<span aria-hidden="true">·</span>
							<span>{post.readTime || `${mins} min read`}</span>
						</div>
					</div>
				</div>

				<!-- Cover (breaks slightly wider than the reading measure) -->
				{
					post.coverImage && (
						<img
							src={post.coverImage}
							srcset={cfSrcset(post.coverImage, [400, 768, 1200, 1600])}
							sizes="(min-width: 1024px) 768px, 92vw"
							alt={post.title}
							width="1600"
							height="900"
							class="w-full aspect-[16/9] rounded-base mb-12 object-cover bg-[var(--paper-sunken)]"
							loading="eager"
							fetchpriority="high"
							decoding="async"
						/>
					)
				}

				<!-- Mobile-only TOC (collapsed) -->
				{
					toc.length > 1 && (
						<details class="lg:hidden mb-10 border border-[var(--hairline)] rounded-md bg-[var(--paper)] group">
							<summary class="px-4 py-3 cursor-pointer text-sm font-semibold text-text-primary flex items-center gap-2 list-none">
								<svg class="w-4 h-4 text-[var(--ink-faint)] transition-transform group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
								<span>On this page</span>
								<span class="ml-auto text-xs font-normal text-[var(--ink-faint)]">{toc.length}</span>
							</summary>
							<nav class="border-t border-[var(--hairline)] px-4 py-3">
								<ol class="space-y-1.5 text-sm">
									{toc.map((h) => (
										<li class={h.level === 3 ? 'pl-4' : ''}>
											<a href={`#${h.id}`} class="text-[var(--ink-soft)] hover:text-secondary transition-colors block py-0.5">
												{h.text}
											</a>
										</li>
									))}
								</ol>
							</nav>
						</details>
					)
				}

				<!-- Body -->
				<div class="prose-blog" set:html={bodyHtml} />

				<!-- End-of-article CTA — back to the product. -->
				<aside class="mt-14 rounded-base bg-[var(--paper)] border border-[var(--hairline)] px-6 py-7 sm:px-8 sm:py-8">
					<p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary mb-2">Now your turn</p>
					<h2 class="text-xl sm:text-2xl font-bold text-text-primary leading-snug">
						Stop reading about prompts. Go copy one.
					</h2>
					<p class="text-sm text-[var(--ink-soft)] mt-2 leading-relaxed max-w-md">
						A free, browsable library of ready-to-use prompts for ChatGPT, Claude, Midjourney and more.
					</p>
					<a
						href="/"
						class="btn-primary inline-flex items-center gap-2 mt-5 btn-feedback group"
					>
						Browse the prompt library
						<svg class="w-4 h-4 transition-transform duration-300 ease-out group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
					</a>
				</aside>

				<!-- FAQ (if present) -->
				{
					post.faqItems.length > 0 && (
						<section class="mt-14 pt-10 border-t border-[var(--hairline)]">
							<p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--ink-faint)] mb-2">FAQ</p>
							<h2 class="text-2xl font-bold text-text-primary mb-6">Frequently asked</h2>
							<div class="space-y-3">
								{post.faqItems.map((item) => (
									<details class="border border-[var(--hairline)] rounded-md bg-[var(--paper)] group">
										<summary class="px-4 py-3.5 cursor-pointer text-sm font-semibold text-text-primary flex items-center gap-2.5 list-none">
											<svg class="w-4 h-4 text-[var(--ink-faint)] transition-transform group-open:rotate-90 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
											<span>{item.question}</span>
										</summary>
										<div class="px-4 pb-4 pt-0 pl-11 text-[var(--ink-soft)] leading-relaxed whitespace-pre-wrap">
											{item.answer}
										</div>
									</details>
								))}
							</div>
						</section>
					)
				}

				<!-- Related -->
				{
					related.length > 0 && (
						<section class="mt-16 pt-10 border-t border-[var(--hairline)]">
							<p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--ink-faint)] mb-2">More to read</p>
							<h2 class="text-2xl font-bold text-text-primary mb-5">Keep reading</h2>
							<ol class="border-t border-[var(--hairline)]">
								{related.map((rel) => (
									<li>
										<a
											href={`/blog/${rel.slug}`}
											class="entry-row group flex items-center gap-4 py-4 px-3 -mx-3 rounded-lg border-b border-[var(--hairline)]"
										>
											<div class="w-14 h-14 shrink-0 overflow-hidden rounded-md bg-[var(--paper-sunken)]">
												{rel.coverImage ? (
													<img
														src={rel.coverImage}
														srcset={cfSrcset(rel.coverImage, [120, 200])}
														sizes="56px"
														alt={rel.title}
														class="w-full h-full object-cover"
														loading="lazy"
														decoding="async"
													/>
												) : (
													<div class="w-full h-full flex items-center justify-center text-text-primary/30">
														<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h12a4 4 0 0 1 4 4v12H8a4 4 0 0 1-4-4V4z"/><path d="M8 9h8M8 13h8"/></svg>
													</div>
												)}
											</div>
											<div class="min-w-0 flex-1">
												<h3 class="text-base font-bold text-text-primary leading-snug group-hover:text-secondary transition-colors line-clamp-2">
													{rel.title}
												</h3>
												<div class="text-xs text-[var(--ink-faint)] mt-1">
													{new Date(rel.publishedAt ?? rel.createdAt).toLocaleDateString('en-US', {
														month: 'short',
														day: 'numeric',
														year: 'numeric',
													})}
												</div>
											</div>
											<svg class="w-4 h-4 shrink-0 text-[var(--ink-faint)] group-hover:text-secondary transition-all duration-300 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
										</a>
									</li>
								))}
							</ol>
						</section>
					)
				}
			</article>

			<!-- Sticky TOC (lg+) -->
			{
				toc.length > 1 && (
					<aside class="hidden lg:block lg:w-56 lg:shrink-0">
						<div class="sticky top-20">
							<p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-[var(--ink-faint)] mb-4">
								On this page
							</p>
							<nav aria-label="Table of contents">
								<ol class="space-y-2 text-sm border-l border-[var(--hairline)] pl-4">
									{toc.map((h) => (
										<li class:list={[h.level === 3 && 'pl-3']}>
											<a
												href={`#${h.id}`}
												data-toc-link
												data-target={h.id}
												class="block py-0.5 text-[var(--ink-soft)] hover:text-secondary transition-colors leading-snug"
											>
												{h.text}
											</a>
										</li>
									))}
								</ol>
							</nav>
						</div>
					</aside>
				)
			}
		</div>
	</main>
	<Footer />
</Layout>

<style is:global>
	.prose-blog {
		max-width: 68ch;
		color: var(--color-text-primary, #1f2937);
		font-family: var(--font-serif);
		font-size: 1.1rem;
		line-height: 1.75;
	}
	@media (min-width: 640px) {
		.prose-blog {
			font-size: 1.1875rem;
			line-height: 1.8;
		}
	}
	.prose-blog > :first-child {
		margin-top: 0;
	}
	/* Headings stay in the brand sans for contrast against the serif body. */
	.prose-blog h2,
	.prose-blog h3 {
		font-family: var(--font-heading);
	}
	.prose-blog h2 {
		font-size: 1.5rem;
		font-weight: 700;
		margin-top: 2.75rem;
		margin-bottom: 0.75rem;
		letter-spacing: -0.015em;
		scroll-margin-top: 5rem;
		line-height: 1.2;
		color: var(--color-text-primary);
	}
	@media (min-width: 640px) {
		.prose-blog h2 {
			font-size: 1.75rem;
			margin-top: 3.25rem;
		}
	}
	.prose-blog h3 {
		font-size: 1.25rem;
		font-weight: 700;
		margin-top: 2.25rem;
		margin-bottom: 0.5rem;
		scroll-margin-top: 5rem;
		line-height: 1.3;
		color: var(--color-text-primary);
	}
	.prose-blog p {
		margin-top: 1.15rem;
		margin-bottom: 1.15rem;
		color: #2b2b2b;
	}
	.prose-blog ul,
	.prose-blog ol {
		margin: 1.15rem 0;
		padding-left: 1.5rem;
		color: #2b2b2b;
	}
	.prose-blog ul {
		list-style: disc;
	}
	.prose-blog ol {
		list-style: decimal;
	}
	.prose-blog li {
		margin: 0.35rem 0;
	}
	.prose-blog li::marker {
		color: var(--color-primary);
	}
	.prose-blog a {
		color: var(--color-text-primary);
		text-decoration: underline;
		text-decoration-color: var(--color-primary);
		text-decoration-thickness: 2px;
		text-underline-offset: 3px;
		transition: color 150ms ease;
	}
	.prose-blog a:hover {
		color: var(--color-primary);
	}
	.prose-blog strong {
		color: #111827;
		font-weight: 700;
	}
	.prose-blog em {
		font-style: italic;
	}
	/* Inline code + blocks switch back to mono (serif numerals look wrong in code). */
	.prose-blog code {
		background: var(--paper-sunken);
		border: 1px solid var(--hairline);
		border-radius: 4px;
		padding: 0.08rem 0.35rem;
		font-size: 0.85em;
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		color: #211D16;
	}
	.prose-blog pre {
		background: #211D16;
		color: #ececf1;
		padding: 1.1rem 1.25rem;
		border-radius: 10px;
		overflow-x: auto;
		margin: 1.75rem 0;
		font-size: 0.9rem;
		line-height: 1.65;
	}
	.prose-blog pre code {
		background: transparent;
		border: 0;
		padding: 0;
		color: inherit;
	}
	/* Pull-quote: top/bottom hairlines, no side-stripe. */
	.prose-blog blockquote {
		margin: 2.25rem 0;
		padding: 1.5rem 0;
		border-top: 1px solid var(--hairline);
		border-bottom: 1px solid var(--hairline);
		font-size: 1.3em;
		line-height: 1.5;
		font-style: italic;
		color: var(--color-text-primary);
	}
	.prose-blog blockquote p {
		margin: 0;
		color: inherit;
	}
	.prose-blog img {
		border-radius: 10px;
		margin: 1.75rem 0;
	}
	.prose-blog hr {
		border: 0;
		border-top: 1px solid var(--hairline);
		margin: 2.75rem 0;
