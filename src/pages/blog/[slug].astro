<script>
	// --- Reading-progress bar ---------------------------------------------
	// Drives --read-progress (0..1) from scroll position; the CSS scales the
	// bar with a transform. Hidden under prefers-reduced-motion via CSS.
	const bar = document.getElementById('read-progress');
	const pctEls = Array.from(document.querySelectorAll<HTMLElement>('[data-read-pct]'));
	if (bar) {
		let ticking = false;
		let lastPct = -1;
		const update = () => {
			const doc = document.documentElement;
			const max = doc.scrollHeight - doc.clientHeight;
			const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
			bar.style.setProperty('--read-progress', String(ratio));
			const pct = Math.round(ratio * 100);
			if (pct !== lastPct) {
				lastPct = pct;
				pctEls.forEach((el) => (el.textContent = `${pct}%`));
			}
			ticking = false;
		};
		const onScroll = () => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		};
		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', onScroll, { passive: true });
		update();
	}

	// --- Copy buttons on inline prompt cards ------------------------------
	document.querySelectorAll<HTMLElement>('[data-copy-root]').forEach((root) => {
		const btn = root.querySelector<HTMLButtonElement>('[data-copy-btn]');
		const source = root.querySelector<HTMLElement>('[data-copy-text]');
		const label = root.querySelector<HTMLElement>('.copy-label');
		const iconCopy = root.querySelector<SVGElement>('.copy-icon-copy');
		const iconDone = root.querySelector<SVGElement>('.copy-icon-done');
		if (!btn || !source || !label) return;
		const text = source.textContent ?? '';
		let resetTimer: ReturnType<typeof setTimeout> | undefined;
		const reset = () => {
			label.textContent = 'Copy';
			iconDone?.classList.add('hidden');
			iconCopy?.classList.remove('hidden');
		};
		btn.addEventListener('click', async () => {
			try {
				if (navigator.clipboard?.writeText) {
					await navigator.clipboard.writeText(text);
				} else {
					const ta = document.createElement('textarea');
					ta.value = text;
					ta.style.position = 'fixed';
					ta.style.opacity = '0';
					document.body.appendChild(ta);
					ta.select();
					document.execCommand('copy');
					document.body.removeChild(ta);
				}
				label.textContent = 'Copied!';
				iconCopy?.classList.add('hidden');
				iconDone?.classList.remove('hidden');
			} catch {
				label.textContent = 'Press Ctrl/⌘+C';
			}
			clearTimeout(resetTimer);
			resetTimer = setTimeout(reset, 2000);
		});
	});

	// --- Highlight the TOC item whose section is currently visible. -------
	const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
	if (links.length > 0) {
		const targets = links
			.map((l) => document.getElementById(l.dataset.target || ''))
			.filter((el): el is HTMLElement => !!el);

		const map = new Map<HTMLElement, HTMLAnchorElement>();
		links.forEach((l, i) => {
			const t = targets[i];
			if (t) map.set(t, l);
		});

		const progress = document.querySelector<HTMLElement>('[data-toc-progress]');
		const track = document.querySelector<HTMLElement>('.toc-track');
		const moveProgress = (a: HTMLAnchorElement | null) => {
			if (!progress || !track || !a) return;
			const tr = track.getBoundingClientRect();
			const ar = a.getBoundingClientRect();
			const h = Math.max(0, Math.min(tr.height, ar.top + ar.height / 2 - tr.top));
			progress.style.height = `${h}px`;
		};

		const setActive = (a: HTMLAnchorElement | null) => {
			links.forEach((l) => l.classList.remove('is-active'));
			if (a) a.classList.add('is-active');
			moveProgress(a);
		};

		const observer = new IntersectionObserver(
			(entries) => {
				const visible = entries
					.filter((e) => e.isIntersecting)
					.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
				if (visible) {
					const link = map.get(visible.target as HTMLElement);
					if (link) setActive(link);
				}
			},
			{ rootMargin: '-80px 0px -70% 0px', threshold: [0, 1] },
		);

		targets.forEach((t) => observer.observe(t));
		// Default to first link on load
		setActive(links[0] || null);
		// Keep the gold fill aligned when the layout reflows.
		window.addEventListener(
			'resize',
			() => moveProgress(document.querySelector<HTMLAnchorElement>('[data-toc-link].is-active')),
			{ passive: true },
		);
	}
</script>
