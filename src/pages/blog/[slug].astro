---
import ArticleDetail from '../../components/ArticleDetail.astro';
import { getPostBySlug } from '../../lib/posts';
import { isRemovedPostSlug, removedPostGoneResponse } from '../../data/removed-posts';

export const prerender = false;

const slug = Astro.params.slug!;
if (isRemovedPostSlug(slug)) {
	return removedPostGoneResponse();
}

const post = await getPostBySlug(slug);

if (!post) {
	return Astro.rewrite('/404');
}

if (post.contentType === 'news') {
	return Astro.redirect(`/news/${post.slug}`, 301);
}
---

<ArticleDetail post={post} />
