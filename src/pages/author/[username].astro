---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PromptGrid from '../../components/PromptGrid.astro';
import { getAllCategories, getPromptsByAuthor } from '../../lib/prompts';
import { getUserByUsername } from '../../lib/users';
import { cfSrcset } from '../../lib/cfImage';

const username = Astro.params.username!;
const profileUser = await getUserByUsername(username);
if (!profileUser) {
	return Astro.rewrite('/404');
}

const viewer = Astro.locals.user;
const isOwner = viewer?.id === profileUser.id;

const [allPromptsByAuthor, categories] = await Promise.all([
	getPromptsByAuthor(profileUser.id, { includeAll: isOwner }),
	getAllCategories(),
]);

const approved = allPromptsByAuthor.filter((p) => (p.status ?? 'approved') === 'approved');
const pending = isOwner ? allPromptsByAuthor.filter((p) => p.status === 'pending') : [];
const rejected = isOwner ? allPromptsByAuthor.filter((p) => p.status === 'rejected') : [];

const justSubmittedSlug = Astro.url.searchParams.get('submitted') || '';

const noindex = approved.length === 0;

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: profileUser.name,
	image: profileUser.avatarUrl || undefined,
	description: profileUser.bio || undefined,
	url: `${(Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/$/, '')}/author/${profileUser.username}`,
	...((() => {
		const sameAs = [
			profileUser.twitter ? `https://twitter.com/${profileUser.twitter}` : null,
			profileUser.instagram ? `https://instagram.com/${profileUser.instagram}` : null,
			profileUser.website || null,
		].filter(Boolean);
		return sameAs.length ? { sameAs } : {};
	})()),
};

const title = `${profileUser.name} — prompts on Free Prompt Base`;
const description = profileUser.bio
	? profileUser.bio
	: `Prompts by ${profileUser.name} on Free Prompt Base.`;
---

<Layout
	title={title}
	description={description}
	schema={personSchema}
	noindex={noindex}
	preloadImage={approved[0]?.coverImage}
	preloadImageSrcset={approved[0]?.coverImage ? cfSrcset(approved[0].coverImage, [300, 400, 520, 660], 68) : undefined}
	preloadImageSizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 92vw"
>
	<Header />
	<main class="site-main py-10">
		{justSubmittedSlug && isOwner ? (
			<div class="mb-6 bg-amber-50 border border-amber-200 text-amber-900 rounded-md px-4 py-3 text-sm">
				<p class="font-semibold">Submitted — pending review</p>
				<p class="mt-0.5">Your prompt is in the moderation queue. We'll publish it as soon as an admin approves it.</p>
			</div>
		) : null}

		<header class="flex flex-col sm:flex-row sm:items-center gap-5 mb-10">
			{profileUser.avatarUrl ? (
							<img src={profileUser.avatarUrl} alt={profileUser.name} width="80" height="80" class="w-20 h-20 rounded-full object-cover bg-gray-100" referrerpolicy="no-referrer" />
			) : (
				<div class="w-20 h-20 rounded-full bg-gray-200 flex items-center justify-center text-2xl font-semibold text-gray-500">
					{profileUser.name.slice(0, 1).toUpperCase()}
				</div>
			)}
			<div class="flex-1 min-w-0">
				<h1 class="text-3xl md:text-4xl font-bold tracking-tight text-text-primary">{profileUser.name}</h1>
				<p class="text-sm text-gray-600 mt-1">@{profileUser.username}</p>
				{profileUser.bio ? <p class="text-gray-700 mt-3 max-w-2xl">{profileUser.bio}</p> : null}
				{(profileUser.twitter || profileUser.instagram || profileUser.website) ? (
					<div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 mt-3 text-sm">
						{profileUser.twitter ? (
							<a href={`https://twitter.com/${profileUser.twitter}`} target="_blank" rel="noopener nofollow" class="inline-flex items-center gap-1.5 text-gray-600 hover:text-secondary transition-colors">
								<svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
								@{profileUser.twitter}
							</a>
						) : null}
						{profileUser.instagram ? (
							<a href={`https://instagram.com/${profileUser.instagram}`} target="_blank" rel="noopener nofollow" class="inline-flex items-center gap-1.5 text-gray-600 hover:text-secondary transition-colors">
								<svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
								@{profileUser.instagram}
							</a>
						) : null}
						{profileUser.website ? (
							<a href={profileUser.website} target="_blank" rel="noopener nofollow" class="inline-flex items-center gap-1.5 text-gray-600 hover:text-secondary transition-colors">
								<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
								{profileUser.website.replace(/^https?:\/\//, '').replace(/\/$/, '')}
							</a>
						) : null}
					</div>
				) : null}
			</div>
			{isOwner ? (
				<div class="flex gap-2 shrink-0">
					<a href="/submit" class="btn-primary">
						Submit a prompt
					</a>
					<a href="/account" class="btn-secondary">
						Edit profile
					</a>
				</div>
			) : null}
		</header>

		<section class="mb-12">
			<div class="flex items-baseline justify-between mb-5">
				<h2 class="text-xl font-semibold text-text-primary">
					{approved.length === 1 ? 'Prompt' : 'Prompts'}
					<span class="text-gray-600 font-normal ml-2">{approved.length}</span>
				</h2>
			</div>
			{approved.length > 0 ? (
				<PromptGrid prompts={approved} categories={categories} />
			) : (
				<p class="text-gray-500 py-8">
					{isOwner
						? "You haven't had any prompts approved yet. Submit one to get started."
						: `${profileUser.name} hasn't published any prompts yet.`}
				</p>
			)}
		</section>

		{isOwner && (pending.length > 0 || rejected.length > 0) ? (
			<section class="border-t border-gray-200 pt-10 space-y-10">
				<p class="text-xs uppercase tracking-wide text-gray-600 font-semibold">Only you can see this section</p>

				{pending.length > 0 && (
					<div>
						<h2 class="text-lg font-semibold text-text-primary mb-4">
							Pending review
							<span class="text-gray-600 font-normal ml-2">{pending.length}</span>
						</h2>
						<ul class="space-y-3">
							{pending.map((p) => (
								<li class="border border-amber-200 bg-amber-50/40 rounded-md px-4 py-3 flex items-center justify-between gap-3">
									<div class="min-w-0">
										<p class="font-medium text-text-primary truncate">{p.title}</p>
										<p class="text-xs text-gray-500 mt-0.5">Submitted {p.submittedAt?.slice(0, 10) ?? ''}</p>
									</div>
									<span class="text-xs font-semibold uppercase tracking-wide text-amber-700 shrink-0">Awaiting review</span>
								</li>
							))}
						</ul>
					</div>
				)}

				{rejected.length > 0 && (
					<div>
						<h2 class="text-lg font-semibold text-text-primary mb-4">
							Rejected
							<span class="text-gray-600 font-normal ml-2">{rejected.length}</span>
						</h2>
						<ul class="space-y-3">
							{rejected.map((p) => (
								<li class="border border-gray-200 rounded-md px-4 py-3">
									<div class="flex items-center justify-between gap-3">
										<p class="font-medium text-text-primary truncate">{p.title}</p>
										<span class="text-xs font-semibold uppercase tracking-wide text-gray-500 shrink-0">Rejected</span>
									</div>
									{p.rejectionReason ? (
										<p class="text-sm text-gray-600 mt-2">
											<span class="font-semibold">Reason:</span> {p.rejectionReason}
										</p>
									) : null}
								</li>
							))}
						</ul>
					</div>
				)}
			</section>
		) : null}
	</main>
	<Footer />
</Layout>
