---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Footer from '../components/Footer.astro';
import { getAllTags } from '../lib/prompts';
import { itemListSchema, breadcrumbSchema } from '../lib/seo';
import { isTagIndexable, TAG_HUB_SLUG_SET } from '../data/tag-seo';

export const prerender = false;

const tags = getAllTags()
	.filter((t) => isTagIndexable(t.slug))
	.sort((a, b) => {
		const ah = TAG_HUB_SLUG_SET.has(a.slug) ? 0 : 1;
		const bh = TAG_HUB_SLUG_SET.has(b.slug) ? 0 : 1;
		if (ah !== bh) return ah - bh;
		return a.name.localeCompare(b.name);
	});

const list = itemListSchema(
	tags.map((t) => ({ name: t.name, url: `/${t.slug}` })),
	'Prompt keywords',
);
const crumb = breadcrumbSchema([
	{ name: 'Home', path: '/' },
	{ name: 'Tags', path: '/tags' },
]);
---

<Layout
	title="Browse prompts by keyword | Free Prompt Base"
	description="Gemini photo prompts, nano banana prompts, couple prompts, and other searches people type. Free to copy."
	extraSchemas={[list, crumb]}
>
	<Header />
	<main class="flex-grow site-main py-12">
		<Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Tags' }]} />
		<header class="text-center mb-12">
			<h1 class="text-3xl md:text-4xl font-bold tracking-tight text-text-primary">
				Browse by keyword
			</h1>
			<p class="text-gray-600 text-lg mt-3">
				{tags.length} keywords people search for, with free prompts ready to paste.
			</p>
		</header>

		<div class="flex flex-wrap gap-2.5">
			{
				tags.map((t) => (
					<a
						href={`/${t.slug}`}
						class="bg-gray-100 hover:bg-gray-200 text-gray-800 text-sm font-medium px-3.5 py-2 rounded-lg transition-colors"
					>
						{t.name}
					</a>
				))
			}
		</div>
	</main>
	<Footer />
</Layout>
