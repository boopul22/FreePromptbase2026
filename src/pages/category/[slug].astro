---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CategoryChips from '../../components/CategoryChips.astro';
import PromptGrid from '../../components/PromptGrid.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import {
	getAllCategories,
	getCategoryBySlug,
	getPromptsByCategory,
} from '../../lib/prompts';
import { itemListSchema, breadcrumbSchema } from '../../lib/seo';
import { cfSrcset } from '../../lib/cfImage';
import { pillColor } from '../../lib/pills';

// On-demand: resolve the category + its prompts from D1 at request time.
export const prerender = false;

const slug = Astro.params.slug!;
const category = await getCategoryBySlug(slug);
if (!category) {
	return Astro.rewrite('/404');
}

const [prompts, categories] = await Promise.all([
	getPromptsByCategory(slug),
	getAllCategories(),
]);

const list = itemListSchema(
	prompts.slice(0, 30).map((p) => ({ name: p.title, url: `/${p.slug}` })),
	`${category.name} prompts`,
);
const crumb = breadcrumbSchema([
	{ name: 'Home', path: '/' },
	{ name: 'Categories', path: '/categories' },
	{ name: category.name, path: `/category/${category.slug}` },
]);
---

<Layout
	title={`${category.name} prompts — Free Prompt Base`}
	description={category.description}
	extraSchemas={[list, crumb]}
	preloadImage={prompts[0]?.coverImage}
	preloadImageSrcset={prompts[0]?.coverImage ? cfSrcset(prompts[0].coverImage, [300, 400, 520, 660], 68) : undefined}
	preloadImageSizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 92vw"
>
	<Header />
	<main class="flex-grow site-main py-10">
		<!-- Breadcrumb — matches the detail page (home glyph, chevrons, colour pill). -->
		<nav class="mb-5 flex flex-wrap items-center gap-2 text-xs" aria-label="Breadcrumb">
			<a href="/" class="inline-flex items-center gap-1 font-semibold text-text-primary hover:text-secondary transition-colors">
				<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
				Home
			</a>
			<svg class="w-3.5 h-3.5 text-gray-300 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
			<a href="/categories" class="font-semibold text-text-primary hover:text-secondary transition-colors">Categories</a>
			<svg class="w-3.5 h-3.5 text-gray-300 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
			<span class={`pill ${pillColor(category.slug)}`}>
				<CategoryIcon slug={category.slug} class="w-3 h-3" />
				{category.name}
			</span>
		</nav>

		<header class="mb-8 flex items-start gap-4">
			<div class={`${pillColor(category.slug)} shrink-0 flex items-center justify-center w-14 h-14 rounded-base border`}>
				<CategoryIcon slug={category.slug} class="w-7 h-7" />
			</div>
			<div class="min-w-0">
				<h1 class="text-3xl md:text-4xl font-bold tracking-tight text-text-primary">
					{category.name}
				</h1>
				<p class="text-gray-600 text-lg mt-2 max-w-2xl">{category.description}</p>
				<p class="text-sm font-medium text-gray-500 mt-2">
					{prompts.length} {prompts.length === 1 ? 'prompt' : 'prompts'}
				</p>
			</div>
		</header>

		<div class="mb-10">
			<CategoryChips categories={categories} active={category.slug} />
		</div>

		{
			prompts.length > 0 ? (
				<PromptGrid prompts={prompts} categories={categories} />
			) : (
				<p class="text-center text-gray-500 py-16">
					No prompts in this category yet. Check back soon!
				</p>
			)
		}
	</main>
	<Footer />
</Layout>
