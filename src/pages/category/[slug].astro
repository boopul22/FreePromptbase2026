---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CategoryChips from '../../components/CategoryChips.astro';
import PromptGrid from '../../components/PromptGrid.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import {
	getAllCategories,
	getCategoryBySlug,
	getPromptsByCategory,
} from '../../lib/prompts';
import { itemListSchema, breadcrumbSchema } from '../../lib/seo';
import { cfSrcset } from '../../lib/cfImage';

// On-demand: resolve the category + its prompts from D1 at request time.
export const prerender = false;

const slug = Astro.params.slug!;
const category = await getCategoryBySlug(slug);
if (!category) {
	return Astro.rewrite('/404');
}

const [prompts, categories] = await Promise.all([
	getPromptsByCategory(slug),
	getAllCategories(),
]);

const list = itemListSchema(
	prompts.slice(0, 30).map((p) => ({ name: p.title, url: `/${p.slug}` })),
	`${category.name} prompts`,
);
const crumb = breadcrumbSchema([
	{ name: 'Home', path: '/' },
	{ name: 'Categories', path: '/categories' },
	{ name: category.name, path: `/category/${category.slug}` },
]);
---

<Layout
	title={`${category.name} prompts — Free Prompt Base`}
	description={category.description}
	extraSchemas={[list, crumb]}
	preloadImage={prompts[0]?.coverImage}
	preloadImageSrcset={prompts[0]?.coverImage ? cfSrcset(prompts[0].coverImage, [300, 400, 520, 660], 68) : undefined}
	preloadImageSizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 92vw"
>
	<Header />
	<main class="flex-grow site-main py-10">
		<header class="mb-8">
			<CategoryIcon slug={category.slug} class="w-9 h-9 text-primary mb-3" />
			<h1 class="text-3xl md:text-4xl font-bold tracking-tight text-text-primary">
				{category.name}
			</h1>
			<p class="text-gray-600 text-lg mt-2">{category.description}</p>
			<p class="text-sm text-gray-600 mt-2">
				{prompts.length} {prompts.length === 1 ? 'prompt' : 'prompts'}
			</p>
		</header>

		<div class="mb-10">
			<CategoryChips categories={categories} active={category.slug} />
		</div>

		{
			prompts.length > 0 ? (
				<PromptGrid prompts={prompts} categories={categories} />
			) : (
				<p class="text-center text-gray-500 py-16">
					No prompts in this category yet. Check back soon!
				</p>
			)
		}
	</main>
	<Footer />
</Layout>
