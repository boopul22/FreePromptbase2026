---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { breadcrumbSchema } from '../lib/seo';

const crumb = breadcrumbSchema([
	{ name: 'Home', path: '/' },
	{ name: 'Contact', path: '/contact' },
]);
---

<Layout
	title="Contact Us — Free Prompt Base"
	description="Get in touch with Free Prompt Base. Suggest a prompt, report an issue, or ask a question — we'd love to hear from you."
	extraSchemas={[crumb]}
>
	<Header />
	<main class="flex-grow site-main py-10 sm:py-14">
		<Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} />

		<header class="max-w-2xl">
			<p class="text-xs font-semibold uppercase tracking-[0.18em] text-secondary mb-3">Contact</p>
			<h1 class="text-4xl md:text-5xl font-bold tracking-tight text-text-primary leading-[1.05]">Get in touch</h1>
			<p class="mt-4 text-lg text-gray-600 leading-relaxed">
				Have a suggestion for a new prompt category, found a problem, or just want to say hello?
				We'd love to hear from you.
			</p>
		</header>

		<div class="contact-grid mt-10">
			<!-- Contact form -->
			<div class="contact-card">
				<h2 class="text-xl font-bold text-text-primary mb-1" style="font-family: var(--font-heading);">Send a message</h2>
				<p class="text-sm text-gray-600 mb-5">We usually reply within a couple of days.</p>

				<form class="contact-form space-y-4" novalidate>
					<div class="grid sm:grid-cols-2 gap-4">
						<label class="block">
							<span class="contact-label">Name</span>
							<input type="text" name="name" autocomplete="name" required class="contact-input" placeholder="Your name" />
						</label>
						<label class="block">
							<span class="contact-label">Email</span>
							<input type="email" name="email" autocomplete="email" required class="contact-input" placeholder="you@email.com" />
						</label>
					</div>
					<label class="block">
						<span class="contact-label">Subject</span>
						<input type="text" name="subject" class="contact-input" placeholder="What's this about?" />
					</label>
					<label class="block">
						<span class="contact-label">Message</span>
						<textarea name="message" rows="6" required class="contact-input" placeholder="Write your message…"></textarea>
					</label>
					<div class="flex items-center gap-4 pt-1">
						<button type="submit" class="btn-primary contact-submit">Send message</button>
						<p class="contact-msg text-sm" role="status" aria-live="polite" hidden></p>
					</div>
				</form>
			</div>

			<!-- Aside: direct email + links -->
			<aside class="contact-aside">
				<div class="contact-panel">
					<p class="contact-label">Email us directly</p>
					<a href="mailto:blog.boopul@gmail.com" class="contact-email">blog.boopul@gmail.com</a>
					<p class="text-sm text-gray-600 mt-2">For general questions, partnerships, or feedback.</p>
				</div>
				<div class="contact-panel">
					<p class="contact-label">Quick links</p>
					<ul class="contact-links">
						<li><a href="/submit">Submit a prompt</a></li>
						<li><a href="/about">About Free Prompt Base</a></li>
						<li><a href="/privacy">Privacy Policy</a></li>
						<li><a href="/terms">Terms of Service</a></li>
					</ul>
				</div>
			</aside>
		</div>
	</main>
	<Footer />
</Layout>

<style>
	.contact-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
	}
	@media (min-width: 900px) {
		.contact-grid { grid-template-columns: minmax(0, 1fr) 300px; gap: 2.5rem; align-items: start; }
	}

	.contact-card {
		background: #fff;
		border: 1px solid var(--color-outline);
		border-radius: 14px;
		padding: 1.5rem;
		box-shadow: 0 1px 2px rgba(33, 29, 22, 0.04), 0 10px 30px -18px rgba(33, 29, 22, 0.25);
	}
	@media (min-width: 640px) { .contact-card { padding: 2rem 2.25rem; } }

	.contact-label {
		display: block;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-secondary);
		margin-bottom: 0.4rem;
	}
	.contact-input {
		width: 100%;
		background: var(--color-background);
		border: 1px solid var(--color-outline);
		border-radius: 8px;
		padding: 0.6rem 0.8rem;
		font-size: 0.95rem;
		color: var(--color-text-primary);
		transition: border-color 140ms ease, box-shadow 140ms ease;
	}
	.contact-input::placeholder { color: #9ca3af; }
	.contact-input:focus {
		outline: none;
		border-color: var(--color-primary);
		box-shadow: 0 0 0 3px oklch(0.925 0.135 99 / 0.35);
	}
	textarea.contact-input { resize: vertical; min-height: 7rem; }

	.contact-submit { border: 1px solid var(--color-link); }
	.contact-submit:disabled { opacity: 0.6; cursor: not-allowed; }

	.contact-aside { display: flex; flex-direction: column; gap: 1rem; }
	.contact-panel {
		background: var(--color-soft);
		border: 1px solid oklch(0.88 0.07 96);
		border-radius: 12px;
		padding: 1.1rem 1.25rem;
	}
	.contact-email {
		display: inline-block;
		font-weight: 600;
		color: var(--color-text-primary);
		text-decoration: underline;
		text-underline-offset: 2px;
		text-decoration-color: var(--color-primary);
		word-break: break-all;
	}
	.contact-links { list-style: none; margin: 0.25rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
	.contact-links a {
		font-size: 0.9rem;
		color: var(--color-text-primary);
		text-decoration: none;
		border-bottom: 1px solid transparent;
		transition: border-color 140ms ease;
	}
	.contact-links a:hover { border-bottom-color: var(--color-primary); }
</style>

<script>
	// Contact form via FormSubmit.co AJAX — no backend required.
	const form = document.querySelector<HTMLFormElement>('.contact-form');
	if (form) {
		const msg = form.querySelector<HTMLElement>('.contact-msg');
		const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
		const emailInput = form.querySelector<HTMLInputElement>('input[name="email"]');

		const show = (text: string, ok: boolean) => {
			if (!msg) return;
			msg.textContent = text;
			msg.style.color = ok ? '#15803d' : '#dc2626';
			msg.hidden = false;
		};

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const data = new FormData(form);
			const email = String(data.get('email') ?? '').trim();
			const message = String(data.get('message') ?? '').trim();
			if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
				show('Please enter a valid email.', false);
				emailInput?.focus();
				return;
			}
			if (!message) {
				show('Please write a message.', false);
				return;
			}
			if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
			try {
				const res = await fetch('https://formsubmit.co/ajax/blog.boopul@gmail.com', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
					body: JSON.stringify({
						name: data.get('name') || '',
						email,
						message,
						_subject: `Contact form: ${data.get('subject') || 'Free Prompt Base'}`,
					}),
				});
				if (!res.ok) throw new Error('Request failed');
				show('Thanks — your message is on its way.', true);
				form.reset();
			} catch {
				show('Something went wrong. Please email us directly.', false);
			} finally {
				if (btn) { btn.disabled = false; btn.textContent = 'Send message'; }
			}
		});
	}
</script>
