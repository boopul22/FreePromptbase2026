---
// ISR — SSR + edge cache. SSG speed with background refresh on CMS edits.
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getDB } from '../../lib/db';
import { breadcrumbSchema, publisherBlock } from '../../lib/seo';

const { slug } = Astro.params;
const db = getDB(Astro.locals);

const row = await db
 .prepare("SELECT * FROM pages WHERE slug = ? AND status = 'published'")
 .bind(slug)
 .first();

if (!row) {
 return new Response(null, { status: 404 });
}

// ISR: Cache at CDN edge for 10 min, serve stale up to 1 day while revalidating
Astro.response.headers.set('CDN-Cache-Control', 'public, max-age=600, stale-while-revalidate=86400');
Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');

const page = row as any;
const title = page.meta_title || page.title;

// Derive a meta description: prefer the authored one, else the first ~155 chars
// of the rendered content with tags/whitespace stripped, so these CMS pages are
// never left with the generic site-wide fallback description.
const plainText = String(page.content ?? '')
 .replace(/<[^>]+>/g, ' ')
 .replace(/\s+/g, ' ')
 .trim();
const description =
 page.meta_description ||
 (plainText ? plainText.slice(0, 155).trim() + (plainText.length > 155 ? '…' : '') : undefined);

const pageUrl = new URL(`/p/${page.slug}`, Astro.site).href;
const webPageSchema = {
 '@context': 'https://schema.org',
 '@type': 'WebPage',
 name: page.title,
 ...(description ? { description } : {}),
 url: pageUrl,
 inLanguage: 'en',
 ...(page.created_at ? { datePublished: new Date(page.created_at.replace(' ', 'T') + 'Z').toISOString() } : {}),
 ...(page.updated_at ? { dateModified: new Date(page.updated_at.replace(' ', 'T') + 'Z').toISOString() } : {}),
 isPartOf: { '@id': new URL('/#website', Astro.site).href },
 publisher: publisherBlock(),
};
const breadcrumb = breadcrumbSchema([
 { name: 'Home', path: '/' },
 { name: page.title, path: `/p/${page.slug}` },
]);
---

<Layout title={`${title} - Free Prompt Base`} description={description} schema={webPageSchema} extraSchemas={[breadcrumb]}>
 <Nav />

 <main class="flex-grow site-main py-12">
 <nav class="text-sm text-gray-500 mb-4" aria-label="Breadcrumb">
  <a href="/" class="hover:text-secondary">Home</a>
  <span class="mx-1.5">/</span>
  <span class="text-gray-700">{page.title}</span>
 </nav>
 <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-text-primary leading-tight">{page.title}</h1>
 <article class="prose-blog mt-8" set:html={page.content} />
 </main>

 <Footer />
</Layout>
