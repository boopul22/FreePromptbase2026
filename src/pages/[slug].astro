---
import PromptDetail from '../components/PromptDetail.astro';
import KeywordLanding from '../components/KeywordLanding.astro';
import { getPromptBySlug, getTagBySlug } from '../lib/prompts';
import { tagCanonicalTarget } from '../data/tag-seo';

// Root catch-all. A slug is resolved in priority order:
//   1. an approved prompt        -> full prompt detail page
//   2. a curated keyword (CSV)   -> keyword landing page at /<main-keyword>
//   3. neither                   -> 404
// Prompts win on collision so existing prompt URLs never change behaviour.
// Retired near-dupe keyword slugs 301 to their hub (tag-seo.ts).
export const prerender = false;

const slug = Astro.params.slug!;
const redirectTo = tagCanonicalTarget(slug);
if (redirectTo) {
	return Astro.redirect(`/${redirectTo}`, 301);
}
// Prompt and keyword slugs are always plain [a-z0-9-] (see generateSlug); a
// value with dots, encoded bytes, or other punctuation can never match, so skip
// the D1 lookup for it and go straight to the 404.
if (!/^[a-z0-9][a-z0-9_-]{0,199}$/i.test(slug)) {
	return Astro.rewrite('/404');
}
const prompt = await getPromptBySlug(slug);
const keyword = prompt ? null : getTagBySlug(slug);
if (!prompt && !keyword) {
	return Astro.rewrite('/404');
}
---

{prompt ? <PromptDetail prompt={prompt} /> : <KeywordLanding tag={keyword!} />}
