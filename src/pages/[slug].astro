---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CopyPromptButton from '../components/CopyPromptButton.astro';
import PromptCard from '../components/PromptCard.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import {
	getPromptBySlug,
	getCategoryBySlug,
	getRelatedPrompts,
	getAllCategories,
	readTime,
} from '../lib/prompts';
import { breadcrumbSchema } from '../lib/seo';

// On-demand: look the prompt up in D1 at request time.
export const prerender = false;

const slug = Astro.params.slug!;
const prompt = await getPromptBySlug(slug);
if (!prompt) {
	return Astro.rewrite('/404');
}

const category = await getCategoryBySlug(prompt.category);
const related = await getRelatedPrompts(prompt);
const categories = await getAllCategories();
const categoryBySlug = new Map(categories.map((c) => [c.slug, c]));

const dateLabel = new Date(prompt.date).toLocaleDateString('en-US', {
	month: 'short',
	day: 'numeric',
	year: 'numeric',
});
const mins = readTime(prompt);

// Use the gallery as og:image when present, otherwise the cover.
const heroImage =
	(prompt.images && prompt.images.length > 0 ? prompt.images[0] : prompt.coverImage) ?? undefined;

// Prefer the real creator name (from createdBy join) over the static author
// string for E-E-A-T signal; fall back to the author string.
const authorName = (prompt as unknown as { createdByName?: string }).createdByName || prompt.author;

const promptSchema: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: prompt.title,
	headline: prompt.title,
	description: prompt.description,
	datePublished: new Date(prompt.date).toISOString(),
	author: { '@type': 'Person', name: authorName },
	keywords: prompt.tags.join(', '),
	about: category?.name,
	url: new URL(`/${prompt.slug}`, Astro.site).href,
	inLanguage: 'en',
	isAccessibleForFree: true,
	text: prompt.promptText,
	...(prompt.images && prompt.images.length > 0
		? { image: prompt.images }
		: prompt.coverImage
			? { image: prompt.coverImage }
			: {}),
};

const breadcrumb = breadcrumbSchema([
	{ name: 'Home', path: '/' },
	...(category ? [{ name: category.name, path: `/category/${category.slug}` }] : []),
	{ name: prompt.title, path: `/${prompt.slug}` },
]);
---

<Layout
	title={`${prompt.title} — Free Prompt Base`}
	description={prompt.description}
	schema={promptSchema}
	extraSchemas={[breadcrumb]}
	ogType="article"
	ogImage={heroImage}
>
	<Header />
	<main class="flex-grow max-w-3xl mx-auto px-4 w-full py-8 sm:py-12">
		<!-- Breadcrumb -->
		<nav class="text-xs text-gray-500 mb-6 flex flex-wrap items-center gap-1.5" aria-label="Breadcrumb">
			<a href="/" class="hover:text-primary transition-colors">Home</a>
			<span class="text-gray-300" aria-hidden="true">/</span>
			{
				category && (
					<>
						<a href={`/category/${category.slug}`} class="hover:text-primary transition-colors">
							{category.name}
						</a>
						<span class="text-gray-300" aria-hidden="true">/</span>
					</>
				)
			}
			<span class="text-text-primary truncate max-w-[60%]">{prompt.title}</span>
		</nav>

		<!-- Title + lead -->
		<header class="mb-6">
			<h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-text-primary leading-[1.15]">
				{prompt.title}
			</h1>
			<p class="text-gray-600 text-lg sm:text-xl leading-relaxed mt-4 max-w-2xl">
				{prompt.description}
			</p>
		</header>

		<!-- Meta strip -->
		<div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-gray-500 pb-6 mb-8 border-b border-gray-200">
			{
				category && (
					<a
						href={`/category/${category.slug}`}
						class="inline-flex items-center gap-1.5 text-text-primary hover:text-primary font-semibold transition-colors"
					>
						<CategoryIcon slug={category.slug} class="w-3.5 h-3.5" />
						{category.name}
					</a>
				)
			}
			<span class="inline-flex items-center gap-1.5">
				<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
				{dateLabel}
			</span>
			<span class="inline-flex items-center gap-1.5">
				<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
				{mins} min read
			</span>
			<span class="inline-flex items-center gap-1.5">
				<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
				by <span class="text-text-primary font-medium">{prompt.author}</span>
			</span>
		</div>

		<!-- Gallery / cover -->
		{
			(prompt.images?.length ?? 0) > 1 ? (
				<div class="mb-10">
					<div
						class="flex gap-3 overflow-x-auto snap-x snap-mandatory pb-3 -mx-4 px-4 scroll-smooth"
						style="scrollbar-width: thin;"
					>
						{prompt.images!.map((src, i) => (
							<img
								src={src}
								alt={`${prompt.title} — image ${i + 1}`}
								class="snap-center shrink-0 w-full sm:w-[60%] md:w-[55%] rounded-base object-cover aspect-[4/3] bg-gray-100"
								loading={i === 0 ? 'eager' : 'lazy'}
							/>
						))}
					</div>
				</div>
			) : prompt.coverImage ? (
				<img
					src={prompt.coverImage}
					alt={prompt.title}
					class="w-full rounded-base mb-10 object-cover"
					loading="lazy"
				/>
			) : null
		}

		<!-- The prompt + copy -->
		<CopyPromptButton text={prompt.promptText} />

		<!-- How to use (tip card) -->
		{
			prompt.howToUse && (
				<aside class="mt-8 flex gap-3 sm:gap-4 bg-amber-50/60 border border-amber-200/60 rounded-base p-4 sm:p-5">
					<svg class="w-5 h-5 text-amber-700 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.74V17a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-2.26A7 7 0 0 0 12 2z"/>
					</svg>
					<div class="min-w-0">
						<h2 class="text-sm font-semibold text-amber-900 mb-1">How to use it</h2>
						<p class="text-sm text-amber-900/80 leading-relaxed whitespace-pre-wrap">{prompt.howToUse}</p>
					</div>
				</aside>
			)
		}

		<!-- Tags -->
		{
			prompt.tags.length > 0 && (
				<section class="mt-10 pt-6 border-t border-gray-200">
					<p class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-3">Tags</p>
					<div class="flex flex-wrap gap-1.5">
						{prompt.tags.map((tag) => (
							<span class="bg-gray-100 text-gray-700 text-xs font-medium px-2.5 py-1 rounded-md">
								#{tag}
							</span>
						))}
					</div>
				</section>
			)
		}

		<!-- Related -->
		{
			related.length > 0 && (
				<section class="mt-16 pt-10 border-t border-gray-200">
					<header class="mb-6">
						<p class="text-xs font-semibold uppercase tracking-wide text-gray-500">More like this</p>
						<h2 class="text-2xl font-bold text-text-primary mt-1">Related prompts</h2>
					</header>
					<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
						{related.map((rel) => (
							<PromptCard prompt={rel} category={categoryBySlug.get(rel.category)} />
						))}
					</div>
				</section>
			)
		}
	</main>
	<Footer />
</Layout>
