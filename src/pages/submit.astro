---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getAllCategories } from '../lib/prompts';
import { issueCaptcha } from '../lib/captcha';

const user = Astro.locals.user!;
const categories = await getAllCategories();
const captcha = await issueCaptcha();

const MAX_IMAGES = 3;
const MAX_FILE_MB = 5;
---

<Layout title="Submit a prompt — Free Prompt Base" noindex={true}>
	<Header />

	<form id="submit-form" novalidate class="min-h-[calc(100vh-4rem)] bg-surface">
		<div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-10">

			<!-- ─────────────────────── Compact header ─────────────────────── -->
			<header class="mb-7">
				<p class="text-xs font-semibold uppercase tracking-[0.16em] text-secondary mb-1.5">Contribute</p>
				<h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-text-primary">Submit a prompt</h1>
				<p class="mt-1.5 text-sm text-secondary max-w-xl">
					An admin reviews each submission before it goes live.
					{user.username ? (
						<>
							It'll show as <span class="font-medium text-text-primary">Pending review</span> on
							<a href={`/author/${user.username}`} class="underline underline-offset-2 hover:text-text-primary">your profile</a> until then.
						</>
					) : null}
				</p>
			</header>

			<!-- ─────────────────────── Multi-column body ─────────────────────── -->
			<div class="grid lg:grid-cols-[1.7fr_1fr] gap-5 lg:gap-7 items-start">

				<!-- ============ LEFT: the prompt itself ============ -->
				<div class="bg-white border border-gray-200 rounded-xl shadow-sm">

					<!-- Text fields -->
					<div class="p-5 sm:p-6 space-y-5">

						<!-- Title -->
						<div>
							<div class="flex items-baseline justify-between mb-1.5">
								<label class="text-sm font-medium text-text-primary" for="f-title">Title <span class="text-red-500">*</span></label>
								<span id="title-counter" class="text-[11px] text-gray-400 tabular-nums">0 / 120</span>
							</div>
							<input
								id="f-title"
								type="text"
								required
								maxlength="120"
								placeholder="e.g. Cinematic Portrait Photography"
								autocomplete="off"
								class="block w-full text-base sm:text-lg px-3.5 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-text-primary focus:border-text-primary transition-shadow placeholder:text-gray-300" />
							<p data-error="title" class="hidden mt-1.5 text-xs text-red-600"></p>

							<!-- Slug preview (collapsible, sits tight under the title) -->
							<details class="group mt-2">
								<summary class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 hover:text-text-primary cursor-pointer select-none">
									<svg class="w-3.5 h-3.5 transition-transform group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
									Customize URL slug
								</summary>
								<div class="mt-2 flex items-stretch border border-gray-200 rounded-lg overflow-hidden focus-within:ring-2 focus-within:ring-text-primary focus-within:border-text-primary transition-shadow">
									<span class="px-3 py-2 text-sm bg-gray-50 text-gray-500 font-mono border-r border-gray-200 select-all">freepromptbase.com/</span>
									<input
										id="f-slug"
										type="text"
										maxlength="80"
										placeholder="auto-generated from title"
										class="flex-1 min-w-0 px-3 py-2 text-sm font-mono focus:outline-none" />
								</div>
							</details>
						</div>

						<!-- Short description -->
						<div>
							<div class="flex items-baseline justify-between mb-1.5">
								<label class="text-sm font-medium text-text-primary" for="f-description">Short description</label>
								<span id="desc-counter" class="text-[11px] text-gray-400 tabular-nums">0 / 280</span>
							</div>
							<textarea
								id="f-description"
								rows="2"
								maxlength="280"
								placeholder="One sentence that hooks readers — shown on cards and in search."
								class="block w-full text-sm leading-relaxed px-3.5 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-text-primary focus:border-text-primary transition-shadow resize-y placeholder:text-gray-300"></textarea>
						</div>

						<!-- Prompt body — the star field -->
						<div>
							<label class="text-sm font-medium text-text-primary mb-1.5 block" for="f-prompt-text">Prompt text <span class="text-red-500">*</span></label>
							<textarea
								id="f-prompt-text"
								rows="11"
								required
								placeholder="Paste the full prompt body — exactly what someone would copy and use."
								class="block w-full text-sm font-mono leading-relaxed px-3.5 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-text-primary focus:border-text-primary transition-shadow resize-y placeholder:text-gray-300"></textarea>
							<p data-error="promptText" class="hidden mt-1.5 text-xs text-red-600"></p>
							<p class="mt-1.5 text-[11px] text-gray-400">Tip: press <kbd class="px-1 py-0.5 rounded border border-gray-200 bg-gray-50 font-mono text-[10px]">⌘/Ctrl</kbd> + <kbd class="px-1 py-0.5 rounded border border-gray-200 bg-gray-50 font-mono text-[10px]">Enter</kbd> to submit.</p>
						</div>

						<!-- How to use -->
						<div>
							<label class="text-sm font-medium text-text-primary mb-1.5 block" for="f-how-to-use">How to use <span class="text-gray-400 font-normal">(optional)</span></label>
							<textarea
								id="f-how-to-use"
								rows="3"
								placeholder="Tips on substituting placeholders, tuning parameters, what to expect…"
								class="block w-full text-sm leading-relaxed px-3.5 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-text-primary focus:border-text-primary transition-shadow resize-y placeholder:text-gray-300"></textarea>
						</div>
					</div>

					<!-- Images -->
					<div class="border-t border-gray-100 p-5 sm:p-6 space-y-3.5">
						<div class="flex items-center justify-between">
							<div>
								<h2 class="text-sm font-medium text-text-primary">Preview images</h2>
								<p class="text-[11px] text-gray-500 mt-0.5">First one is the card cover. Up to {MAX_IMAGES}, ≤ {MAX_FILE_MB} MB each.</p>
							</div>
							<span id="image-count-badge" class="text-xs font-semibold text-gray-500 bg-gray-100 px-2 py-0.5 rounded-full tabular-nums">0 / {MAX_IMAGES}</span>
						</div>

						<label
							id="dropzone"
							for="image-input"
							class="group block relative border-2 border-dashed border-gray-300 hover:border-text-primary hover:bg-soft/40 rounded-xl px-5 py-7 text-center cursor-pointer transition-colors"
						>
							<div class="w-10 h-10 rounded-full bg-gray-100 group-hover:bg-soft flex items-center justify-center mx-auto mb-2.5 transition-colors">
								<svg class="w-5 h-5 text-gray-500 group-hover:text-text-primary transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
								</svg>
							</div>
							<p class="text-sm font-medium text-text-primary">
								<span class="underline underline-offset-2 decoration-gray-300 group-hover:decoration-text-primary">Click to upload</span>
								<span class="text-gray-500"> or drag and drop</span>
							</p>
							<p class="text-[11px] text-gray-400 mt-1">JPG, PNG, WEBP or GIF</p>
							<input
								id="image-input"
								type="file"
								accept="image/jpeg,image/png,image/webp,image/gif"
								multiple
								class="sr-only" />
						</label>

						<p id="image-status" class="hidden text-xs text-gray-500 flex items-center gap-2">
							<span class="inline-block w-3 h-3 border-2 border-gray-300 border-t-text-primary rounded-full animate-spin"></span>
							<span data-status-text></span>
						</p>
						<p data-error="images" class="hidden text-xs text-red-600"></p>

						<div id="image-strip" class="grid grid-cols-3 sm:grid-cols-4 gap-2.5 empty:hidden"></div>
					</div>
				</div>

				<!-- ============ RIGHT: sticky publish rail ============ -->
				<aside class="space-y-5 lg:sticky lg:top-24 lg:self-start">

					<!-- Placement -->
					<div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5 space-y-4">
						<div>
							<label class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5 block" for="f-category">Category <span class="text-red-500">*</span></label>
							<select
								id="f-category"
								required
								class="block w-full text-sm px-3 py-2.5 border border-gray-200 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-text-primary focus:border-text-primary transition-shadow">
								<option value="">Choose a category…</option>
								{categories.map((c) => (
									<option value={c.slug}>{c.emoji} {c.name}</option>
								))}
							</select>
							<p data-error="category" class="hidden mt-1.5 text-xs text-red-600"></p>
						</div>

						<div>
							<label class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5 block" for="f-tags">Tags</label>
							<input
								id="f-tags"
								type="text"
								placeholder="comma, separated, tags"
								class="block w-full text-sm px-3 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-text-primary focus:border-text-primary transition-shadow placeholder:text-gray-300" />
							<p class="text-[11px] text-gray-400 mt-1">Up to 12 — they help people find your prompt.</p>
						</div>
					</div>

					<!-- Quick check -->
					<div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5 space-y-3">
						<div class="flex items-center justify-between">
							<h2 class="text-xs font-semibold uppercase tracking-wide text-gray-500">Quick check</h2>
							<button
								id="captcha-refresh"
								type="button"
								class="text-[11px] text-gray-400 hover:text-text-primary inline-flex items-center gap-1 transition-colors">
								<svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
								New
							</button>
						</div>
						<div class="flex items-center gap-2.5">
							<div class="shrink-0 inline-flex items-center gap-1.5 bg-soft/50 border border-gray-200 rounded-lg px-3 py-2 font-mono text-base text-text-primary select-none">
								<span id="captcha-question">{captcha.question}</span>
								<span class="text-gray-400">=</span>
								<span class="text-gray-400">?</span>
							</div>
							<input
								id="f-captcha"
								type="text"
								inputmode="numeric"
								autocomplete="off"
								required
								maxlength="4"
								placeholder="Answer"
								class="flex-1 min-w-0 text-center text-base font-mono px-3 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-text-primary focus:border-text-primary transition-shadow" />
						</div>
						<input id="f-captcha-token" type="hidden" value={captcha.token} />
						<p data-error="captcha" class="hidden text-xs text-red-600"></p>
					</div>

					<!-- Publish -->
					<div class="space-y-3">
						<div id="submit-error" class="hidden text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg px-4 py-3"></div>
						<button
							id="submit-btn"
							type="button"
							class="btn-feedback btn-primary btn-block inline-flex items-center justify-center gap-2">
							<svg data-btn-spinner class="spinner hidden w-4 h-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="42" stroke-dashoffset="14"/>
							</svg>
							<span data-btn-label>Submit for review</span>
							<svg data-btn-arrow class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
							</svg>
						</button>
						<a href="/" class="block text-center text-xs text-gray-500 hover:text-text-primary transition-colors">Cancel and go back</a>
					</div>
				</aside>
			</div>
		</div>
	</form>

	<Footer />
</Layout>

<script is:inline define:vars={{ MAX_IMAGES, MAX_FILE_MB }}>
	const MAX_FILE_BYTES = MAX_FILE_MB * 1024 * 1024;
	const ALLOWED = ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];

	// Convert to WebP in the browser before upload (inlined — this is an
	// is:inline script, so module imports aren't bundled here).
	async function imageToWebp(file, quality) {
		quality = quality || 0.92;
		const type = (file.type || '').toLowerCase();
		if (type === 'image/webp' || type === 'image/gif' || type === 'image/svg+xml' || type.indexOf('image/') !== 0) return file;
		try {
			let bitmap;
			try { bitmap = await createImageBitmap(file, { imageOrientation: 'from-image' }); }
			catch (e) { bitmap = await createImageBitmap(file); }
			const canvas = document.createElement('canvas');
			canvas.width = bitmap.width; canvas.height = bitmap.height;
			const ctx = canvas.getContext('2d');
			if (!ctx) { bitmap.close && bitmap.close(); return file; }
			ctx.drawImage(bitmap, 0, 0);
			bitmap.close && bitmap.close();
			const blob = await new Promise((res) => canvas.toBlob(res, 'image/webp', quality));
			if (!blob || blob.size === 0 || blob.size >= file.size) return file;
			const name = file.name.replace(/\.[^./\\]+$/, '') + '.webp';
			return new File([blob], name, { type: 'image/webp', lastModified: file.lastModified });
		} catch (e) { return file; }
	}

	const $ = (id) => document.getElementById(id);

	// Shared toast (loaded by the module script below). Falls back silently if
	// it hasn't attached yet — toasts only fire on user actions, well after load.
	function notify(msg, type) {
		if (window.__toast) window.__toast(msg, type || 'info');
	}

	// ──────────────── Inline error helpers ────────────────
	function setError(field, msg) {
		const el = document.querySelector(`[data-error="${field}"]`);
		if (!el) return;
		if (msg) { el.textContent = msg; el.classList.remove('hidden'); }
		else { el.textContent = ''; el.classList.add('hidden'); }
	}
	function clearErrors() {
		document.querySelectorAll('[data-error]').forEach((el) => {
			el.textContent = ''; el.classList.add('hidden');
		});
		const g = $('submit-error');
		g.textContent = ''; g.classList.add('hidden');
	}

	// ──────────────── Char counters ────────────────
	const titleInput = $('f-title');
	const descInput = $('f-description');
	titleInput.addEventListener('input', () => { $('title-counter').textContent = `${titleInput.value.length} / 120`; });
	descInput.addEventListener('input', () => { $('desc-counter').textContent = `${descInput.value.length} / 280`; });

	// ──────────────── Auto-slug from title ────────────────
	const slugInput = $('f-slug');
	let slugTouched = false;
	slugInput.addEventListener('input', () => { slugTouched = true; });
	titleInput.addEventListener('input', () => {
		if (slugTouched) return;
		slugInput.value = titleInput.value
			.toLowerCase()
			.replace(/[^a-z0-9\s-]/g, '')
			.replace(/\s+/g, '-')
			.replace(/-+/g, '-')
			.replace(/^-|-$/g, '');
	});

	// ──────────────── Images: state + render ────────────────
	const imageInput = $('image-input');
	const dropzone = $('dropzone');
	const strip = $('image-strip');
	const statusEl = $('image-status');
	const statusText = statusEl.querySelector('[data-status-text]');
	const countBadge = $('image-count-badge');
	let images = []; // {url, name}
	let pending = 0; // skeleton tiles shown while uploads are in flight

	function renderStrip() {
		countBadge.textContent = `${images.length} / ${MAX_IMAGES}`;
		const tiles = images.map((img, i) => `
			<figure class="relative group rounded-lg overflow-hidden border border-gray-200 aspect-square bg-gray-50">
				<img src="${img.url}" alt="" class="upload-thumb w-full h-full object-cover" />
				${i === 0 ? '<figcaption class="absolute top-2 left-2 bg-primary text-link text-[10px] font-semibold px-2 py-0.5 rounded-md uppercase tracking-wide shadow-sm">Cover</figcaption>' : ''}
				<button type="button" data-remove="${i}" aria-label="Remove image" class="btn-feedback absolute top-2 right-2 w-7 h-7 rounded-full bg-white/95 hover:bg-white text-gray-700 hover:text-red-600 flex items-center justify-center shadow-sm">
					<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
				</button>
			</figure>
		`);
		for (let p = 0; p < pending; p++) {
			tiles.push('<div class="upload-skeleton aspect-square rounded-lg border border-gray-200" aria-hidden="true"></div>');
		}
		strip.innerHTML = tiles.join('');
		// Crossfade each thumbnail in once it has decoded.
		strip.querySelectorAll('img.upload-thumb').forEach((img) => {
			if (img.complete) img.classList.add('is-ready');
			else img.addEventListener('load', () => img.classList.add('is-ready'), { once: true });
		});
		strip.querySelectorAll('button[data-remove]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const idx = parseInt(btn.dataset.remove || '0', 10);
				images.splice(idx, 1);
				renderStrip();
			});
		});
	}

	// ──────────────── Upload pipeline ────────────────
	async function uploadOne(file) {
		if (!ALLOWED.includes(file.type)) {
			return { error: `${file.name || 'file'}: unsupported type (${file.type || 'unknown'}).` };
		}
		if (file.size > MAX_FILE_BYTES) {
			return { error: `${file.name} is ${(file.size / 1024 / 1024).toFixed(1)} MB — max ${MAX_FILE_MB} MB.` };
		}
		const webp = await imageToWebp(file);
		const fd = new FormData();
		fd.append('file', webp);
		const res = await fetch('/api/submit-prompt/upload', { method: 'POST', body: fd });
		const data = await res.json().catch(() => ({}));
		if (!res.ok) return { error: data.error || `Upload failed (${res.status}).` };
		return { url: data.url, name: file.name };
	}

	async function handleFiles(files) {
		setError('images', '');
		const remaining = MAX_IMAGES - images.length;
		if (remaining <= 0) {
			setError('images', `You've already added the maximum of ${MAX_IMAGES} images.`);
			return;
		}
		const list = Array.from(files).slice(0, remaining);
		if (files.length > remaining) {
			setError('images', `Only ${remaining} more image${remaining === 1 ? '' : 's'} allowed — extras were ignored.`);
		}
		statusEl.classList.remove('hidden');
		// Show placeholder tiles immediately so the upload feels instant.
		pending = list.length;
		renderStrip();
		let done = 0;
		for (const file of list) {
			done++;
			statusText.textContent = `Uploading ${done} of ${list.length} — ${file.name}`;
			const r = await uploadOne(file);
			pending = list.length - done; // one fewer tile in flight
			if (r.error) {
				// Keep any successful uploads; surface this one and carry on.
				notify(r.error, 'error');
				renderStrip();
				continue;
			}
			images.push({ url: r.url, name: r.name });
			renderStrip();
		}
		pending = 0;
		statusEl.classList.add('hidden');
		imageInput.value = '';
	}

	imageInput.addEventListener('change', (e) => {
		const t = e.target;
		if (t.files && t.files.length) handleFiles(t.files);
	});

	['dragenter', 'dragover'].forEach((ev) => {
		dropzone.addEventListener(ev, (e) => {
			e.preventDefault(); e.stopPropagation();
			dropzone.classList.add('border-primary', 'bg-amber-50/60');
		});
	});
	['dragleave', 'drop'].forEach((ev) => {
		dropzone.addEventListener(ev, (e) => {
			e.preventDefault(); e.stopPropagation();
			dropzone.classList.remove('border-primary', 'bg-amber-50/60');
		});
	});
	dropzone.addEventListener('drop', (e) => {
		const files = e.dataTransfer?.files;
		if (files && files.length) handleFiles(files);
	});

	// ──────────────── CAPTCHA ────────────────
	async function refreshCaptcha(focus = false) {
		const res = await fetch('/api/captcha');
		if (!res.ok) return;
		const data = await res.json();
		$('captcha-question').textContent = data.question;
		$('f-captcha-token').value = data.token;
		$('f-captcha').value = '';
		if (focus) $('f-captcha').focus();
	}
	$('captcha-refresh').addEventListener('click', () => {
		setError('captcha', '');
		refreshCaptcha(true);
	});

	// ──────────────── Submit handler ────────────────
	function setBusy(busy) {
		const btn = $('submit-btn');
		btn.disabled = busy;
		btn.setAttribute('aria-busy', busy ? 'true' : 'false');
		btn.querySelector('[data-btn-label]').textContent = busy ? 'Submitting…' : 'Submit for review';
		btn.querySelector('[data-btn-spinner]').classList.toggle('hidden', !busy);
		btn.querySelector('[data-btn-arrow]').classList.toggle('hidden', busy);
	}

	async function submit() {
		clearErrors();
		setBusy(true);

		const tags = $('f-tags').value.split(',').map((t) => t.trim()).filter(Boolean);
		const payload = {
			title: titleInput.value.trim(),
			slug: slugInput.value.trim() || undefined,
			description: descInput.value.trim(),
			promptText: $('f-prompt-text').value,
			category: $('f-category').value,
			tags,
			howToUse: $('f-how-to-use').value.trim() || undefined,
			images: images.map((i) => i.url),
			captchaToken: $('f-captcha-token').value,
			captchaAnswer: $('f-captcha').value,
		};

		// Client-side guards: short-circuit before hitting the API.
		if (!payload.title) { setError('title', 'Title is required.'); setBusy(false); titleInput.focus(); return; }
		if (!payload.promptText.trim()) { setError('promptText', 'Prompt text is required.'); setBusy(false); $('f-prompt-text').focus(); return; }
		if (!payload.category) { setError('category', 'Pick a category.'); setBusy(false); $('f-category').focus(); return; }
		if (!payload.captchaAnswer) { setError('captcha', 'Answer the math question.'); setBusy(false); $('f-captcha').focus(); return; }

		const res = await fetch('/api/submit-prompt', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify(payload),
		});
		const data = await res.json().catch(() => ({}));

		if (res.ok) {
			notify('Submitted for review', 'success');
			// Brief beat so the toast registers before the redirect.
			setTimeout(() => { window.location.href = data.redirect || '/'; }, 500);
			return;
		}

		if (data.field) {
			setError(data.field, data.error || 'Invalid value.');
		} else {
			const g = $('submit-error');
			g.textContent = data.error || `Submission failed (${res.status}).`;
			g.classList.remove('hidden');
		}
		notify(data.error || 'Submission failed — please check the form.', 'error');
		// Token is one-shot semantically — rotate after any failure.
		await refreshCaptcha(false);
		setBusy(false);
	}

	$('submit-btn').addEventListener('click', submit);

	// Cmd/Ctrl + Enter shortcut on the prompt body for quick submit.
	$('f-prompt-text').addEventListener('keydown', (e) => {
		if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
			e.preventDefault();
			submit();
		}
	});
</script>

<!-- Bundled module: exposes the shared toast to the inline script above. -->
<script>
	import { toast } from '../scripts/toast';
	(window as any).__toast = toast;
</script>
