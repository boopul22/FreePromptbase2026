---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Privacy Policy — Free Prompt Base" description="How Free Prompt Base handles your data.">
	<Header />
	<main class="flex-grow max-w-3xl mx-auto px-4 w-full py-12">
		<h1 class="text-3xl font-bold tracking-tight text-text-primary">Privacy Policy</h1>
		<div class="mt-6 space-y-4 text-gray-600 leading-relaxed">
			<p>
				Free Prompt Base is a free resource. We keep data collection to a minimum. If you
				subscribe to the newsletter, we store the email address you provide solely to send you
				prompt updates, and you can unsubscribe at any time.
			</p>
			<p>
				We do not sell your personal data. This page is a placeholder and will be expanded with
				full details before launch.
			</p>
			<p class="text-sm text-gray-600">
				Questions? Email
				<a href="mailto:blog.boopul@gmail.com" class="text-link underline hover:text-primary"
					>blog.boopul@gmail.com</a
				>.
			</p>
		</div>
	</main>
	<Footer />
</Layout>
