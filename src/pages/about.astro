---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { breadcrumbSchema } from '../lib/seo';

const crumb = breadcrumbSchema([
	{ name: 'Home', path: '/' },
	{ name: 'About', path: '/about' },
]);
---

<Layout title="About — Free Prompt Base" description="Free Prompt Base is a community library of ready-to-use AI prompts. Built by Bipul Kumar."
	extraSchemas={[crumb]}
>
	<Header />
	<main class="flex-grow site-main py-12">
		<Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'About' }]} />
		<div class="max-w-2xl">
			<p class="text-xs font-semibold uppercase tracking-[0.18em] text-secondary mb-3">About</p>
			<h1 class="text-4xl md:text-5xl font-bold tracking-tight text-text-primary leading-[1.1]">
				About Free Prompt Base
			</h1>
			<p class="text-gray-600 text-lg mt-4">
				Free Prompt Base is a free, curated library of AI prompts, built for the community, by
				the community. Every prompt is ready to copy and use with ChatGPT, Midjourney, Claude or
				Gemini.
			</p>

			<div class="mt-6 mb-8 h-px bg-gray-200"></div>

			<div class="prose-like space-y-4 text-gray-600 leading-relaxed">
			<p>
				Hi, I'm <strong class="text-text-primary">Bipul Kumar</strong> 👋 — an AI-powered creator,
				no-code explorer, and disciplined builder. I believe consistency beats talent and action
				beats intention.
			</p>
			<p>
				I build small apps, tools and websites with AI and no-code, and I share what I learn
				about prompting, automation and building in public. Free Prompt Base is where I collect
				the prompts I actually use, so anyone can grab them for free.
			</p>
			<p>The idea is simple: <strong class="text-text-primary">find a prompt, copy it, create.</strong></p>
			</div>

			<div class="mt-10 flex flex-wrap gap-3">
				<a href="/categories" class="btn-primary">
					Browse prompts
				</a>
				<a href="mailto:blog.boopul@gmail.com" class="btn-secondary">
					Contact
				</a>
			</div>
		</div>
	</main>
	<Footer />
</Layout>
