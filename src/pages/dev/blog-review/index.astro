---
/**
 * LOCAL DRAFT REVIEW INDEX — lists all 30 unpublished blog drafts with covers.
 * Not available in production.
 */
export const prerender = false;

if (import.meta.env.PROD) {
	return Astro.rewrite('/404');
}

const metaModules = import.meta.glob('../../../../content/blog-drafts/*.meta.json', {
	eager: true,
}) as Record<string, { default?: Record<string, unknown> } | Record<string, unknown>>;

const catalogModules = import.meta.glob('../../../../content/blog-drafts/catalog-30.json', {
	eager: true,
}) as Record<
	string,
	{ default?: { blogs: Array<{ id: string; slug: string; title: string }> } } | { blogs: Array<{ id: string; slug: string; title: string }> }
>;

function unwrap<T>(mod: { default?: T } | T): T {
	if (mod && typeof mod === 'object' && 'default' in mod && mod.default !== undefined) {
		return mod.default as T;
	}
	return mod as T;
}

const catalog = unwrap(Object.values(catalogModules)[0]);
const bySlug = new Map(
	Object.values(metaModules)
		.map((m) => unwrap(m))
		.map((m) => [String(m.slug), m] as const),
);

const blogs = catalog.blogs.map((b) => {
	const meta = bySlug.get(b.slug) || {};
	return {
		id: b.id,
		slug: b.slug,
		title: String(meta.title || b.title),
		status: String(meta.status || 'draft'),
		publishReadyImages: Boolean(meta.publishReadyImages),
		coverImage: String(meta.coverImage || ''),
		promptImageCount: Array.isArray(meta.promptImages) ? meta.promptImages.length : 0,
	};
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex,nofollow" />
		<title>Local blog draft review — {blogs.length} posts</title>
		<style>
			:root {
				color-scheme: light;
				--bg: #f6f3ee;
				--ink: #1a1714;
				--muted: #6b635a;
				--line: #ddd4c8;
				--card: #fffdf9;
				--accent: #b45309;
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
				background:
					radial-gradient(1200px 600px at 10% -10%, #efe4d4 0%, transparent 55%),
					radial-gradient(900px 500px at 100% 0%, #e8ddd0 0%, transparent 50%),
					var(--bg);
				color: var(--ink);
			}
			.banner {
				position: sticky;
				top: 0;
				z-index: 20;
				background: #f59e0b;
				color: #111;
				text-align: center;
				font: 600 13px/1.4 ui-sans-serif, system-ui, sans-serif;
				padding: 10px 14px;
			}
			.wrap {
				max-width: 1180px;
				margin: 0 auto;
				padding: 28px 18px 64px;
			}
			h1 {
				font-size: clamp(1.8rem, 3vw, 2.6rem);
				letter-spacing: -0.02em;
				margin: 0 0 8px;
			}
			.sub {
				color: var(--muted);
				font: 400 15px/1.5 ui-sans-serif, system-ui, sans-serif;
				margin: 0 0 28px;
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 18px;
			}
			a.card {
				display: block;
				text-decoration: none;
				color: inherit;
				background: var(--card);
				border: 1px solid var(--line);
				overflow: hidden;
				transition: transform 0.15s ease, box-shadow 0.15s ease;
			}
			a.card:hover {
				transform: translateY(-2px);
				box-shadow: 0 10px 28px rgba(40, 28, 12, 0.08);
			}
			.cover {
				aspect-ratio: 16 / 9;
				width: 100%;
				object-fit: cover;
				display: block;
				background: #e8e0d6;
			}
			.meta {
				padding: 14px 14px 16px;
			}
			.id {
				font: 600 11px/1 ui-sans-serif, system-ui, sans-serif;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--accent);
				margin-bottom: 6px;
			}
			.title {
				font-size: 1.05rem;
				line-height: 1.3;
				margin: 0 0 8px;
			}
			.flags {
				font: 400 12px/1.4 ui-sans-serif, system-ui, sans-serif;
				color: var(--muted);
			}
		</style>
	</head>
	<body>
		<div class="banner">
			LOCAL DRAFT REVIEW — {blogs.filter((b) => b.publishReadyImages).length}/{blogs.length} image-ready · not published
		</div>
		<div class="wrap">
			<h1>Review all 30 blog drafts</h1>
			<p class="sub">
				Click any card to open the full article layout with Discover cover + all prompt images.
			</p>
			<div class="grid">
				{
					blogs.map((blog) => (
						<a class="card" href={`/dev/blog-review/${blog.slug}`}>
							{blog.coverImage ? (
								<img class="cover" src={blog.coverImage} alt="" loading="lazy" width="640" height="360" />
							) : (
								<div class="cover" />
							)}
							<div class="meta">
								<div class="id">Blog {blog.id}</div>
								<h2 class="title">{blog.title}</h2>
								<div class="flags">
									{blog.promptImageCount} prompt images · {blog.status}
								</div>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</body>
</html>
