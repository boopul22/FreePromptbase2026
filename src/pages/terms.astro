---
import LegalPage from '../components/LegalPage.astro';

const toc = [
	{ id: 'acceptance', label: '1. Acceptance of Terms' },
	{ id: 'description', label: '2. Description of the Service' },
	{ id: 'accounts', label: '3. Accounts' },
	{ id: 'acceptable-use', label: '4. Acceptable Use' },
	{ id: 'submissions', label: '5. User Submissions' },
	{ id: 'ip', label: '6. Intellectual Property' },
	{ id: 'ai-tools', label: '7. Third-Party AI Tools' },
	{ id: 'advertising', label: '8. Advertising' },
	{ id: 'disclaimers', label: '9. Disclaimers' },
	{ id: 'liability', label: '10. Limitation of Liability' },
	{ id: 'termination', label: '11. Termination' },
	{ id: 'law', label: '12. Governing Law' },
	{ id: 'changes', label: '13. Changes' },
	{ id: 'contact', label: '14. Contact Us' },
];
---

<LegalPage
	title="Terms of Service — Free Prompt Base"
	description="The terms that govern your use of Free Prompt Base, a free library of ready-to-use AI prompts."
	heading="Terms of Service"
	intro="The rules for using Free Prompt Base. By using the site, you agree to these terms."
	lastUpdated="July 1, 2026"
	crumb="Terms of Service"
	path="/terms"
	toc={toc}
>
	<section id="acceptance">
		<h2>1. Acceptance of Terms</h2>
		<p>
			These Terms of Service ("Terms") govern your access to and use of Free Prompt Base, including
			our website at <strong>freepromptbase.com</strong> (the "Service"). By accessing or using the
			Service, you agree to be bound by these Terms and by our
			<a href="/privacy">Privacy Policy</a>. If you do not agree, do not use the Service.
		</p>
	</section>

	<section id="description">
		<h2>2. Description of the Service</h2>
		<p>
			Free Prompt Base is a free, curated library of AI image-generation prompts. You can browse, search, and
			copy prompts without creating an account. Optional account features let you save and like
			prompts, and you may submit prompts for review. The Service does not generate images or text
			itself; you use the prompts with third-party AI tools of your choice. The Service is provided
			free of charge and is supported by advertising — there are currently no payments,
			subscriptions, or paid features.
		</p>
	</section>

	<section id="accounts">
		<h2>3. Accounts</h2>
