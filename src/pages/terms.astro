---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Terms of Service — Free Prompt Base" description="Terms for using Free Prompt Base.">
	<Header />
	<main class="flex-grow site-main py-12">
		<h1 class="text-3xl font-bold tracking-tight text-text-primary">Terms of Service</h1>
		<div class="mt-6 space-y-4 text-gray-600 leading-relaxed">
			<p>
				The prompts on Free Prompt Base are provided free of charge, "as is", for your personal
				and commercial use. We make no guarantees about the output you get from any AI model.
			</p>
			<p>
				Please don't scrape the site wholesale or republish the collection as your own. Linking
				to individual prompts is always welcome.
			</p>
			<p>
				This page is a placeholder and will be expanded with full terms before launch.
			</p>
			<p class="text-sm text-gray-600">
				Questions? Email
				<a href="mailto:blog.boopul@gmail.com" class="text-link underline hover:text-secondary"
					>blog.boopul@gmail.com</a
				>.
			</p>
		</div>
	</main>
	<Footer />
</Layout>
