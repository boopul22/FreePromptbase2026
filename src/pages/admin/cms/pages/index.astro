---
export const prerender = false;

import Layout from '../../../../layouts/Layout.astro';
import AdminSidebar from '../../../../components/AdminSidebar.astro';
---

<Layout title="Pages - CMS - Free Prompt Base" noindex={true}>

 <div class="flex flex-col md:flex-row min-h-screen md:h-screen md:overflow-hidden">
 <AdminSidebar activePage="cms" />

 <main class="flex-1 min-w-0 p-3 sm:p-5 space-y-4 bg-gray-50 md:overflow-y-auto md:h-screen">
 <!-- Breadcrumb -->
 <nav class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-gray-500" aria-label="Breadcrumb">
 <a href="/admin/cms" class="hover:text-text-primary transition-colors">Content</a>
 <span class="material-symbols-outlined text-sm">chevron_right</span>
 <span class="text-text-primary">Pages</span>
 </nav>

 <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
 <div>
 <h1 class="text-lg font-semibold text-text-primary">Pages</h1>
 <p class="text-xs text-gray-500 mt-0.5">Manage static pages like About, Terms, and Privacy.</p>
 </div>
 <button id="new-page-btn" class="btn-primary flex items-center gap-1.5 self-start sm:self-auto">
 <span class="material-symbols-outlined text-lg">add</span>
 New Page
 </button>
 </div>

 <!-- New Page Form (hidden initially) -->
 <div id="new-page-form" class="hidden bg-white border border-gray-200 rounded-md p-4 space-y-3">
 <h3 class="font-semibold text-lg">Create New Page</h3>
 <input id="page-title" type="text" placeholder="Page title..." class="w-full border border-gray-200 rounded-lg px-3 py-1.5 bg-white text-sm" />
 <input id="page-slug" type="text" placeholder="page-slug (auto-generated)" class="w-full border border-gray-200 rounded-lg px-3 py-1.5 bg-white text-sm" />
 <textarea id="page-content" rows="10" placeholder="Page content (HTML supported)..." class="w-full border border-gray-200 rounded-lg px-3 py-1.5 bg-white text-sm font-mono resize-y"></textarea>
 <div class="flex items-center gap-4">
 <select id="page-status" class="border border-gray-200 rounded-lg px-3 py-1.5 bg-white text-sm">
 <option value="draft">Draft</option>
 <option value="published">Published</option>
 </select>
 <input id="page-meta-title" type="text" placeholder="Meta title (optional)" class="flex-1 border border-gray-200 rounded-lg px-3 py-1.5 bg-white text-sm" />
 </div>
 <div class="flex gap-3">
 <button id="save-page-btn" class="btn-feedback btn-primary">Save Page</button>
 <button id="cancel-page-btn" class="btn-secondary">Cancel</button>
 </div>
 </div>

 <!-- Pages Table -->
 <div id="pages-table" class="bg-white border border-gray-200 rounded-md overflow-hidden">
 <div class="py-10 px-6 text-center text-gray-500">
 <span class="material-symbols-outlined text-3xl">hourglass_empty</span>
 <p class="text-xs uppercase tracking-wide mt-2">Loading...</p>
 </div>
 </div>
 </main>
 </div>
</Layout>

<script>
 import { toast } from '../../../../scripts/toast';
 import { withButtonLoading } from '../../../../scripts/button-loading';

 function esc(s: string): string {
 const d = document.createElement('div');
 d.textContent = s;
 return d.innerHTML;
 }

 let editingPageId: string | null = null;

 async function loadPages() {
 const res = await fetch('/api/admin/cms/pages');
 const data = await res.json();
 const table = document.getElementById('pages-table')!;

 if (!data.pages?.length) {
 table.innerHTML = '<div class="py-10 px-6 text-center text-gray-500"><span class="material-symbols-outlined text-3xl">description</span><p class="text-xs uppercase tracking-wide mt-2">No pages yet</p></div>';
 return;
 }

 table.innerHTML = `
 <div class="overflow-x-auto"><table class="w-full text-left min-w-[600px]">
 <thead>
 <tr class="border-b border-gray-200">
 <th class="px-3 py-2 text-[11px] font-semibold uppercase tracking-wide text-gray-500">Title</th>
 <th class="px-3 py-2 text-[11px] font-semibold uppercase tracking-wide text-gray-500">Slug</th>
 <th class="px-3 py-2 text-[11px] font-semibold uppercase tracking-wide text-gray-500">Status</th>
 <th class="px-3 py-2 text-[11px] font-semibold uppercase tracking-wide text-gray-500">Updated</th>
 <th class="px-3 py-2 text-[11px] font-semibold uppercase tracking-wide text-gray-500">Actions</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-gray-200/50">
 ${data.pages.map((p: any) => `
 <tr class="hover:bg-gray-50 transition-colors">
 <td class="px-3 py-2.5 font-bold text-sm">${esc(p.title)}</td>
 <td class="px-3 py-2.5 text-sm text-gray-500">/p/${esc(p.slug)}</td>
 <td class="px-3 py-2.5 text-sm">
 <span class="px-3 py-1.5 rounded-full text-xs font-semibold uppercase ${
 p.status === 'published' ? 'bg-blue-50 text-blue-900' : 'bg-amber-50 text-amber-900'
 }">${p.status}</span>
 </td>
 <td class="px-3 py-2.5 text-sm text-gray-500">${new Date(p.updatedAt).toLocaleDateString()}</td>
 <td class="px-3 py-2.5 text-sm">
 <div class="flex gap-2">
 <button onclick="editPage('${esc(p.id)}')" class="btn-feedback btn-secondary btn-sm">Edit</button>
 <button onclick="deletePage('${esc(p.id)}', this)" class="btn-feedback btn-danger btn-sm">Delete</button>
 </div>
 </td>
 </tr>
 `).join('')}
 </tbody>
 </table></div>
 `;
 }

 // New page toggle
 document.getElementById('new-page-btn')!.addEventListener('click', () => {
 editingPageId = null;
 document.getElementById('new-page-form')!.classList.remove('hidden');
 (document.getElementById('page-title') as HTMLInputElement).value = '';
 (document.getElementById('page-slug') as HTMLInputElement).value = '';
 (document.getElementById('page-content') as HTMLTextAreaElement).value = '';
 (document.getElementById('page-status') as HTMLSelectElement).value = 'draft';
 (document.getElementById('page-meta-title') as HTMLInputElement).value = '';
 });

 document.getElementById('cancel-page-btn')!.addEventListener('click', () => {
 document.getElementById('new-page-form')!.classList.add('hidden');
 editingPageId = null;
 });

 // Auto-generate slug
 document.getElementById('page-title')!.addEventListener('input', (e) => {
 const slug = (e.target as HTMLInputElement).value.toLowerCase().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-');
 (document.getElementById('page-slug') as HTMLInputElement).value = slug;
 });

 // Save page
 document.getElementById('save-page-btn')!.addEventListener('click', async (e) => {
 const title = (document.getElementById('page-title') as HTMLInputElement).value;
 const slug = (document.getElementById('page-slug') as HTMLInputElement).value;
 const content = (document.getElementById('page-content') as HTMLTextAreaElement).value;
 const status = (document.getElementById('page-status') as HTMLSelectElement).value;
 const metaTitle = (document.getElementById('page-meta-title') as HTMLInputElement).value;

 if (!title) { toast('Title is required.', 'error'); return; }

 const wasEditing = !!editingPageId;
 try {
 await withButtonLoading(e.currentTarget as HTMLButtonElement, async () => {
 const res = editingPageId
 ? await fetch(`/api/admin/cms/pages/${editingPageId}`, {
 method: 'PUT',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ title, slug, content, status, metaTitle: metaTitle || null }),
 })
 : await fetch('/api/admin/cms/pages', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ title, slug, content, status, metaTitle: metaTitle || null }),
 });
 const data = await res.json().catch(() => ({}));
 if (!res.ok || data.error) throw new Error(data.error || res.statusText);
 }, { loadingLabel: 'Saving…' });
 document.getElementById('new-page-form')!.classList.add('hidden');
 editingPageId = null;
 toast(wasEditing ? 'Page saved' : 'Page created', 'success');
 loadPages();
 } catch (err: any) {
 toast(`Save failed: ${err.message || 'try again'}`, 'error');
 }
 });

 (window as any).editPage = async (id: string) => {
 const res = await fetch(`/api/admin/cms/pages/${id}`);
 const data = await res.json();
 if (!data.success) return;

 editingPageId = id;
 document.getElementById('new-page-form')!.classList.remove('hidden');
 (document.getElementById('page-title') as HTMLInputElement).value = data.page.title;
 (document.getElementById('page-slug') as HTMLInputElement).value = data.page.slug;
 (document.getElementById('page-content') as HTMLTextAreaElement).value = data.page.content;
 (document.getElementById('page-status') as HTMLSelectElement).value = data.page.status;
 (document.getElementById('page-meta-title') as HTMLInputElement).value = data.page.metaTitle || '';
 };

 (window as any).deletePage = async (id: string, btn: HTMLButtonElement) => {
 if (!confirm('Delete this page permanently?')) return;
 try {
 await withButtonLoading(btn, async () => {
 const res = await fetch('/api/admin/cms/pages', {
 method: 'DELETE',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ id }),
 });
 const data = await res.json().catch(() => ({}));
 if (!res.ok || data.error) throw new Error(data.error || res.statusText);
 });
 toast('Page deleted', 'success');
 loadPages();
 } catch (err: any) {
 toast(err.message || 'Delete failed', 'error');
 }
 };

 loadPages();
</script>
