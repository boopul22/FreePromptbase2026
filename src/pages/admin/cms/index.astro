---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import AdminSidebar from '../../../components/AdminSidebar.astro';
import { getDB } from '../../../lib/db';

// SSR the dashboard (counts + recent posts + activity) in one batched D1 call so
// it paints instantly instead of firing 6 client fetches after JS parse.
let dash: any = { counts: { prompts: 0, posts: 0, published: 0, categories: 0, media: 0 }, posts: [], activity: [] };
try {
	const db = getDB(Astro.locals);
	const [pc, poc, pubc, cc, mc, posts, act] = await db.batch<any>([
		db.prepare('SELECT COUNT(*) AS n FROM prompts'),
		db.prepare('SELECT COUNT(*) AS n FROM posts'),
		db.prepare("SELECT COUNT(*) AS n FROM posts WHERE status = 'published'"),
		db.prepare('SELECT COUNT(*) AS n FROM categories'),
		db.prepare('SELECT COUNT(*) AS n FROM media'),
		db.prepare(
			`SELECT p.id, p.title, p.status, p.read_time, c.name AS category_name
			 FROM posts p LEFT JOIN categories c ON p.category_id = c.id
			 ORDER BY p.updated_at DESC LIMIT 5`,
		),
		db.prepare('SELECT user_name, action, entity_title, created_at FROM activity_log ORDER BY created_at DESC LIMIT 10'),
	]);
	dash = {
		counts: {
			prompts: pc.results?.[0]?.n ?? 0,
			posts: poc.results?.[0]?.n ?? 0,
			published: pubc.results?.[0]?.n ?? 0,
			categories: cc.results?.[0]?.n ?? 0,
			media: mc.results?.[0]?.n ?? 0,
		},
		posts: (posts.results || []).map((p: any) => ({ id: p.id, title: p.title, status: p.status, readTime: p.read_time, categoryName: p.category_name })),
		activity: (act.results || []).map((a: any) => ({ userName: a.user_name, action: a.action, entityTitle: a.entity_title, createdAt: a.created_at })),
	};
} catch {
	// Fall through with empties — the client fetches as a fallback.
}
const dashJson = JSON.stringify(dash).replace(/</g, '\\u003c');
---

<Layout title="Content Management - Admin - Free Prompt Base" noindex={true}>

 <div class="flex flex-col md:flex-row min-h-screen md:h-screen md:overflow-hidden">
 <AdminSidebar activePage="cms" />

 <main class="flex-1 min-w-0 p-3 sm:p-5 space-y-4 bg-gray-50 md:overflow-y-auto md:h-screen">
 <!-- Header -->
 <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
 <div>
 <h1 class="text-lg font-semibold text-text-primary">Content Management</h1>
 <p class="text-xs text-gray-500 mt-0.5">Create, edit, and publish blog posts and pages.</p>
 </div>
 </div>

 <!-- Quick Actions -->
 <div class="flex flex-wrap gap-3 sm:gap-4">
 <a href="/admin/cms/prompts/new" class="bg-primary text-link px-3 py-1.5 rounded-md text-sm font-semibold hover:opacity-90 transition-opacity flex items-center gap-1.5">
 <span class="material-symbols-outlined text-base">bolt</span>
 New Prompt
 </a>
 <a href="/admin/cms/posts/new" class="bg-white text-text-primary px-3 py-1.5 rounded-md text-sm font-semibold border border-gray-200 hover:border-primary transition-colors flex items-center gap-1.5">
 <span class="material-symbols-outlined text-base">add</span>
 New Post
 </a>
 <a href="/admin/cms/media" class="bg-white text-text-primary px-3 py-1.5 rounded-md text-sm font-semibold border border-gray-200 hover:border-primary transition-colors flex items-center gap-1.5">
 <span class="material-symbols-outlined text-base">upload</span>
 Upload Media
 </a>
 </div>

 <!-- Stats Cards -->
 <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3" id="cms-stats">
 <div class="bg-white border border-gray-200 rounded-md p-4">
 <span class="material-symbols-outlined text-primary text-xl">bolt</span>
 <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-500 mt-2">Prompts</p>
 <p class="text-2xl font-semibold text-text-primary mt-1" id="stat-prompts">—</p>
 </div>
 <div class="bg-white border border-gray-200 rounded-md p-4">
 <span class="material-symbols-outlined text-primary text-xl">article</span>
 <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-500 mt-2">Posts</p>
 <p class="text-2xl font-semibold text-text-primary mt-1" id="stat-posts">—</p>
 </div>
 <div class="bg-white border border-gray-200 rounded-md p-4">
 <span class="material-symbols-outlined text-primary text-xl">publish</span>
 <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-500 mt-2">Published</p>
 <p class="text-2xl font-semibold text-text-primary mt-1" id="stat-published">—</p>
 </div>
 <div class="bg-white border border-gray-200 rounded-md p-4">
 <span class="material-symbols-outlined text-primary text-xl">category</span>
 <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-500 mt-2">Categories</p>
 <p class="text-2xl font-semibold text-text-primary mt-1" id="stat-categories">—</p>
 </div>
 <div class="bg-white border border-gray-200 rounded-md p-4">
 <span class="material-symbols-outlined text-primary text-xl">image</span>
 <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-500 mt-2">Media</p>
 <p class="text-2xl font-semibold text-text-primary mt-1" id="stat-media">—</p>
 </div>
 </div>

 <!-- Two Column Layout -->
 <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6">
 <!-- Recent Posts -->
 <div class="bg-white border border-gray-200 rounded-md">
 <div class="p-4 border-b border-gray-200 flex items-center justify-between">
 <h2 class="font-semibold text-base">Recent Posts</h2>
 <a href="/admin/cms/posts" class="text-xs font-semibold text-primary hover:underline flex items-center gap-1">
 View all <span class="material-symbols-outlined text-sm">arrow_forward</span>
 </a>
 </div>
 <div id="recent-posts" class="divide-y divide-gray-200/50">
 <div class="py-10 px-6 text-center text-gray-500">
 <span class="material-symbols-outlined text-3xl">hourglass_empty</span>
 <p class="text-xs uppercase tracking-wide mt-2">Loading...</p>
 </div>
 </div>
 </div>

 <!-- Recent Activity -->
 <div class="bg-white border border-gray-200 rounded-md">
 <div class="p-4 border-b border-gray-200">
 <h2 class="font-semibold text-base">Recent Activity</h2>
 </div>
 <div id="recent-activity" class="divide-y divide-gray-200/50 max-h-[400px] overflow-y-auto">
 <div class="py-10 px-6 text-center text-gray-500">
 <span class="material-symbols-outlined text-3xl">hourglass_empty</span>
 <p class="text-xs uppercase tracking-wide mt-2">Loading...</p>
 </div>
 </div>
 </div>
 </div>
 </main>
 </div>

 <script type="application/json" id="cms-dash" set:html={dashJson}></script>
</Layout>

<script>
 function esc(s: string): string {
 const d = document.createElement('div');
 d.textContent = s;
 return d.innerHTML;
 }

 async function loadDashboard(preloaded?: any) {
 let counts: any, posts: any[], activity: any[];
 if (preloaded) {
 counts = preloaded.counts; posts = preloaded.posts; activity = preloaded.activity;
 } else {
 const [promptsRes, postsRes, publishedRes, categoriesRes, mediaRes, activityRes] = await Promise.all([
 fetch('/api/admin/cms/prompts?limit=5'),
 fetch('/api/admin/cms/posts?limit=5'),
 fetch('/api/admin/cms/posts?status=published&limit=1'),
 fetch('/api/admin/cms/categories'),
 fetch('/api/admin/cms/media?limit=1'),
 fetch('/api/admin/cms/activity?limit=10'),
 ]);
 const promptsData = await promptsRes.json();
 const postsData = await postsRes.json();
 const publishedData = await publishedRes.json();
 const categoriesData = await categoriesRes.json();
 const mediaData = await mediaRes.json();
 const activityData = await activityRes.json();
 counts = {
 prompts: promptsData.total || 0, posts: postsData.total || 0,
 published: publishedData.total || 0, categories: categoriesData.categories?.length || 0,
 media: mediaData.total || 0,
 };
 posts = postsData.posts || [];
 activity = activityData.activity || [];
 }

 // Stats
 document.getElementById('stat-prompts')!.textContent = String(counts.prompts || 0);
 document.getElementById('stat-posts')!.textContent = String(counts.posts || 0);
 document.getElementById('stat-published')!.textContent = String(counts.published || 0);
 document.getElementById('stat-categories')!.textContent = String(counts.categories || 0);
 document.getElementById('stat-media')!.textContent = String(counts.media || 0);

 // Recent posts
 const recentPosts = document.getElementById('recent-posts')!;
 if (posts?.length) {
 recentPosts.innerHTML = posts.map((p: any) => `
 <a href="/admin/cms/posts/edit/${esc(p.id)}" class="flex items-center justify-between p-4 hover:bg-gray-50 transition-colors">
 <div class="flex-1 min-w-0">
 <p class="font-semibold text-sm truncate">${esc(p.title)}</p>
 <p class="text-xs text-gray-500 mt-1">${esc(p.categoryName || 'Uncategorized')} &middot; ${esc(p.readTime)}</p>
 </div>
 <span class="px-2.5 py-1 rounded-md text-[11px] font-semibold uppercase tracking-wide ml-3 ${
 p.status === 'published' ? 'bg-green-50 text-green-700' :
 p.status === 'draft' ? 'bg-amber-50 text-amber-700' :
 'bg-gray-100 text-gray-600'
 }">${p.status}</span>
 </a>
 `).join('');
 } else {
 recentPosts.innerHTML = '<div class="py-10 px-6 text-center text-gray-500"><p class="text-xs uppercase tracking-wide">No posts yet</p></div>';
 }

 // Activity
 const actionIcons: Record<string, string> = {
 create_post: 'add_circle', update_post: 'edit', archive_post: 'archive',
 publish_post: 'publish', unpublish_post: 'unpublished',
 create_prompt: 'bolt', update_prompt: 'edit_note', delete_prompt: 'delete_forever',
 create_category: 'new_label', update_category: 'label', delete_category: 'label_off',
 upload_media: 'upload_file', delete_media: 'delete', update_media: 'image',
 create_page: 'note_add', update_page: 'edit_document', delete_page: 'delete',
 promote_user: 'shield_person', demote_user: 'person', ban_user: 'block',
 unban_user: 'lock_open', delete_user: 'person_remove',
 migrate_blog: 'sync',
 };

 const recentActivity = document.getElementById('recent-activity')!;
 if (activity?.length) {
 recentActivity.innerHTML = activity.map((a: any) => `
 <div class="flex items-center gap-3 p-4">
 <span class="material-symbols-outlined text-primary text-xl">${actionIcons[a.action] || 'info'}</span>
 <div class="flex-1 min-w-0">
 <p class="text-sm"><strong>${esc(a.userName)}</strong> ${esc(a.action.replace(/_/g, ' '))} ${a.entityTitle ? `"${esc(a.entityTitle)}"` : ''}</p>
 <p class="text-xs text-gray-500 mt-0.5">${new Date(a.createdAt).toLocaleString()}</p>
 </div>
 </div>
 `).join('');
 } else {
 recentActivity.innerHTML = '<div class="py-10 px-6 text-center text-gray-500"><p class="text-xs uppercase tracking-wide">No activity yet</p></div>';
 }
 }

 // Use the server-rendered island for instant paint; fetch only as a fallback.
 let dashInitial: any = null;
 try { dashInitial = JSON.parse(document.getElementById('cms-dash')?.textContent || 'null'); } catch {}
 loadDashboard(dashInitial && dashInitial.counts ? dashInitial : undefined);
</script>
