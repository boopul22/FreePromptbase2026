---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import AdminSidebar from '../../../components/AdminSidebar.astro';
---

<Layout title="Content Management - Admin - Free Prompt Base" noindex={true}>
 <Nav activePage="admin" />

 <div class="flex">
 <AdminSidebar activePage="cms" />

 <main class="flex-1 p-4 sm:p-6 md:p-6 space-y-4 sm:space-y-6 md:space-y-8 bg-gray-50 min-h-[calc(100dvh-var(--nav-h,57px))]">
 <!-- Header -->
 <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
 <div>
 <h1 class="text-xl sm:text-2xl font-semibold text-text-primary">Content Management</h1>
 <p class="text-sm text-gray-500 mt-1">Create, edit, and publish blog posts and pages.</p>
 </div>
 </div>

 <!-- Quick Actions -->
 <div class="flex flex-wrap gap-3 sm:gap-4">
 <a href="/admin/cms/posts/new" class="bg-primary text-link px-4 py-2 rounded-md text-sm font-semibold hover:opacity-90 transition-opacity flex items-center gap-2">
 <span class="material-symbols-outlined text-base">add</span>
 New Post
 </a>
 <a href="/admin/cms/media" class="bg-white text-text-primary px-4 py-2 rounded-md text-sm font-semibold border border-gray-200 hover:border-primary transition-colors flex items-center gap-2">
 <span class="material-symbols-outlined text-base">upload</span>
 Upload Media
 </a>
 <a href="/admin/cms/categories" class="bg-white text-text-primary px-4 py-2 rounded-md text-sm font-semibold border border-gray-200 hover:border-primary transition-colors flex items-center gap-2">
 <span class="material-symbols-outlined text-base">category</span>
 Categories
 </a>
 </div>

 <!-- Stats Cards -->
 <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3" id="cms-stats">
 <div class="bg-white border border-gray-200 rounded-md p-4">
 <span class="material-symbols-outlined text-primary text-xl">article</span>
 <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-500 mt-2">Total Posts</p>
 <p class="text-2xl font-semibold text-text-primary mt-1" id="stat-posts">—</p>
 </div>
 <div class="bg-white border border-gray-200 rounded-md p-4">
 <span class="material-symbols-outlined text-primary text-xl">publish</span>
 <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-500 mt-2">Published</p>
 <p class="text-2xl font-semibold text-text-primary mt-1" id="stat-published">—</p>
 </div>
 <div class="bg-white border border-gray-200 rounded-md p-4">
 <span class="material-symbols-outlined text-primary text-xl">edit_note</span>
 <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-500 mt-2">Drafts</p>
 <p class="text-2xl font-semibold text-text-primary mt-1" id="stat-drafts">—</p>
 </div>
 <div class="bg-white border border-gray-200 rounded-md p-4">
 <span class="material-symbols-outlined text-primary text-xl">category</span>
 <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-500 mt-2">Categories</p>
 <p class="text-2xl font-semibold text-text-primary mt-1" id="stat-categories">—</p>
 </div>
 <div class="bg-white border border-gray-200 rounded-md p-4">
 <span class="material-symbols-outlined text-primary text-xl">image</span>
 <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-500 mt-2">Media</p>
 <p class="text-2xl font-semibold text-text-primary mt-1" id="stat-media">—</p>
 </div>
 </div>

 <!-- Two Column Layout -->
 <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6">
 <!-- Recent Posts -->
 <div class="bg-white border border-gray-200 rounded-md">
 <div class="p-4 border-b border-gray-200 flex items-center justify-between">
 <h2 class="font-semibold text-base">Recent Posts</h2>
 <a href="/admin/cms/posts" class="text-xs font-semibold text-primary hover:underline flex items-center gap-1">
 View all <span class="material-symbols-outlined text-sm">arrow_forward</span>
 </a>
 </div>
 <div id="recent-posts" class="divide-y divide-gray-200/50">
 <div class="p-6 text-center text-gray-500">
 <span class="material-symbols-outlined text-4xl">hourglass_empty</span>
 <p class="text-xs uppercase tracking-wide mt-2">Loading...</p>
 </div>
 </div>
 </div>

 <!-- Recent Activity -->
 <div class="bg-white border border-gray-200 rounded-md">
 <div class="p-4 border-b border-gray-200">
 <h2 class="font-semibold text-base">Recent Activity</h2>
 </div>
 <div id="recent-activity" class="divide-y divide-gray-200/50 max-h-[400px] overflow-y-auto">
 <div class="p-6 text-center text-gray-500">
 <span class="material-symbols-outlined text-4xl">hourglass_empty</span>
 <p class="text-xs uppercase tracking-wide mt-2">Loading...</p>
 </div>
 </div>
 </div>
 </div>
 </main>
 </div>
</Layout>

<script>
 function esc(s: string): string {
 const d = document.createElement('div');
 d.textContent = s;
 return d.innerHTML;
 }

 async function loadDashboard() {
 // Load stats
 const [postsRes, categoriesRes, mediaRes, activityRes] = await Promise.all([
 fetch('/api/admin/cms/posts?limit=5'),
 fetch('/api/admin/cms/categories'),
 fetch('/api/admin/cms/media?limit=1'),
 fetch('/api/admin/cms/activity?limit=10'),
 ]);

 const postsData = await postsRes.json();
 const categoriesData = await categoriesRes.json();
 const mediaData = await mediaRes.json();
 const activityData = await activityRes.json();

 // Stats
 document.getElementById('stat-posts')!.textContent = String(postsData.total || 0);
 document.getElementById('stat-categories')!.textContent = String(categoriesData.categories?.length || 0);
 document.getElementById('stat-media')!.textContent = String(mediaData.total || 0);

 // Count published/drafts from posts
 const allPostsRes = await fetch('/api/admin/cms/posts?status=published&limit=1');
 const allPostsData = await allPostsRes.json();
 document.getElementById('stat-published')!.textContent = String(allPostsData.total || 0);

 const draftsRes = await fetch('/api/admin/cms/posts?status=draft&limit=1');
 const draftsData = await draftsRes.json();
 document.getElementById('stat-drafts')!.textContent = String(draftsData.total || 0);

 // Recent posts
 const recentPosts = document.getElementById('recent-posts')!;
 if (postsData.posts?.length) {
 recentPosts.innerHTML = postsData.posts.map((p: any) => `
 <a href="/admin/cms/posts/edit/${esc(p.id)}" class="flex items-center justify-between p-4 hover:bg-gray-50 transition-colors">
 <div class="flex-1 min-w-0">
 <p class="font-bold text-sm truncate">${esc(p.title)}</p>
 <p class="text-xs text-gray-500 uppercase tracking-wider mt-1">${esc(p.categoryName || 'Uncategorized')} &middot; ${esc(p.readTime)}</p>
 </div>
 <span class="px-2.5 py-1 rounded-full text-xs font-bold uppercase ml-3 ${
 p.status === 'published' ? 'bg-blue-50 text-blue-900' :
 p.status === 'draft' ? 'bg-amber-50 text-amber-900' :
 'bg-red-50 text-red-900'
 }">${p.status}</span>
 </a>
 `).join('');
 } else {
 recentPosts.innerHTML = '<div class="p-6 text-center text-gray-500"><p class="text-xs uppercase tracking-wide">No posts yet</p></div>';
 }

 // Activity
 const actionIcons: Record<string, string> = {
 create_post: 'add_circle', update_post: 'edit', archive_post: 'archive',
 publish_post: 'publish', unpublish_post: 'unpublished',
 create_category: 'new_label', update_category: 'label', delete_category: 'label_off',
 upload_media: 'upload_file', delete_media: 'delete', update_media: 'image',
 create_page: 'note_add', update_page: 'edit_document', delete_page: 'delete',
 migrate_blog: 'sync',
 };

 const recentActivity = document.getElementById('recent-activity')!;
 if (activityData.activity?.length) {
 recentActivity.innerHTML = activityData.activity.map((a: any) => `
 <div class="flex items-center gap-3 p-4">
 <span class="material-symbols-outlined text-primary text-xl">${actionIcons[a.action] || 'info'}</span>
 <div class="flex-1 min-w-0">
 <p class="text-sm"><strong>${esc(a.userName)}</strong> ${esc(a.action.replace(/_/g, ' '))} ${a.entityTitle ? `"${esc(a.entityTitle)}"` : ''}</p>
 <p class="text-xs text-gray-500 uppercase tracking-wider mt-0.5">${new Date(a.createdAt).toLocaleString()}</p>
 </div>
 </div>
 `).join('');
 } else {
 recentActivity.innerHTML = '<div class="p-6 text-center text-gray-500"><p class="text-xs uppercase tracking-wide">No activity yet</p></div>';
 }
 }

 loadDashboard();
</script>
