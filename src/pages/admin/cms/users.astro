---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import AdminSidebar from '../../../components/AdminSidebar.astro';

const currentUserId = Astro.locals.user?.id ?? '';
---

<Layout title="Users - CMS - Free Prompt Base" noindex={true}>
 <div class="flex">
 <AdminSidebar activePage="cms" />

 <main class="flex-1 p-4 sm:p-6 md:p-6 space-y-5 bg-gray-50 min-h-screen">
 <!-- Header -->
 <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
 <div>
 <h1 class="text-xl sm:text-2xl font-semibold text-text-primary">Users</h1>
 <p class="text-sm text-gray-500 mt-1" id="user-subtitle">Everyone who has signed in with Google.</p>
 </div>
 </header>

 <!-- Filters -->
 <div class="flex flex-col md:flex-row gap-3">
 <select id="role-filter" class="px-3 py-2 border border-gray-200 rounded-md bg-white text-sm">
 <option value="">All roles</option>
 <option value="admin">Admins</option>
 <option value="user">Users</option>
 </select>
 <div class="flex items-center gap-2 px-3 py-2 bg-white border border-gray-200 rounded-md flex-1">
 <span class="material-symbols-outlined text-gray-400 text-base">search</span>
 <input id="search-input" type="text" placeholder="Search by name or email..." class="bg-transparent border-none focus:outline-none w-full text-sm" />
 </div>
 </div>

 <!-- Table -->
 <div class="bg-white border border-gray-200 rounded-md overflow-hidden">
 <div id="users-list">
 <div class="p-8 text-center text-gray-500">
 <span class="material-symbols-outlined text-3xl">hourglass_empty</span>
 <p class="text-xs uppercase tracking-wide mt-2">Loading...</p>
 </div>
 </div>
 </div>
 </main>
 </div>
</Layout>

<script define:vars={{ currentUserId }}>
 let currentFilters = {};

 function esc(s) {
 const d = document.createElement('div');
 d.textContent = s == null ? '' : String(s);
 return d.innerHTML;
 }

 function fmtDate(iso) {
 if (!iso) return '';
 const d = new Date(iso);
 return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
 }

 async function loadUsers() {
 const params = new URLSearchParams(currentFilters);
 const res = await fetch(`/api/admin/cms/users?${params}`);
 const data = await res.json();
 const list = document.getElementById('users-list');

 document.getElementById('user-subtitle').textContent =
 `${data.total} ${data.total === 1 ? 'user' : 'users'}.`;

 if (!data.users?.length) {
 list.innerHTML = '<div class="p-8 text-center text-gray-500"><p class="text-sm">No users match the current filter.</p></div>';
 return;
 }

 list.innerHTML = `
 <table class="w-full text-sm">
 <thead class="bg-gray-50 text-[11px] font-semibold uppercase tracking-wide text-gray-500">
 <tr>
 <th class="text-left px-4 py-3">User</th>
 <th class="text-left px-4 py-3 hidden md:table-cell">Role</th>
 <th class="text-left px-4 py-3 hidden lg:table-cell">Joined</th>
 <th class="text-left px-4 py-3 hidden md:table-cell">Status</th>
 <th class="text-right px-4 py-3">Actions</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-gray-200">
 ${data.users.map((u) => {
 const isMe = u.id === currentUserId;
 return `
 <tr class="hover:bg-gray-50 transition-colors ${u.isBanned ? 'opacity-60' : ''}">
 <td class="px-4 py-3">
 <div class="flex items-center gap-3">
 ${u.avatarUrl
 ? `<img src="${esc(u.avatarUrl)}" alt="" class="w-8 h-8 rounded-full object-cover shrink-0" />`
 : `<div class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-xs font-semibold text-gray-500 shrink-0">${esc((u.name || '?')[0].toUpperCase())}</div>`}
 <div class="min-w-0">
 <p class="font-medium text-text-primary truncate">
 ${esc(u.name)}
 ${isMe ? '<span class="ml-1 text-[10px] font-semibold uppercase tracking-wide text-primary">you</span>' : ''}
 </p>
 <p class="text-xs text-gray-500 truncate">${esc(u.email)}</p>
 </div>
 </div>
 </td>
 <td class="px-4 py-3 hidden md:table-cell">
 <span class="px-2 py-0.5 rounded-md text-[11px] font-semibold uppercase tracking-wide ${
 u.role === 'admin' ? 'bg-amber-50 text-amber-700' : 'bg-gray-100 text-gray-600'
 }">${esc(u.role)}</span>
 </td>
 <td class="px-4 py-3 hidden lg:table-cell text-xs text-gray-500">${esc(fmtDate(u.createdAt))}</td>
 <td class="px-4 py-3 hidden md:table-cell">
 ${u.isBanned
 ? '<span class="px-2 py-0.5 rounded-md text-[11px] font-semibold uppercase tracking-wide bg-red-50 text-red-700">Banned</span>'
 : '<span class="px-2 py-0.5 rounded-md text-[11px] font-semibold text-gray-500">Active</span>'}
 </td>
 <td class="px-4 py-3 text-right whitespace-nowrap">
 ${isMe ? '<span class="text-xs text-gray-400">—</span>' : `
 ${u.role === 'admin'
 ? `<button onclick="setRole('${esc(u.id)}', 'user')" class="text-xs font-semibold px-2 py-1 rounded-md text-gray-600 hover:bg-gray-100 transition-colors" title="Remove admin">Demote</button>`
 : `<button onclick="setRole('${esc(u.id)}', 'admin')" class="text-xs font-semibold px-2 py-1 rounded-md text-amber-700 hover:bg-amber-50 transition-colors" title="Make admin">Make admin</button>`}
 ${u.isBanned
 ? `<button onclick="setBan('${esc(u.id)}', false)" class="text-xs font-semibold px-2 py-1 rounded-md text-gray-600 hover:bg-gray-100 transition-colors" title="Unban">Unban</button>`
 : `<button onclick="setBan('${esc(u.id)}', true)" class="text-xs font-semibold px-2 py-1 rounded-md text-red-700 hover:bg-red-50 transition-colors" title="Ban">Ban</button>`}
 <button onclick="del('${esc(u.id)}', '${esc((u.email || '').replace(/'/g, "\\'"))}')" class="inline-flex items-center justify-center w-7 h-7 rounded-md hover:bg-red-50 text-gray-500 hover:text-red-600 transition-colors" title="Delete">
 <span class="material-symbols-outlined text-base">delete</span>
 </button>
 `}
 </td>
 </tr>
 `;
 }).join('')}
 </tbody>
 </table>
 `;
 }

 async function setRole(id, role) {
 const verb = role === 'admin' ? 'promote to admin' : 'demote to user';
 if (!confirm(`Are you sure you want to ${verb}?`)) return;
 const res = await fetch(`/api/admin/cms/users/${encodeURIComponent(id)}`, {
 method: 'PUT',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ role }),
 });
 if (res.ok) {
 loadUsers();
 } else {
 const err = await res.json().catch(() => ({}));
 alert(`Update failed: ${err.error || res.statusText}`);
 }
 }

 async function setBan(id, isBanned) {
 const verb = isBanned ? 'ban' : 'unban';
 if (!confirm(`Are you sure you want to ${verb} this user?`)) return;
 const res = await fetch(`/api/admin/cms/users/${encodeURIComponent(id)}`, {
 method: 'PUT',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ isBanned }),
 });
 if (res.ok) {
 loadUsers();
 } else {
 const err = await res.json().catch(() => ({}));
 alert(`Update failed: ${err.error || res.statusText}`);
 }
 }

 async function del(id, email) {
 if (!confirm(`Delete user ${email}? This removes their account and active sessions. Activity history stays.`)) return;
 const res = await fetch(`/api/admin/cms/users/${encodeURIComponent(id)}`, { method: 'DELETE' });
 if (res.ok) {
 loadUsers();
 } else {
 const err = await res.json().catch(() => ({}));
 alert(`Delete failed: ${err.error || res.statusText}`);
 }
 }

 window.setRole = setRole;
 window.setBan = setBan;
 window.del = del;

 function applyFilters() {
 currentFilters = {};
 const role = document.getElementById('role-filter').value;
 const search = document.getElementById('search-input').value.trim();
 if (role) currentFilters.role = role;
 if (search) currentFilters.search = search;
 loadUsers();
 }

 document.getElementById('role-filter').addEventListener('change', applyFilters);
 let searchTimer;
 document.getElementById('search-input').addEventListener('input', () => {
 clearTimeout(searchTimer);
 searchTimer = setTimeout(applyFilters, 250);
 });

 loadUsers();
</script>
