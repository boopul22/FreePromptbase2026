---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import AdminSidebar from '../../../components/AdminSidebar.astro';
---

<Layout title="Categories - CMS - Free Prompt Base" noindex={true}>

 <div class="flex flex-col md:flex-row min-h-screen md:h-screen md:overflow-hidden">
 <AdminSidebar activePage="cms" />

 <main class="flex-1 p-4 sm:p-6 md:p-6 space-y-4 sm:space-y-6 bg-gray-50 md:overflow-y-auto md:h-screen">
 <!-- Breadcrumb -->
 <nav class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-gray-500" aria-label="Breadcrumb">
 <a href="/admin/cms" class="hover:text-text-primary transition-colors">Content</a>
 <span class="material-symbols-outlined text-sm">chevron_right</span>
 <span class="text-text-primary">Categories</span>
 </nav>

 <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
 <div>
 <h1 class="text-xl sm:text-2xl font-bold text-text-primary">Categories</h1>
 <p class="text-gray-600 mt-1">Organize your blog content by topic.</p>
 </div>
 </div>

 <!-- Add Category -->
 <div class="bg-white border border-gray-200 rounded-md p-4">
 <h3 class="text-xs font-semibold uppercase tracking-wide mb-4">Add New Category</h3>
 <div class="flex flex-col sm:flex-row gap-3">
 <input id="new-cat-name" type="text" placeholder="Category name..." class="flex-1 border border-gray-200 rounded-lg px-4 py-2 bg-white text-sm" />
 <select id="new-cat-color" class="border border-gray-200 rounded-lg px-4 py-2 bg-white text-sm">
 <option value="primary">Purple (Primary)</option>
 <option value="secondary">Teal (Secondary)</option>
 <option value="tertiary">Olive (Tertiary)</option>
 </select>
 <button id="add-cat-btn" class="bg-primary text-link px-6 py-2 rounded-lg text-xs font-semibold uppercase tracking-wide border border-gray-200 transition-all">
 Add
 </button>
 </div>
 </div>

 <!-- Categories List -->
 <div id="categories-list" class="bg-white border border-gray-200 rounded-md overflow-hidden">
 <div class="p-6 text-center text-gray-500">
 <span class="material-symbols-outlined text-4xl">hourglass_empty</span>
 <p class="text-xs uppercase tracking-wide mt-2">Loading...</p>
 </div>
 </div>
 </main>
 </div>
</Layout>

<script>
 function esc(s: string): string {
 const d = document.createElement('div');
 d.textContent = s;
 return d.innerHTML;
 }

 async function loadCategories() {
 const res = await fetch('/api/admin/cms/categories');
 const data = await res.json();
 const container = document.getElementById('categories-list')!;

 if (!data.categories?.length) {
 container.innerHTML = '<div class="p-6 text-center text-gray-500"><span class="material-symbols-outlined text-4xl">category</span><p class="text-xs uppercase tracking-wide mt-2">No categories yet</p></div>';
 return;
 }

 const colorLabel = (c: string) => c === 'primary' ? 'Purple' : c === 'secondary' ? 'Teal' : 'Olive';

 container.innerHTML = `
 <div class="overflow-x-auto"><table class="w-full text-left min-w-[600px]">
 <thead>
 <tr class="border-b border-gray-200">
 <th class="px-6 py-4 text-xs uppercase tracking-wide font-bold text-gray-500 tracking-wider">Name</th>
 <th class="px-6 py-4 text-xs uppercase tracking-wide font-bold text-gray-500 tracking-wider">Slug</th>
 <th class="px-6 py-4 text-xs uppercase tracking-wide font-bold text-gray-500 tracking-wider">Color</th>
 <th class="px-6 py-4 text-xs uppercase tracking-wide font-bold text-gray-500 tracking-wider">Posts</th>
 <th class="px-6 py-4 text-xs uppercase tracking-wide font-bold text-gray-500 tracking-wider">Actions</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-gray-200/50">
 ${data.categories.map((c: any) => `
 <tr class="hover:bg-gray-50 transition-colors" data-id="${esc(c.id)}">
 <td class="px-6 py-4">
 <input type="text" value="${esc(c.name)}" class="cat-name bg-transparent border-b border-transparent hover:border-gray-200 focus:border-primary focus:outline-none font-bold text-sm w-full" />
 </td>
 <td class="px-6 py-4 text-sm text-gray-500">${esc(c.slug)}</td>
 <td class="px-6 py-4">
 <select class="cat-color border border-gray-200 rounded px-2 py-1 bg-white text-xs">
 <option value="primary" ${c.color === 'primary' ? 'selected' : ''}>Purple</option>
 <option value="secondary" ${c.color === 'secondary' ? 'selected' : ''}>Teal</option>
 <option value="tertiary" ${c.color === 'tertiary' ? 'selected' : ''}>Olive</option>
 </select>
 </td>
 <td class="px-6 py-4 text-sm font-bold">${c.postCount}</td>
 <td class="px-6 py-4">
 <div class="flex gap-2">
 <button onclick="saveCat('${esc(c.id)}')" class="px-3 py-1 rounded-full text-xs font-bold uppercase border border-primary text-primary hover:bg-primary hover:text-link transition-colors">Save</button>
 <button onclick="deleteCat('${esc(c.id)}')" class="px-3 py-1 rounded-full text-xs font-bold uppercase border border-red-300 text-red-600 hover:bg-red-50 hover:text-red-900 transition-colors">Delete</button>
 </div>
 </td>
 </tr>
 `).join('')}
 </tbody>
 </table></div>
 `;
 }

 (window as any).saveCat = async (id: string) => {
 const row = document.querySelector(`tr[data-id="${id}"]`)!;
 const name = (row.querySelector('.cat-name') as HTMLInputElement).value;
 const color = (row.querySelector('.cat-color') as HTMLSelectElement).value;

 await fetch('/api/admin/cms/categories', {
 method: 'PUT',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ id, name, color }),
 });
 loadCategories();
 };

 (window as any).deleteCat = async (id: string) => {
 if (!confirm('Delete this category?')) return;
 const res = await fetch('/api/admin/cms/categories', {
 method: 'DELETE',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ id }),
 });
 const data = await res.json();
 if (data.error) alert(data.error);
 loadCategories();
 };

 document.getElementById('add-cat-btn')!.addEventListener('click', async () => {
 const name = (document.getElementById('new-cat-name') as HTMLInputElement).value.trim();
 const color = (document.getElementById('new-cat-color') as HTMLSelectElement).value;
 if (!name) return;

 const res = await fetch('/api/admin/cms/categories', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ name, color }),
 });
 const data = await res.json();
 if (data.error) { alert(data.error); return; }
 (document.getElementById('new-cat-name') as HTMLInputElement).value = '';
 loadCategories();
 });

 loadCategories();
</script>
