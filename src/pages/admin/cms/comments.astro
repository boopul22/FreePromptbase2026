---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import AdminSidebar from '../../../components/AdminSidebar.astro';
import { getDB } from '../../../lib/db';
import { listAdminComments, type AdminComment, type CommentStatus } from '../../../lib/comments';

const statusFilter = (Astro.url.searchParams.get('status') || 'all') as
	| CommentStatus
	| 'all';
const allowed = new Set(['visible', 'hidden', 'deleted', 'all']);
const status = allowed.has(statusFilter) ? statusFilter : 'all';

let comments: AdminComment[] = [];
try {
	const db = getDB(Astro.locals);
	comments = await listAdminComments(db, { status, limit: 100 });
} catch {
	comments = [];
}

function snippet(body: string, n = 140): string {
	const t = body.replace(/\s+/g, ' ').trim();
	return t.length <= n ? t : t.slice(0, n - 1) + '…';
}

function articleHref(c: AdminComment): string {
	if (!c.postSlug) return '#';
	const base = c.postContentType === 'news' ? '/news' : '/blog';
	return `${base}/${c.postSlug}`;
}

const filters: Array<{ value: string; label: string }> = [
	{ value: 'all', label: 'Active' },
	{ value: 'visible', label: 'Visible' },
	{ value: 'hidden', label: 'Hidden' },
	{ value: 'deleted', label: 'Deleted' },
];
---

<Layout title="Comments — CMS — Free Prompt Base" noindex={true}>
	<div class="flex flex-col md:flex-row min-h-screen md:h-screen md:overflow-hidden">
		<AdminSidebar activePage="comments" />

		<main class="flex-1 min-w-0 p-3 sm:p-5 space-y-4 bg-gray-50 md:overflow-y-auto md:h-screen">
			<header class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
				<div>
					<h1 class="text-lg font-semibold text-text-primary">Comments</h1>
					<p class="text-xs text-gray-500 mt-0.5">
						Moderate discussion on blog and news articles.
					</p>
				</div>
				<nav class="flex flex-wrap gap-1.5" aria-label="Filter comments">
					{filters.map((f) => (
						<a
							href={`/admin/cms/comments?status=${f.value}`}
							class:list={[
								'px-2.5 py-1 rounded-md text-xs font-semibold border transition-colors',
								status === f.value
									? 'bg-primary text-link border-primary'
									: 'bg-white text-gray-600 border-gray-200 hover:border-gray-300',
							]}
						>
							{f.label}
						</a>
					))}
				</nav>
			</header>

			{comments.length === 0 ? (
				<div class="bg-white border border-gray-200 rounded-md py-10 px-6 text-center text-sm text-gray-500">
					No comments in this view.
				</div>
			) : (
				<div class="bg-white border border-gray-200 rounded-md overflow-hidden">
					<ul class="divide-y divide-gray-100" id="comments-mod-list">
						{comments.map((c) => (
							<li
								class="p-4 flex flex-col gap-3 sm:flex-row sm:items-start"
								data-comment-row={c.id}
							>
								<div class="flex items-start gap-3 sm:w-48 shrink-0">
									{c.author.avatarUrl ? (
										<img
											src={c.author.avatarUrl}
											alt=""
											referrerpolicy="no-referrer"
											class="w-9 h-9 rounded-full object-cover bg-gray-100"
											width="36"
											height="36"
										/>
									) : (
										<div class="w-9 h-9 rounded-full bg-gray-200 flex items-center justify-center text-xs font-semibold text-gray-500">
											{c.author.name.slice(0, 1).toUpperCase()}
										</div>
									)}
									<div class="min-w-0">
										<p class="text-sm font-medium text-text-primary truncate">{c.author.name}</p>
										{c.author.username ? (
											<a
												href={`/author/${c.author.username}`}
												class="text-xs text-gray-500 hover:text-secondary truncate block"
											>
												@{c.author.username}
											</a>
										) : null}
										<p class="text-[11px] text-gray-400 mt-0.5">{c.createdAt.slice(0, 16)}</p>
									</div>
								</div>

								<div class="flex-1 min-w-0">
									<div class="flex flex-wrap items-center gap-2 mb-1">
										<span
											class:list={[
												'text-[10px] font-semibold uppercase tracking-wide px-1.5 py-0.5 rounded',
												c.status === 'visible' && 'bg-emerald-50 text-emerald-800',
												c.status === 'hidden' && 'bg-amber-50 text-amber-900',
												c.status === 'deleted' && 'bg-red-50 text-red-800',
											]}
											data-status-badge
										>
											{c.status}
										</span>
										{c.parentId ? (
											<span class="text-[10px] font-semibold uppercase tracking-wide text-gray-400">
												reply
											</span>
										) : null}
										{c.postSlug ? (
											<a
												href={articleHref(c)}
												class="text-xs text-primary hover:underline truncate"
												target="_blank"
												rel="noopener"
											>
												{c.postTitle}
											</a>
										) : (
											<span class="text-xs text-gray-400">{c.postTitle}</span>
										)}
									</div>
									<p class="text-sm text-gray-800 whitespace-pre-wrap break-words">{snippet(c.body, 280)}</p>
									<div class="mt-3 flex flex-wrap gap-2 items-center">
										{c.status !== 'visible' && (
											<button
												type="button"
												class="btn-secondary btn-sm"
												data-mod-action="visible"
												data-id={c.id}
											>
												Restore
											</button>
										)}
										{c.status !== 'hidden' && c.status !== 'deleted' && (
											<button
												type="button"
												class="btn-secondary btn-sm"
												data-mod-action="hidden"
												data-id={c.id}
											>
												Hide
											</button>
										)}
										{c.status !== 'deleted' && (
											<button
												type="button"
												class="btn-danger btn-sm"
												data-mod-action="deleted"
												data-id={c.id}
											>
												Delete
											</button>
										)}
										<span data-feedback class="text-xs text-gray-500 hidden"></span>
									</div>
								</div>
							</li>
						))}
					</ul>
				</div>
			)}
		</main>
	</div>
</Layout>

<script>
	import { toast } from '../../../scripts/toast';

	async function setStatus(id: string, status: string) {
		const res = await fetch('/api/admin/cms/comments', {
			method: 'PATCH',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ id, status }),
		});
		return res;
	}

	document.querySelectorAll('button[data-mod-action]').forEach((btn) => {
		btn.addEventListener('click', async () => {
			const button = btn as HTMLButtonElement;
			const action = button.dataset.modAction!;
			const id = button.dataset.id!;
			const row = document.querySelector(`[data-comment-row="${id}"]`) as HTMLElement | null;
			const feedback = row?.querySelector('[data-feedback]') as HTMLElement | null;

			if (action === 'deleted' && !confirm('Soft-delete this comment?')) return;

			button.disabled = true;
			if (feedback) {
				feedback.textContent = 'Saving…';
				feedback.classList.remove('hidden');
			}

			const res = await setStatus(id, action);
			if (res.ok) {
				toast(
					action === 'hidden'
						? 'Comment hidden'
						: action === 'deleted'
							? 'Comment deleted'
							: 'Comment restored',
					'success',
				);
				if (row) {
					row.classList.add('opacity-50');
					setTimeout(() => row.remove(), 280);
				}
			} else {
				const err = await res.json().catch(() => ({}));
				toast((err as { error?: string }).error || 'Failed to update', 'error');
				button.disabled = false;
				if (feedback) feedback.classList.add('hidden');
			}
		});
	});
</script>
