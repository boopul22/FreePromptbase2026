---
export const prerender = false;

import Layout from '../../../../layouts/Layout.astro';
import AdminSidebar from '../../../../components/AdminSidebar.astro';

const currentAdminId = Astro.locals.user?.id || '';
const today = new Date().toISOString().slice(0, 10);
---

<Layout title="New Prompt - CMS - Free Prompt Base" noindex={true}>
 <div class="flex flex-col md:flex-row min-h-screen md:h-screen md:overflow-hidden">
 <AdminSidebar activePage="cms" />

 <main class="flex-1 min-w-0 p-4 sm:p-6 md:p-6 space-y-5 bg-gray-50 md:overflow-y-auto md:h-screen">
 <!-- Breadcrumb -->
 <nav class="flex items-center gap-2 text-xs text-gray-500">
 <a href="/admin/cms/prompts" class="hover:text-text-primary transition-colors">Prompts</a>
 <span class="material-symbols-outlined text-sm">chevron_right</span>
 <span class="text-text-primary font-medium">New</span>
 </nav>

 <header class="flex items-center justify-between gap-4">
 <h1 class="text-xl sm:text-2xl font-semibold text-text-primary">New prompt</h1>
 <div class="flex gap-2">
 <a href="/admin/cms/prompts" class="px-3 py-2 rounded-md text-sm font-semibold text-gray-600 hover:bg-gray-100 transition-colors">Cancel</a>
 <button id="draft-btn" type="button" class="btn-feedback bg-white text-text-primary px-4 py-2 rounded-md text-sm font-semibold border border-gray-200 hover:bg-gray-50 flex items-center gap-2">
 <span class="material-symbols-outlined text-base">draft</span>
 Save draft
 </button>
 <button id="schedule-btn" type="button" class="btn-feedback bg-white text-text-primary px-4 py-2 rounded-md text-sm font-semibold border border-gray-200 hover:bg-gray-50 flex items-center gap-2">
 <span class="material-symbols-outlined text-base">schedule</span>
 Schedule
 </button>
 <button id="publish-btn" type="button" class="btn-feedback bg-primary text-link px-4 py-2 rounded-md text-sm font-semibold hover:opacity-90 flex items-center gap-2">
 <span class="material-symbols-outlined text-base">publish</span>
 Publish
 </button>
 </div>
 </header>

 <form id="prompt-form" class="grid grid-cols-1 lg:grid-cols-3 gap-5">
 <!-- Main column -->
 <div class="lg:col-span-2 space-y-4">
 <div class="bg-white border border-gray-200 rounded-md p-5 space-y-4">
 <div>
 <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5" for="f-title">Title</label>
 <input id="f-title" name="title" type="text" required placeholder="Cinematic Portrait Photography" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
 </div>
 <div>
 <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5" for="f-slug">Slug</label>
 <input id="f-slug" name="slug" type="text" placeholder="auto-generated from title" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-primary" />
 <p class="text-xs text-gray-500 mt-1">Used in the URL: <span class="font-mono">/your-slug</span>. Leave blank to auto-generate.</p>
 </div>
 <div>
 <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5" for="f-description">Description</label>
 <textarea id="f-description" name="description" rows="2" placeholder="One-line hook shown on cards and search." class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary resize-y"></textarea>
 </div>
 <div>
 <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5" for="f-prompt-text">Prompt text</label>
 <textarea id="f-prompt-text" name="promptText" rows="12" required placeholder="The full prompt body the user will copy." class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-primary resize-y"></textarea>
 </div>
 <div>
 <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5" for="f-how-to-use">How to use (optional)</label>
 <textarea id="f-how-to-use" name="howToUse" rows="3" placeholder="Tips on substituting placeholders, tuning, etc." class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary resize-y"></textarea>
 </div>
 </div>

 <!-- Images -->
 <div class="bg-white border border-gray-200 rounded-md p-5 space-y-4">
 <div>
 <p class="text-sm font-semibold text-text-primary">Images</p>
 <p class="text-xs text-gray-500 mt-0.5">Drag &amp; drop or click to upload. They render as a carousel on the prompt page. Click a thumbnail to set it as the cover (featured) image, or drag thumbnails to reorder the gallery.</p>
 </div>
 <label id="dropzone" class="block border-2 border-dashed border-gray-300 rounded-md px-4 py-8 text-center cursor-pointer hover:border-primary hover:bg-gray-50 transition-colors">
 <input id="image-input" type="file" accept="image/*" multiple class="hidden" />
 <span class="material-symbols-outlined text-3xl text-gray-400">cloud_upload</span>
 <p class="text-sm font-medium text-text-primary mt-1">Drop images here, or click to browse</p>
 <p class="text-xs text-gray-500 mt-0.5">PNG, JPG or WebP — multiple allowed</p>
 </label>
 <div id="image-status" class="text-xs text-gray-500 hidden"></div>
 <div id="image-strip" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 empty:hidden"></div>
 </div>
 </div>

 <!-- Side column -->
 <aside class="space-y-4">
 <div class="bg-white border border-gray-200 rounded-md p-5 space-y-4">
 <div>
 <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5" for="f-category">Category</label>
 <select id="f-category" name="category" required class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-primary">
 <option value="">Select category…</option>
 </select>
 </div>
 <div>
 <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5" for="f-tags">Tags</label>
 <input id="f-tags" name="tags" type="text" placeholder="copywriting, social media, hooks" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
 <p class="text-xs text-gray-500 mt-1">Comma-separated.</p>
 </div>
 <div>
 <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5" for="f-cover">Cover image URL</label>
 <input id="f-cover" name="coverImage" type="url" placeholder="https://..." class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
 </div>
 </div>

 <div class="bg-white border border-gray-200 rounded-md p-5 space-y-4">
 <div>
 <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5" for="f-author">Author</label>
 <select id="f-author" name="createdBy" required data-default-id={currentAdminId} class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-primary">
 <option value="">Loading users…</option>
 </select>
 <p class="text-xs text-gray-500 mt-1">Pick the user this prompt should be credited to. Their display name becomes the byline.</p>
 </div>
 <div>
 <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5" for="f-popularity">Popularity</label>
 <input id="f-popularity" name="popularity" type="number" min="0" value="0" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
 </div>
 <label class="flex items-center gap-2 text-sm text-text-primary cursor-pointer">
 <input id="f-featured" name="featured" type="checkbox" class="accent-primary w-4 h-4" />
 Featured prompt
 </label>
 </div>
 </aside>
 </form>

 <!-- Publish / schedule date picker (shared by both actions) -->
 <dialog id="schedule-dialog" class="fpb-modal">
 <div class="p-4 space-y-3">
 <div class="flex items-center gap-2">
 <span class="material-symbols-outlined text-primary text-lg leading-none shrink-0">schedule</span>
 <h2 id="schedule-dialog-title" class="text-sm font-semibold text-text-primary">Publish</h2>
 </div>
 <p id="schedule-dialog-hint" class="text-xs text-gray-500 leading-snug">Choose when this prompt goes live. Your local timezone.</p>
 <input id="f-publish-at" type="datetime-local" class="w-full border border-gray-200 rounded-md px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
 <div id="schedule-presets" class="flex flex-wrap gap-1.5">
 <button type="button" class="fpb-preset" data-preset="1h">In 1 hour</button>
 <button type="button" class="fpb-preset" data-preset="tom9">Tomorrow 9 AM</button>
 <button type="button" class="fpb-preset" data-preset="week">Next week</button>
 </div>
 <p id="schedule-summary" class="hidden items-center gap-1.5 text-xs font-medium text-text-primary bg-gray-50 border border-gray-200 rounded-md px-2.5 py-1.5">
 <span class="material-symbols-outlined text-sm text-primary">event_available</span>
 <span data-summary-text></span>
 <button type="button" id="schedule-change" class="ml-auto text-primary font-semibold hover:underline">Change</button>
 </p>
 <div class="flex justify-end gap-2 pt-0.5">
 <button id="schedule-cancel" type="button" class="btn-feedback px-3 py-1.5 rounded-md text-sm font-medium text-gray-600 hover:bg-gray-100">Cancel</button>
 <button id="schedule-confirm" type="button" class="btn-feedback bg-primary text-link px-3.5 py-1.5 rounded-md text-sm font-semibold hover:opacity-90">Confirm</button>
 </div>
 </div>
 </dialog>
 </main>
 </div>
</Layout>

<script>
 import { imageToWebp } from '../../../../scripts/image-to-webp';
 import { toast } from '../../../../scripts/toast';
 import { withButtonLoading } from '../../../../scripts/button-loading';

 async function loadCategories() {
 const res = await fetch('/api/admin/cms/prompt-categories');
 const data = await res.json();
 const sel = document.getElementById('f-category') as HTMLSelectElement;
 for (const c of data.categories || []) {
 const opt = document.createElement('option');
 opt.value = c.slug;
 opt.textContent = `${c.emoji} ${c.name}`;
 sel.appendChild(opt);
 }
 }

 async function loadAuthors() {
 const sel = document.getElementById('f-author') as HTMLSelectElement;
 const defaultId = sel.dataset.defaultId || '';
 const res = await fetch('/api/admin/cms/users');
 if (!res.ok) {
 sel.innerHTML = '<option value="">Could not load users</option>';
 return;
 }
 const data = await res.json();
 const users = (data.users || []) as Array<{ id: string; name: string; email: string; role: string }>;
 // Sort: admins first, then alphabetical
 users.sort((a, b) => {
 if (a.role !== b.role) return a.role === 'admin' ? -1 : 1;
 return a.name.localeCompare(b.name);
 });
 sel.innerHTML = '';
 for (const u of users) {
 const opt = document.createElement('option');
 opt.value = u.id;
 const tag = u.role === 'admin' ? ' (admin)' : '';
 opt.textContent = `${u.name}${tag} — ${u.email}`;
 if (u.id === defaultId) opt.selected = true;
 sel.appendChild(opt);
 }
 }

 function val(id: string): string {
 return (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement).value;
 }
 function bool(id: string): boolean {
 return (document.getElementById(id) as HTMLInputElement).checked;
 }

 // --- Image gallery state ---
 let images: string[] = [];
 let pending = 0; // skeleton tiles shown while uploads are in flight

 function coverField(): HTMLInputElement {
 return document.getElementById('f-cover') as HTMLInputElement;
 }

 // The cover (featured) image: an explicit pick wins, else the first upload.
 function currentCover(): string {
 return coverField().value.trim() || images[0] || '';
 }

 function renderStrip() {
 const strip = document.getElementById('image-strip')!;
 const cover = currentCover();
 strip.innerHTML = images.map((url, i) => {
 const isCover = url === cover;
 return `
 <div draggable="true" data-idx="${i}" class="relative group rounded-md overflow-hidden border ${isCover ? 'border-primary ring-2 ring-primary' : 'border-gray-200'} aspect-square bg-gray-50 cursor-pointer select-none" data-cover="${url}" title="${isCover ? 'Cover image · drag to reorder' : 'Click to set as cover · drag to reorder'}">
 <img src="${url}" alt="" draggable="false" class="w-full h-full object-cover pointer-events-none" />
 ${isCover
 ? '<span class="absolute top-1 left-1 bg-primary text-link text-[10px] font-semibold px-1.5 py-0.5 rounded-md uppercase tracking-wide">Cover</span>'
 : '<span class="absolute inset-0 flex items-center justify-center bg-black/0 group-hover:bg-black/30 transition-colors"><span class="opacity-0 group-hover:opacity-100 text-white text-[10px] font-semibold uppercase tracking-wide bg-black/60 px-2 py-1 rounded-md transition-opacity">Set as cover</span></span>'}
 <span class="absolute bottom-1 left-1 z-10 opacity-0 group-hover:opacity-100 bg-black/50 text-white rounded p-0.5 transition-opacity pointer-events-none" title="Drag to reorder"><span class="material-symbols-outlined text-sm leading-none">drag_indicator</span></span>
 <button type="button" data-remove="${i}" class="absolute top-1 right-1 z-10 w-6 h-6 rounded-full bg-white/90 hover:bg-white text-gray-700 hover:text-red-600 flex items-center justify-center shadow-sm transition-colors" title="Remove">
 <span class="material-symbols-outlined text-sm">close</span>
 </button>
 </div>
 `;
 }).join('');
 // Placeholder tiles for uploads still in flight.
 for (let p = 0; p < pending; p++) {
 strip.insertAdjacentHTML('beforeend', '<div class="upload-skeleton aspect-square rounded-md border border-gray-200" aria-hidden="true"></div>');
 }
 // Click a thumbnail → make it the cover.
 strip.querySelectorAll('[data-cover]').forEach((el) => {
 el.addEventListener('click', () => {
 coverField().value = (el as HTMLElement).dataset.cover || '';
 renderStrip();
 });
 });
 // Remove button (stop the click from also setting the cover).
 strip.querySelectorAll('button[data-remove]').forEach((btn) => {
 btn.addEventListener('click', (e) => {
 e.stopPropagation();
 const idx = parseInt((btn as HTMLElement).dataset.remove || '0', 10);
 const removed = images[idx];
 images.splice(idx, 1);
 // If the removed image was the explicit cover, clear it so it falls back.
 if (coverField().value.trim() === removed) coverField().value = '';
 renderStrip();
 });
 });
 // Drag a thumbnail onto another to reorder the gallery.
 let dragFrom: number | null = null;
 strip.querySelectorAll('[data-idx]').forEach((tile) => {
 const el = tile as HTMLElement;
 el.addEventListener('dragstart', (e) => {
 dragFrom = parseInt(el.dataset.idx || '0', 10);
 const dt = (e as DragEvent).dataTransfer;
 if (dt) dt.effectAllowed = 'move';
 el.classList.add('opacity-40');
 });
 el.addEventListener('dragend', () => {
 dragFrom = null;
 el.classList.remove('opacity-40');
 });
 el.addEventListener('dragover', (e) => {
 e.preventDefault();
 const dt = (e as DragEvent).dataTransfer;
 if (dt) dt.dropEffect = 'move';
 el.classList.add('outline', 'outline-2', 'outline-primary');
 });
 el.addEventListener('dragleave', () => {
 el.classList.remove('outline', 'outline-2', 'outline-primary');
 });
 el.addEventListener('drop', (e) => {
 e.preventDefault();
 e.stopPropagation();
 el.classList.remove('outline', 'outline-2', 'outline-primary');
 const to = parseInt(el.dataset.idx || '0', 10);
 if (dragFrom === null || dragFrom === to) return;
 const [moved] = images.splice(dragFrom, 1);
 images.splice(to, 0, moved);
 renderStrip();
 });
 });
 }

 async function uploadFiles(files: FileList) {
 const status = document.getElementById('image-status')!;
 status.classList.remove('hidden');
 const list = Array.from(files);
 const total = list.length;
 pending = total;
 renderStrip();
 let done = 0;
 for (const file of list) {
 done++;
 status.textContent = `Uploading ${done} of ${total}…`;
 try {
 const webp = await imageToWebp(file);
 const fd = new FormData();
 fd.append('file', webp);
 fd.append('folder', 'prompts');
 const res = await fetch('/api/admin/cms/media', { method: 'POST', body: fd });
 if (!res.ok) {
 const err = await res.json().catch(() => ({}));
 throw new Error(err.error || res.statusText);
 }
 const data = await res.json();
 if (data.url) images.push(data.url);
 } catch (err: any) {
 // Keep earlier uploads; report this one and continue.
 toast(`${file.name}: ${err.message || 'upload failed'}`, 'error');
 }
 pending = total - done;
 renderStrip();
 }
 pending = 0;
 status.classList.add('hidden');
 renderStrip();
 (document.getElementById('image-input') as HTMLInputElement).value = '';
 }

 (document.getElementById('image-input') as HTMLInputElement).addEventListener('change', (e) => {
 const target = e.target as HTMLInputElement;
 if (target.files && target.files.length > 0) uploadFiles(target.files);
 });

 // Drag & drop onto the dropzone.
 const dropzone = document.getElementById('dropzone')!;
 ['dragenter', 'dragover'].forEach((ev) => {
 dropzone.addEventListener(ev, (e) => {
 e.preventDefault();
 dropzone.classList.add('border-primary', 'bg-gray-50');
 });
 });
 ['dragleave', 'drop'].forEach((ev) => {
 dropzone.addEventListener(ev, (e) => {
 e.preventDefault();
 dropzone.classList.remove('border-primary', 'bg-gray-50');
 });
 });
 dropzone.addEventListener('drop', (e) => {
 const dt = (e as DragEvent).dataTransfer;
 if (dt && dt.files && dt.files.length > 0) uploadFiles(dt.files);
 });

 // Keep the thumbnail highlight in sync when the cover URL is typed/pasted.
 coverField().addEventListener('input', renderStrip);

 const draftBtn = document.getElementById('draft-btn') as HTMLButtonElement;
 const scheduleBtn = document.getElementById('schedule-btn') as HTMLButtonElement;
 const publishBtn = document.getElementById('publish-btn') as HTMLButtonElement;
 const actionBtns = [draftBtn, scheduleBtn, publishBtn];

 // The local datetime-local value → UTC ISO, or null if empty/invalid.
 function scheduleIso(): string | null {
 const v = (document.getElementById('f-publish-at') as HTMLInputElement).value;
 if (!v) return null;
 const d = new Date(v); // parsed in the admin's local timezone
 return isNaN(d.getTime()) ? null : d.toISOString();
 }

 // mode: 'draft' (hidden) | 'publish' (live now) | 'schedule' (live later)
 async function save(mode: 'draft' | 'publish' | 'schedule', activeBtn: HTMLButtonElement) {
 const status = mode === 'draft' ? 'draft' : 'approved';
 let publishAt: string | null = null;
 if (mode === 'schedule') {
 publishAt = scheduleIso();
 if (!publishAt || new Date(publishAt) <= new Date()) {
 toast('Pick a future date & time to schedule.', 'error');
 return;
 }
 }

 const tags = val('f-tags').split(',').map((t) => t.trim()).filter(Boolean);
 const body = {
 title: val('f-title'),
 slug: val('f-slug') || undefined,
 description: val('f-description'),
 promptText: val('f-prompt-text'),
 category: val('f-category'),
 tags,
 createdBy: val('f-author'),
 coverImage: val('f-cover') || null,
 images,
 featured: bool('f-featured'),
 popularity: parseInt(val('f-popularity') || '0', 10),
 howToUse: val('f-how-to-use') || null,
 status,
 publishAt,
 };

 if (!body.title || !body.promptText || !body.category) {
 toast('Title, prompt text and category are required.', 'error');
 return;
 }

 actionBtns.forEach((b) => { if (b !== activeBtn) b.disabled = true; });
 const loadingLabel = mode === 'draft' ? 'Saving…' : mode === 'schedule' ? 'Scheduling…' : 'Publishing…';
 try {
 await withButtonLoading(activeBtn, async () => {
 const res = await fetch('/api/admin/cms/prompts', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify(body),
 });
 if (!res.ok) {
 const err = await res.json().catch(() => ({}));
 throw new Error(err.error || res.statusText);
 }
 const data = await res.json().catch(() => ({}));
 toast(mode === 'draft' ? 'Draft saved' : mode === 'schedule' ? 'Prompt scheduled' : 'Prompt published', 'success');
 // Drafts return to the editor so the admin can keep refining; published /
 // scheduled prompts go back to the list.
 const dest = mode === 'draft' && data.slug
 ? `/admin/cms/prompts/edit/${encodeURIComponent(data.slug)}`
 : '/admin/cms/prompts';
 setTimeout(() => { window.location.href = dest; }, 450);
 }, { loadingLabel });
 } catch (err: any) {
 toast(`Save failed: ${err.message || 'try again'}`, 'error');
 actionBtns.forEach((b) => { if (b !== activeBtn) b.disabled = false; });
 }
 }

 // --- Publish / schedule dialog (the single date picker) ---
 const dialog = document.getElementById('schedule-dialog') as HTMLDialogElement;
 const dlgTitle = document.getElementById('schedule-dialog-title')!;
 const dlgHint = document.getElementById('schedule-dialog-hint')!;
 const confirmBtn = document.getElementById('schedule-confirm') as HTMLButtonElement;
 const cancelBtn = document.getElementById('schedule-cancel') as HTMLButtonElement;
 const publishAtInput = document.getElementById('f-publish-at') as HTMLInputElement;
 const presetsEl = document.getElementById('schedule-presets')!;
 const summaryEl = document.getElementById('schedule-summary')!;
 const summaryTextEl = summaryEl.querySelector('[data-summary-text]') as HTMLElement;

 function localInputValue(d: Date): string {
 const p = (n: number) => String(n).padStart(2, '0');
 return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`;
 }
 function friendly(d: Date): string {
 return d.toLocaleString(undefined, { weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
 }
 // Once a time is chosen, collapse the presets into a one-line confirmation.
 function showPresets() {
 presetsEl.classList.remove('hidden');
 summaryEl.classList.remove('flex'); summaryEl.classList.add('hidden');
 }
 function showSummary() {
 const iso = scheduleIso();
 if (!iso) return;
 const d = new Date(iso);
 summaryTextEl.textContent = d > new Date() ? `Goes live ${friendly(d)}` : 'Publishes immediately';
 presetsEl.classList.add('hidden');
 summaryEl.classList.remove('hidden'); summaryEl.classList.add('flex');
 }
 function requiredOk(): boolean {
 if (!val('f-title') || !val('f-prompt-text') || !val('f-category')) {
 toast('Title, prompt text and category are required.', 'error');
 return false;
 }
 return true;
 }
 function openDialog(mode: 'publish' | 'schedule') {
 if (!requiredOk()) return;
 const now = new Date();
 if (mode === 'publish') {
 publishAtInput.value = localInputValue(now);
 dlgTitle.textContent = 'Publish';
 dlgHint.textContent = 'Publishes immediately. Or pick a future time to schedule it instead.';
 confirmBtn.textContent = 'Publish now';
 } else {
 publishAtInput.value = localInputValue(new Date(now.getTime() + 60 * 60 * 1000));
 dlgTitle.textContent = 'Schedule';
 dlgHint.textContent = 'Pick a future date & time. It stays hidden until then. Your local timezone.';
 confirmBtn.textContent = 'Schedule';
 }
 showPresets(); // each open starts with the quick options visible
 dialog.showModal();
 }

 // Quick presets → fill the datetime input with a friendly future time.
 function presetDate(kind: string): Date {
 const d = new Date();
 if (kind === '1h') { d.setHours(d.getHours() + 1); return d; }
 if (kind === 'tom9') { d.setDate(d.getDate() + 1); d.setHours(9, 0, 0, 0); return d; }
 d.setDate(d.getDate() + 7); d.setHours(9, 0, 0, 0); return d; // 'week'
 }
 presetsEl.addEventListener('click', (e) => {
 const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-preset]');
 if (!btn) return;
 publishAtInput.value = localInputValue(presetDate(btn.dataset.preset || 'week'));
 showSummary(); // collapse presets after a pick
 });
 // Manually editing the field also counts as a pick.
 publishAtInput.addEventListener('change', () => showSummary());
 document.getElementById('schedule-change')!.addEventListener('click', () => { showPresets(); publishAtInput.focus(); });

 draftBtn.addEventListener('click', () => save('draft', draftBtn));
 publishBtn.addEventListener('click', () => openDialog('publish'));
 scheduleBtn.addEventListener('click', () => openDialog('schedule'));
 cancelBtn.addEventListener('click', () => dialog.close());
 // Click outside the card (on the backdrop) closes the dialog.
 dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
 confirmBtn.addEventListener('click', () => {
 const iso = scheduleIso();
 if (!iso) { toast('Pick a date & time.', 'error'); return; }
 // Future → schedule (hidden until then); now/past → publish live.
 const mode = new Date(iso) > new Date() ? 'schedule' : 'publish';
 save(mode, confirmBtn);
 });

 // Auto-slug from title (only when slug field is empty)
 const titleInput = document.getElementById('f-title') as HTMLInputElement;
 const slugInput = document.getElementById('f-slug') as HTMLInputElement;
 let slugTouched = false;
 slugInput.addEventListener('input', () => { slugTouched = true; });
 titleInput.addEventListener('input', () => {
 if (slugTouched) return;
 slugInput.value = titleInput.value
 .toLowerCase()
 .replace(/[^a-z0-9\s-]/g, '')
 .replace(/\s+/g, '-')
 .replace(/-+/g, '-')
 .replace(/^-|-$/g, '');
 });

 loadCategories();
 loadAuthors();
</script>
