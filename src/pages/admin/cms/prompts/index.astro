---
export const prerender = false;

import Layout from '../../../../layouts/Layout.astro';
import AdminSidebar from '../../../../components/AdminSidebar.astro';
import { getDB } from '../../../../lib/db';

// SSR the first page of data + categories so the list paints instantly with no
// client fetch waterfall. The client renderer consumes this island and only
// re-fetches on filter / search / pagination.
const LIMIT = 20;
let initial = { prompts: [] as any[], total: 0, counts: { all: 0, published: 0, scheduled: 0, draft: 0 }, page: 1, totalPages: 1, categories: [] as any[] };
try {
	const db = getDB(Astro.locals);
	const [listRes, countRes, catRes] = await db.batch<any>([
		db.prepare(
			`SELECT p.slug, p.title, p.description, p.status, p.featured, p.date, p.publish_at, p.author, p.category,
			        c.name AS category_name, c.emoji AS category_emoji,
			        u.name AS creator_name, u.avatar_url AS creator_avatar
			 FROM prompts p
			 LEFT JOIN prompt_categories c ON p.category = c.slug
			 LEFT JOIN users u ON p.created_by = u.id
			 ORDER BY p.date DESC, p.created_at DESC LIMIT ${LIMIT}`,
		),
		db.prepare(
			`SELECT
			   COUNT(*) AS all_n,
			   SUM(CASE WHEN status = 'approved' AND (publish_at IS NULL OR publish_at <= datetime('now')) THEN 1 ELSE 0 END) AS published_n,
			   SUM(CASE WHEN status = 'approved' AND publish_at IS NOT NULL AND publish_at > datetime('now') THEN 1 ELSE 0 END) AS scheduled_n,
			   SUM(CASE WHEN status = 'draft' THEN 1 ELSE 0 END) AS draft_n
			 FROM prompts`,
		),
		db.prepare('SELECT slug, name, emoji FROM prompt_categories ORDER BY sort_order'),
	]);
	const c = countRes.results?.[0] ?? {};
	const total = (c.all_n as number) ?? 0;
	initial = {
		prompts: (listRes.results || []).map((r: any) => ({
			slug: r.slug, title: r.title, description: r.description, status: r.status,
			publishAt: r.publish_at ?? null, featured: !!r.featured, date: r.date,
			category: r.category, categoryName: r.category_name, categoryEmoji: r.category_emoji,
			createdByName: r.creator_name, createdByAvatar: r.creator_avatar, author: r.author,
		})),
		total,
		counts: {
			all: (c.all_n as number) ?? 0,
			published: (c.published_n as number) ?? 0,
			scheduled: (c.scheduled_n as number) ?? 0,
			draft: (c.draft_n as number) ?? 0,
		},
		page: 1, totalPages: Math.max(1, Math.ceil(total / LIMIT)),
		categories: catRes.results || [],
	};
} catch {
	// Fall through with empty initial — the client will fetch as a fallback.
}
const initialJson = JSON.stringify(initial).replace(/</g, '\\u003c');
---

<Layout title="Prompts - CMS - Free Prompt Base" noindex={true}>
 <div class="flex flex-col md:flex-row min-h-screen md:h-screen md:overflow-hidden">
 <AdminSidebar activePage="cms" />

 <main class="flex-1 min-w-0 p-3 sm:p-5 space-y-4 bg-gray-50 md:overflow-y-auto md:h-screen">
 <!-- Header -->
 <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
 <div>
 <h1 class="text-lg font-semibold text-text-primary">Prompts</h1>
 <p class="text-xs text-gray-500 mt-0.5" id="prompt-subtitle">Manage the prompt library.</p>
 </div>
 <div class="flex items-center gap-2 self-start sm:self-auto">
 <button id="pinterest-export-btn" type="button" title="Download a CSV of live prompts not yet exported, formatted for Pinterest Bulk create Pins. Each export includes only new prompts." class="bg-white border border-gray-200 text-text-primary px-3 py-1.5 rounded-md text-sm font-semibold hover:bg-gray-100 transition-colors flex items-center gap-1.5">
 <span class="material-symbols-outlined text-base">download</span>
 <span id="pinterest-export-label">Export Pinterest CSV</span>
 </button>
 <a href="/admin/cms/prompts/new" class="bg-primary text-link px-3 py-1.5 rounded-md text-sm font-semibold hover:opacity-90 transition-opacity flex items-center gap-1.5">
 <span class="material-symbols-outlined text-base">add</span>
 New prompt
 </a>
 </div>
 </div>

 <!-- Status tabs -->
 <div class="flex flex-wrap gap-1" id="status-filters">
 <button class="px-3 py-1.5 rounded-full border border-gray-200 text-xs font-semibold uppercase bg-text-primary text-surface transition-all" data-status="all">All <span data-count class="ml-0.5 opacity-60 tabular-nums"></span></button>
 <button class="px-3 py-1.5 rounded-full border border-gray-200 text-xs font-semibold uppercase bg-white hover:bg-gray-100 transition-all" data-status="approved">Live <span data-count class="ml-0.5 opacity-60 tabular-nums"></span></button>
 <button class="px-3 py-1.5 rounded-full border border-gray-200 text-xs font-semibold uppercase bg-white hover:bg-gray-100 transition-all" data-status="scheduled">Scheduled <span data-count class="ml-0.5 opacity-60 tabular-nums"></span></button>
 <button class="px-3 py-1.5 rounded-full border border-gray-200 text-xs font-semibold uppercase bg-white hover:bg-gray-100 transition-all" data-status="draft">Drafts <span data-count class="ml-0.5 opacity-60 tabular-nums"></span></button>
 </div>

 <!-- Filters -->
 <div class="flex flex-col md:flex-row gap-2">
 <select id="category-filter" class="px-3 py-1.5 border border-gray-200 rounded-md bg-white text-sm">
 <option value="">All categories</option>
 </select>
 <label class="inline-flex items-center gap-2 px-3 py-1.5 border border-gray-200 rounded-md bg-white text-sm text-text-primary cursor-pointer">
 <input id="featured-filter" type="checkbox" class="accent-primary" />
 Featured only
 </label>
 <div class="flex items-center gap-2 px-3 py-1.5 bg-white border border-gray-200 rounded-md flex-1">
 <span class="material-symbols-outlined text-gray-400 text-base">search</span>
 <input id="search-input" type="text" placeholder="Search prompts..." class="bg-transparent border-none focus:outline-none w-full text-sm" />
 </div>
 </div>

 <!-- Table -->
 <div class="bg-white border border-gray-200 rounded-md overflow-hidden">
 <div id="prompts-list">
 <div class="py-10 px-6 text-center text-gray-500">
 <span class="material-symbols-outlined text-3xl">hourglass_empty</span>
 <p class="text-xs uppercase tracking-wide mt-2">Loading...</p>
 </div>
 </div>
 </div>

 <!-- Pagination -->
 <div id="pagination" class="flex items-center justify-between text-sm text-gray-500"></div>
 </main>
 </div>

 <!-- Server-rendered first page + categories (consumed for instant first paint). -->
 <script type="application/json" id="cms-initial" set:html={initialJson}></script>
</Layout>

<script>
 let currentPage = 1;
 let currentFilters: Record<string, string> = {};

 function esc(s: string): string {
 const d = document.createElement('div');
 d.textContent = s;
 return d.innerHTML;
 }

 // publish_at is stored UTC but zone-less; render it in the admin's local time.
 function fmtSchedule(publishAt: string | null): string {
 if (!publishAt) return '';
 const d = new Date(String(publishAt).replace(' ', 'T') + 'Z');
 if (isNaN(d.getTime())) return '';
 return d.toLocaleString(undefined, { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
 }

 // Fill the count badge on each status tab. Keys map tab data-status → counts.
 function renderCounts(counts: any) {
 if (!counts) return;
 const map: Record<string, number> = {
 all: counts.all ?? 0, approved: counts.published ?? 0,
 scheduled: counts.scheduled ?? 0, draft: counts.draft ?? 0,
 };
 document.querySelectorAll('#status-filters button').forEach((b) => {
 const key = (b as HTMLElement).dataset.status || '';
 const span = b.querySelector('[data-count]');
 if (span && map[key] != null) span.textContent = String(map[key]);
 });
 }

 function renderCategories(categories: any[]) {
 const sel = document.getElementById('category-filter') as HTMLSelectElement;
 for (const c of categories || []) {
 const opt = document.createElement('option');
 opt.value = c.slug;
 opt.textContent = `${c.emoji} ${c.name}`;
 sel.appendChild(opt);
 }
 }
 async function loadCategories() {
 const res = await fetch('/api/admin/cms/prompt-categories');
 const data = await res.json();
 renderCategories(data.categories || []);
 }

 async function loadPrompts(page = 1, preloaded?: any) {
 currentPage = page;
 let data = preloaded;
 if (!data) {
 const params = new URLSearchParams({ page: String(page), limit: '20', ...currentFilters });
 const res = await fetch(`/api/admin/cms/prompts?${params}`);
 data = await res.json();
 }
 const list = document.getElementById('prompts-list')!;

 renderCounts(data.counts);
 const c = data.counts;
 (document.getElementById('prompt-subtitle')!).textContent = c
 ? `${c.all} total — ${c.published} live, ${c.scheduled} scheduled, ${c.draft} ${c.draft === 1 ? 'draft' : 'drafts'}.`
 : `${data.total} ${data.total === 1 ? 'prompt' : 'prompts'} in the library.`;

 if (!data.prompts?.length) {
 list.innerHTML = `
 <div class="py-10 px-6 text-center text-gray-500">
 <span class="material-symbols-outlined text-3xl text-gray-300">inbox</span>
 <p class="text-sm mt-2">No prompts match the current filter.</p>
 <a href="/admin/cms/prompts/new" class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary hover:underline mt-3">
 <span class="material-symbols-outlined text-base">add</span>
 Create the first one
 </a>
 </div>`;
 document.getElementById('pagination')!.innerHTML = '';
 return;
 }

 // Approved but not yet live → "scheduled" (a derived state, not a real status).
 const isScheduledRow = (p: any) => {
 if (p.status !== 'approved' || !p.publishAt) return false;
 const t = new Date(String(p.publishAt).replace(' ', 'T') + 'Z').getTime();
 return !isNaN(t) && t > Date.now();
 };

 const statusBadge = (p: any) => {
 const map: Record<string, string> = {
 draft: 'bg-amber-50 text-amber-900 border-tertiary',
 approved: 'bg-blue-50 text-blue-900 border-secondary',
 scheduled: 'bg-indigo-50 text-indigo-900 border-indigo-300',
 pending: 'bg-purple-50 text-purple-900 border-purple-300',
 rejected: 'bg-red-50 text-red-900 border-red-300',
 };
 const label: Record<string, string> = { draft: 'Draft', approved: 'Published', scheduled: 'Scheduled', pending: 'Pending', rejected: 'Rejected' };
 const s = isScheduledRow(p) ? 'scheduled' : p.status;
 const cls = map[s] || map.approved;
 return `<span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase border ${cls} shrink-0">${label[s] || s}</span>`;
 };

 // Publish/Unpublish quick action, depending on status. Pending/rejected
 // submissions are managed in the review queue, so they get no toggle here.
 const toggleBtn = (p: any, variant: 'card' | 'icon') => {
 // Drafts and scheduled prompts both get a "Publish (now)" quick action that
 // clears any schedule and goes live immediately.
 if (p.status === 'draft' || isScheduledRow(p)) {
 const title = isScheduledRow(p) ? 'Publish now' : 'Publish';
 return variant === 'card'
 ? `<button onclick="promptAction('${esc(p.slug)}', 'publish')" class="px-3 py-2 rounded-md text-xs font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 transition-colors">${title}</button>`
 : `<button onclick="promptAction('${esc(p.slug)}', 'publish')" class="inline-flex items-center justify-center w-7 h-7 rounded-md hover:bg-blue-50 text-gray-500 hover:text-blue-700 transition-colors" title="${title}"><span class="material-symbols-outlined text-base">publish</span></button>`;
 }
 if (p.status === 'approved') {
 return variant === 'card'
 ? `<button onclick="promptAction('${esc(p.slug)}', 'unpublish')" class="px-3 py-2 rounded-md text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 transition-colors">Unpublish</button>`
 : `<button onclick="promptAction('${esc(p.slug)}', 'unpublish')" class="inline-flex items-center justify-center w-7 h-7 rounded-md hover:bg-gray-100 text-gray-500 hover:text-text-primary transition-colors" title="Unpublish"><span class="material-symbols-outlined text-base">unpublished</span></button>`;
 }
 return '';
 };

 // --- Mobile card list (md:hidden) ---
 const cards = `
 <ul class="md:hidden divide-y divide-gray-200">
 ${data.prompts.map((p: any) => `
 <li class="p-4">
 <div class="flex items-start justify-between gap-3">
 <div class="min-w-0 flex-1">
 <div class="flex items-center gap-2 flex-wrap">
 ${p.featured ? '<span class="material-symbols-outlined text-primary text-base shrink-0" title="Featured">star</span>' : ''}
 <a href="/admin/cms/prompts/edit/${esc(p.slug)}" class="font-semibold text-text-primary leading-snug">${esc(p.title)}</a>
 ${statusBadge(p)}
 </div>
 ${p.description ? `<p class="text-xs text-gray-500 mt-1 line-clamp-2">${esc(p.description)}</p>` : ''}
 <div class="flex flex-wrap items-center gap-x-2 gap-y-1 mt-2 text-xs text-gray-500">
 <span>${p.categoryEmoji ?? ''} ${esc(p.categoryName ?? p.category)}</span>
 <span aria-hidden="true">·</span>
 <span>${esc(p.date)}</span>
 ${isScheduledRow(p) ? `<span aria-hidden="true">·</span><span class="text-indigo-700 font-semibold inline-flex items-center gap-0.5"><span class="material-symbols-outlined text-sm">schedule</span>Goes live ${esc(fmtSchedule(p.publishAt))}</span>` : ''}
 </div>
 ${p.createdByName ? `
 <div class="flex items-center gap-1.5 mt-2 text-xs text-gray-500">
 ${p.createdByAvatar ? `<img src="${esc(p.createdByAvatar)}" alt="" class="w-4 h-4 rounded-full object-cover" />` : ''}
 <span>Added by ${esc(p.createdByName)}</span>
 </div>` : ''}
 </div>
 </div>
 <div class="flex items-center gap-1 mt-3 -mr-1">
 <a href="/${esc(p.slug)}" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-md text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 transition-colors">
 <span class="material-symbols-outlined text-base">open_in_new</span>
 View
 </a>
 <a href="/admin/cms/prompts/edit/${esc(p.slug)}" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-md text-xs font-semibold text-text-primary bg-gray-100 hover:bg-gray-200 transition-colors">
 <span class="material-symbols-outlined text-base">edit</span>
 Edit
 </a>
 ${toggleBtn(p, 'card')}
 <button onclick="deletePrompt('${esc(p.slug)}', '${esc(p.title.replace(/'/g, "\\'"))}')" class="ml-auto inline-flex items-center gap-1.5 px-3 py-2 rounded-md text-xs font-semibold text-red-700 bg-red-50 hover:bg-red-100 transition-colors">
 <span class="material-symbols-outlined text-base">delete</span>
 Delete
 </button>
 </div>
 </li>
 `).join('')}
 </ul>`;

 // --- Desktop table (hidden md:block) ---
 const table = `
 <table class="hidden md:table w-full text-sm table-fixed">
 <colgroup>
 <col />
 <col class="hidden md:table-column" style="width: 160px;" />
 <col class="hidden lg:table-column" style="width: 170px;" />
 <col class="hidden xl:table-column" style="width: 110px;" />
 <col style="width: 168px;" />
 </colgroup>
 <thead class="bg-gray-50 text-[11px] font-semibold uppercase tracking-wide text-gray-500">
 <tr>
 <th class="text-left px-3 py-2">Title</th>
 <th class="text-left px-3 py-2 hidden md:table-cell">Category</th>
 <th class="text-left px-3 py-2 hidden lg:table-cell">Added by</th>
 <th class="text-left px-3 py-2 hidden xl:table-cell">Date</th>
 <th class="text-right px-3 py-2">Actions</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-gray-200">
 ${data.prompts.map((p: any) => `
 <tr class="hover:bg-gray-50 transition-colors">
 <td class="px-3 py-2.5 align-top">
 <div class="flex items-center gap-2 min-w-0">
 ${p.featured ? '<span class="material-symbols-outlined text-primary text-base shrink-0" title="Featured">star</span>' : ''}
 <a href="/admin/cms/prompts/edit/${esc(p.slug)}" class="font-medium text-text-primary hover:text-primary truncate">${esc(p.title)}</a>
 ${statusBadge(p)}
 </div>
 <p class="text-xs text-gray-500 mt-0.5 truncate">${esc(p.description || '')}</p>
 ${isScheduledRow(p) ? `<p class="text-[11px] text-indigo-700 font-semibold mt-1 inline-flex items-center gap-0.5"><span class="material-symbols-outlined text-sm">schedule</span>Goes live ${esc(fmtSchedule(p.publishAt))}</p>` : ''}
 </td>
 <td class="px-3 py-2.5 hidden md:table-cell text-gray-600 align-middle truncate">${p.categoryEmoji ?? ''} ${esc(p.categoryName ?? p.category)}</td>
 <td class="px-3 py-2.5 hidden lg:table-cell align-middle">
 ${p.createdByName
 ? `<div class="flex items-center gap-2 min-w-0">
 ${p.createdByAvatar ? `<img src="${esc(p.createdByAvatar)}" alt="" class="w-6 h-6 rounded-full object-cover shrink-0" />` : `<div class="w-6 h-6 rounded-full bg-gray-100 flex items-center justify-center text-[10px] font-semibold text-gray-500 shrink-0">${esc(p.createdByName[0].toUpperCase())}</div>`}
 <span class="text-gray-600 text-xs truncate">${esc(p.createdByName)}</span>
 </div>`
 : `<span class="text-gray-400 text-xs">${esc(p.author || '—')}</span>`}
 </td>
 <td class="px-3 py-2.5 hidden xl:table-cell text-gray-500 text-xs align-middle whitespace-nowrap">${esc(p.date)}</td>
 <td class="px-3 py-2.5 text-right whitespace-nowrap">
 <a href="/${esc(p.slug)}" target="_blank" rel="noopener" class="inline-flex items-center justify-center w-7 h-7 rounded-md hover:bg-gray-100 text-gray-500 hover:text-text-primary transition-colors" title="View live">
 <span class="material-symbols-outlined text-base">open_in_new</span>
 </a>
 <a href="/admin/cms/prompts/edit/${esc(p.slug)}" class="inline-flex items-center justify-center w-7 h-7 rounded-md hover:bg-gray-100 text-gray-500 hover:text-text-primary transition-colors" title="Edit">
 <span class="material-symbols-outlined text-base">edit</span>
 </a>
 ${toggleBtn(p, 'icon')}
 <button onclick="deletePrompt('${esc(p.slug)}', '${esc(p.title.replace(/'/g, "\\'"))}')" class="inline-flex items-center justify-center w-7 h-7 rounded-md hover:bg-red-50 text-gray-500 hover:text-red-600 transition-colors" title="Delete">
 <span class="material-symbols-outlined text-base">delete</span>
 </button>
 </td>
 </tr>
 `).join('')}
 </tbody>
 </table>`;

 list.innerHTML = cards + table;

 // Pagination
 const pg = document.getElementById('pagination')!;
 if (data.totalPages > 1) {
 pg.innerHTML = `
 <span>Page ${data.page} of ${data.totalPages}</span>
 <div class="flex gap-2">
 <button onclick="loadPrompts(${Math.max(1, page - 1)})" ${page === 1 ? 'disabled' : ''} class="px-3 py-1.5 border border-gray-200 rounded-md text-xs font-semibold bg-white hover:bg-gray-50 transition-colors disabled:opacity-40">Previous</button>
 <button onclick="loadPrompts(${Math.min(data.totalPages, page + 1)})" ${page === data.totalPages ? 'disabled' : ''} class="px-3 py-1.5 border border-gray-200 rounded-md text-xs font-semibold bg-white hover:bg-gray-50 transition-colors disabled:opacity-40">Next</button>
 </div>
 `;
 } else {
 pg.innerHTML = '';
 }
 }

 (window as any).loadPrompts = loadPrompts;
 (window as any).promptAction = async (slug: string, action: 'publish' | 'unpublish') => {
 const res = await fetch(`/api/admin/cms/prompts/${encodeURIComponent(slug)}/${action}`, { method: 'POST' });
 if (res.ok) {
 loadPrompts(currentPage);
 } else {
 const err = await res.json().catch(() => ({}));
 alert(`${action === 'publish' ? 'Publish' : 'Unpublish'} failed: ${err.error || res.statusText}`);
 }
 };
 (window as any).deletePrompt = async (slug: string, title: string) => {
 if (!confirm(`Delete prompt "${title}"? This cannot be undone.`)) return;
 const res = await fetch(`/api/admin/cms/prompts/${encodeURIComponent(slug)}`, { method: 'DELETE' });
 if (res.ok) {
 loadPrompts(currentPage);
 } else {
 const err = await res.json().catch(() => ({}));
 alert(`Delete failed: ${err.error || res.statusText}`);
 }
 };

 let currentStatus = 'all';

 function applyFilters() {
 currentFilters = {};
 const cat = (document.getElementById('category-filter') as HTMLSelectElement).value;
 const featured = (document.getElementById('featured-filter') as HTMLInputElement).checked;
 const search = (document.getElementById('search-input') as HTMLInputElement).value.trim();
 if (cat) currentFilters.category = cat;
 if (currentStatus !== 'all') currentFilters.status = currentStatus;
 if (featured) currentFilters.featured = '1';
 if (search) currentFilters.search = search;
 loadPrompts(1);
 }

 document.getElementById('status-filters')!.addEventListener('click', (e) => {
 const btn = (e.target as HTMLElement).closest('button');
 if (!btn) return;
 currentStatus = btn.dataset.status || 'all';
 document.querySelectorAll('#status-filters button').forEach((b) => {
 b.className = b === btn
 ? 'px-3 py-1.5 rounded-full border border-gray-200 text-xs font-semibold uppercase bg-text-primary text-surface transition-all'
 : 'px-3 py-1.5 rounded-full border border-gray-200 text-xs font-semibold uppercase bg-white hover:bg-gray-100 transition-all';
 });
 applyFilters();
 });

 (document.getElementById('category-filter') as HTMLSelectElement).addEventListener('change', applyFilters);
 (document.getElementById('featured-filter') as HTMLInputElement).addEventListener('change', applyFilters);

 let searchTimer: any;
 (document.getElementById('search-input') as HTMLInputElement).addEventListener('input', () => {
 clearTimeout(searchTimer);
 searchTimer = setTimeout(applyFilters, 250);
 });

 // Pinterest CSV export — delta export of live, not-yet-exported prompts.
 // Downloads the CSV, then offers an undo that resets that batch server-side.
 const pinBtn = document.getElementById('pinterest-export-btn') as HTMLButtonElement | null;
 const pinLabel = document.getElementById('pinterest-export-label');
 if (pinBtn && pinLabel) {
 pinBtn.addEventListener('click', async () => {
 pinBtn.disabled = true;
 const original = pinLabel.textContent;
 pinLabel.textContent = 'Exporting…';
 try {
 const res = await fetch('/api/admin/cms/prompts/pinterest-export', { headers: { Accept: 'text/csv' } });
 if (!res.ok) throw new Error((await res.text()) || res.statusText);
 const count = Number(res.headers.get('X-Export-Count') || '0');
 if (count === 0) {
 alert('No new prompts to export — everything live has already been exported to Pinterest.');
 return;
 }
 const blob = await res.blob();
 const cd = res.headers.get('Content-Disposition') || '';
 const fname = (cd.match(/filename="([^"]+)"/) || [])[1] || 'pinterest-prompts.csv';
 const url = URL.createObjectURL(blob);
 const a = document.createElement('a');
 a.href = url;
 a.download = fname;
 document.body.appendChild(a);
 a.click();
 a.remove();
 URL.revokeObjectURL(url);
 if (confirm(`Exported ${count} prompt${count === 1 ? '' : 's'} and marked them as done.\n\nUpload "${fname}" to Pinterest → Bulk create Pins.\n\nClick Cancel if the download failed and you want to undo (un-mark this batch so it exports again).`)) {
 // OK = keep the batch marked. Nothing to do.
 } else {
 const undo = await fetch('/api/admin/cms/prompts/pinterest-export', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ action: 'reset' }),
 });
 const j = await undo.json().catch(() => ({}));
 alert(`Undone — ${j.reset ?? 0} prompt${j.reset === 1 ? '' : 's'} un-marked. They'll be included in your next export.`);
 }
 } catch (e: any) {
 alert(`Pinterest export failed: ${e?.message || e}`);
 } finally {
 pinLabel.textContent = original;
 pinBtn.disabled = false;
 }
 });
 }

 // Boot — use the server-rendered island for instant first paint; fall back to
 // fetching only if it's missing.
 (async () => {
 let initial: any = null;
 try { initial = JSON.parse(document.getElementById('cms-initial')?.textContent || 'null'); } catch {}
 if (initial && initial.prompts) {
 renderCategories(initial.categories || []);
 loadPrompts(1, initial);
 } else {
 await loadCategories();
 loadPrompts(1);
 }
 })();
</script>
