---
export const prerender = false;

import Layout from '../../../../../layouts/Layout.astro';
import AdminSidebar from '../../../../../components/AdminSidebar.astro';

const slug = Astro.params.slug!;
---

<Layout title="Edit Prompt - CMS - Free Prompt Base" noindex={true}>
 <div class="flex flex-col md:flex-row min-h-screen md:h-screen md:overflow-hidden">
 <AdminSidebar activePage="cms" />

 <main class="flex-1 min-w-0 p-4 sm:p-6 md:p-6 space-y-5 bg-gray-50 md:overflow-y-auto md:h-screen">
 <!-- Breadcrumb -->
 <nav class="flex items-center gap-2 text-xs text-gray-500">
 <a href="/admin/cms/prompts" class="hover:text-text-primary transition-colors">Prompts</a>
 <span class="material-symbols-outlined text-sm">chevron_right</span>
 <span class="text-text-primary font-medium" id="crumb-title">Loading…</span>
 </nav>

 <header class="flex items-center justify-between gap-4">
 <div>
 <div class="flex items-center gap-2.5">
 <h1 class="text-xl sm:text-2xl font-semibold text-text-primary" id="page-title">Edit prompt</h1>
 <span id="status-badge" class="hidden"></span>
 </div>
 <div class="flex items-center gap-3 mt-1">
 <a id="live-link" href="#" target="_blank" rel="noopener" class="text-xs text-primary hover:underline inline-flex items-center gap-1">
 <span class="material-symbols-outlined text-sm">open_in_new</span>
 <span data-slug></span>
 </a>
 <span id="creator-meta" class="text-xs text-gray-500 hidden items-center gap-1.5">
 <span>·</span>
 <span>Added by</span>
 <img id="creator-avatar" alt="" class="w-4 h-4 rounded-full object-cover hidden" />
 <span id="creator-name" class="font-medium text-text-primary"></span>
 </span>
 </div>
 </div>
 <div id="actions" class="flex gap-2">
 <a href="/admin/cms/prompts" class="px-3 py-2 rounded-md text-sm font-semibold text-gray-600 hover:bg-gray-100 transition-colors">Cancel</a>
 </div>
 </header>

 <form id="prompt-form" class="grid grid-cols-1 lg:grid-cols-3 gap-5">
 <div class="lg:col-span-2 space-y-4">
 <div class="bg-white border border-gray-200 rounded-md p-5 space-y-4">
 <div>
 <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5" for="f-title">Title</label>
 <input id="f-title" type="text" required class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
 </div>
 <div>
 <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5" for="f-slug">Slug</label>
 <input id="f-slug" type="text" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-primary" />
 <p class="text-xs text-gray-500 mt-1">Changing the slug changes the public URL.</p>
 </div>
 <div>
 <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5" for="f-description">Description</label>
 <textarea id="f-description" rows="2" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary resize-y"></textarea>
 </div>
 <div>
 <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5" for="f-prompt-text">Prompt text</label>
 <textarea id="f-prompt-text" rows="12" required class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-primary resize-y"></textarea>
 </div>
 <div>
 <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5" for="f-how-to-use">How to use (optional)</label>
 <textarea id="f-how-to-use" rows="3" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary resize-y"></textarea>
 </div>
 </div>

 <!-- Images -->
 <div class="bg-white border border-gray-200 rounded-md p-5 space-y-4">
 <div>
 <p class="text-sm font-semibold text-text-primary">Images</p>
 <p class="text-xs text-gray-500 mt-0.5">Drag &amp; drop or click to upload. They render as a carousel on the prompt page. Click a thumbnail to set it as the cover (featured) image, or drag thumbnails to reorder the gallery.</p>
 </div>
 <label id="dropzone" class="block border-2 border-dashed border-gray-300 rounded-md px-4 py-8 text-center cursor-pointer hover:border-primary hover:bg-gray-50 transition-colors">
 <input id="image-input" type="file" accept="image/*" multiple class="hidden" />
 <span class="material-symbols-outlined text-3xl text-gray-400">cloud_upload</span>
 <p class="text-sm font-medium text-text-primary mt-1">Drop images here, or click to browse</p>
 <p class="text-xs text-gray-500 mt-0.5">PNG, JPG or WebP — multiple allowed</p>
 </label>
 <div id="image-status" class="text-xs text-gray-500 hidden"></div>
 <div id="image-strip" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 empty:hidden"></div>
 </div>

 <!-- Danger zone -->
 <div class="bg-white border border-red-200 rounded-md p-5">
 <h2 class="text-sm font-semibold text-red-700">Danger zone</h2>
 <p class="text-xs text-gray-500 mt-1 mb-3">Deleting a prompt is permanent. The public URL will 404 immediately.</p>
 <button id="delete-btn" type="button" class="btn-feedback inline-flex items-center gap-2 px-3 py-2 rounded-md text-sm font-semibold border border-red-300 text-red-700 hover:bg-red-50">
 <span class="material-symbols-outlined text-base">delete</span>
 Delete prompt
 </button>
 </div>
 </div>

 <aside class="space-y-4">
 <div class="bg-white border border-gray-200 rounded-md p-5 space-y-4">
 <div>
 <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5" for="f-category">Category</label>
 <select id="f-category" required class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-primary"></select>
 </div>
 <div>
 <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5" for="f-tags">Tags</label>
 <input id="f-tags" type="text" placeholder="comma, separated, list" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
 </div>
 <div>
 <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5" for="f-cover">Cover image URL</label>
 <input id="f-cover" type="url" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
 </div>
 </div>

 <div class="bg-white border border-gray-200 rounded-md p-5 space-y-4">
 <div>
 <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5" for="f-author">Author</label>
 <select id="f-author" required class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-primary">
 <option value="">Loading users…</option>
 </select>
 <p class="text-xs text-gray-500 mt-1">Pick the user this prompt is credited to. Their display name becomes the byline.</p>
 </div>
 <div>
 <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5" for="f-date">Date</label>
 <input id="f-date" type="date" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
 </div>
 <div>
 <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5" for="f-publish-at">Schedule publish</label>
 <input id="f-publish-at" type="datetime-local" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
 <p id="schedule-note" class="text-xs text-gray-500 mt-1">Pick a future time, then click <strong>Schedule</strong>. Your local timezone.</p>
 </div>
 <div>
 <label class="block text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5" for="f-popularity">Popularity</label>
 <input id="f-popularity" type="number" min="0" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
 </div>
 <label class="flex items-center gap-2 text-sm text-text-primary cursor-pointer">
 <input id="f-featured" type="checkbox" class="accent-primary w-4 h-4" />
 Featured prompt
 </label>
 </div>
 </aside>
 </form>
 </main>
 </div>
</Layout>

<script define:vars={{ slug }}>
 // Client-side WebP conversion before upload (inlined — this is a define:vars
 // script, which Astro renders inline and does not bundle module imports into).
 async function imageToWebp(file, quality) {
 quality = quality || 0.92;
 const type = (file.type || '').toLowerCase();
 if (type === 'image/webp' || type === 'image/gif' || type === 'image/svg+xml' || type.indexOf('image/') !== 0) return file;
 try {
 let bitmap;
 try { bitmap = await createImageBitmap(file, { imageOrientation: 'from-image' }); }
 catch (e) { bitmap = await createImageBitmap(file); }
 const canvas = document.createElement('canvas');
 canvas.width = bitmap.width; canvas.height = bitmap.height;
 const ctx = canvas.getContext('2d');
 if (!ctx) { bitmap.close && bitmap.close(); return file; }
 ctx.drawImage(bitmap, 0, 0);
 bitmap.close && bitmap.close();
 const blob = await new Promise((res) => canvas.toBlob(res, 'image/webp', quality));
 if (!blob || blob.size === 0 || blob.size >= file.size) return file;
 const name = file.name.replace(/\.[^./\\]+$/, '') + '.webp';
 return new File([blob], name, { type: 'image/webp', lastModified: file.lastModified });
 } catch (e) { return file; }
 }

 // Shared toast (attached by the module script at the end of the file).
 function notify(msg, type) {
 if (window.__toast) window.__toast(msg, type || 'info');
 }

 // Inline spinner markup (this is a define:vars script — no module imports).
 const SPINNER_SVG = '<svg class="spinner w-4 h-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="42" stroke-dashoffset="14"/></svg>';

 function setBtnLoading(btn, loading, label) {
 if (!btn) return;
 if (loading) {
 if (!btn.dataset.original) btn.dataset.original = btn.innerHTML;
 btn.disabled = true;
 btn.setAttribute('aria-busy', 'true');
 btn.innerHTML = SPINNER_SVG + (label ? `<span>${label}</span>` : '');
 } else {
 if (btn.dataset.original) btn.innerHTML = btn.dataset.original;
 delete btn.dataset.original;
 btn.disabled = false;
 btn.removeAttribute('aria-busy');
 }
 }

 // --- Image gallery state ---
 let images = [];
 let pending = 0; // skeleton tiles shown while uploads are in flight
 // Current lifecycle status of this prompt; drives the badge + action buttons.
 let currentStatus = 'approved';
 // Current scheduled publish time (UTC string) or null. Future = "scheduled".
 let currentPublishAt = null;

 function coverField() {
 return document.getElementById('f-cover');
 }

 // --- Schedule helpers ---
 // Is the prompt approved but not yet live?
 function isScheduled() {
 if (currentStatus !== 'approved' || !currentPublishAt) return false;
 const t = new Date(String(currentPublishAt).replace(' ', 'T') + 'Z').getTime();
 return !isNaN(t) && t > Date.now();
 }
 // UTC 'YYYY-MM-DD HH:MM:SS' (or ISO) → local 'YYYY-MM-DDTHH:MM' for the input.
 function toLocalInput(utc) {
 if (!utc) return '';
 const d = new Date(String(utc).replace(' ', 'T') + (String(utc).endsWith('Z') ? '' : 'Z'));
 if (isNaN(d.getTime())) return '';
 const p = (n) => String(n).padStart(2, '0');
 return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`;
 }
 // The schedule field's local value → UTC ISO, or null if empty/invalid.
 function scheduleIso() {
 const val = document.getElementById('f-publish-at').value;
 if (!val) return null;
 const d = new Date(val);
 return isNaN(d.getTime()) ? null : d.toISOString();
 }
 // Reflect the scheduled state in the helper note under the field.
 function renderScheduleNote() {
 const note = document.getElementById('schedule-note');
 if (!note) return;
 if (isScheduled()) {
 const when = new Date(String(currentPublishAt).replace(' ', 'T') + 'Z').toLocaleString();
 note.innerHTML = `Scheduled for <strong>${when}</strong> (your time). Use <strong>Publish now</strong> to go live immediately, or pick a new time and <strong>Reschedule</strong>.`;
 } else {
 note.innerHTML = 'Pick a future time, then click <strong>Schedule</strong>. Your local timezone.';
 }
 }

 // The cover (featured) image: an explicit pick wins, else the first upload.
 function currentCover() {
 return coverField().value.trim() || images[0] || '';
 }

 function renderStrip() {
 const strip = document.getElementById('image-strip');
 const cover = currentCover();
 strip.innerHTML = images.map((url, i) => {
 const isCover = url === cover;
 return `
 <div draggable="true" data-idx="${i}" class="relative group rounded-md overflow-hidden border ${isCover ? 'border-primary ring-2 ring-primary' : 'border-gray-200'} aspect-square bg-gray-50 cursor-pointer select-none" data-cover="${url}" title="${isCover ? 'Cover image · drag to reorder' : 'Click to set as cover · drag to reorder'}">
 <img src="${url}" alt="" draggable="false" class="w-full h-full object-cover pointer-events-none" />
 ${isCover
 ? '<span class="absolute top-1 left-1 bg-primary text-link text-[10px] font-semibold px-1.5 py-0.5 rounded-md uppercase tracking-wide">Cover</span>'
 : '<span class="absolute inset-0 flex items-center justify-center bg-black/0 group-hover:bg-black/30 transition-colors"><span class="opacity-0 group-hover:opacity-100 text-white text-[10px] font-semibold uppercase tracking-wide bg-black/60 px-2 py-1 rounded-md transition-opacity">Set as cover</span></span>'}
 <span class="absolute bottom-1 left-1 z-10 opacity-0 group-hover:opacity-100 bg-black/50 text-white rounded p-0.5 transition-opacity pointer-events-none" title="Drag to reorder"><span class="material-symbols-outlined text-sm leading-none">drag_indicator</span></span>
 <button type="button" data-remove="${i}" class="absolute top-1 right-1 z-10 w-6 h-6 rounded-full bg-white/90 hover:bg-white text-gray-700 hover:text-red-600 flex items-center justify-center shadow-sm transition-colors" title="Remove">
 <span class="material-symbols-outlined text-sm">close</span>
 </button>
 </div>
 `;
 }).join('');
 // Placeholder tiles for uploads still in flight.
 for (let p = 0; p < pending; p++) {
 strip.insertAdjacentHTML('beforeend', '<div class="upload-skeleton aspect-square rounded-md border border-gray-200" aria-hidden="true"></div>');
 }
 // Click a thumbnail → make it the cover.
 strip.querySelectorAll('[data-cover]').forEach((el) => {
 el.addEventListener('click', () => {
 coverField().value = el.dataset.cover || '';
 renderStrip();
 });
 });
 // Remove button (stop the click from also setting the cover).
 strip.querySelectorAll('button[data-remove]').forEach((btn) => {
 btn.addEventListener('click', (e) => {
 e.stopPropagation();
 const idx = parseInt(btn.dataset.remove || '0', 10);
 const removed = images[idx];
 images.splice(idx, 1);
 if (coverField().value.trim() === removed) coverField().value = '';
 renderStrip();
 });
 });
 // Drag a thumbnail onto another to reorder the gallery.
 let dragFrom = null;
 strip.querySelectorAll('[data-idx]').forEach((tile) => {
 tile.addEventListener('dragstart', (e) => {
 dragFrom = parseInt(tile.dataset.idx, 10);
 if (e.dataTransfer) e.dataTransfer.effectAllowed = 'move';
 tile.classList.add('opacity-40');
 });
 tile.addEventListener('dragend', () => {
 dragFrom = null;
 tile.classList.remove('opacity-40');
 });
 tile.addEventListener('dragover', (e) => {
 e.preventDefault();
 if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
 tile.classList.add('outline', 'outline-2', 'outline-primary');
 });
 tile.addEventListener('dragleave', () => {
 tile.classList.remove('outline', 'outline-2', 'outline-primary');
 });
 tile.addEventListener('drop', (e) => {
 e.preventDefault();
 e.stopPropagation();
 tile.classList.remove('outline', 'outline-2', 'outline-primary');
 const to = parseInt(tile.dataset.idx, 10);
 if (dragFrom === null || dragFrom === to) return;
 const [moved] = images.splice(dragFrom, 1);
 images.splice(to, 0, moved);
 renderStrip();
 });
 });
 }

 async function uploadFiles(files) {
 const status = document.getElementById('image-status');
 status.classList.remove('hidden');
 const list = Array.from(files);
 const total = list.length;
 pending = total;
 renderStrip();
 let done = 0;
 for (const file of list) {
 done++;
 status.textContent = `Uploading ${done} of ${total}…`;
 try {
 const webp = await imageToWebp(file);
 const fd = new FormData();
 fd.append('file', webp);
 fd.append('folder', 'prompts');
 const res = await fetch('/api/admin/cms/media', { method: 'POST', body: fd });
 if (!res.ok) {
 const err = await res.json().catch(() => ({}));
 throw new Error(err.error || res.statusText);
 }
 const data = await res.json();
 if (data.url) images.push(data.url);
 } catch (err) {
 // Keep earlier uploads; report this one and continue.
 notify(`${file.name}: ${err.message || 'upload failed'}`, 'error');
 }
 pending = total - done;
 renderStrip();
 }
 pending = 0;
 status.classList.add('hidden');
 renderStrip();
 document.getElementById('image-input').value = '';
 }

 document.getElementById('image-input').addEventListener('change', (e) => {
 if (e.target.files && e.target.files.length > 0) uploadFiles(e.target.files);
 });

 // Drag & drop onto the dropzone.
 const dropzone = document.getElementById('dropzone');
 ['dragenter', 'dragover'].forEach((ev) => {
 dropzone.addEventListener(ev, (e) => {
 e.preventDefault();
 dropzone.classList.add('border-primary', 'bg-gray-50');
 });
 });
 ['dragleave', 'drop'].forEach((ev) => {
 dropzone.addEventListener(ev, (e) => {
 e.preventDefault();
 dropzone.classList.remove('border-primary', 'bg-gray-50');
 });
 });
 dropzone.addEventListener('drop', (e) => {
 if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
 uploadFiles(e.dataTransfer.files);
 }
 });

 // Keep the thumbnail highlight in sync when the cover URL is typed/pasted.
 document.getElementById('f-cover').addEventListener('input', renderStrip);

 async function boot() {
 // Load categories + users + prompt in parallel
 const [catRes, usersRes, promptRes] = await Promise.all([
 fetch('/api/admin/cms/prompt-categories'),
 fetch('/api/admin/cms/users'),
 fetch(`/api/admin/cms/prompts/${encodeURIComponent(slug)}`),
 ]);

 if (!promptRes.ok) {
 document.getElementById('page-title').textContent = 'Prompt not found';
 return;
 }

 const catData = await catRes.json();
 const usersData = usersRes.ok ? await usersRes.json() : { users: [] };
 const promptData = await promptRes.json();
 const p = promptData.prompt;

 // Seed gallery
 images = Array.isArray(p.images) ? p.images.slice() : [];
 renderStrip();

 // Populate category dropdown
 const catSel = document.getElementById('f-category');
 for (const c of catData.categories || []) {
 const opt = document.createElement('option');
 opt.value = c.slug;
 opt.textContent = `${c.emoji} ${c.name}`;
 if (c.slug === p.category) opt.selected = true;
 catSel.appendChild(opt);
 }

 // Populate author dropdown — admins first, then by name.
 const authorSel = document.getElementById('f-author');
 const users = (usersData.users || []).slice();
 users.sort((a, b) => {
 if (a.role !== b.role) return a.role === 'admin' ? -1 : 1;
 return a.name.localeCompare(b.name);
 });
 authorSel.innerHTML = '';
 for (const u of users) {
 const opt = document.createElement('option');
 opt.value = u.id;
 const tag = u.role === 'admin' ? ' (admin)' : '';
 opt.textContent = `${u.name}${tag} — ${u.email}`;
 if (u.id === p.createdBy) opt.selected = true;
 authorSel.appendChild(opt);
 }

 // Fill form
 document.getElementById('crumb-title').textContent = p.title;
 document.getElementById('page-title').textContent = p.title;
 const live = document.getElementById('live-link');
 live.href = `/${p.slug}`;
 live.querySelector('[data-slug]').textContent = `/${p.slug}`;

 // Creator metadata
 const creatorMeta = document.getElementById('creator-meta');
 if (p.createdByName || p.author) {
 creatorMeta.classList.remove('hidden');
 creatorMeta.classList.add('inline-flex');
 const name = p.createdByName || p.author;
 document.getElementById('creator-name').textContent = name;
 const av = document.getElementById('creator-avatar');
 if (p.createdByAvatar) {
 av.src = p.createdByAvatar;
 av.classList.remove('hidden');
 }
 }
 document.getElementById('f-title').value = p.title;
 document.getElementById('f-slug').value = p.slug;
 document.getElementById('f-description').value = p.description || '';
 document.getElementById('f-prompt-text').value = p.promptText || '';
 document.getElementById('f-how-to-use').value = p.howToUse || '';
 document.getElementById('f-tags').value = (p.tags || []).join(', ');
 document.getElementById('f-cover').value = p.coverImage || '';
 // Re-render now that the cover is known, so the right thumbnail is badged.
 renderStrip();
 // f-author is populated above. If the prompt has no createdBy yet (e.g. seed
 // rows), leave the first option selected so the admin makes an explicit pick.
 document.getElementById('f-date').value = p.date || '';
 document.getElementById('f-popularity').value = String(p.popularity ?? 0);
 document.getElementById('f-featured').checked = !!p.featured;

 currentStatus = p.status || 'approved';
 currentPublishAt = p.publishAt || null;
 // Prefill the schedule picker only while the prompt is actually scheduled.
 document.getElementById('f-publish-at').value = isScheduled() ? toLocalInput(currentPublishAt) : '';
 renderScheduleNote();
 renderStatus();
 renderActions();
 }

 const STATUS_BADGES = {
 draft: { label: 'Draft', cls: 'bg-amber-50 text-amber-900 border-tertiary' },
 approved: { label: 'Published', cls: 'bg-blue-50 text-blue-900 border-secondary' },
 pending: { label: 'Pending review', cls: 'bg-purple-50 text-purple-900 border-purple-300' },
 rejected: { label: 'Rejected', cls: 'bg-red-50 text-red-900 border-red-300' },
 };

 function renderStatus() {
 const el = document.getElementById('status-badge');
 const b = isScheduled()
 ? { label: 'Scheduled', cls: 'bg-indigo-50 text-indigo-900 border-indigo-300' }
 : (STATUS_BADGES[currentStatus] || STATUS_BADGES.approved);
 el.className = `px-2.5 py-1 rounded-full text-xs font-bold uppercase border ${b.cls}`;
 el.textContent = b.label;
 }

 function renderActions() {
 const el = document.getElementById('actions');
 const cancel = '<a href="/admin/cms/prompts" class="px-3 py-2 rounded-md text-sm font-semibold text-gray-600 hover:bg-gray-100 transition-colors">Cancel</a>';
 const secondary = (id, icon, label) =>
 `<button id="${id}" type="button" class="btn-feedback bg-white text-text-primary px-4 py-2 rounded-md text-sm font-semibold border border-gray-200 hover:bg-gray-50 flex items-center gap-2"><span class="material-symbols-outlined text-base">${icon}</span>${label}</button>`;
 const primary = (id, icon, label) =>
 `<button id="${id}" type="button" class="btn-feedback bg-primary text-link px-4 py-2 rounded-md text-sm font-semibold hover:opacity-90 flex items-center gap-2"><span class="material-symbols-outlined text-base">${icon}</span>${label}</button>`;

 let buttons = '';
 if (currentStatus === 'draft') {
 buttons = secondary('draft-btn', 'draft', 'Save draft')
 + secondary('schedule-btn', 'schedule', 'Schedule')
 + primary('publish-btn', 'publish', 'Publish');
 } else if (currentStatus === 'approved') {
 const scheduled = isScheduled();
 buttons = secondary('unpublish-btn', 'unpublished', 'Unpublish')
 + (scheduled ? secondary('publishnow-btn', 'publish', 'Publish now') : '')
 + secondary('schedule-btn', 'schedule', scheduled ? 'Reschedule' : 'Schedule')
 + primary('save-btn', 'save', 'Save changes');
 } else {
 // pending / rejected — managed by the review queue; editing keeps state.
 buttons = primary('save-btn', 'save', 'Save changes');
 }
 el.innerHTML = cancel + buttons;

 // status, stay, btnId, loadingLabel, publishArg ('keep' | null | ISO string)
 document.getElementById('draft-btn')?.addEventListener('click', () => save('draft', true, 'draft-btn', 'Saving…', 'keep'));
 document.getElementById('publish-btn')?.addEventListener('click', () => save('approved', false, 'publish-btn', 'Publishing…', null));
 document.getElementById('publishnow-btn')?.addEventListener('click', () => save('approved', false, 'publishnow-btn', 'Publishing…', null));
 document.getElementById('unpublish-btn')?.addEventListener('click', () => save('draft', true, 'unpublish-btn', 'Unpublishing…', 'keep'));
 document.getElementById('save-btn')?.addEventListener('click', () => save(undefined, false, 'save-btn', 'Saving…', 'keep'));
 document.getElementById('schedule-btn')?.addEventListener('click', () => {
 const iso = scheduleIso();
 if (!iso || new Date(iso) <= new Date()) {
 notify('Pick a future date & time to schedule.', 'error');
 return;
 }
 save('approved', false, 'schedule-btn', 'Scheduling…', iso);
 });
 }

 function v(id) { return document.getElementById(id).value; }
 function b(id) { return document.getElementById(id).checked; }

 // status: 'draft' | 'approved' | undefined (undefined = keep current state).
 // stay: true → reload the editor after saving (Save draft / Unpublish);
 //       false → return to the list (Publish / Save changes).
 // publishArg: 'keep' (preserve existing schedule) | null (clear → live now) | ISO string (schedule)
 async function save(status, stay, activeBtnId, loadingLabel, publishArg = 'keep') {
 const actionBtns = document.querySelectorAll('#actions button');
 actionBtns.forEach((btn) => { btn.disabled = true; });
 const activeBtn = activeBtnId ? document.getElementById(activeBtnId) : null;
 setBtnLoading(activeBtn, true, loadingLabel);

 const tags = v('f-tags').split(',').map((t) => t.trim()).filter(Boolean);
 const body = {
 title: v('f-title'),
 slug: v('f-slug'),
 description: v('f-description'),
 promptText: v('f-prompt-text'),
 category: v('f-category'),
 tags,
 createdBy: v('f-author'),
 date: v('f-date'),
 coverImage: v('f-cover') || null,
 images,
 featured: b('f-featured'),
 popularity: parseInt(v('f-popularity') || '0', 10),
 howToUse: v('f-how-to-use') || null,
 };
 if (status) body.status = status;
 // Only send publishAt when explicitly changing it; 'keep' preserves server-side.
 if (publishArg !== 'keep') body.publishAt = publishArg;
 const scheduling = typeof publishArg === 'string';

 const res = await fetch(`/api/admin/cms/prompts/${encodeURIComponent(slug)}`, {
 method: 'PUT',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify(body),
 });

 if (res.ok) {
 const data = await res.json();
 notify(scheduling ? 'Prompt scheduled' : status === 'approved' ? 'Prompt published' : 'Changes saved', 'success');
 // If slug changed, the edit URL moved — go there regardless.
 const go = () => {
 if (data.slug && data.slug !== slug) {
 window.location.href = `/admin/cms/prompts/edit/${encodeURIComponent(data.slug)}`;
 } else if (stay) {
 window.location.reload();
 } else {
 window.location.href = '/admin/cms/prompts';
 }
 };
 setTimeout(go, 450);
 } else {
 const err = await res.json().catch(() => ({}));
 notify(`Save failed: ${err.error || res.statusText}`, 'error');
 setBtnLoading(activeBtn, false);
 actionBtns.forEach((btn) => { btn.disabled = false; });
 }
 }

 async function del() {
 const title = v('f-title') || slug;
 if (!confirm(`Delete prompt "${title}"? This cannot be undone.`)) return;
 const delBtn = document.getElementById('delete-btn');
 setBtnLoading(delBtn, true, 'Deleting…');
 try {
 const res = await fetch(`/api/admin/cms/prompts/${encodeURIComponent(slug)}`, { method: 'DELETE' });
 if (!res.ok) {
 const err = await res.json().catch(() => ({}));
 throw new Error(err.error || res.statusText);
 }
 notify('Prompt deleted', 'success');
 setTimeout(() => { window.location.href = '/admin/cms/prompts'; }, 450);
 } catch (err) {
 notify(`Delete failed: ${err.message || 'try again'}`, 'error');
 setBtnLoading(delBtn, false);
 }
 }

 document.getElementById('delete-btn').addEventListener('click', del);
 boot();
</script>

