---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import AdminSidebar from '../../../components/AdminSidebar.astro';
import { getPendingPrompts, getAllCategories } from '../../../lib/prompts';

const [pending, categories] = await Promise.all([
	getPendingPrompts(),
	getAllCategories(),
]);
const categoryName = new Map(categories.map((c) => [c.slug, `${c.emoji} ${c.name}`]));
---

<Layout title="Submissions — CMS — Free Prompt Base" noindex={true}>
	<div class="flex flex-col md:flex-row min-h-screen md:h-screen md:overflow-hidden">
		<AdminSidebar activePage="submissions" />

		<main class="flex-1 min-w-0 p-4 sm:p-6 md:p-6 space-y-5 bg-gray-50 md:overflow-y-auto md:h-screen">
			<header class="flex items-center justify-between gap-4">
				<div>
					<h1 class="text-xl sm:text-2xl font-semibold text-text-primary">Submissions</h1>
					<p class="text-xs text-gray-500 mt-0.5">
						{pending.length === 0
							? 'Inbox zero. No pending submissions.'
							: `${pending.length} pending submission${pending.length === 1 ? '' : 's'}.`}
					</p>
				</div>
			</header>

			{pending.length === 0 ? (
				<div class="bg-white border border-gray-200 rounded-md p-10 text-center text-sm text-gray-500">
					Nothing waiting for review right now.
				</div>
			) : (
				<ul class="space-y-3">
					{pending.map((p) => (
						<li
							class="bg-white border border-gray-200 rounded-md p-4 sm:p-5 flex flex-col sm:flex-row gap-4"
							data-slug={p.slug}
						>
							<div class="flex items-center gap-3 sm:flex-col sm:items-start sm:w-44 shrink-0">
								{p.submitterAvatar ? (
									<img src={p.submitterAvatar} alt="" referrerpolicy="no-referrer"
										class="w-10 h-10 rounded-full object-cover bg-gray-100" />
								) : (
									<div class="w-10 h-10 rounded-full bg-gray-200 flex items-center justify-center text-sm font-semibold text-gray-500">
										{p.submitterName.slice(0, 1).toUpperCase()}
									</div>
								)}
								<div class="min-w-0">
									<p class="text-sm font-medium text-text-primary truncate">{p.submitterName}</p>
									{p.submitterUsername ? (
										<a href={`/author/${p.submitterUsername}`}
											class="text-xs text-gray-500 hover:text-primary truncate block">
											@{p.submitterUsername}
										</a>
									) : null}
									<p class="text-[11px] text-gray-400 mt-0.5">
										{p.submittedAt?.slice(0, 10) ?? ''}
									</p>
								</div>
							</div>

							<div class="flex-1 min-w-0">
								<div class="flex items-start justify-between gap-3">
									<div class="min-w-0">
										<h2 class="text-base font-semibold text-text-primary truncate">{p.title}</h2>
										<p class="text-xs text-gray-500 mt-0.5">
											<span>{categoryName.get(p.category) ?? p.category}</span>
											<span class="mx-1.5">·</span>
											<span class="font-mono">{p.slug}</span>
										</p>
									</div>
								</div>
								{p.description ? (
									<p class="text-sm text-gray-700 mt-2 line-clamp-2">{p.description}</p>
								) : null}
								<details class="mt-3">
									<summary class="text-xs font-semibold text-gray-500 cursor-pointer hover:text-text-primary">
										View prompt text
									</summary>
									<pre class="mt-2 text-xs font-mono whitespace-pre-wrap bg-gray-50 border border-gray-200 rounded-md p-3 max-h-64 overflow-y-auto">{p.promptText}</pre>
								</details>
								<div class="mt-4 flex flex-wrap gap-2 items-center">
									<a href={`/admin/cms/prompts/edit/${p.slug}`}
										class="text-xs font-semibold text-gray-600 hover:text-text-primary px-3 py-1.5 rounded-md border border-gray-200 hover:border-primary transition-colors">
										Edit before approve
									</a>
									<button type="button" data-action="approve" data-slug={p.slug}
										class="bg-primary text-link text-xs font-semibold px-3 py-1.5 rounded-md hover:opacity-90 transition-opacity">
										Approve
									</button>
									<button type="button" data-action="reject" data-slug={p.slug}
										class="text-xs font-semibold text-red-600 hover:bg-red-50 px-3 py-1.5 rounded-md border border-red-200 transition-colors">
										Reject
									</button>
									<span data-feedback class="text-xs text-gray-500 ml-2 hidden"></span>
								</div>
							</div>
						</li>
					))}
				</ul>
			)}
		</main>
	</div>
</Layout>

<script>
	import { toast } from '../../../scripts/toast';

	async function review(action: 'approve' | 'reject', slug: string, reason?: string) {
		const res = await fetch(`/api/admin/cms/submissions/${encodeURIComponent(slug)}`, {
			method: 'PATCH',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ action, reason }),
		});
		return res;
	}

	document.querySelectorAll('button[data-action]').forEach((btn) => {
		btn.addEventListener('click', async () => {
			const button = btn as HTMLButtonElement;
			const action = button.dataset.action as 'approve' | 'reject';
			const slug = button.dataset.slug!;
			const row = document.querySelector(`li[data-slug="${slug}"]`) as HTMLElement | null;
			const feedback = row?.querySelector('[data-feedback]') as HTMLElement | null;

			let reason: string | undefined;
			if (action === 'reject') {
				const entered = window.prompt('Reason for rejection (shown to the submitter, optional):', '');
				if (entered === null) return;
				reason = entered.trim() || undefined;
			}

			button.disabled = true;
			if (feedback) {
				feedback.textContent = action === 'approve' ? 'Approving…' : 'Rejecting…';
				feedback.classList.remove('hidden');
			}

			const res = await review(action, slug, reason);
			if (res.ok) {
				toast(action === 'approve' ? 'Submission approved' : 'Submission rejected', 'success');
				if (row) {
					row.classList.add('opacity-50');
					setTimeout(() => row.remove(), 300);
				}
			} else {
				const err = await res.json().catch(() => ({}));
				const msg = err.error || `Failed (${res.status})`;
				if (feedback) feedback.textContent = msg;
				toast(msg, 'error');
				button.disabled = false;
			}
		});
	});
</script>
