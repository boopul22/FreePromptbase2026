---
export const prerender = false;

import Layout from '../../../../layouts/Layout.astro';
import AdminSidebar from '../../../../components/AdminSidebar.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
---

<Layout title="Posts - CMS - Free Prompt Base" noindex={true}>

 <div class="flex flex-col md:flex-row min-h-screen md:h-screen md:overflow-hidden">
 <AdminSidebar activePage="cms" />

 <main class="flex-1 min-w-0 p-3 sm:p-5 space-y-4 bg-gray-50 md:overflow-y-auto md:h-screen">
 <!-- Breadcrumb -->
 <Breadcrumb
 	variant="admin"
 	items={[
 		{ label: 'Content', href: '/admin/cms' },
 		{ label: 'Posts' },
 	]}
 />

 <!-- Header -->
 <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
 <div>
 <h1 class="text-lg font-semibold text-text-primary">Posts</h1>
 <p class="text-xs text-gray-500 mt-0.5" id="post-subtitle">Manage your blog content.</p>
 </div>
 <a href="/admin/cms/posts/new" class="btn-primary flex items-center gap-1.5 self-start sm:self-auto">
 <span class="material-symbols-outlined text-lg">add</span>
 New Post
 </a>
 </div>

 <!-- Filters -->
 <div class="flex flex-col md:flex-row gap-4">
 <div class="flex flex-wrap gap-1" id="status-filters">
 <button class="px-3 py-1.5 rounded-full border border-gray-200 text-xs font-semibold uppercase bg-text-primary text-surface transition-all" data-status="all">All</button>
 <button class="px-3 py-1.5 rounded-full border border-gray-200 text-xs font-semibold uppercase bg-white hover:bg-gray-100 transition-all" data-status="published">Published</button>
 <button class="px-3 py-1.5 rounded-full border border-gray-200 text-xs font-semibold uppercase bg-white hover:bg-gray-100 transition-all" data-status="draft">Drafts</button>
 <button class="px-3 py-1.5 rounded-full border border-gray-200 text-xs font-semibold uppercase bg-white hover:bg-gray-100 transition-all" data-status="archived">Archived</button>
 </div>
 <select id="category-filter" class="px-4 py-2 border border-gray-200 rounded-lg bg-white text-sm font-bold">
 <option value="">All Categories</option>
 </select>
 <div class="flex items-center gap-3 px-4 py-2 bg-white border border-gray-200 rounded-lg flex-1">
 <span class="material-symbols-outlined text-gray-500">search</span>
 <input id="search-input" type="text" placeholder="Search posts..." class="bg-transparent border-none focus:outline-none w-full font-body text-sm" />
 </div>
 </div>

 <!-- Posts Table -->
 <div id="posts-table" class="bg-white border border-gray-200 rounded-md overflow-hidden">
 <div class="py-10 px-6 text-center text-gray-500">
 <span class="material-symbols-outlined text-3xl">hourglass_empty</span>
 <p class="text-xs uppercase tracking-wide mt-2">Loading...</p>
 </div>
 </div>

 <!-- Pagination -->
 <div class="flex items-center justify-between">
 <p class="text-sm text-gray-500" id="showing-text"></p>
 <div id="pagination" class="flex gap-2"></div>
 </div>
 </main>
 </div>
</Layout>

<script>
 function esc(s: string): string {
 const d = document.createElement('div');
 d.textContent = s;
 return d.innerHTML;
 }

 let currentPage = 1;
 let currentStatus = 'all';
 let currentCategory = '';
 let currentSearch = '';

 async function loadCategories() {
 const res = await fetch('/api/admin/cms/categories');
 const data = await res.json();
 const select = document.getElementById('category-filter') as HTMLSelectElement;
 for (const cat of data.categories || []) {
 const opt = document.createElement('option');
 opt.value = cat.id;
 opt.textContent = `${cat.name} (${cat.postCount})`;
 select.appendChild(opt);
 }
 }

 async function loadPosts(page: number) {
 const params = new URLSearchParams({ page: String(page), limit: '20' });
 if (currentStatus !== 'all') params.set('status', currentStatus);
 if (currentCategory) params.set('category', currentCategory);
 if (currentSearch) params.set('search', currentSearch);

 const res = await fetch(`/api/admin/cms/posts?${params}`);
 const data = await res.json();
 currentPage = page;

 document.getElementById('post-subtitle')!.textContent =
 `${data.total} posts total`;

 const table = document.getElementById('posts-table')!;
 if (!data.posts?.length) {
 table.innerHTML = '<div class="py-10 px-6 text-center text-gray-500"><span class="material-symbols-outlined text-3xl">article</span><p class="text-xs uppercase tracking-wide mt-2">No posts found</p></div>';
 document.getElementById('showing-text')!.textContent = '';
 document.getElementById('pagination')!.innerHTML = '';
 return;
 }

 const statusBadge = (status: string) => {
 if (status === 'published') return '<span class="px-2.5 py-1 rounded-full text-xs font-bold uppercase bg-blue-50 text-blue-900 border border-secondary">Published</span>';
 if (status === 'draft') return '<span class="px-2.5 py-1 rounded-full text-xs font-bold uppercase bg-amber-50 text-amber-900 border border-tertiary">Draft</span>';
 return '<span class="px-2.5 py-1 rounded-full text-xs font-bold uppercase bg-red-50 text-red-900 border border-red-300">Archived</span>';
 };

 // --- Mobile card list (md:hidden) ---
 const cards = `
 <ul class="md:hidden divide-y divide-gray-200">
 ${data.posts.map((p: any) => `
 <li class="p-4">
 <div class="flex items-start justify-between gap-3">
 <div class="min-w-0 flex-1">
 <a href="/admin/cms/posts/edit/${esc(p.id)}" class="font-semibold text-text-primary block leading-snug">${esc(p.title)}</a>
 ${p.excerpt ? `<p class="text-xs text-gray-500 mt-1 line-clamp-2">${esc(p.excerpt)}</p>` : ''}
 <div class="flex flex-wrap items-center gap-x-2 gap-y-1 mt-2 text-xs text-gray-500">
 <span>${esc(p.categoryName || 'Uncategorized')}</span>
 <span aria-hidden="true">·</span>
 <span>${new Date(p.updatedAt).toLocaleDateString()}</span>
 <span aria-hidden="true">·</span>
 <span>${esc(p.authorName)}</span>
 </div>
 </div>
 ${statusBadge(p.status)}
 </div>
 <div class="flex flex-wrap items-center gap-2 mt-3">
 <a href="/admin/cms/posts/edit/${esc(p.id)}" class="btn-secondary btn-sm inline-flex items-center gap-1.5">
 <span class="material-symbols-outlined text-base">edit</span>
 Edit
 </a>
 ${p.status === 'published'
 ? `<button onclick="postAction('${p.id}', 'unpublish')" class="btn-secondary btn-sm">Unpublish</button>`
 : p.status === 'draft'
 ? `<button onclick="postAction('${p.id}', 'publish')" class="btn-primary btn-sm">Publish</button>`
 : ''}
 <button onclick="postAction('${p.id}', 'archive')" class="btn-danger btn-sm ml-auto inline-flex items-center gap-1.5">
 <span class="material-symbols-outlined text-base">archive</span>
 Archive
 </button>
 </div>
 </li>`).join('')}
 </ul>`;

 // --- Desktop table (hidden md:block) ---
 const tableHtml = `
 <div class="hidden md:block overflow-x-auto"><table class="w-full text-left min-w-[700px]">
 <thead>
 <tr class="border-b border-gray-200">
 <th class="px-3 py-2 text-[11px] font-semibold uppercase tracking-wide text-gray-500">Title</th>
 <th class="px-3 py-2 text-[11px] font-semibold uppercase tracking-wide text-gray-500">Category</th>
 <th class="px-3 py-2 text-[11px] font-semibold uppercase tracking-wide text-gray-500">Status</th>
 <th class="px-3 py-2 text-[11px] font-semibold uppercase tracking-wide text-gray-500">Author</th>
 <th class="px-3 py-2 text-[11px] font-semibold uppercase tracking-wide text-gray-500">Updated</th>
 <th class="px-3 py-2 text-[11px] font-semibold uppercase tracking-wide text-gray-500">Actions</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-gray-200/50">
 ${data.posts.map((p: any) => `
 <tr class="hover:bg-gray-50 transition-colors">
 <td class="px-3 py-2.5 text-sm">
 <div>
 <a href="/admin/cms/posts/edit/${esc(p.id)}" class="font-bold text-sm hover:text-secondary transition-colors">${esc(p.title)}</a>
 ${p.featured ? '<span class="ml-2 text-xs text-tertiary font-bold uppercase">Featured</span>' : ''}
 <p class="text-xs text-gray-500 truncate mt-0.5 max-w-sm">${esc(p.excerpt)}</p>
 </div>
 </td>
 <td class="px-3 py-2.5 text-sm text-gray-600">${esc(p.categoryName || '—')}</td>
 <td class="px-3 py-2.5 text-sm">${statusBadge(p.status)}</td>
 <td class="px-3 py-2.5 text-sm text-gray-600">${esc(p.authorName)}</td>
 <td class="px-3 py-2.5 text-sm text-gray-600">${new Date(p.updatedAt).toLocaleDateString()}</td>
 <td class="px-3 py-2.5 text-sm">
 <div class="flex gap-2">
 <a href="/admin/cms/posts/edit/${esc(p.id)}" class="btn-secondary btn-sm">Edit</a>
 ${p.status === 'published'
 ? `<button onclick="postAction('${p.id}', 'unpublish')" class="btn-secondary btn-sm">Unpublish</button>`
 : p.status === 'draft'
 ? `<button onclick="postAction('${p.id}', 'publish')" class="btn-primary btn-sm">Publish</button>`
 : ''
 }
 <button onclick="postAction('${p.id}', 'archive')" class="btn-danger btn-sm">Archive</button>
 </div>
 </td>
 </tr>
 `).join('')}
 </tbody>
 </table></div>`;

 table.innerHTML = cards + tableHtml;

 // Showing text
 const start = (page - 1) * 20 + 1;
 const end = Math.min(page * 20, data.total);
 document.getElementById('showing-text')!.textContent = `Showing ${start}–${end} of ${data.total}`;

 // Pagination
 const pag = document.getElementById('pagination')!;
 if (data.totalPages > 1) {
 pag.innerHTML = `
 <button onclick="loadPage(${Math.max(1, page - 1)})" class="px-4 py-2.5 border border-gray-200 rounded-md text-xs font-bold bg-white hover:bg-gray-100 active:bg-gray-100 transition-colors ${page === 1 ? 'opacity-30' : ''}">Previous</button>
 <button onclick="loadPage(${Math.min(data.totalPages, page + 1)})" class="px-4 py-2.5 border border-gray-200 rounded-md text-xs font-bold bg-white hover:bg-gray-100 active:bg-gray-100 transition-colors ${page === data.totalPages ? 'opacity-30' : ''}">Next</button>
 `;
 } else {
 pag.innerHTML = '';
 }
 }

 (window as any).postAction = async (id: string, action: string) => {
 if (action === 'archive') {
 if (!confirm('Archive this post?')) return;
 await fetch('/api/admin/cms/posts', {
 method: 'DELETE',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ id }),
 });
 } else {
 await fetch(`/api/admin/cms/posts/${id}/${action}`, { method: 'POST' });
 }
 loadPosts(currentPage);
 };

 (window as any).loadPage = (page: number) => loadPosts(page);

 // Status filter
 document.getElementById('status-filters')?.addEventListener('click', (e) => {
 const btn = (e.target as HTMLElement).closest('button');
 if (!btn) return;
 currentStatus = btn.dataset.status || 'all';
 document.querySelectorAll('#status-filters button').forEach(b => {
 b.className = b === btn
 ? 'px-3 py-1.5 rounded-full border border-gray-200 text-xs font-semibold uppercase bg-text-primary text-surface transition-all'
 : 'px-3 py-1.5 rounded-full border border-gray-200 text-xs font-semibold uppercase bg-white hover:bg-gray-100 transition-all';
 });
 loadPosts(1);
 });

 // Category filter
 document.getElementById('category-filter')?.addEventListener('change', (e) => {
 currentCategory = (e.target as HTMLSelectElement).value;
 loadPosts(1);
 });

 // Search
 let searchTimeout: any;
 document.getElementById('search-input')?.addEventListener('input', (e) => {
 clearTimeout(searchTimeout);
 searchTimeout = setTimeout(() => {
 currentSearch = (e.target as HTMLInputElement).value;
 loadPosts(1);
 }, 300);
 });

 loadCategories();
 loadPosts(1);
</script>
