---
export const prerender = false;

import Layout from '../../../../layouts/Layout.astro';
import AdminSidebar from '../../../../components/AdminSidebar.astro';
---

<Layout title="Posts - CMS - Free Prompt Base" noindex={true}>

 <div class="flex h-screen overflow-hidden">
 <AdminSidebar activePage="cms" />

 <main class="flex-1 p-4 sm:p-6 md:p-6 space-y-4 sm:space-y-6 bg-gray-50 overflow-y-auto h-screen">
 <!-- Breadcrumb -->
 <nav class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-gray-500" aria-label="Breadcrumb">
 <a href="/admin/cms" class="hover:text-text-primary transition-colors">Content</a>
 <span class="material-symbols-outlined text-sm">chevron_right</span>
 <span class="text-text-primary">Posts</span>
 </nav>

 <!-- Header -->
 <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
 <div>
 <h1 class="text-xl sm:text-2xl font-bold text-text-primary">Posts</h1>
 <p class="text-gray-600 mt-1" id="post-subtitle">Manage your blog content.</p>
 </div>
 <a href="/admin/cms/posts/new" class="bg-primary text-link px-4 py-2 rounded-md text-xs font-semibold uppercase tracking-wide border border-gray-200 transition-all flex items-center gap-2 self-start sm:self-auto">
 <span class="material-symbols-outlined text-lg">add</span>
 New Post
 </a>
 </div>

 <!-- Filters -->
 <div class="flex flex-col md:flex-row gap-4">
 <div class="flex flex-wrap gap-1" id="status-filters">
 <button class="px-4 py-2 rounded-full border border-gray-200 text-xs font-bold uppercase bg-text-primary text-surface transition-all" data-status="all">All</button>
 <button class="px-4 py-2 rounded-full border border-gray-200 text-xs font-bold uppercase bg-white hover:bg-gray-100 transition-all" data-status="published">Published</button>
 <button class="px-4 py-2 rounded-full border border-gray-200 text-xs font-bold uppercase bg-white hover:bg-gray-100 transition-all" data-status="draft">Drafts</button>
 <button class="px-4 py-2 rounded-full border border-gray-200 text-xs font-bold uppercase bg-white hover:bg-gray-100 transition-all" data-status="archived">Archived</button>
 </div>
 <select id="category-filter" class="px-4 py-2 border border-gray-200 rounded-lg bg-white text-sm font-bold">
 <option value="">All Categories</option>
 </select>
 <div class="flex items-center gap-3 px-4 py-2 bg-white border border-gray-200 rounded-lg flex-1">
 <span class="material-symbols-outlined text-gray-500">search</span>
 <input id="search-input" type="text" placeholder="Search posts..." class="bg-transparent border-none focus:outline-none w-full font-body text-sm" />
 </div>
 </div>

 <!-- Posts Table -->
 <div id="posts-table" class="bg-white border border-gray-200 rounded-md overflow-hidden">
 <div class="p-6 text-center text-gray-500">
 <span class="material-symbols-outlined text-4xl">hourglass_empty</span>
 <p class="text-xs uppercase tracking-wide mt-2">Loading...</p>
 </div>
 </div>

 <!-- Pagination -->
 <div class="flex items-center justify-between">
 <p class="text-sm text-gray-500" id="showing-text"></p>
 <div id="pagination" class="flex gap-2"></div>
 </div>
 </main>
 </div>
</Layout>

<script>
 function esc(s: string): string {
 const d = document.createElement('div');
 d.textContent = s;
 return d.innerHTML;
 }

 let currentPage = 1;
 let currentStatus = 'all';
 let currentCategory = '';
 let currentSearch = '';

 async function loadCategories() {
 const res = await fetch('/api/admin/cms/categories');
 const data = await res.json();
 const select = document.getElementById('category-filter') as HTMLSelectElement;
 for (const cat of data.categories || []) {
 const opt = document.createElement('option');
 opt.value = cat.id;
 opt.textContent = `${cat.name} (${cat.postCount})`;
 select.appendChild(opt);
 }
 }

 async function loadPosts(page: number) {
 const params = new URLSearchParams({ page: String(page), limit: '20' });
 if (currentStatus !== 'all') params.set('status', currentStatus);
 if (currentCategory) params.set('category', currentCategory);
 if (currentSearch) params.set('search', currentSearch);

 const res = await fetch(`/api/admin/cms/posts?${params}`);
 const data = await res.json();
 currentPage = page;

 document.getElementById('post-subtitle')!.textContent =
 `${data.total} posts total`;

 const table = document.getElementById('posts-table')!;
 if (!data.posts?.length) {
 table.innerHTML = '<div class="p-6 text-center text-gray-500"><span class="material-symbols-outlined text-4xl">article</span><p class="text-xs uppercase tracking-wide mt-2">No posts found</p></div>';
 document.getElementById('showing-text')!.textContent = '';
 document.getElementById('pagination')!.innerHTML = '';
 return;
 }

 const statusBadge = (status: string) => {
 if (status === 'published') return '<span class="px-2.5 py-1 rounded-full text-xs font-bold uppercase bg-blue-50 text-blue-900 border border-secondary">Published</span>';
 if (status === 'draft') return '<span class="px-2.5 py-1 rounded-full text-xs font-bold uppercase bg-amber-50 text-amber-900 border border-tertiary">Draft</span>';
 return '<span class="px-2.5 py-1 rounded-full text-xs font-bold uppercase bg-red-50 text-red-900 border border-red-300">Archived</span>';
 };

 table.innerHTML = `
 <div class="overflow-x-auto"><table class="w-full text-left min-w-[700px]">
 <thead>
 <tr class="border-b border-gray-200">
 <th class="px-6 py-4 text-xs uppercase tracking-wide font-bold text-gray-500 tracking-wider">Title</th>
 <th class="px-6 py-4 text-xs uppercase tracking-wide font-bold text-gray-500 tracking-wider">Category</th>
 <th class="px-6 py-4 text-xs uppercase tracking-wide font-bold text-gray-500 tracking-wider">Status</th>
 <th class="px-6 py-4 text-xs uppercase tracking-wide font-bold text-gray-500 tracking-wider">Author</th>
 <th class="px-6 py-4 text-xs uppercase tracking-wide font-bold text-gray-500 tracking-wider">Updated</th>
 <th class="px-6 py-4 text-xs uppercase tracking-wide font-bold text-gray-500 tracking-wider">Actions</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-gray-200/50">
 ${data.posts.map((p: any) => `
 <tr class="hover:bg-gray-50 transition-colors">
 <td class="px-6 py-4">
 <div>
 <a href="/admin/cms/posts/edit/${esc(p.id)}" class="font-bold text-sm hover:text-primary transition-colors">${esc(p.title)}</a>
 ${p.featured ? '<span class="ml-2 text-xs text-tertiary font-bold uppercase">Featured</span>' : ''}
 <p class="text-xs text-gray-500 truncate mt-0.5 max-w-sm">${esc(p.excerpt)}</p>
 </div>
 </td>
 <td class="px-6 py-4 text-sm text-gray-600">${esc(p.categoryName || '—')}</td>
 <td class="px-6 py-4">${statusBadge(p.status)}</td>
 <td class="px-6 py-4 text-sm text-gray-600">${esc(p.authorName)}</td>
 <td class="px-6 py-4 text-sm text-gray-600">${new Date(p.updatedAt).toLocaleDateString()}</td>
 <td class="px-6 py-4">
 <div class="flex gap-2">
 <a href="/admin/cms/posts/edit/${esc(p.id)}" class="px-3 py-1 rounded-full text-xs font-bold uppercase border border-primary text-primary hover:bg-primary hover:text-link transition-colors">Edit</a>
 ${p.status === 'published'
 ? `<button onclick="postAction('${p.id}', 'unpublish')" class="px-3 py-1 rounded-full text-xs font-bold uppercase border border-gray-300 text-gray-500 hover:bg-gray-100 transition-colors">Unpublish</button>`
 : p.status === 'draft'
 ? `<button onclick="postAction('${p.id}', 'publish')" class="px-3 py-1 rounded-full text-xs font-bold uppercase border border-secondary text-secondary hover:bg-secondary hover:text-on-secondary transition-colors">Publish</button>`
 : ''
 }
 <button onclick="postAction('${p.id}', 'archive')" class="px-3 py-1 rounded-full text-xs font-bold uppercase border border-red-300 text-red-600 hover:bg-red-50 hover:text-red-900 transition-colors">Archive</button>
 </div>
 </td>
 </tr>
 `).join('')}
 </tbody>
 </table></div>
 `;

 // Showing text
 const start = (page - 1) * 20 + 1;
 const end = Math.min(page * 20, data.total);
 document.getElementById('showing-text')!.textContent = `Showing ${start}–${end} of ${data.total}`;

 // Pagination
 const pag = document.getElementById('pagination')!;
 if (data.totalPages > 1) {
 pag.innerHTML = `
 <button onclick="loadPage(${Math.max(1, page - 1)})" class="px-4 py-2.5 border border-gray-200 rounded-md text-xs font-bold bg-white hover:bg-gray-100 active:bg-gray-100 transition-colors ${page === 1 ? 'opacity-30' : ''}">Previous</button>
 <button onclick="loadPage(${Math.min(data.totalPages, page + 1)})" class="px-4 py-2.5 border border-gray-200 rounded-md text-xs font-bold bg-white hover:bg-gray-100 active:bg-gray-100 transition-colors ${page === data.totalPages ? 'opacity-30' : ''}">Next</button>
 `;
 } else {
 pag.innerHTML = '';
 }
 }

 (window as any).postAction = async (id: string, action: string) => {
 if (action === 'archive') {
 if (!confirm('Archive this post?')) return;
 await fetch('/api/admin/cms/posts', {
 method: 'DELETE',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ id }),
 });
 } else {
 await fetch(`/api/admin/cms/posts/${id}/${action}`, { method: 'POST' });
 }
 loadPosts(currentPage);
 };

 (window as any).loadPage = (page: number) => loadPosts(page);

 // Status filter
 document.getElementById('status-filters')?.addEventListener('click', (e) => {
 const btn = (e.target as HTMLElement).closest('button');
 if (!btn) return;
 currentStatus = btn.dataset.status || 'all';
 document.querySelectorAll('#status-filters button').forEach(b => {
 b.className = b === btn
 ? 'px-4 py-2 rounded-full border border-gray-200 text-xs font-bold uppercase bg-text-primary text-surface transition-all'
 : 'px-4 py-2 rounded-full border border-gray-200 text-xs font-bold uppercase bg-white hover:bg-gray-100 transition-all';
 });
 loadPosts(1);
 });

 // Category filter
 document.getElementById('category-filter')?.addEventListener('change', (e) => {
 currentCategory = (e.target as HTMLSelectElement).value;
 loadPosts(1);
 });

 // Search
 let searchTimeout: any;
 document.getElementById('search-input')?.addEventListener('input', (e) => {
 clearTimeout(searchTimeout);
 searchTimeout = setTimeout(() => {
 currentSearch = (e.target as HTMLInputElement).value;
 loadPosts(1);
 }, 300);
 });

 loadCategories();
 loadPosts(1);
</script>
