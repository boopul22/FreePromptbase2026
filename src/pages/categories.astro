---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Footer from '../components/Footer.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import { getAllCategories, getCategoryCounts } from '../lib/prompts';
import { itemListSchema, breadcrumbSchema } from '../lib/seo';

export const prerender = false;

const categories = await getAllCategories();
const counts = await getCategoryCounts();

const list = itemListSchema(
	categories.map((c) => ({ name: c.name, url: `/category/${c.slug}` })),
	'Prompt categories',
);
const crumb = breadcrumbSchema([
	{ name: 'Home', path: '/' },
	{ name: 'Categories', path: '/categories' },
]);
---

<Layout
	title="Categories — Free Prompt Base"
	description="Browse AI prompt categories: writing, coding, image generation, marketing and more."
	extraSchemas={[list, crumb]}
>
	<Header />
	<main class="flex-grow site-main py-12">
		<Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Categories' }]} />
		<header class="text-center mb-12">
			<h1 class="text-3xl md:text-4xl font-bold tracking-tight text-text-primary">
				Browse by category
			</h1>
			<p class="text-gray-600 text-lg mt-3">
				Find the right prompt for the job across {categories.length} collections.
			</p>
		</header>

		<div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
			{
				categories.map((cat) => (
					<a
						href={`/category/${cat.slug}`}
						class="flex items-center gap-4 bg-gray-100 rounded-2xl p-4 hover:bg-gray-200 transition-colors"
					>
						<div class="flex items-center justify-center w-12 h-12 shrink-0 rounded-xl bg-white shadow-sm">
							<CategoryIcon slug={cat.slug} class="w-6 h-6 text-primary" />
						</div>
						<div class="min-w-0">
							<h2 class="font-bold text-text-primary leading-tight truncate">{cat.name}</h2>
							<p class="text-xs text-gray-600 mt-1">
								{counts[cat.slug] ?? 0} {(counts[cat.slug] ?? 0) === 1 ? 'Prompt' : 'Prompts'}
							</p>
						</div>
					</a>
				))
			}
		</div>
	</main>
	<Footer />
</Layout>
