---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getAllCategories, getCategoryCounts } from '../lib/prompts';

const categories = await getAllCategories();
const counts = await getCategoryCounts();
---

<Layout title="Categories — Free Prompt Base" description="Browse AI prompt categories: writing, coding, image generation, marketing and more.">
	<Header />
	<main class="flex-grow max-w-7xl mx-auto px-4 w-full py-12">
		<header class="text-center mb-12">
			<h1 class="text-3xl md:text-4xl font-bold tracking-tight text-text-primary">
				Browse by category
			</h1>
			<p class="text-gray-600 text-lg mt-3">
				Find the right prompt for the job across {categories.length} collections.
			</p>
		</header>

		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
			{
				categories.map((cat) => (
					<a
						href={`/category/${cat.slug}`}
						class="flex flex-col bg-white rounded-base border border-gray-200 p-6 hover:border-primary hover:shadow-sm transition-all"
					>
						<span class="text-4xl">{cat.emoji}</span>
						<h2 class="font-bold text-lg text-text-primary mt-4">{cat.name}</h2>
						<p class="text-sm text-gray-500 mt-1 flex-grow">{cat.description}</p>
						<span class="text-xs font-semibold text-primary mt-4">
							{counts[cat.slug] ?? 0} {(counts[cat.slug] ?? 0) === 1 ? 'prompt' : 'prompts'} →
						</span>
					</a>
				))
			}
		</div>
	</main>
	<Footer />
</Layout>
